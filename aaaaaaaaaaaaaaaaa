local StreamingEnabled = workspace.StreamingEnabled
local lastKnownPositions = {}

RunService.Heartbeat:Connect(function()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    lastKnownPositions[plr.UserId] = hrp.Position
                end
            end
        end
    end
end)

local function ForceStreamToPlayer(player, callback)
    if not player or player == LocalPlayer then
        if callback then callback() end
        return
    end

    -- Si el juego NO tiene streaming, ejecutar callback directo
    if not StreamingEnabled then
        if callback then callback() end
        return
    end

    -- Forzar stream solo si el char no está renderizado o no tiene RootPart
    local charOk = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

    if charOk then
        -- Ya está renderizado, solo llamar callback
        if callback then callback() end
        return
    end

    -- Necesita forzar stream — usar última posición conocida si hay
    local targetPos = lastKnownPositions and lastKnownPositions[player.UserId]
    if not targetPos then
        Rayfield:Notify({Title = "Sin datos", Content = "No hay posición conocida de " .. player.Name, Duration = 3, Image = 4483362458})
        return
    end

    pcall(function()
        LocalPlayer:RequestStreamAroundAsync(targetPos, 1024)
    end)

    -- Esperar hasta que aparezca (máx 3s)
    task.spawn(function()
        local intentos = 0
        repeat
            task.wait(0.3)
            intentos = intentos + 1
        until (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) or intentos >= 20

        if callback then callback() end
    end)
end

