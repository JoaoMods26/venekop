    DragImage = 127271155083726
})

local ItemsTab = Window:CreateTab("Items")
local EnviarTab = Window:CreateTab("Jugadores")

local itemSeleccionado = nil
local itemEnviar = nil
local jugadorDestino = nil
local radioCirculo = 4
local radioCirculoEnviar = 4

local function getCarpeta()
    local map = workspace:FindFirstChild("Map")
    if not map then warn("No existe workspace.Map") return nil end
    local util = map:FindFirstChild("Util")
    if not util then warn("No existe workspace.Map.Util") return nil end
    local items = util:FindFirstChild("Items")
    if not items then warn("No existe workspace.Map.Util.Items") return nil end
    return items
end

local function getCFrame(obj)
    if obj:IsA("BasePart") then
        return obj.CFrame
    elseif obj:IsA("Tool") then
        local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
        if handle then return handle.CFrame end
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.CFrame end
        local parte = obj:FindFirstChildWhichIsA("BasePart")
        if parte then return parte.CFrame end
    end
    return nil
end

local function moverA(obj, targetCFrame)
    if obj:IsA("BasePart") then
        obj.CFrame = targetCFrame
    elseif obj:IsA("Tool") then
        local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
        if handle then
            handle.CFrame = targetCFrame
            for _, parte in pairs(obj:GetDescendants()) do
                if parte:IsA("BasePart") and parte ~= handle then
                    parte.CFrame = targetCFrame
                end
            end
        end
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then
            obj:SetPrimaryPartCFrame(targetCFrame)
        else
            local parte = obj:FindFirstChildWhichIsA("BasePart")
            if parte then parte.CFrame = targetCFrame end
        end
    end
end

--- Círculo genérico, recibe el radio como parámetro
local function moverEnCirculo(itemsList, centroCFrame, radio)
    local total = #itemsList
    for i, item in ipairs(itemsList) do
        local angulo = (2 * math.pi / total) * (i - 1)
        local offsetX = math.cos(angulo) * radio
        local offsetZ = math.sin(angulo) * radio
        local nuevaPos = centroCFrame.Position + Vector3.new(offsetX, 3, offsetZ)
        moverA(item, CFrame.new(nuevaPos))
    end
end

--- Traer ABSOLUTAMENTE todos los items de la carpeta en círculo
local function traerTodosLosItems(centroCFrame, radio)
    local carpeta = getCarpeta()
    if not carpeta then return 0 end
    local lista = {}
    for _, item in pairs(carpeta:GetChildren()) do
        table.insert(lista, item)
    end
    if #lista == 0 then return 0 end
    if #lista == 1 then
        moverA(lista[1], centroCFrame + Vector3.new(0, 3, 3))
    else
        moverEnCirculo(lista, centroCFrame, radio)
    end
    return #lista
end

local function obtenerItems()
    local carpeta = getCarpeta()
    if not carpeta then return {"(Ruta no encontrada)"} end
    local items = {}
    local nombresVistos = {}
    for _, item in pairs(carpeta:GetChildren()) do
        if not nombresVistos[item.Name] then
            nombresVistos[item.Name] = true
            table.insert(items, item.Name)
        end
    end
    if #items == 0 then return {"(Carpeta vacia)"} end
    return items
end

local function obtenerJugadores()
    local lista = {}
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= game.Players.LocalPlayer then
            table.insert(lista, p.Name)
        end
    end
    if #lista == 0 then return {"(No hay jugadores)"} end
    return lista
end

