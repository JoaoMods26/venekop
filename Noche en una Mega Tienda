    end
})

spawn(function()
    while true do
        wait(3)
        ItemsDropdown:UpdateOnClose(obtenerItems())
    end
end)

ItemsTab:CreateSection("Acciones")

ItemsTab:CreateButton({
    Name = "Ir al Item",
    Callback = function()
        if not itemSeleccionado then
            JmodsLib:Notify({ Title = "Sin Seleccion", Content = "Selecciona un item primero.", Duration = 3 })
            return
        end
        local carpeta = getCarpeta() if not carpeta then return end
        local target = carpeta:FindFirstChild(itemSeleccionado)
        if not target then
            JmodsLib:Notify({ Title = "Error", Content = "No se encontro: " .. itemSeleccionado, Duration = 3 })
            return
        end
        local targetCFrame = getCFrame(target)
        if not targetCFrame then return end
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = targetCFrame + Vector3.new(0, 5, 0)
            JmodsLib:Notify({ Title = "Teleport", Content = "Fuiste a: " .. itemSeleccionado, Duration = 3 })
        end
    end
})

ItemsTab:CreateButton({
    Name = "Traer Item",
    Callback = function()
        if not itemSeleccionado then
            JmodsLib:Notify({ Title = "Sin Seleccion", Content = "Selecciona un item primero.", Duration = 3 })
            return
        end
        local carpeta = getCarpeta() if not carpeta then return end
        local char = game.Players.LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local target = carpeta:FindFirstChild(itemSeleccionado)
        if not target then
            JmodsLib:Notify({ Title = "Error", Content = "No se encontro: " .. itemSeleccionado, Duration = 3 })
            return
        end
        moverA(target, char.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0))
        JmodsLib:Notify({ Title = "Item Traido", Content = "Trajiste: " .. itemSeleccionado, Duration = 3 })
    end
})

ItemsTab:CreateButton({
    Name = "Traer Todos del mismo (en circulo)",
    Callback = function()
        if not itemSeleccionado then
            JmodsLib:Notify({ Title = "Sin Seleccion", Content = "Selecciona un item primero.", Duration = 3 })
            return
        end
        local carpeta = getCarpeta() if not carpeta then return end
        local char = game.Players.LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local listaItems = {}
        for _, item in pairs(carpeta:GetChildren()) do
            if item.Name == itemSeleccionado then
                table.insert(listaItems, item)
            end
        end
        if #listaItems == 0 then
            JmodsLib:Notify({ Title = "Error", Content = "No se encontraron items.", Duration = 3 })
            return
        end
        if #listaItems == 1 then
            moverA(listaItems[1], char.HumanoidRootPart.CFrame + Vector3.new(0, 3, 3))
        else
            moverEnCirculo(listaItems, char.HumanoidRootPart.CFrame, radioCirculo)
        end
        JmodsLib:Notify({
            Title = "Items Traidos",
            Content = string.format("Trajiste %d x '%s'", #listaItems, itemSeleccionado),
            Duration = 4
        })
    end
})

--- BOTON NUEVO: Traer absolutamente todos los items
ItemsTab:CreateButton({
