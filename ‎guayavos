local function awaitCircuitPromise(promise, timeout)
    if not promise then
        return false,nil
    end
    local finished = false
    local success = false
    local response = nil
    pcall(function()
        promise:andThen(function(result)
            success = true
            response = result
            finished = true
        end):catch(function(err)
            response = err
            finished = true
        end)
    end)
    local deadline = tick() + (timeout or 5)
    while not finished and tick() < deadline do
        task.wait()
    end
    return success,response
end

local function normalizeCircuitGraph(value)
    if type(value) ~= "table" then
        return nil
    end
    if type(value.nodes) ~= "table" or type(value.execs) ~= "table" or type(value.datas) ~= "table" then
        return nil
    end
    local nextId = tonumber(value.next) or tonumber(value.nextId) or tonumber(value.nextNode) or tonumber(value.nextIndex)
    if not nextId then
        nextId = 1
        for _,node in ipairs(value.nodes) do
            local id = tonumber(node.i)
            if id and id >= nextId then
                nextId = id + 1
            end
        end
    end
    nextId = math.max(1,math.floor(nextId))
    return {
        nodes=value.nodes,
        execs=value.execs,
        datas=value.datas,
        next=nextId
    }
end

local function getCircuitGraph(response)
    if type(response) ~= "table" then
        return nil
    end

    local directKeys={"graph","data","result","state","session","circuit","payload","value"}
    local visited={}

    local function scan(value,depth)
        if type(value) ~= "table" or depth > 10 or visited[value] then
            return nil
        end
        visited[value]=true
        local normalized=normalizeCircuitGraph(value)
        if normalized then
            return normalized
        end
        for _,key in ipairs(directKeys) do
            local nested=rawget(value,key)
            if type(nested)=="table" then
                local found=scan(nested,depth+1)
                if found then
                    return found
                end
            end
        end
        for _,nested in pairs(value) do
            if type(nested)=="table" then
                local found=scan(nested,depth+1)
                if found then
                    return found
                end
            end
        end
        return nil
    end

    return scan(response,0)
end

local function cloneCircuit(sourceObject,targetObject)
    if not CircuitsNet then
        return false,"Circuits.Net no disponible"
    end
    local sourceId=sourceObject and sourceObject:GetAttribute("CircuitId")
    if typeof(sourceId)~="number" or sourceId<=0 then
        return false,"panel origen sin CircuitId valido"
    end
    local targetId=targetObject and targetObject:GetAttribute("CircuitId")
    local deadline=tick()+4
    while (typeof(targetId)~="number" or targetId<=0) and tick()<deadline do
        task.wait(.05)
        targetId=targetObject and targetObject:GetAttribute("CircuitId")
    end
    if typeof(targetId)~="number" or targetId<=0 then
        return false,"panel destino sin CircuitId valido"
    end
    if sourceId==targetId then
        return false,"CircuitId origen y destino iguales"
    end
    local openOK,openPromise=pcall(function()
        return CircuitsNet.Open.invoke({panel=math.floor(sourceId)})
    end)
    if not openOK or not openPromise then
        return false,"no se pudo abrir el circuito origen: "..tostring(openPromise)
    end
    local readOK,response=awaitCircuitPromise(openPromise,5)
    if not readOK then
        return false,"Open rechazado: "..tostring(response)
    end
    local graph=getCircuitGraph(response)
    if not graph then
        warn("CIRCUITO OPEN RESPUESTA:",response)
        return false,"Open no devolvio un graph util"
    end
    local saveOK,savePromise=pcall(function()
        return CircuitsNet.Save.invoke({
            panel=math.floor(targetId),
            graph=graph
        })
    end)
    if not saveOK or not savePromise then
        return false,"no se pudo guardar el circuito destino: "..tostring(savePromise)
    end
    local writeOK,writeResponse=awaitCircuitPromise(savePromise,5)
    if not writeOK then
        return false,"Save rechazado: "..tostring(writeResponse)
    end
    return true
end

