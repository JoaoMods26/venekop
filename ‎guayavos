function JmodsAvatarProgress:Update(current,stage,total)
    pcall(function()
        if not self.Gui or not self.Fill then
            return
        end
        total = math.max(1,tonumber(total) or self.Total or 1)
        current = math.clamp(tonumber(current) or 0,0,total)
        self.Total = total
        self.Current = current
        local ratio = current/total
        self.Fill.Size = UDim2.new(ratio,0,1,0)
        self.Percent.Text = tostring(math.floor(ratio*100+.5)).."%"
        self.Info.Text = tostring(stage or "Procesando").." | "..tostring(current).."/"..tostring(total)
    end)
end

function JmodsAvatarProgress:Step(stage)
    if self.Gui then
        self:Update((self.Current or 0)+1,stage,self.Total)
    end
end

function JmodsAvatarProgress:Finish(stopped)
    pcall(function()
        if not self.Gui then
            return
        end
        if not stopped then
            self:Update(self.Total,"Completado",self.Total)
            if self.Title then
                self.Title.Text = "Avatar listo"
            end
        elseif self.Title then
            self.Title.Text = "Operación cancelada"
        end
        task.delay(.8,function()
            pcall(function()
                if self.Gui then
                    self.Gui:Destroy()
                    self.Gui = nil
                    self.Fill = nil
                    self.Percent = nil
                    self.Info = nil
                    self.Title = nil
                end
            end)
        end)
    end)
end

local AvatarProgressStage = "Preparando"

 function CountAvatarAssets(desc,includeBody,includeClothes,includeAccessories,includeMakeup,includeAnimations)
    local total = 0
    if not desc then
        return 0
    end
    if includeBody then
        for _,prop in ipairs(bodyParts) do
            local id = tonumber(desc[prop])
            if id and id > 0 then
                total += 1
            end
        end
    end
    if includeClothes then
        for _,prop in ipairs({"Shirt","GraphicTShirt","Pants","Face"}) do
            local id = tonumber(desc[prop])
            if id and id > 0 then
                total += 1
            end
        end
    end
    if includeAccessories then
        local ok,accessories = pcall(function()
            return desc:GetAccessories(true)
        end)
        if ok and accessories then
            total += #accessories
        end
    end
    if includeMakeup then
        for _,child in ipairs(desc:GetChildren()) do
            if child:IsA("MakeupDescription") then
                local id = tonumber(child.AssetId)
                if id and id > 0 then
                    total += 1
                end
            end
        end
    end
    if includeAnimations then
        for _,prop in ipairs(animationProps) do
            local id = tonumber(desc[prop])
            if id and id > 0 then
                total += 1
            end
        end
    end
    return total
end

local OperationId = 0
local AvatarOperationBusy = false

 function BeginOperation()
    if AvatarOperationBusy then
        return nil
    end
    OperationId += 1
    AvatarOperationBusy = true
    return OperationId
end

 function FinishOperation(operationId)
    if operationId == OperationId then
        AvatarOperationBusy = false
    end
end

 function CancelOperation()
    OperationId += 1
    AvatarOperationBusy = false
end

 function IsCancelled(id)
    return id ~= OperationId
end

local AvatarRateHistory = {
    Equip = {},
    SetBodyColor = {},
    SetBodyScale = {},
    SetSkinTone = {},
    Reset = {}
}

local AvatarRateMax = {
    Equip = 7,
    SetBodyColor = 11,
    SetBodyScale = 11,
    SetSkinTone = 7,
    Reset = 2
}

local AvatarRateWindow = 10

 function AvatarRateLimit(route,operationId)
    local history = AvatarRateHistory[route]
    local maxCalls = AvatarRateMax[route]
    if not history or not maxCalls then
        return true
    end
    while true do
        if operationId and IsCancelled(operationId) then
            return false
        end
        local now = tick()
        local i = 1
        while i <= #history do
            if now - history[i] >= AvatarRateWindow then
                table.remove(history,i)
            else
                i += 1
            end
        end
        if #history < maxCalls then
            table.insert(history,tick())
            return true
        end
        local waitTime = AvatarRateWindow - (tick() - history[1]) + .05
        if waitTime > 0 then
            local deadline = tick() + waitTime
            while tick() < deadline do
                if operationId and IsCancelled(operationId) then
                    return false
                end
                task.wait(math.min(.05,deadline-tick()))
            end
        end
    end
end

 function EnsureEquip(id,operationId)
    if operationId and IsCancelled(operationId) then
        return false
    end
    id = tonumber(id)
    if not id or id == 0 then
        return false
    end
    for attempt = 1,2 do
        if operationId and IsCancelled(operationId) then
            return false
        end
        if not AvatarRateLimit("Equip",operationId) then
            return false
        end
        local ok,response = Invoke("Equip",{
            assetId = id
        })
        if operationId and IsCancelled(operationId) then
            return false
        end
        if ok and type(response) == "table" and response.ok == false then
            ok = false
            warn("Avatar.Equip rechazo",id,"razon:",tostring(response.reason))
        end
        if ok then
            WaitApply(operationId)
            if operationId and IsCancelled(operationId) then
                return false
            end
            JmodsAvatarProgress:Step(AvatarProgressStage)
            return true
        end
        task.wait(.1)
    end
    warn("No se pudo equipar:",id)
    return false
end

 function RunAvatarOperation(callback)
    local operationId = BeginOperation()
    if not operationId then
        return false
    end
    task.spawn(function()
        local ok,err = pcall(function()
            callback(operationId)
        end)
        if not ok then
            warn("Error en operación de avatar:",err)
        end
        if operationId == OperationId then
            JmodsAvatarProgress:Finish(not ok)
        end
        FinishOperation(operationId)
    end)
    return true
end

local Body = require(ReplicatedStorage.Shared.Avatar.Body)

local Palette = {}

for _,v in ipairs(Body.BASIC_COLORS) do
    table.insert(Palette,v.rgb)
end

for _,v in ipairs(Body.ADVANCED_COLORS) do
    table.insert(Palette,v.rgb)
end

 function ClosestColor(color)
    local r = math.floor(color.R*255+0.5)
    local g = math.floor(color.G*255+0.5)
    local b = math.floor(color.B*255+0.5)
    local best = Palette[1]
    local bestDist = math.huge
    for _,rgb in ipairs(Palette) do
        local dr = r-rgb[1]
        local dg = g-rgb[2]
        local db = b-rgb[3]
        local dist = dr*dr + dg*dg + db*db
        if dist < bestDist then
            bestDist = dist
            best = rgb
        end
    end
    return best[1],best[2],best[3]
end

 function CopyBody(desc,operationId)
    AvatarProgressStage = "Cuerpo"
    for _,prop in ipairs(bodyParts) do
        if IsCancelled(operationId) then
            return false
        end
        EnsureEquip(desc[prop],operationId)
    end
    return not IsCancelled(operationId)
end

 function CopyClothes(desc,operationId)
    AvatarProgressStage = "Ropa"
    if IsCancelled(operationId) then return false end
    EnsureEquip(desc.Shirt,operationId)
    if IsCancelled(operationId) then return false end
    EnsureEquip(desc.GraphicTShirt,operationId)
    if IsCancelled(operationId) then return false end
    EnsureEquip(desc.Pants,operationId)
    if IsCancelled(operationId) then return false end
    EnsureEquip(desc.Face,operationId)
    return not IsCancelled(operationId)
end

 function CopyAccessories(desc,operationId)
    AvatarProgressStage = "Accesorios"
    local accessories = desc:GetAccessories(true)
    table.sort(accessories,function(a,b)
        return (a.Order or 0) < (b.Order or 0)
    end)
    for _,acc in ipairs(accessories) do
        if IsCancelled(operationId) then
            return false
        end
        EnsureEquip(acc.AssetId,operationId)
    end
    return not IsCancelled(operationId)
end

 function CopyMakeup(desc,operationId)
    AvatarProgressStage = "Maquillaje"
    local makeup = {}
    for _,child in ipairs(desc:GetChildren()) do
        if child:IsA("MakeupDescription") then
            local id = tonumber(child.AssetId)
            local order = tonumber(child.Order) or 0
            if id and id > 0 then
                table.insert(makeup,{id=id,order=order})
            end
        end
    end
    table.sort(makeup,function(a,b)
        return a.order < b.order
    end)
    for _,entry in ipairs(makeup) do
        if IsCancelled(operationId) then
            return false
        end
        EnsureEquip(entry.id,operationId)
    end
    return not IsCancelled(operationId)
end

 function CopyColors(desc,operationId)
    AvatarProgressStage = "Colores"
    for _,part in ipairs(bodyColorParts) do
        if IsCancelled(operationId) then
            return false
        end
        if not AvatarRateLimit("SetBodyColor",operationId) then
            return false
        end
        local c = desc[part[2]]
        local r,g,b = ClosestColor(c)
        local ok = select(1,Invoke("SetBodyColor",{
            part = part[1],
            r = r,
            g = g,
            b = b
        }))
        if not ok then
            warn("No se pudo copiar color:",part[1])
        end
        if IsCancelled(operationId) then
            return false
        end
        WaitApply(operationId)
        JmodsAvatarProgress:Step(AvatarProgressStage)
    end
    return not IsCancelled(operationId)
end

 function RandomColor(operationId)
    if #Palette == 0 or (operationId and IsCancelled(operationId)) then
        return false
    end
    if not AvatarRateLimit("SetSkinTone",operationId) then
        return false
    end
    local rgb = Palette[math.random(1,#Palette)]
    local ok = select(1,Invoke("SetSkinTone",{
        r = rgb[1],
        g = rgb[2],
        b = rgb[3]
    }))
    if operationId and IsCancelled(operationId) then
        return false
    end
    WaitApply(operationId)
    JmodsAvatarProgress:Step("Color")
    return ok
end

 function ResetAvatar(operationId)
    AvatarProgressStage = "Reiniciando"
    if IsCancelled(operationId) then
        return false
    end
    if not AvatarRateLimit("Reset",operationId) then
        return false
    end
    local ok = select(1,Invoke("Reset",{}))
    if IsCancelled(operationId) then
        return false
    end
    WaitApply(operationId)
    JmodsAvatarProgress:Step(AvatarProgressStage)
    return ok
end

 function HasDescriptionData(desc)
    if not desc then
        return false
    end
    local props = {
        "Shirt",
        "GraphicTShirt",
        "Pants",
        "Face",
        "Head",
        "Torso",
        "LeftArm",
        "RightArm",
        "LeftLeg",
        "RightLeg",
        "ClimbAnimation",
        "FallAnimation",
        "IdleAnimation",
        "JumpAnimation",
        "RunAnimation",
        "SwimAnimation",
        "WalkAnimation",
        "MoodAnimation"
    }
    for _,prop in ipairs(props) do
        local id = tonumber(desc[prop])
        if id and id ~= 0 then
            return true
        end
    end
    local ok,acc = pcall(function()
        return desc:GetAccessories(true)
    end)
    if ok and #acc > 0 then
        return true
    end
    for _,child in ipairs(desc:GetChildren()) do
        if child:IsA("MakeupDescription") and tonumber(child.AssetId) and tonumber(child.AssetId) > 0 then
            return true
        end
    end
    return false
end

 function GetLocalDescription()
    local char = Players.LocalPlayer.Character
    if not char then
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then
        return
    end
    local ok,desc = pcall(function()
        return hum:GetAppliedDescription()
    end)
    if ok and HasDescriptionData(desc) then
        return desc
    end
    for _,obj in ipairs(char:GetDescendants()) do
        if obj:IsA("HumanoidDescription") then
            if HasDescriptionData(obj) then
                return obj
            end
        end
    end
end

 function UnequipAll(operationId)
    AvatarProgressStage = "Quitando"
    if IsCancelled(operationId) then
        return false
    end
    local desc = GetLocalDescription()
    if not desc then
        warn("No se encontró el avatar actual.")
        return false
    end
    if not CopyBody(desc,operationId) then
        return false
    end
    if not CopyClothes(desc,operationId) then
        return false
    end
    if not CopyAccessories(desc,operationId) then
        return false
    end
    if not CopyMakeup(desc,operationId) then
        return false
    end
    for _,prop in ipairs(animationProps) do
        if IsCancelled(operationId) then
            return false
        end
        local id = tonumber(desc[prop])
        if id and id ~= 0 then
            AvatarProgressStage = "Animaciones"
            if not EnsureEquip(id,operationId) and IsCancelled(operationId) then
                return false
            end
        end
    end
    if IsCancelled(operationId) then
        return false
    end
    task.wait(.3)
    return true
end

