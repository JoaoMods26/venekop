local SAVE_FOLDER = "JmodsBuildingCopier"
local SAVE_EXTENSION = ".jmods"

local SaveFileName = ""
local SelectedSaveFile = nil
local SavedFilesDropdown = nil

local function fileApiAvailable(name)
    if name == "isfolder" then
        return type(isfolder) == "function"
    elseif name == "makefolder" then
        return type(makefolder) == "function"
    elseif name == "listfiles" then
        return type(listfiles) == "function"
    elseif name == "isfile" then
        return type(isfile) == "function"
    elseif name == "writefile" then
        return type(writefile) == "function"
    elseif name == "readfile" then
        return type(readfile) == "function"
    end

    return false
end

local function callGlobalFunction(name, ...)
    if not fileApiAvailable(name) then
        return false, "API no disponible: " .. name
    end

    if name == "isfolder" then
        return pcall(isfolder, ...)
    elseif name == "makefolder" then
        return pcall(makefolder, ...)
    elseif name == "listfiles" then
        return pcall(listfiles, ...)
    elseif name == "isfile" then
        return pcall(isfile, ...)
    elseif name == "writefile" then
        return pcall(writefile, ...)
    elseif name == "readfile" then
        return pcall(readfile, ...)
    end

    return false, "API no disponible: " .. name
end

local function ensureSaveFolder()
    if not fileApiAvailable("isfolder") or not fileApiAvailable("makefolder") then
        return false
    end

    local ok, exists = callGlobalFunction("isfolder", SAVE_FOLDER)
    if not ok then
        return false
    end

    if not exists then
        local created = callGlobalFunction("makefolder", SAVE_FOLDER)
        if not created then
            return false
        end
    end

    return true
end

local function sanitizeFileName(name)
    name = tostring(name or "")
    name = name:gsub("[^%w%s_%-]", "_")
    name = name:gsub("%s+", "_")
    name = name:gsub("_+", "_")
    name = name:gsub("^_+", "")
    name = name:gsub("_+$", "")
    return name
end

local function encodeValue(value, seen)
    local valueType = typeof(value)

    if value == nil
    or valueType == "boolean"
    or valueType == "number"
    or valueType == "string" then
        return value
    end

    if valueType == "Vector2" then
        return {
            __type = "Vector2",
            x = value.X,
            y = value.Y
        }
    end

    if valueType == "Vector3" then
        return {
            __type = "Vector3",
            x = value.X,
            y = value.Y,
            z = value.Z
        }
    end

    if valueType == "Color3" then
        return {
            __type = "Color3",
            r = value.R,
            g = value.G,
            b = value.B
        }
    end

    if valueType == "Instance"
    or valueType == "function"
    or valueType == "thread"
    or valueType == "userdata"
    or valueType == "buffer" then
        return nil
    end

    if valueType ~= "table" then
        return nil
    end

    seen = seen or {}

    if seen[value] then
        error("Tabla circular en cache")
    end

    seen[value] = true

    local result = {
        __type = "table",
        array = {},
        map = {}
    }

    local arrayCount = #value

    for i = 1, arrayCount do
        local encoded = encodeValue(value[i], seen)
        result.array[i] = encoded
    end

    for key, val in pairs(value) do
        if key ~= "SourceObject"
        and not (
            typeof(key) == "number"
            and key >= 1
            and key <= arrayCount
            and key % 1 == 0
        ) then
            local encodedKey = encodeValue(key, seen)
            local encodedValue = encodeValue(val, seen)

            if encodedKey ~= nil and encodedValue ~= nil then
                table.insert(result.map, {
                    key = encodedKey,
                    value = encodedValue
                })
            end
        end
    end

    seen[value] = nil
    return result
end

local function decodeValue(value)
    if type(value) ~= "table" then
        return value
    end

    if value.__type == "Vector2" then
        return Vector2.new(
            tonumber(value.x) or 0,
            tonumber(value.y) or 0
        )
    end

    if value.__type == "Vector3" then
        return Vector3.new(
            tonumber(value.x) or 0,
            tonumber(value.y) or 0,
            tonumber(value.z) or 0
        )
    end

    if value.__type == "Color3" then
        return Color3.new(
            tonumber(value.r) or 0,
            tonumber(value.g) or 0,
            tonumber(value.b) or 0
        )
    end

    if value.__type == "table" then
        local result = {}

        local array = type(value.array) == "table" and value.array or {}
        for i, item in ipairs(array) do
            local decoded = decodeValue(item)
            if decoded ~= nil then
                result[i] = decoded
            end
        end

        local map = type(value.map) == "table" and value.map or {}
        for _, entry in ipairs(map) do
            if type(entry) == "table" then
                local decodedKey = decodeValue(entry.key)
                local decodedValue = decodeValue(entry.value)

                if decodedKey ~= nil and decodedValue ~= nil then
                    result[decodedKey] = decodedValue
                end
            end
        end

        return result
    end

    local result = {}
    for key, item in pairs(value) do
        local decoded = decodeValue(item)
        if decoded ~= nil then
            result[key] = decoded
        end
    end

    return result
end

local function getSavedFiles()
    if not fileApiAvailable("listfiles")
    or not fileApiAvailable("isfile") then
        return {}
    end

    if not ensureSaveFolder() then
        return {}
    end

    local ok, entries = callGlobalFunction("listfiles", SAVE_FOLDER)
    if not ok or type(entries) ~= "table" then
        return {}
    end

    local files = {}

    for _, path in ipairs(entries) do
        local normalized = tostring(path):gsub("\\", "/")
        if normalized:sub(-#SAVE_EXTENSION) == SAVE_EXTENSION then
            local fileName = normalized:match("([^/]+)$")
            if fileName then
                table.insert(files, fileName)
            end
        end
    end

    table.sort(files)
    return files
end

local function refreshSavedFiles()
    local files = getSavedFiles()

    if SelectedSaveFile then
        local stillExists = false

        for _, fileName in ipairs(files) do
            if fileName == SelectedSaveFile then
                stillExists = true
                break
            end
        end

        if not stillExists then
            SelectedSaveFile = files[1]
        end
    elseif files[1] then
        SelectedSaveFile = files[1]
    end

    if SavedFilesDropdown then
        SavedFilesDropdown:UpdateOnClose(files)
    end

    return files
end

local function getCacheForSave()
    if not BuildCache then
        return nil
    end

    return {
        Version = 2,
        Objects = BuildCache.Objects or {},
        Walls = BuildCache.Walls or {},
        Paths = BuildCache.Paths or {},
        Floors = BuildCache.Floors or {},
        Openings = BuildCache.Openings or {},
        Stairs = BuildCache.Stairs or {},
        Roofs = BuildCache.Roofs or {}
    }
end

local function saveCacheToFile(name)
    local cleanName = sanitizeFileName(name)

    if cleanName == "" then
        warn("ESCRIBE UN NOMBRE PARA EL ARCHIVO")
        return
    end

    if not fileApiAvailable("writefile") then
        warn("TU EXECUTOR NO SOPORTA writefile")
        return
    end

    local cache = getCacheForSave()
    if not cache then
        warn("NO HAY CACHE PARA GUARDAR")
        return
    end

    if not ensureSaveFolder() then
        warn("NO SE PUDO ACCEDER A LA CARPETA DE GUARDADOS")
        return
    end

    local okEncode, payload = pcall(function()
        local prepared = encodeValue(cache)
        return HttpService:JSONEncode(prepared)
    end)

    if not okEncode then
        warn("ERROR SERIALIZANDO CACHE:", payload)
        return
    end

    local path = SAVE_FOLDER .. "/" .. cleanName .. SAVE_EXTENSION

    local okWrite, writeResult = callGlobalFunction("writefile", path, payload)
    if not okWrite then
        warn("ERROR GUARDANDO ARCHIVO:", writeResult)
        return
    end

    SelectedSaveFile = cleanName .. SAVE_EXTENSION
    refreshSavedFiles()

    JmodsLib:Notify({
        Title = "Cache guardado",
        Content = SelectedSaveFile,
        Duration = 4
    })
end

local function loadCacheFromFile(fileName)
    if demolishRunning then
        JmodsLib:Notify({Title="Carga",Content="Primero detén la demolición en curso.",Duration=3})
        return
    end
    if not fileName or tostring(fileName) == "" then
        warn("NO HAY ARCHIVO SELECCIONADO")
        return
    end

    if not fileApiAvailable("readfile")
    or not fileApiAvailable("isfile") then
        warn("TU EXECUTOR NO SOPORTA ARCHIVOS LOCALES")
        return
    end

    if not ensureSaveFolder() then
        warn("NO SE PUDO ACCEDER A LA CARPETA DE GUARDADOS")
        return
    end

    local path = SAVE_FOLDER .. "/" .. tostring(fileName)

    local okExists, exists = callGlobalFunction("isfile", path)
    if not okExists or not exists then
        warn("NO EXISTE EL ARCHIVO:", tostring(fileName))
        refreshSavedFiles()
        return
    end

    local okRead, content = callGlobalFunction("readfile", path)
    if not okRead or type(content) ~= "string" then
        warn("ERROR LEYENDO ARCHIVO:", content)
        return
    end

    local okJson, parsed = pcall(function()
        return HttpService:JSONDecode(content)
    end)

    if not okJson then
        warn("ERROR DECODIFICANDO ARCHIVO:", parsed)
        return
    end

    local okConvert, decoded = pcall(function()
        return decodeValue(parsed)
    end)

    if not okConvert or type(decoded) ~= "table" then
        warn("ERROR RESTAURANDO CACHE:", decoded)
        return
    end

    BuildCache = {
        SourcePlot = nil,
        SourceBase = nil,
        Objects = type(decoded.Objects) == "table" and decoded.Objects or {},
        Walls = type(decoded.Walls) == "table" and decoded.Walls or {},
        Paths = type(decoded.Paths) == "table" and decoded.Paths or {},
        Floors = type(decoded.Floors) == "table" and decoded.Floors or {},
        Openings = type(decoded.Openings) == "table" and decoded.Openings or {},
        Stairs = type(decoded.Stairs) == "table" and decoded.Stairs or {},
        Roofs = type(decoded.Roofs) == "table" and decoded.Roofs or {}
    }

    local totalCached =
        #BuildCache.Objects
        + #BuildCache.Walls
        + #BuildCache.Paths
        + #BuildCache.Floors
        + #BuildCache.Openings
        + #BuildCache.Stairs
        + #BuildCache.Roofs

    SelectedSaveFile = tostring(fileName)
    refreshSavedFiles()

    JmodsLib:Notify({
        Title = "Cache cargado",
        Content = "Elementos: " .. tostring(totalCached),
        Duration = 4
    })

    local target = SavedPastePlot
    if not target or not target.Parent then
        target = restorePlotByIds(SavedPasteObjectId, SavedPasteOwnerId)
    end

    if not target then
        target = getMyPlot()
    end

    if target then
        pasteCacheToPlot(target)
    else
        warn("NO SE ENCONTRÓ PLOT PARA PEGAR EL GUARDADO")
    end
end

