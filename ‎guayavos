end
 function findCleanMess()
    local root=getCleanRoot()
    if not root then return end
    local best
    for _,v in ipairs(workspace:GetDescendants()) do
        local id=v:GetAttribute("WorkSpotId")
        if typeof(id)=="number" and not v:GetAttribute("JanitorDone") then
            local p=cleanGetPos(v)
            if p then
                local d=(root.Position-p).Magnitude
                if not best or d<best.distance then
                    best={object=v,id=id,position=p,distance=d}
                end
            end
        end
    end
    return best
end
 function getCleanScrub()
    if not HasGetGC then return nil,nil end
    for _,obj in ipairs(getgc(true)) do
        if type(obj)=="table" then
            local workId=rawget(obj,"workId")
            local scrub=rawget(obj,"scrub")
            if workId=="foodix-cleaner" and type(scrub)=="table" then
                return obj,scrub
            end
        end
    end
    return nil,nil
end
 function startCleanSpot(id,runId)
    if not JanitorAvailable or not isCleanRunning(runId) then return false end
    local ok,promise=pcall(function()
        return JanitorNet.StartClean.invoke({spotId=id})
    end)
    if not ok then
        warn("[AUTO CLEAN] Start error:",promise)
        return false
    end
    local result
    local finished=false
    promise:andThen(function(r)
        result=r
        finished=true
    end):catch(function(err)
        warn("[AUTO CLEAN] Start rechazo:",err)
        finished=true
    end)
    local t=time()
    while not finished and time()-t<5 do
        if not isCleanRunning(runId) then return false end
        task.wait()
    end
    if not isCleanRunning(runId) or not result then return false end
    if type(result)=="table" and result.ok==false then
        warn("[AUTO CLEAN] Start rechazado:",result.reason)
        return false
    end
    return true
end
 function runCleanScrub(runId)
    if not HasGetGC or not isCleanRunning(runId) then return false end
    local scrub
    local t=time()
    while time()-t<5 do
        if not isCleanRunning(runId) then return false end
        local _,s=getCleanScrub()
        if s then
            scrub=s
            break
        end
        task.wait(0.05)
    end
    if not scrub or not isCleanRunning(runId) then return false end
    print("[AUTO CLEAN] Scrub detectado")
    while scrub and isCleanRunning(runId) and not scrub.finishing and scrub.done<scrub.strokes do
        local waitTime=(scrub.nextStrokeAt or time())-time()
        if waitTime>0 then
            local untilTime=time()+waitTime
            while time()<untilTime do
                if not isCleanRunning(runId) then return false end
                task.wait(math.min(0.05,untilTime-time()))
            end
        end
        if not isCleanRunning(runId) or scrub.finishing then break end
        local direction=scrub.lastStrokeDir==1 and -1 or 1
        pcall(function() scrub:_feedPointer(direction*55) end)
        task.wait()
        local _,newScrub=getCleanScrub()
        if newScrub then scrub=newScrub end
    end
    print("[AUTO CLEAN] Scrub terminado")
    return isCleanRunning(runId) and scrub and scrub.done>=scrub.strokes
end
 function finishCleanSpot(id,size,runId)
    if not JanitorAvailable or not isCleanRunning(runId) then return false end
    local waitTime=1.5
    if JanitorConfig.SIZES[size] then
        waitTime=JanitorConfig.SIZES[size].minSeconds+0.05
    end
    local untilTime=time()+waitTime
    while time()<untilTime do
        if not isCleanRunning(runId) then return false end
        task.wait(math.min(0.05,untilTime-time()))
    end
    if not isCleanRunning(runId) then return false end
    local ok,promise=pcall(function()
        return JanitorNet.FinishClean.invoke({spotId=id})
    end)
    if not ok then
        warn("[AUTO CLEAN] Finish error:",promise)
        return false
    end
    local result
    local finished=false
    promise:andThen(function(r)
        result=r
        finished=true
    end):catch(function(err)
        warn("[AUTO CLEAN] Finish rechazo:",err)
        finished=true
    end)
    local t=time()
    while not finished and time()-t<5 do
        if not isCleanRunning(runId) then return false end
        task.wait()
    end
    return isCleanRunning(runId) and result and result.ok==true
end
local function cleanOneSpot(mess,runId)
    if not isCleanRunning(runId) then return false end
    arepamovilState.activeSpotId=mess.id
    local root=getCleanRoot()
    if root then
        root.CFrame=CFrame.new(mess.position+Vector3.new(0,3,0))
    end
    task.wait(0.15)
    if not isCleanRunning(runId) then return false end
    if not startCleanSpot(mess.id,runId) then return false end
    local scrubbed=runCleanScrub(runId)
    if not isCleanRunning(runId) then return false end
    if scrubbed then
        return true
    end
    return finishCleanSpot(mess.id,mess.object:GetAttribute("WorkSpotSize"),runId)
end
local function startArepamovilAutoFarm()
    if ArepamovilConfig.AutoFarm then return end
    ArepamovilConfig.AutoFarm=true
    arepamovilState.paused=false
    arepamovilState.runId+=1
    local runId=arepamovilState.runId
    if ArepamovilConfig.NoCooldown then
        task.spawn(function()
            for _,v in pairs(workspace:GetDescendants()) do
                if not isCleanRunning(runId) then return end
                if v:IsA("ProximityPrompt") then v.HoldDuration=0 end
            end
        end)
    end
    task.spawn(function()
        local ok,err=pcall(function()
            arepamovilState.currentTask="Iniciando trabajo"
            if not activateCleanJob(runId) then return end
            print("[AUTO CLEAN] Trabajo iniciado")
            while isCleanRunning(runId) do
                local mess=findCleanMess()
                if not mess then
                    arepamovilState.currentTask="Esperando desastres"
                    task.wait(0.25)
                else
                    arepamovilState.currentTask="Limpiando desastre"
                    print("[AUTO CLEAN] Mancha:",mess.object:GetFullName())
                    print("[AUTO CLEAN] SpotId:",mess.id)
                    cleanOneSpot(mess,runId)
                    arepamovilState.activeSpotId=nil
                    if isCleanRunning(runId) then task.wait(0.15) end
                end
            end
        end)
        if not ok then warn("❌ Error en Limpiar:",err) end
        if arepamovilState.runId==runId then
            arepamovilState.currentTask="Inactivo"
            arepamovilState.activeSpotId=nil
            pcall(RestoreCharacterState)
        end
    end)
end
