    if not isCleanRunning(runId) then return false end
    pcall(function() data.prompt.HoldDuration=0 end)
    if fireproximityprompt then
        pcall(function() fireproximityprompt(data.prompt) end)
    end
    if getconnections then
        pcall(function()
            local connections=getconnections(data.prompt.Triggered)
            if connections then
                for _,connection in ipairs(connections) do
                    if not isCleanRunning(runId) then return end
                    pcall(function() connection:Fire() end)
                end
