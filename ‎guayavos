function ArturosDelivery.getOrderId(obj)
    local current=obj
    while current and current~=workspace do
        local id=tonumber(current:GetAttribute("WorksOrderId"))
        if id then return id end
        current=current.Parent
    end
    return nil
end

function ArturosDelivery.getCustomerModel(obj)
    local current=obj
    local fallback=nil
    while current and current~=workspace do
        if current:IsA("Model") then
            fallback=fallback or current
            if current:FindFirstChildOfClass("Humanoid") then
                return current
            end
        end
        current=current.Parent
    end
    return fallback
end

function ArturosDelivery.getCustomerPosition(obj)
    local model=ArturosDelivery.getCustomerModel(obj)
    if model then
        local hrp=model:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:IsA("BasePart") then return hrp.Position,model end
        local root=model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("Head")
        if root and root:IsA("BasePart") then return root.Position,model end
        return model:GetPivot().Position,model
    end
    if obj:IsA("BasePart") then return obj.Position,obj end
    local part=obj:FindFirstChildWhichIsA("BasePart",true)
    return part and part.Position or nil,obj
end

function ArturosDelivery.getPromptPosition(prompt)
    if not prompt then return nil end
    local parent=prompt.Parent
    if parent and parent:IsA("Attachment") then return parent.WorldPosition end
    if parent and parent:IsA("BasePart") then return parent.Position end
    local attachment=prompt:FindFirstAncestorWhichIsA("Attachment")
    if attachment then return attachment.WorldPosition end
    local part=prompt:FindFirstAncestorWhichIsA("BasePart")
    if part then return part.Position end
    local model=prompt:FindFirstAncestorWhichIsA("Model")
    if model then return model:GetPivot().Position end
    return nil
end

function ArturosDelivery.findHandoffPrompt(orderId)
    local CollectionService=game:GetService("CollectionService")
    local ok,tagged=pcall(function() return CollectionService:GetTagged("WorksHandoffPrompt") end)
    if ok and type(tagged)=="table" then
        for _,prompt in ipairs(tagged) do
            if prompt:IsA("ProximityPrompt") then
                local id=ArturosDelivery.getOrderId(prompt)
                if id==orderId then
                    local position=ArturosDelivery.getPromptPosition(prompt)
                    if position then return prompt,position end
                end
            end
        end
    end
    for _,prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local id=ArturosDelivery.getOrderId(prompt)
            local full=prompt:GetFullName():lower()
            if id==orderId and (full:find("handoff",1,true) or full:find("customer",1,true)) then
                local position=ArturosDelivery.getPromptPosition(prompt)
                if position then return prompt,position end
            end
        end
    end
    return nil
end

function ArturosDelivery.findPrompt()
    local root=getCleanRoot()
    local bestEnabled=nil
    local bestDisabled=nil
    local bestEnabledScore=-math.huge
    local bestDisabledScore=-math.huge
    local bestEnabledDistance=math.huge
    local bestDisabledDistance=math.huge

    for _,v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local full=v:GetFullName():lower()
            local current=v
            local hasGiver=false
            local hasArturos=false
            local hasCustomer=false
            local hasHandoff=false
            while current and current~=workspace do
                local name=current.Name:lower()
                if name=="giver" then hasGiver=true end
                if name:find("arturos",1,true) then hasArturos=true end
                if name:find("customer",1,true) then hasCustomer=true end
                if name:find("handoff",1,true) then hasHandoff=true end
                current=current.Parent
            end
            hasGiver=hasGiver or full:find("giver",1,true)~=nil
            hasArturos=hasArturos or full:find("arturos",1,true)~=nil
            hasCustomer=hasCustomer or full:find("customer",1,true)~=nil
            hasHandoff=hasHandoff or full:find("handoff",1,true)~=nil
            if hasGiver and not hasCustomer and not hasHandoff then
                local position=ArturosDelivery.getPromptPosition(v)
                if position then
                    local distance=root and (root.Position-position).Magnitude or 0
                    local score=0
                    if hasArturos then score+=100000 end
                    if full:find("delivery",1,true) then score+=100 end
                    if v.Enabled then score+=1000 end
                    if score>bestEnabledScore and v.Enabled then
                        bestEnabledScore=score
                        bestEnabledDistance=distance
                        bestEnabled={prompt=v,position=position}
                    elseif score>bestDisabledScore then
                        bestDisabledScore=score
                        bestDisabledDistance=distance
                        bestDisabled={prompt=v,position=position}
                    elseif score==bestEnabledScore and v.Enabled and distance<bestEnabledDistance then
                        bestEnabledDistance=distance
                        bestEnabled={prompt=v,position=position}
                    elseif score==bestDisabledScore and not v.Enabled and distance<bestDisabledDistance then
                        bestDisabledDistance=distance
                        bestDisabled={prompt=v,position=position}
                    end
                end
            end
        end
    end
    return bestEnabled or bestDisabled
end

function ArturosDelivery.getOrders()
    local orders={}
    local seen={}
    local CollectionService=game:GetService("CollectionService")
    local ok,tagged=pcall(function() return CollectionService:GetTagged("WorksHandoffPrompt") end)
    if ok and type(tagged)=="table" then
        for _,prompt in ipairs(tagged) do
            if prompt:IsA("ProximityPrompt") then
                local id=ArturosDelivery.getOrderId(prompt)
                if id and not seen[id] then
                    local position=ArturosDelivery.getPromptPosition(prompt)
                    if position then
                        seen[id]=true
                        table.insert(orders,{id=id,object=prompt,position=position,prompt=prompt})
                    end
                end
            end
        end
    end
    if #orders>0 then return orders end
    for _,v in ipairs(workspace:GetDescendants()) do
        if v.Name=="Customers" then
            for _,obj in ipairs(v:GetDescendants()) do
                local id=ArturosDelivery.getOrderId(obj)
                if id and not seen[id] then
                    local position,model=ArturosDelivery.getCustomerPosition(obj)
                    if position then
                        seen[id]=true
                        table.insert(orders,{id=id,object=model or obj,position=position})
                    end
                end
            end
        end
    end
    return orders
end

function ArturosDelivery.findCustomer(order)
    local targetId=tonumber(type(order)=="table" and (order.id or order.orderId) or order)
    if not targetId then return nil end
    local prompt,promptPosition=ArturosDelivery.findHandoffPrompt(targetId)
    if promptPosition then
        return {object=prompt.Parent,position=promptPosition,id=targetId,prompt=prompt}
    end
    if type(order)=="table" and order.position and typeof(order.position)=="Vector3" then
        return {object=order.object,position=order.position,id=targetId,prompt=order.prompt}
    end
    if type(order)=="table" and order.object then
        local position,model=ArturosDelivery.getCustomerPosition(order.object)
        if position then return {object=model or order.object,position=position,id=targetId,prompt=order.prompt} end
    end
    for _,v in ipairs(workspace:GetDescendants()) do
        if v.Name=="Customers" then
            for _,obj in ipairs(v:GetDescendants()) do
                if ArturosDelivery.getOrderId(obj)==targetId then
                    local position,model=ArturosDelivery.getCustomerPosition(obj)
                    if position then return {object=model or obj,position=position,id=targetId} end
                end
            end
        end
    end
    return nil
end

