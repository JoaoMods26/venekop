local GridMath = {
    TILE_STUDS = 8,
    UNIT = 2,
    STRUCTURE_STEPS = {2,1,1,1},
    SUBDIVISIONS = {Vector2.new(2,2),Vector2.new(4,4),Vector2.new(20,20),Vector2.zero},
    SNAP_SUBDIVISIONS = {Vector2.new(2,2),Vector2.new(4,4),Vector2.new(80,80),Vector2.new(8000,8000)}
}

function GridMath.squares(value)
    return math.max(1,math.round((tonumber(value) or 0) / GridMath.TILE_STUDS))
end

function GridMath.layout(base)
    local columns = GridMath.squares(base.Size.X)
    local rows = GridMath.squares(base.Size.Z)
    return {
        columns = columns,
        rows = rows,
        cell = Vector2.new(base.Size.X / columns,base.Size.Z / rows)
    }
end

function GridMath.localCornerPosition(layout,corner)
    return Vector2.new((corner.x / GridMath.UNIT - layout.columns / 2) * layout.cell.X,(corner.z / GridMath.UNIT - layout.rows / 2) * layout.cell.Y)
end

function GridMath.cornerToWorld(base,corner)
    local localPos = GridMath.localCornerPosition(GridMath.layout(base),corner)
    return base.CFrame:PointToWorldSpace(Vector3.new(localPos.X,base.Size.Y / 2,localPos.Y))
end

function GridMath.nearestCorner(base,worldPosition,mode)
    local layout = GridMath.layout(base)
    local structureStep = GridMath.STRUCTURE_STEPS[mode or 1] or 1
    local localPosition = base.CFrame:PointToObjectSpace(worldPosition)
    local x = math.round((localPosition.X + base.Size.X / 2) / layout.cell.X * GridMath.UNIT / structureStep) * structureStep
    local z = math.round((localPosition.Z + base.Size.Z / 2) / layout.cell.Y * GridMath.UNIT / structureStep) * structureStep
    return {
        x = math.clamp(x,0,layout.columns * GridMath.UNIT),
        z = math.clamp(z,0,layout.rows * GridMath.UNIT)
    }
end

