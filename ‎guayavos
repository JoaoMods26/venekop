 function debugText(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if depth > 4 then
        return "<depth>"
    end
    local t = typeof(value)
    if value == nil then
        return "nil"
    end
    if t == "string" then
        return value:gsub("\n", "\\n")
    end
    if t == "number" or t == "boolean" then
        return tostring(value)
    end
    if t == "Vector2" then
        return string.format("V2(%.4f,%.4f)", value.X, value.Y)
    end
    if t == "Vector3" then
        return string.format("V3(%.4f,%.4f,%.4f)", value.X, value.Y, value.Z)
    end
    if t == "CFrame" then
        local p = value.Position
        return string.format("CF(%.4f,%.4f,%.4f)", p.X, p.Y, p.Z)
    end
    if t == "Instance" then
        return value:GetFullName()
    end
    if t ~= "table" then
        return "<" .. t .. ">"
    end
    if seen[value] then
        return "<cycle>"
    end
    seen[value] = true
    local parts = {}
    local count = 0
    for k,v in pairs(value) do
        count += 1
        if count > 30 then
            parts[#parts+1]="..."
            break
        end
        parts[#parts+1]=tostring(k).."="..debugText(v,depth+1,seen)
    end
    seen[value] = nil
    return "{" .. table.concat(parts,",") .. "}"
end

 function debugWriteLine(line)
    if not (getgenv and getgenv().JMODS_BUILD_DEBUG == true) then
        return
    end
    line = tostring(line or "")
    if #line > DEBUG_MAX_LINE then
        line = line:sub(1,DEBUG_MAX_LINE) .. "..."
    end
    print("[JmodsBuildDebug]",line)
end

 function debugLog(tag, ...)
    if not (getgenv and getgenv().JMODS_BUILD_DEBUG == true) then
        return
    end
    local parts = { "[" .. tostring(tag) .. "]" }
    for i=1,select("#",...) do
        local argValue = select(i, ...)
        parts[#parts+1]=debugText(argValue)
    end
    debugWriteLine(table.concat(parts," "))
end

 function debugLogVerbose(tag,...)
    if not DEBUG_VERBOSE then return end
    debugLog(tag,...)
end

