 function parseRoofKey(key)
    if typeof(key) ~= "string" then return nil end
    local levelString,designId,heightString,overhangString,polygonString = tostring(key):match("^(%d+)|([^|]+)|([^|]+)|([^|]+)|(.+)$")
    if not levelString or not designId or not polygonString then return nil end
    local level=tonumber(levelString)
    local height=tonumber(heightString)
    local overhang=tonumber(overhangString)
    if not level or not height or not overhang then return nil end
    local axis
    local cleanPolygon,axisString=polygonString:match("^(.-)|a(%d+)$")
    if cleanPolygon then
        polygonString=cleanPolygon
        axis=tonumber(axisString)
