 function findCleanJobPrompt()
    local root=getCleanRoot()
    local best
    local bestDistance=math.huge
    for _,v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Enabled then
            local parent=v.Parent
            if parent and parent:IsA("BasePart") then
                local full=v:GetFullName():lower()
                local pfull=parent:GetFullName():lower()
                local score=0
                if full:find("foodix",1,true) then score+=100 end
                if pfull:find("foodix",1,true) then score+=100 end
                if full:find("works",1,true) then score+=25 end
                if pfull:find("works",1,true) then score+=25 end
                if full:find("delivery",1,true) or pfull:find("delivery",1,true) then score-=200 end
                if full:find("handoff",1,true) or pfull:find("handoff",1,true) then score-=200 end
                if full:find("trash",1,true) or pfull:find("trash",1,true) then score-=100 end
                if score>0 then
                    local d=root and (root.Position-parent.Position).Magnitude or 0
                    if score>0 and (score>=(best and best.score or -math.huge)) and (d<bestDistance or score>(best and best.score or -math.huge)) then
                        best={prompt=v,position=parent.Position,score=score,distance=d}
                        bestDistance=d
                    end
                end
            end
        end
    end
    return best
end
