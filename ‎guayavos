function B.makeCenterPoint(base)
    local columns = math.floor(base.Size.X / GridMath.TILE_STUDS)
    local rows = math.floor(base.Size.Z / GridMath.TILE_STUDS)
    local pointUnit = POINTS_PER_CORNER * GridMath.UNIT
    return {x=columns * pointUnit / 2,z=rows * pointUnit / 2}
end

function B.makeNearTargetPoint(base,point,distanceStuds)
    local layout=GridMath.layout(base)
    local center=B.makeCenterPoint(base)
    local dxStuds=((tonumber(point.x) or 0)-(tonumber(center.x) or 0))/POINT_UNIT*layout.cell.X
    local dzStuds=((tonumber(point.z) or 0)-(tonumber(center.z) or 0))/POINT_UNIT*layout.cell.Y
    local distance=math.sqrt(dxStuds*dxStuds+dzStuds*dzStuds)
    distanceStuds=math.max(0,tonumber(distanceStuds) or 0)
    if distance<=distanceStuds or distance<0.001 then
        return {x=math.round(tonumber(point.x) or 0),z=math.round(tonumber(point.z) or 0)}
    end
    local factor=(distance-distanceStuds)/distance
    local x=(tonumber(center.x) or 0)+((tonumber(point.x) or 0)-(tonumber(center.x) or 0))*factor
    local z=(tonumber(center.z) or 0)+((tonumber(point.z) or 0)-(tonumber(center.z) or 0))*factor
    return {
        x=math.clamp(math.round(x),0,layout.columns*POINT_UNIT),
        z=math.clamp(math.round(z),0,layout.rows*POINT_UNIT)
    }
end

function B.pointWorldCFrame(base,point,height)
    local layout=GridMath.layout(base)
    local x=((tonumber(point.x) or 0)/POINT_UNIT-layout.columns/2)*layout.cell.X
    local z=((tonumber(point.z) or 0)/POINT_UNIT-layout.rows/2)*layout.cell.Y
    return base.CFrame*CFrame.new(x,base.Size.Y/2+(tonumber(height) or 0),z)
end

local supportRaycastParamsCache=setmetatable({}, {__mode="k"})

function B.clearSupportRaycastCache(targetPlot)
    if targetPlot then
        supportRaycastParamsCache[targetPlot]=nil
    else
        supportRaycastParamsCache=setmetatable({}, {__mode="k"})
    end
end

function B.buildSupportRaycastParams(targetPlot)
    if targetPlot and supportRaycastParamsCache[targetPlot] then
        return supportRaycastParamsCache[targetPlot]
    end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Include
    local include={}
    local base=targetPlot and targetPlot:FindFirstChild("Base")
    if base then table.insert(include,base) end
    local container=targetPlot and targetPlot:FindFirstChild("Container")
    if container then
        for _,name in ipairs({"Walls","Floors","Items","Openings","Stairs"}) do
            local folder=container:FindFirstChild(name)
            if folder then table.insert(include,folder) end
        end
    end
    if #include==0 then
        include={targetPlot}
    end
    params.FilterDescendantsInstances=include
    if targetPlot then
        supportRaycastParamsCache[targetPlot]=params
    end
    return params
end

function B.supportHeightAtPoint(base,targetPlot,point)
    local params=B.buildSupportRaycastParams(targetPlot)
    local anchor=B.pointWorldCFrame(base,point,0).Position
    local up=base.CFrame.UpVector
    local origin=anchor+up*SUPPORT_RAY_HEIGHT
    local result=workspace:Raycast(origin,-up*SUPPORT_RAY_LENGTH,params)
    if not result or not result.Instance then
        return nil,nil
    end
    local localHit=base.CFrame:PointToObjectSpace(result.Position)
    local height=localHit.Y-base.Size.Y/2
    if height < -0.05 then
        return nil,nil
    end
    return math.max(0,height),result.Instance
end

local activeSupportIndex=nil

local function supportPointFromAttribute(value)
    if typeof(value)=="Vector2" then
        return {x=math.round(value.X),z=math.round(value.Y)}
    end
    if type(value)=="table" then
        local x=tonumber(value.x) or tonumber(value.X)
        local z=tonumber(value.z) or tonumber(value.Z)
        if x and z then
            return {x=math.round(x),z=math.round(z)}
        end
    end
    return nil
end

local function supportIndexBucket(worldX,worldZ)
    return math.floor(worldX/SUPPORT_INDEX_CELL_STUDS)..":"..math.floor(worldZ/SUPPORT_INDEX_CELL_STUDS)
end

function B.clearSupportIndex()
    activeSupportIndex=nil
end

function B.initSupportIndex(base,targetPlot,targetItems)
    activeSupportIndex={base=base,plot=targetPlot,buckets={},objects={}}
    if not targetItems then return end
    for _,object in ipairs(targetItems:GetChildren()) do
        if object and object.Parent then
            local point=supportPointFromAttribute(object:GetAttribute("PlacePoint"))
            if point then
                local height=tonumber(object:GetAttribute("PlaceHeight")) or 0
                B.registerSupportObject(object,point,height)
            end
        end
    end
end

function B.registerSupportObject(object,point,height)
    if not activeSupportIndex or not object or not object.Parent or not point then return end
    local base=activeSupportIndex.base
    if not base then return end
    local world=B.pointAnchorPosition(base,point,tonumber(height) or 0)
    local bucketKey=supportIndexBucket(world.X,world.Z)
    local bucket=activeSupportIndex.buckets[bucketKey]
    if not bucket then
        bucket={}
        activeSupportIndex.buckets[bucketKey]=bucket
    end
    local old=activeSupportIndex.objects[object]
    if old then
        for i=#old.bucket,1,-1 do
            if old.bucket[i]==old then
                table.remove(old.bucket,i)
                break
            end
        end
    end
    local entry={object=object,point={x=point.x,z=point.z},height=tonumber(height) or 0,worldX=world.X,worldZ=world.Z,bucket=bucket}
    bucket[#bucket+1]=entry
    activeSupportIndex.objects[object]=entry
end

function B.unregisterSupportObject(object)
    if not activeSupportIndex or not object then return end
    local entry=activeSupportIndex.objects[object]
    if not entry then return end
    for i=#entry.bucket,1,-1 do
        if entry.bucket[i]==entry then
            table.remove(entry.bucket,i)
            break
        end
    end
    activeSupportIndex.objects[object]=nil
end

function B.findIndexedSupport(base,targetPlot,targetPoint,targetHeight,maxDistance)
    local index=activeSupportIndex
    if not index or index.base~=base or index.plot~=targetPlot then return nil end
    maxDistance=math.max(0,tonumber(maxDistance) or SUPPORT_INDEX_MAX_DISTANCE_STUDS)
    if maxDistance<=0 then return nil end
    local targetWorld=B.pointAnchorPosition(base,targetPoint,targetHeight)
    local cell=SUPPORT_INDEX_CELL_STUDS
    local baseX=math.floor(targetWorld.X/cell)
    local baseZ=math.floor(targetWorld.Z/cell)
    local radius=math.max(1,math.ceil(maxDistance/cell)+1)
    local best=nil
    local bestScore=math.huge
    for bx=baseX-radius,baseX+radius do
        for bz=baseZ-radius,baseZ+radius do
            local bucket=index.buckets[tostring(bx)..":"..tostring(bz)]
            if bucket then
                for i=#bucket,1,-1 do
                    local entry=bucket[i]
                    local object=entry and entry.object
                    if not object or not object.Parent then
                        table.remove(bucket,i)
                        if object then index.objects[object]=nil end
                    else
                        local candidate=entry.point
                        local candidateWorldX=entry.worldX
                        local candidateWorldZ=entry.worldZ
                        if candidateWorldX==nil or candidateWorldZ==nil then
                            local candidateWorld=B.pointAnchorPosition(base,candidate,entry.height)
                            candidateWorldX=candidateWorld.X
                            candidateWorldZ=candidateWorld.Z
                        end
                        local dx=candidateWorldX-targetWorld.X
                        local dz=candidateWorldZ-targetWorld.Z
                        local actualDistance=math.sqrt(dx*dx+dz*dz)
                        if actualDistance<=maxDistance+0.05 then
                            local supportHeight,supportPart=B.supportHeightAtPoint(base,targetPlot,candidate)
                            if supportHeight~=nil then
                                local heightDelta=math.abs((tonumber(targetHeight) or 0)-supportHeight)
                                if heightDelta<=SUPPORT_EXISTING_MAX_HEIGHT_GAP then
                                    local score=actualDistance+heightDelta*0.35
                                    if supportPart and supportPart:IsDescendantOf(targetPlot) then
                                        score-=0.05
                                    end
                                    if score<bestScore then
                                        bestScore=score
                                        best={point={x=candidate.x,z=candidate.z},height=supportHeight,part=supportPart,distance=actualDistance,existing=true}
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

function B.makeSupportPoint(base,targetPlot,targetPoint,targetHeight,distanceStuds)
    local layout=GridMath.layout(base)
    local tx=tonumber(targetPoint.x) or 0
    local tz=tonumber(targetPoint.z) or 0
    local maxDistance=math.max(0,tonumber(distanceStuds) or 0)
    local indexed=B.findIndexedSupport(base,targetPlot,targetPoint,targetHeight,math.min(maxDistance,SUPPORT_INDEX_MAX_DISTANCE_STUDS))
    if indexed then
        debugLogVerbose("SUPPORT_INDEX_HIT",targetPoint,targetHeight,indexed.point,indexed.height,indexed.distance,indexed.part)
        return indexed
    end
    local center=B.makeCenterPoint(base)
    local cx=tonumber(center.x) or 0
    local cz=tonumber(center.z) or 0
    local dirX=((tx-cx)/POINT_UNIT*layout.cell.X)
    local dirZ=((tz-cz)/POINT_UNIT*layout.cell.Y)
    local dirMag=math.sqrt(dirX*dirX+dirZ*dirZ)
    local baseAngle=0
    if dirMag>0.001 then
        baseAngle=math.atan2(dirZ,dirX)
    end
    local radii={0,4,8,12,16,24,32}
    local best=nil
    local bestScore=math.huge
    local seen={}
    for _,radius in ipairs(radii) do
        if radius<=maxDistance+0.001 then
            for i=0,SUPPORT_SEARCH_ANGLES-1 do
                local angle=baseAngle+(math.pi*2/SUPPORT_SEARCH_ANGLES)*i
                local px=math.clamp(math.round(tx-(math.cos(angle)*radius)/layout.cell.X*POINT_UNIT),0,layout.columns*POINT_UNIT)
                local pz=math.clamp(math.round(tz-(math.sin(angle)*radius)/layout.cell.Y*POINT_UNIT),0,layout.rows*POINT_UNIT)
                local sig=tostring(px)..":"..tostring(pz)
                if not seen[sig] then
                    seen[sig]=true
                    local candidate={x=px,z=pz}
                    local supportHeight,supportPart=B.supportHeightAtPoint(base,targetPlot,candidate)
                    if supportHeight~=nil then
                        local actualDX=((px-tx)/POINT_UNIT)*layout.cell.X
                        local actualDZ=((pz-tz)/POINT_UNIT)*layout.cell.Y
                        local actualDistance=math.sqrt(actualDX*actualDX+actualDZ*actualDZ)
                        local heightDelta=math.abs((tonumber(targetHeight) or 0)-supportHeight)
                        if actualDistance<=maxDistance+0.05 and heightDelta<=SUPPORT_EXISTING_MAX_HEIGHT_GAP then
                            local score=actualDistance+heightDelta*0.35
                            if supportPart and supportPart:IsDescendantOf(targetPlot) and supportPart.Name=="Base" then
                                score-=0.1
                            end
                            if score<bestScore then
                                bestScore=score
                                best={point=candidate,height=supportHeight,part=supportPart,distance=actualDistance,existing=false}
                            end
                        end
                    end
                end
            end
        end
    end
    if best then
        debugLogVerbose("SUPPORT_RAYCAST_BEST",targetPoint,targetHeight,best.point,best.height,best.distance,best.part)
    end
    return best
end

function B.rotationParity(rotation)
    local quarter = ROTATION_UNITS / 4
    return math.round((tonumber(rotation) or 0) % ROTATION_UNITS / quarter) % 2
end

function B.getScalePointStuds(base,object,rotation)
    local layout=GridMath.layout(base)
    local cellX=layout.cell.X
    local cellZ=layout.cell.Y
    local parity=B.rotationParity(rotation or (object and tonumber(object:GetAttribute("PlaceRotation")) or 0))
    local sx=cellX/POINT_UNIT
    local sy=cellX/POINT_UNIT
    local sz=cellZ/POINT_UNIT
    if parity==1 then
        sx=cellZ/POINT_UNIT
        sy=cellX/POINT_UNIT
        sz=cellX/POINT_UNIT
    end
    return {x=sx,y=sy,z=sz}
end

function B.studsToBias(delta,pointStuds)
    local function conv(studs,step)
        if math.abs(step)<1e-9 then return 0 end
        return math.round((studs*2)/step)
    end
    return {
        x=conv(delta.X,pointStuds.x),
        y=conv(delta.Y,pointStuds.y),
        z=conv(delta.Z,pointStuds.z)
    }
end

function B.pointDeltaToBias(base,object,startPoint,targetPoint,rotation,startHeight,targetHeight)
    local layout=GridMath.layout(base)
    local localDelta=Vector3.new(
        ((tonumber(targetPoint.x) or 0)-(tonumber(startPoint.x) or 0))/POINT_UNIT*layout.cell.X,
        (tonumber(targetHeight) or 0)-(tonumber(startHeight) or 0),
        ((tonumber(targetPoint.z) or 0)-(tonumber(startPoint.z) or 0))/POINT_UNIT*layout.cell.Y
    )
    local worldDelta=base.CFrame:VectorToWorldSpace(localDelta)
    local objectRotation=object:GetPivot().Rotation
    local objectDelta=objectRotation:VectorToObjectSpace(worldDelta)
    local pointStuds=B.getScalePointStuds(base,object,rotation)
    return B.studsToBias(objectDelta,pointStuds)
end

function B.scaleBiasForPointDelta(base,object,startPoint,targetPoint,originalBias,rotation)
    local deltaBias=B.pointDeltaToBias(base,object,startPoint,targetPoint,rotation)
    originalBias=originalBias or {x=0,y=0,z=0}
    return {
        x=(tonumber(originalBias.x) or 0)+deltaBias.x,
        y=(tonumber(originalBias.y) or 0)+deltaBias.y,
        z=(tonumber(originalBias.z) or 0)+deltaBias.z
    }
end

function B.scaleBiasTarget(base,object,startPoint,targetPoint,originalBias,rotation)
    return B.scaleBiasForPointDelta(base,object,startPoint,targetPoint,originalBias,rotation)
end

local lastScaleRequestAtByKey={}
local scaleGate={active=0,nextStartAt=0,gap=0.10,minGap=0.07,maxGap=0.22,successStreak=0}
local function acquireScaleGate()
    while true do
        if scaleGate.active<2 then
            local remaining=scaleGate.nextStartAt-os.clock()
            if remaining<=0 then
                scaleGate.active+=1
                scaleGate.nextStartAt=os.clock()+scaleGate.gap
                return
            end
            task.wait(remaining)
        else
            task.wait()
        end
    end
end

local function releaseScaleGate(ok,result)
    scaleGate.active=math.max(0,scaleGate.active-1)
    if ok then
        scaleGate.successStreak+=1
        if scaleGate.successStreak>=12 then
            scaleGate.successStreak=0
            scaleGate.gap=math.max(scaleGate.minGap,scaleGate.gap-0.01)
        end
        return
    end
    scaleGate.successStreak=0
    local reason=tostring(result or "")
    if reason=="rate-limited" or reason=="busy" or reason=="await-timeout" then
        scaleGate.gap=math.min(scaleGate.maxGap,scaleGate.gap+0.03)
        debugLog("SCALE_GATE_BACKOFF",reason,scaleGate.gap)
    end
end

local SCALE_RETRY_COUNT=2
local SCALE_REQUEST_TIMEOUT=4

function B.waitForScaleSlot(key,gap)
    gap=tonumber(gap) or SCALE_MIN_GAP
    local slot=tostring(key)
    local last=lastScaleRequestAtByKey[slot] or 0
    local remaining=gap-(os.clock()-last)
    if remaining>0 then task.wait(remaining) end
end

function B.requestScaleItem(key,stretch,bias,context,gap)
    B.waitForScaleSlot(key,gap)
    acquireScaleGate()
    lastScaleRequestAtByKey[tostring(key)]=os.clock()
    local ok,result=callRoute("ScaleItem",{key=tostring(key),stretch=stretch,bias=bias},context,SCALE_REQUEST_TIMEOUT)
    releaseScaleGate(ok,result)
    return ok,result
end

function B.refreshObjectKey(targetItems,key,timeout)
    if not targetItems or key==nil then return nil end
    local wanted=tostring(key)
    local current=targetItems:FindFirstChild(wanted)
    if current then return current end
    return B.waitForObjectByKey(targetItems,wanted,timeout or SCALE_VERIFY_TIMEOUT)
end

function B.scaleMatches(object,stretch,bias)
    if not object then return false end
    local currentStretch=vec3Data(object:GetAttribute("Stretch"),0,0,0)
    local currentBias=vec3Data(object:GetAttribute("StretchBias") or object:GetAttribute("Bias"),0,0,0)
    return math.abs(currentStretch.x-stretch.x)<0.5
        and math.abs(currentStretch.y-stretch.y)<0.5
        and math.abs(currentStretch.z-stretch.z)<0.5
        and math.abs(currentBias.x-bias.x)<0.5
        and math.abs(currentBias.y-bias.y)<0.5
        and math.abs(currentBias.z-bias.z)<0.5
end

function B.waitForScaleMatch(targetItems,key,stretch,bias,timeout)
    if not targetItems then return nil end
    local deadline=os.clock()+(tonumber(timeout) or SCALE_VERIFY_TIMEOUT)
    local wanted=tostring(key)
    local current=targetItems:FindFirstChild(wanted)
    while os.clock()<=deadline do
        current=current or targetItems:FindFirstChild(wanted)
        if current and B.scaleMatches(current,stretch,bias) then
            return current
        end
        task.wait()
    end
    return current
end

function B.applyScaleDirect(targetItems,key,stretch,bias,context,gap)
    local ok,result=B.requestScaleItem(key,stretch,bias,context,gap)
    if not ok then
        debugLog("SCALE_DIRECT_FAIL",context,key,result,stretch,bias)
        return false,result,nil
    end
    local refreshed=B.waitForScaleMatch(targetItems,key,stretch,bias,SCALE_VERIFY_TIMEOUT)
    if refreshed and B.scaleMatches(refreshed,stretch,bias) then
        debugLogVerbose("SCALE_DIRECT_OK",context,key,stretch,bias)
        return true,nil,refreshed
    end
    debugLog("SCALE_DIRECT_NOT_VERIFIED",context,key,stretch,bias,refreshed)
    return false,"not-verified",refreshed
end

function B.applyScaleRobust(targetItems,key,stretch,bias,context,gap)
    local current=nil
    local lastReason=nil
    for attempt=1,SCALE_RETRY_COUNT do
        local ok,result,refreshed=B.applyScaleDirect(targetItems,key,stretch,bias,context..":attempt"..tostring(attempt),gap)
        current=refreshed or current
        if ok then
            return true,nil,current
        end
        lastReason=result
        local reason=tostring(result or "")
        if reason=="rate-limited" or reason=="busy" or reason=="not-verified" then
            if attempt<SCALE_RETRY_COUNT then
                debugLog("SCALE_RETRY",context,key,attempt,reason,stretch,bias)
                task.wait(SCALE_MIN_GAP)
            end
        else
            break
        end
    end
    debugLog("SCALE_RETRY_FAIL",context,key,lastReason,stretch,bias)
    return false,lastReason or "scale-failed",current
end

function B.applyMoveScale(targetItems,key,stretch,bias,context)
    local ok,result=B.requestScaleItem(key,stretch,bias,context,FALLBACK_MOVE_GAP)
    if ok then
        return true,nil
    end
    local reason=tostring(result or "")
    if reason=="rate-limited" or reason=="busy" then
        task.wait(FALLBACK_MOVE_GAP)
        local retryOK,retryResult=B.requestScaleItem(key,stretch,bias,context..":retry",FALLBACK_MOVE_GAP)
        if retryOK then return true,nil end
        return false,retryResult or result
    end
    return false,result
end


local FALLBACK_MOVE_STEP_STUDS=32
local FALLBACK_MOVE_MIN_STEP_STUDS=0.5
local FALLBACK_FINAL_APPROACH_STUDS=10
local FALLBACK_FINAL_APPROACH_STEP_STUDS=2.5
local FALLBACK_MOVE_GAP=0.03
local FALLBACK_MOVE_BINARY_STEPS=8
local FALLBACK_SAFE_BIAS_LIMIT=58000
local FALLBACK_REANCHOR_TRIGGER=48000
local FALLBACK_REANCHOR_MIN_DISTANCE_STUDS=1
local FALLBACK_REANCHOR_MAX_COUNT=3
local FALLBACK_WIRE_LIMIT=2048000

function B.readExactScaleState(object,base,rotation)
    local stretchAttr=object and object:GetAttribute("Stretch")
    local biasAttr=object and (object:GetAttribute("StretchBias") or object:GetAttribute("Bias"))
    local pointStuds=B.getScalePointStuds(base,object,rotation)
    local stretch={
        x=typeof(stretchAttr)=="Vector3" and math.round(stretchAttr.X) or 0,
        y=typeof(stretchAttr)=="Vector3" and math.round(stretchAttr.Y) or 0,
        z=typeof(stretchAttr)=="Vector3" and math.round(stretchAttr.Z) or 0
    }
    local bias={
        x=typeof(biasAttr)=="Vector3" and math.round(biasAttr.X) or 0,
        y=typeof(biasAttr)=="Vector3" and math.round(biasAttr.Y) or 0,
        z=typeof(biasAttr)=="Vector3" and math.round(biasAttr.Z) or 0
    }
    return stretch,bias,pointStuds
end

function B.pointDeltaStudsExact(base,startPoint,targetPoint)
    local layout=GridMath.layout(base)
    return Vector3.new(
        ((tonumber(targetPoint.x) or 0)-(tonumber(startPoint.x) or 0))/POINT_UNIT*layout.cell.X,
        0,
        ((tonumber(targetPoint.z) or 0)-(tonumber(startPoint.z) or 0))/POINT_UNIT*layout.cell.Y
    )
end

function B.biasDeltaForPointDeltaExact(base,object,startPoint,targetPoint,rotation,startHeight,targetHeight)
    local pointStuds=B.getScalePointStuds(base,object,rotation)
    local pointDelta=B.pointDeltaStudsExact(base,startPoint,targetPoint)
    local worldDelta=base.CFrame:VectorToWorldSpace(Vector3.new(pointDelta.X,(tonumber(targetHeight) or 0)-(tonumber(startHeight) or 0),pointDelta.Z))
    local objectDelta=object:GetPivot().Rotation:VectorToObjectSpace(worldDelta)
    return B.studsToBias(objectDelta,pointStuds),pointStuds
end

function B.biasStepForStuds(studs,pointStuds)
    studs=math.max(FALLBACK_MOVE_MIN_STEP_STUDS,tonumber(studs) or FALLBACK_MOVE_STEP_STUDS)
    return B.studsToBias(Vector3.new(studs,studs,studs),pointStuds)
end

function B.nextBiasToward(current,target,maxStep)
    local function one(a,b,step)
        local d=b-a
        if math.abs(d)<0.5 then return b end
        local amount=math.min(math.abs(d),math.max(1,math.abs(step)))
        return a+(d>0 and amount or -amount)
    end
    return {
        x=one(current.x,target.x,maxStep.x),
        y=one(current.y,target.y,maxStep.y),
        z=one(current.z,target.z,maxStep.z)
    }
end

function B.biasClose(a,b)
    return math.abs(a.x-b.x)<0.5 and math.abs(a.y-b.y)<0.5 and math.abs(a.z-b.z)<0.5
end

function B.pointFromWorldPosition(base,worldPosition)
    local layout=GridMath.layout(base)
    local localPosition=base.CFrame:PointToObjectSpace(worldPosition)
    local x=math.round((localPosition.X/layout.cell.X+layout.columns/2)*POINT_UNIT)
    local z=math.round((localPosition.Z/layout.cell.Y+layout.rows/2)*POINT_UNIT)
    return {
        x=math.clamp(x,0,layout.columns*POINT_UNIT),
        z=math.clamp(z,0,layout.rows*POINT_UNIT)
    }
end

function B.pointAnchorPosition(base,point,height)
    local layout=GridMath.layout(base)
    local x=((tonumber(point.x) or 0)/POINT_UNIT-layout.columns/2)*layout.cell.X
    local z=((tonumber(point.z) or 0)/POINT_UNIT-layout.rows/2)*layout.cell.Y
    return (base.CFrame*CFrame.new(x,base.Size.Y/2+(tonumber(height) or 0),z)).Position
end

function B.residualBiasForWorldPosition(base,object,point,height,rotation,worldPosition)
    local pointStuds=B.getScalePointStuds(base,object,rotation)
    local anchorPosition=B.pointAnchorPosition(base,point,height)
    local worldDelta=worldPosition-anchorPosition
    local objectDelta=object:GetPivot().Rotation:VectorToObjectSpace(worldDelta)
    return B.studsToBias(objectDelta,pointStuds)
end

function B.waitObjectGone(targetItems,key,timeout)
    local deadline=os.clock()+(timeout or 0.5)
    local wanted=tostring(key)
    while os.clock()<deadline do
        if not targetItems:FindFirstChild(wanted) then
            return true
        end
        task.wait()
    end
    return not targetItems:FindFirstChild(wanted)
end

function B.maxAbsBiasValue(bias)
    return math.max(math.abs(tonumber(bias.x) or 0),math.abs(tonumber(bias.y) or 0),math.abs(tonumber(bias.z) or 0))
end

function B.targetBiasFromPoint(base,object,currentPoint,currentHeight,targetPoint,targetHeight,rotation,finalBias)
    local pointStuds=B.getScalePointStuds(base,object,rotation)
    local objectRotation=object:GetPivot().Rotation
    local targetAnchor=B.pointAnchorPosition(base,targetPoint,targetHeight)
    local finalOffset=objectRotation:VectorToWorldSpace(Vector3.new(
        ((tonumber(finalBias.x) or 0)*pointStuds.x)/2,
        ((tonumber(finalBias.y) or 0)*pointStuds.y)/2,
        ((tonumber(finalBias.z) or 0)*pointStuds.z)/2
    ))
    local desiredWorld=targetAnchor+finalOffset
    local currentAnchor=B.pointAnchorPosition(base,currentPoint,currentHeight)
    local objectDelta=objectRotation:VectorToObjectSpace(desiredWorld-currentAnchor)
    return B.studsToBias(objectDelta,pointStuds),pointStuds
end

function B.maxSafeStepStuds(currentBias,targetBias,pointStuds,desiredStep)
    desiredStep=tonumber(desiredStep) or FALLBACK_MOVE_STEP_STUDS
    local safe=desiredStep
    local axes={
        {c="x",p=pointStuds.x},
        {c="y",p=pointStuds.y},
        {c="z",p=pointStuds.z}
    }
    for _,axis in ipairs(axes) do
        local current=tonumber(currentBias[axis.c]) or 0
        local target=tonumber(targetBias[axis.c]) or 0
        if math.abs(target-current)>=0.5 and math.abs(axis.p)>1e-9 then
            local available=FALLBACK_SAFE_BIAS_LIMIT-math.abs(current)
            if available<=0 then
                return 0
            end
            local physical=available*axis.p/2
            safe=math.min(safe,math.abs(physical))
        end
    end
    return math.max(0,safe)
end

function B.reanchorFallbackObject(targetItems,base,object,rotation,height,currentPoint,currentBias,pointStuds,scaleForReanchor)
    local oldKey=tostring(object.Name)
    local itemId=tostring(object:GetAttribute("ItemId") or "")
    if itemId=="" then
        return false,"reanchor-no-item-id",object,currentPoint,nil
    end
    pointStuds=pointStuds or B.getScalePointStuds(base,object,rotation)
    currentBias=currentBias or {x=0,y=0,z=0}
    local objectRotation=object:GetPivot().Rotation
    local anchorPosition=B.pointAnchorPosition(base,currentPoint,height)
    local worldOffset=objectRotation:VectorToWorldSpace(Vector3.new(
        ((tonumber(currentBias.x) or 0)*pointStuds.x)/2,
        ((tonumber(currentBias.y) or 0)*pointStuds.y)/2,
        ((tonumber(currentBias.z) or 0)*pointStuds.z)/2
    ))
    local worldPosition=anchorPosition+worldOffset
    local newPoint=B.pointFromWorldPosition(base,worldPosition)
    if math.abs(newPoint.x-currentPoint.x)<POINT_UNIT/2 and math.abs(newPoint.z-currentPoint.z)<POINT_UNIT/2 then
        local bestPoint=nil
        local bestScore=math.huge
        for radius=1,6 do
            local candidates={
                {x=currentPoint.x+POINT_UNIT*radius,z=currentPoint.z},
                {x=currentPoint.x-POINT_UNIT*radius,z=currentPoint.z},
                {x=currentPoint.x,z=currentPoint.z+POINT_UNIT*radius},
                {x=currentPoint.x,z=currentPoint.z-POINT_UNIT*radius}
            }
            for _,candidate in ipairs(candidates) do
                candidate.x=math.clamp(math.round(candidate.x/POINT_UNIT)*POINT_UNIT,0,GridMath.layout(base).columns*POINT_UNIT)
                candidate.z=math.clamp(math.round(candidate.z/POINT_UNIT)*POINT_UNIT,0,GridMath.layout(base).rows*POINT_UNIT)
                if math.abs(candidate.x-currentPoint.x)>=POINT_UNIT/2 or math.abs(candidate.z-currentPoint.z)>=POINT_UNIT/2 then
                    local residual=B.residualBiasForWorldPosition(base,object,candidate,height,rotation,worldPosition)
                    local score=math.max(math.abs(residual.x),math.abs(residual.y),math.abs(residual.z))
                    if score<bestScore then
                        bestScore=score
                        bestPoint={x=candidate.x,z=candidate.z}
                    end
                end
            end
            if bestPoint and bestScore<=FALLBACK_SAFE_BIAS_LIMIT then
                break
            end
        end
        if bestPoint then
            newPoint=bestPoint
        else
            return false,"reanchor-same-point",object,currentPoint,nil
        end
    end
    debugLog("FALLBACK_REANCHOR_BEGIN",oldKey,itemId,currentPoint,newPoint,worldPosition,currentBias,scaleForReanchor)
    local reanchorData={
        ItemId=itemId,
        PlaceHeight=height,
        PlaceRotation=rotation,
        PlaceStand=nil,
        Surface=nil
    }
    local newObject,placeError=B.sendPlaceItemAndWait(
        targetItems,
        reanchorData,
        newPoint,
        rotation,
        height,
        nil,
        nil,
        "fallback-reanchor:"..oldKey
    )
    if not newObject then
        debugLog("FALLBACK_REANCHOR_PLACE_FAIL",oldKey,placeError,currentPoint,newPoint)
        return false,placeError or "reanchor-place-failed",object,currentPoint,nil
    end
    local residualBias=B.residualBiasForWorldPosition(base,newObject,newPoint,height,rotation,worldPosition)
    if B.maxAbsBiasValue(residualBias)>FALLBACK_SAFE_BIAS_LIMIT then
        debugLog("FALLBACK_REANCHOR_RESIDUAL_TOO_LARGE",oldKey,residualBias,newPoint)
        pcall(function()
            callRouteFast("Demolish",{kind="Item",key=tostring(newObject.Name)},"fallback-reanchor-rollback:"..oldKey)
        end)
        return false,"reanchor-residual-too-large",object,currentPoint,nil
    end
    local desired=scaleForReanchor or {x=0,y=0,z=0}
    local residualOK,residualResult,residualObject=B.applyScaleRobust(
        targetItems,
        tostring(newObject.Name),
        desired,
        residualBias,
        "fallback-reanchor-residual:"..oldKey,
        SCALE_MIN_GAP
    )
    if not residualOK then
        debugLog("FALLBACK_REANCHOR_RESIDUAL_FAIL",oldKey,residualResult,newPoint,residualBias,desired)
        pcall(function()
            callRouteFast("Demolish",{kind="Item",key=tostring(newObject.Name)},"fallback-reanchor-rollback:"..oldKey)
        end)
        return false,residualResult or "reanchor-residual-failed",object,currentPoint,nil
    end
    newObject=residualObject or newObject
    local demolishOK,demolishResult=callRouteFast("Demolish",{kind="Item",key=oldKey},"fallback-reanchor-remove-old:"..oldKey)
    if not demolishOK then
        debugLog("FALLBACK_REANCHOR_REMOVE_OLD_FAIL",oldKey,demolishResult,newPoint,residualBias)
        pcall(function()
            callRouteFast("Demolish",{kind="Item",key=tostring(newObject.Name)},"fallback-reanchor-remove-new:"..oldKey)
        end)
        return false,demolishResult or "reanchor-remove-old-failed",object,currentPoint,nil
    end
    local newKey=tostring(newObject.Name)
    local currentScale,currentBias,pointStuds=B.readExactScaleState(newObject,base,rotation)
    debugLog("FALLBACK_REANCHOR_OK",oldKey,newKey,currentPoint,newPoint,currentBias,worldPosition,currentScale,pointStuds)
    return true,nil,newObject,newPoint,currentBias
end

function B.movePlacedObjectWithScaleBias(targetItems,base,object,startPoint,targetPoint,rotation,transformStretch,transformBias,startHeight,targetHeight)
    local key=tostring(object.Name)
    local current=object
    local currentPoint={x=tonumber(startPoint.x) or 0,z=tonumber(startPoint.z) or 0}
    local currentHeight=tonumber(startHeight) or 0
    local desiredStretch={x=math.round(tonumber(transformStretch.x) or 0),y=math.round(tonumber(transformStretch.y) or 0),z=math.round(tonumber(transformStretch.z) or 0)}
    local originalBias={x=math.round(tonumber(transformBias.x) or 0),y=math.round(tonumber(transformBias.y) or 0),z=math.round(tonumber(transformBias.z) or 0)}
    local currentStretch,currentBias,pointStuds=B.readExactScaleState(current,base,rotation)
    local needsScale=desiredStretch.x~=0 or desiredStretch.y~=0 or desiredStretch.z~=0 or originalBias.x~=0 or originalBias.y~=0 or originalBias.z~=0
    local scaleApplied=false
    local reanchorCount=0
    local stalledCount=0
    local lastProgressKey=nil

    debugLog("FALLBACK_START",key,currentPoint,targetPoint,currentHeight,targetHeight,desiredStretch,originalBias)

    if needsScale then
        local scaleOK,scaleResult,scaledObject=B.applyScaleRobust(
            targetItems,
            key,
            desiredStretch,
            {x=0,y=0,z=0},
            "fallback-initial-scale:"..key,
            SCALE_MIN_GAP
        )
        if scaleOK then
            current=scaledObject or current
            currentStretch,currentBias,pointStuds=B.readExactScaleState(current,base,rotation)
            scaleApplied=true
            debugLog("FALLBACK_INITIAL_SCALE_OK",key,desiredStretch,currentBias,current:GetAttribute("Stretch"),current:GetAttribute("StretchBias") or current:GetAttribute("Bias"))
        else
            debugLog("FALLBACK_INITIAL_SCALE_FAIL",key,scaleResult,desiredStretch,currentPoint,targetPoint)
            currentStretch,currentBias,pointStuds=B.readExactScaleState(current,base,rotation)
        end
    end

    local targetBias,movePointStuds=B.targetBiasFromPoint(base,current,currentPoint,currentHeight,targetPoint,targetHeight,rotation,originalBias)
    local totalSteps=0
    local moveStepStuds=FALLBACK_MOVE_STEP_STUDS
    local scaleDuringMove=scaleApplied and desiredStretch or {x=0,y=0,z=0}

    debugLog("FALLBACK_MOVE_PLAN",key,currentPoint,targetPoint,rotation,desiredStretch,currentStretch,currentBias,targetBias,FALLBACK_MOVE_STEP_STUDS,FALLBACK_SAFE_BIAS_LIMIT)

    while true do
        if stopCopy then
            debugLog("FALLBACK_MOVE_STOP_REQUESTED",key,totalSteps,currentPoint,currentBias,targetBias)
            return false,"stopped",current
        end
        local progressKey=string.format("%d:%d:%d",math.round(currentBias.x),math.round(currentBias.y),math.round(currentBias.z))
        if lastProgressKey==progressKey then
            stalledCount+=1
        else
            stalledCount=0
            lastProgressKey=progressKey
        end
        if stalledCount>=5 then
            debugLog("FALLBACK_MOVE_STALLED",key,totalSteps,currentPoint,currentBias,targetBias,moveStepStuds,reanchorCount)
            if reanchorCount<FALLBACK_REANCHOR_MAX_COUNT then
                local reanchorOK,reanchorResult,reanchoredObject,reanchoredPoint,reanchoredBias=B.reanchorFallbackObject(
                    targetItems,base,current,rotation,currentHeight,currentPoint,currentBias,pointStuds,scaleApplied and desiredStretch or currentStretch
                )
                if reanchorOK and reanchoredObject then
                    current=reanchoredObject
                    currentPoint=reanchoredPoint
                    currentBias=reanchoredBias or {x=0,y=0,z=0}
                    currentHeight=tonumber(current:GetAttribute("PlaceHeight")) or currentHeight
                    currentStretch=select(1,B.readExactScaleState(current,base,rotation)) or currentStretch
                    pointStuds=B.getScalePointStuds(base,current,rotation)
                    movePointStuds=pointStuds
                    targetBias,movePointStuds=B.targetBiasFromPoint(base,current,currentPoint,currentHeight,targetPoint,targetHeight,rotation,originalBias)
                    reanchorCount+=1
                    stalledCount=0
                    lastProgressKey=nil
                    debugLog("FALLBACK_REANCHOR_STALLED_RECOVERY",key,reanchorCount,currentPoint,currentBias,targetBias)
                    continue
                end
                reanchorCount+=1
                debugLog("FALLBACK_REANCHOR_STALLED_FAIL",key,reanchorCount,reanchorResult,currentPoint,currentBias,targetBias)
            end
            return false,"stalled",current
        end
        if B.biasClose(currentBias,targetBias) then
            debugLog("FALLBACK_MOVE_REACHED",key,totalSteps,currentPoint,currentBias,targetBias)
            local finalOK,finalResult,finalObject=B.applyScaleRobust(
                targetItems,
                tostring(current.Name),
                desiredStretch,
                targetBias,
                "fallback-final-scale:"..key,
                SCALE_MIN_GAP
            )
            if finalOK then
                current=finalObject or current
                debugLog("FALLBACK_FINAL_SCALE_OK",key,desiredStretch,targetBias,current:GetAttribute("Stretch"),current:GetAttribute("StretchBias") or current:GetAttribute("Bias"))
                return true,nil,current
            end
            local finalReason=tostring(finalResult or "")
            debugLog("FALLBACK_FINAL_SCALE_FAIL",key,finalReason,desiredStretch,targetBias,currentBias)
            if finalReason=="out-of-bounds" or finalReason=="bad-scale" then
                if reanchorCount<FALLBACK_REANCHOR_MAX_COUNT then
                    local reanchorOK,reanchorResult,reanchoredObject,reanchoredPoint,reanchoredBias=B.reanchorFallbackObject(
                        targetItems,base,current,rotation,currentHeight,currentPoint,currentBias,pointStuds,scaleApplied and desiredStretch or currentStretch
                    )
                    if reanchorOK and reanchoredObject then
                        current=reanchoredObject
                        currentPoint=reanchoredPoint
                        currentBias=reanchoredBias or {x=0,y=0,z=0}
                        currentHeight=tonumber(current:GetAttribute("PlaceHeight")) or currentHeight
                        currentStretch=select(1,B.readExactScaleState(current,base,rotation)) or currentStretch
                        pointStuds=B.getScalePointStuds(base,current,rotation)
                        movePointStuds=pointStuds
                        targetBias,movePointStuds=B.targetBiasFromPoint(base,current,currentPoint,currentHeight,targetPoint,targetHeight,rotation,originalBias)
                        reanchorCount+=1
                        stalledCount=0
                        lastProgressKey=nil
                        debugLog("FALLBACK_FINAL_REANCHOR",key,reanchorCount,currentPoint,currentBias,targetBias)
                        continue
                    end
                    debugLog("FALLBACK_FINAL_REANCHOR_FAIL",key,reanchorCount,reanchorResult,currentPoint,currentBias,targetBias)
                    reanchorCount+=1
                end
            end
            if scaleApplied and B.scaleMatches(current,desiredStretch,targetBias) then
                return true,nil,current
            end
            return false,finalResult or "fallback-final-scale-failed",current
        end

        local remainingX=math.abs(targetBias.x-currentBias.x)*movePointStuds.x/2
        local remainingY=math.abs(targetBias.y-currentBias.y)*movePointStuds.y/2
        local remainingZ=math.abs(targetBias.z-currentBias.z)*movePointStuds.z/2
        local remainingMax=math.max(remainingX,remainingY,remainingZ)
        local absCurrent=B.maxAbsBiasValue(currentBias)
        local absTarget=B.maxAbsBiasValue(targetBias)

        if reanchorCount<FALLBACK_REANCHOR_MAX_COUNT and absCurrent>=FALLBACK_REANCHOR_TRIGGER and absTarget>FALLBACK_SAFE_BIAS_LIMIT and remainingMax>FALLBACK_REANCHOR_MIN_DISTANCE_STUDS then
            local reanchorOK,reanchorResult,reanchoredObject,reanchoredPoint,reanchoredBias=B.reanchorFallbackObject(
                targetItems,
                base,
                current,
                rotation,
                currentHeight,
                currentPoint,
                currentBias,
                pointStuds,
                scaleApplied and desiredStretch or currentStretch
            )
            if reanchorOK and reanchoredObject then
                current=reanchoredObject
                currentPoint=reanchoredPoint
                currentBias=reanchoredBias or {x=0,y=0,z=0}
                currentHeight=tonumber(current:GetAttribute("PlaceHeight")) or currentHeight
                currentStretch=select(1,B.readExactScaleState(current,base,rotation)) or currentStretch
                pointStuds=B.getScalePointStuds(base,current,rotation)
                movePointStuds=pointStuds
                targetBias,movePointStuds=B.targetBiasFromPoint(base,current,currentPoint,currentHeight,targetPoint,targetHeight,rotation,originalBias)
                reanchorCount+=1
                debugLog("FALLBACK_REANCHOR_STEP",key,reanchorCount,currentPoint,currentBias,targetBias)
                continue
            end
            debugLog("FALLBACK_REANCHOR_SKIP",key,reanchorCount,reanchorResult,currentPoint,targetBias)
            reanchorCount+=1
        end

        local stepStuds=moveStepStuds
        if remainingMax<=FALLBACK_FINAL_APPROACH_STUDS then
            stepStuds=math.min(stepStuds,FALLBACK_FINAL_APPROACH_STEP_STUDS)
        end
        local safeStep=B.maxSafeStepStuds(currentBias,targetBias,movePointStuds,stepStuds)
        if safeStep<=0 then
            if reanchorCount<FALLBACK_REANCHOR_MAX_COUNT then
                local reanchorOK,reanchorResult,reanchoredObject,reanchoredPoint,reanchoredBias=B.reanchorFallbackObject(
                    targetItems,
                    base,
                    current,
                    rotation,
                    currentHeight,
                    currentPoint,
                    currentBias,
                    pointStuds,
                    scaleApplied and desiredStretch or currentStretch
                )
                if reanchorOK and reanchoredObject then
                    current=reanchoredObject
                    currentPoint=reanchoredPoint
                    currentBias=reanchoredBias or {x=0,y=0,z=0}
                    currentHeight=tonumber(current:GetAttribute("PlaceHeight")) or currentHeight
                    pointStuds=B.getScalePointStuds(base,current,rotation)
                    movePointStuds=pointStuds
                    targetBias,movePointStuds=B.targetBiasFromPoint(base,current,currentPoint,currentHeight,targetPoint,targetHeight,rotation,originalBias)
                    reanchorCount+=1
                    debugLog("FALLBACK_REANCHOR_FORCED",key,reanchorCount,currentPoint,currentBias,targetBias)
                    continue
                end
                reanchorCount+=1
                debugLog("FALLBACK_REANCHOR_FORCED_FAIL",key,reanchorCount,reanchorResult,currentPoint,currentBias,targetBias)
            end
            if moveStepStuds>FALLBACK_MOVE_MIN_STEP_STUDS then
                moveStepStuds=math.max(FALLBACK_MOVE_MIN_STEP_STUDS,moveStepStuds/2)
                continue
            end
            stepStuds=FALLBACK_MOVE_MIN_STEP_STUDS
            safeStep=stepStuds
        else
            stepStuds=math.min(stepStuds,safeStep)
        end

        local moveStepBias=B.biasStepForStuds(stepStuds,movePointStuds)
        local stageBias=B.nextBiasToward(currentBias,targetBias,moveStepBias)

        debugLogVerbose("FALLBACK_MOVE_SEND",key,totalSteps+1,stageBias,currentPoint,targetBias,stepStuds,desiredStretch,remainingMax)

        local moveStretch=scaleDuringMove
        local ok,result=B.applyMoveScale(
            targetItems,
            tostring(current.Name),
            moveStretch,
            stageBias,
            "fallback-move:"..key..":"..tostring(totalSteps+1)
        )

        if ok then
            totalSteps+=1
            currentBias={x=stageBias.x,y=stageBias.y,z=stageBias.z}
            stalledCount=0
            lastProgressKey=nil
            if not scaleApplied and (moveStretch.x~=0 or moveStretch.y~=0 or moveStretch.z~=0) then
                scaleApplied=true
                scaleDuringMove=desiredStretch
            end
            pointStuds=B.getScalePointStuds(base,current,rotation)
            movePointStuds=pointStuds
            debugLogVerbose("FALLBACK_MOVE_OK",key,totalSteps,currentPoint,currentBias,targetBias,current:GetPivot(),stepStuds,desiredStretch)
            continue
        end

        local moveReason=tostring(result or "")
        debugLog("FALLBACK_MOVE_FAIL",key,totalSteps+1,moveReason,currentPoint,currentBias,stageBias,targetBias,stepStuds)

        if moveReason=="rate-limited" or moveReason=="busy" then
            task.wait(FALLBACK_MOVE_GAP)
            continue
        end

        if moveReason=="out-of-bounds" or moveReason=="bad-scale" then
            if not scaleApplied and (moveStretch.x~=0 or moveStretch.y~=0 or moveStretch.z~=0) then
                scaleDuringMove={x=0,y=0,z=0}
                debugLog("FALLBACK_MOVE_SCALE_DEFERRED",key,totalSteps+1,moveReason,currentBias,stageBias,targetBias)
                continue
            end
            if reanchorCount<FALLBACK_REANCHOR_MAX_COUNT and remainingMax>FALLBACK_REANCHOR_MIN_DISTANCE_STUDS then
                local reanchorOK,reanchorResult,reanchoredObject,reanchoredPoint,reanchoredBias=B.reanchorFallbackObject(
                    targetItems,
                    base,
                    current,
                    rotation,
                    currentHeight,
                    currentPoint,
                    currentBias,
                    pointStuds,
                    scaleApplied and desiredStretch or currentStretch
                )
                if reanchorOK and reanchoredObject then
                    current=reanchoredObject
                    currentPoint=reanchoredPoint
                    currentBias=reanchoredBias or {x=0,y=0,z=0}
                    currentHeight=tonumber(current:GetAttribute("PlaceHeight")) or currentHeight
                    pointStuds=B.getScalePointStuds(base,current,rotation)
                    movePointStuds=pointStuds
                    targetBias,movePointStuds=B.targetBiasFromPoint(base,current,currentPoint,currentHeight,targetPoint,targetHeight,rotation,originalBias)
                    reanchorCount+=1
                    debugLog("FALLBACK_REANCHOR_AFTER_REJECT",key,reanchorCount,currentPoint,currentBias,targetBias)
                    continue
                end
                debugLog("FALLBACK_REANCHOR_AFTER_REJECT_FAIL",key,reanchorCount,reanchorResult,currentPoint,targetBias)
                reanchorCount+=1
            end
            if moveStepStuds>FALLBACK_MOVE_MIN_STEP_STUDS then
                moveStepStuds=math.max(FALLBACK_MOVE_MIN_STEP_STUDS,moveStepStuds/2)
                debugLog("FALLBACK_MOVE_STEP_BACKOFF",key,moveStepStuds,currentBias,targetBias)
                continue
            end
            debugLog("FALLBACK_MOVE_STOP_AT_VALID_POINT",key,currentPoint,currentBias,targetBias,stepStuds)
            local finalOK,finalResult,finalObject=B.applyScaleRobust(
                targetItems,
                tostring(current.Name),
                desiredStretch,
                currentBias,
                "fallback-partial-final-scale:"..key,
                SCALE_MIN_GAP
            )
            if finalOK then
                current=finalObject or current
                return true,nil,current
            end
            debugLog("FALLBACK_PARTIAL_FINAL_SCALE_FAIL",key,finalResult,currentBias)
            if (finalResult=="out-of-bounds" or finalResult=="bad-scale") and reanchorCount<FALLBACK_REANCHOR_MAX_COUNT then
                local reanchorOK,reanchorResult,reanchoredObject,reanchoredPoint,reanchoredBias=B.reanchorFallbackObject(
                    targetItems,base,current,rotation,currentHeight,currentPoint,currentBias,currentStretch,scaleApplied and desiredStretch or currentStretch
                )
                if reanchorOK and reanchoredObject then
                    current=reanchoredObject
                    currentPoint=reanchoredPoint
                    currentBias=reanchoredBias or {x=0,y=0,z=0}
                    currentHeight=tonumber(current:GetAttribute("PlaceHeight")) or currentHeight
                    local refreshedStretch
                    refreshedStretch=select(1,B.readExactScaleState(current,base,rotation))
                    currentStretch=refreshedStretch or currentStretch
                    pointStuds=B.getScalePointStuds(base,current,rotation)
                    movePointStuds=pointStuds
                    targetBias,movePointStuds=B.targetBiasFromPoint(base,current,currentPoint,currentHeight,targetPoint,targetHeight,rotation,originalBias)
                    reanchorCount+=1
                    debugLog("FALLBACK_PARTIAL_REANCHOR",key,reanchorCount,currentPoint,currentBias,targetBias)
                    continue
                end
                debugLog("FALLBACK_PARTIAL_REANCHOR_FAIL",key,reanchorCount,reanchorResult,currentPoint,currentBias,targetBias)
                reanchorCount+=1
            end
            return false,finalResult or "fallback-partial-final-scale-failed",current
        end

        return false,result,current
    end
end

function B.sendPlaceItemAndWait(targetItems,data,point,rotation,height,stand,surface,context)
    local before=B.snapshotChildren(targetItems)
    local request={itemId=tostring(data.ItemId),point={x=point.x,z=point.z},rotation=rotation,height=height,surface=surface,stand=stand}
    debugLog("PLACE_ATTEMPT",context,request)
    local ok,result=callRoute("PlaceItem",request,context)
    if not ok then
        debugLog("PLACE_REJECTED",context,result)
        return nil,result
    end
    local serverKey=type(result)=="table" and result.key or nil
    if serverKey~=nil then
        local exact=B.waitForObjectByKey(targetItems,serverKey,OBJECT_REPLICATION_TIMEOUT,before)
        if exact then
            debugLog("PLACE_REPLICATED",context,serverKey,exact:GetAttribute("ItemId"),exact:GetAttribute("PlacePoint"),exact:GetAttribute("PlaceHeight"))
            return exact,nil
        end
        debugLog("PLACE_KEY_NO_REPLICATION",context,serverKey)
        return nil,"server-ok-but-key-not-replicated"
    end
    local found=B.waitForPlacedObject(targetItems,data,point,height,rotation,before,OBJECT_REPLICATION_TIMEOUT)
    if found then
        debugLog("PLACE_REPLICATED_NO_KEY",context,found.Name,found:GetAttribute("PlacePoint"))
        return found,nil
    end
    debugLog("PLACE_NO_REPLICATION",context)
    return nil,"server-ok-but-not-replicated"
end

function B.dataPoint(base,data)
    local p = data.PlacePoint
    if typeof(p) == "Vector2" then
        return {x=math.round(p.X),z=math.round(p.Y)}
    end
    if type(p) == "table" then
        local x = tonumber(p.x) or tonumber(p.X)
        local z = tonumber(p.z) or tonumber(p.Z)
        if x and z then return {x=math.round(x),z=math.round(z)} end
    end
    local lp = data.LocalPosition
    if typeof(lp) == "Vector3" then
        local layout = GridMath.layout(base)
        local x = math.round((lp.X + base.Size.X / 2) / layout.cell.X * POINT_UNIT)
        local z = math.round((lp.Z + base.Size.Z / 2) / layout.cell.Y * POINT_UNIT)
        return {x=math.clamp(x,0,layout.columns * POINT_UNIT),z=math.clamp(z,0,layout.rows * POINT_UNIT)}
    end
    return nil
end

function B.dataHeight(base,data)
    local height = tonumber(data.PlaceHeight)
    if height then return math.max(0,height) end
    local lp = data.LocalPosition
    if typeof(lp) == "Vector3" then
        return math.max(0,lp.Y - base.Size.Y / 2)
    end
    return 0
end

function B.dataRotation(data)
    local rotation = tonumber(data.PlaceRotation)
    if rotation then return math.round(rotation) % ROTATION_UNITS end
    return 0
end

function B.dataStand(data)
    local stand = data.PlaceStand
    if stand == nil or tostring(stand) == "" or tostring(stand) == "Rest" or tonumber(stand) == 1 then
        return nil
    end
    if tonumber(stand) == 2 or tostring(stand) == "Hang" then return "Hang" end
    if tonumber(stand) == 3 or tostring(stand) == "Side" then return "Side" end
    return nil
end

function B.scaleObjectExact(targetItems,targetObject,data)
    local desiredStretch=vec3Data(data.Stretch,1,1,1)
    local desiredBias=vec3Data(data.Bias,0,0,0)
    local needsScale=desiredStretch.x~=1 or desiredStretch.y~=1 or desiredStretch.z~=1 or desiredBias.x~=0 or desiredBias.y~=0 or desiredBias.z~=0
    if not needsScale then return true,targetObject,nil end
    local key=tostring(targetObject.Name)
    local success,result,refreshed=B.applyScaleRobust(targetItems,key,desiredStretch,desiredBias,"item:"..tostring(data.ItemId)..":"..key,SCALE_MIN_GAP)
    if not success then
        debugLog("SCALE_REJECTED",data.ItemId,key,result)
        return false,refreshed or targetObject,result
    end
    return true,refreshed or targetObject,nil
end

function B.restoreSavedPlacementAfterScale(targetItems,targetObject,data,point,height,rotation,context)
    if not targetObject or not targetObject.Parent or not point then return false,targetObject,"missing-object-or-point" end
    local pitch=math.round(tonumber(data.PlacePitch) or 0)%ROTATION_UNITS
    local roll=math.round(tonumber(data.PlaceRoll) or 0)%ROTATION_UNITS
    local stretch=vec3Data(data.Stretch,0,0,0)
    local bias=vec3Data(data.Bias,0,0,0)
    local ok,result=callRoute("TransformItem",{
        key=tostring(targetObject.Name),
        point={x=point.x,z=point.z},
        height=height,
        rotation=rotation,
        pitch=pitch,
        roll=roll,
        stretch=stretch,
        bias=bias,
        surface=data.Surface,
        stand=B.dataStand(data)
    },context or ("restore-placement:"..tostring(targetObject.Name)))
    if not ok then
        debugLog("RESTORE_PLACEMENT_FAIL",targetObject.Name,point,height,rotation,result)
        return false,targetObject,result
    end
    local refreshed=targetItems and targetItems:FindFirstChild(tostring(targetObject.Name)) or nil
    return true,refreshed or targetObject,nil
end

local function supportPointDistanceStuds(base,a,b)
    local layout=GridMath.layout(base)
    local dx=((tonumber(a.x) or 0)-(tonumber(b.x) or 0))/POINT_UNIT*layout.cell.X
    local dz=((tonumber(a.z) or 0)-(tonumber(b.z) or 0))/POINT_UNIT*layout.cell.Y
    return math.sqrt(dx*dx+dz*dz)
end

local temporarySupportState={}

local function supportSizeStretch(base,supportObject,targetHeight,footprint)
    local _,currentSize=supportObject:GetBoundingBox()
    local pointStuds=B.getScalePointStuds(base,supportObject,0)
    local desiredY=math.max(0.5,tonumber(targetHeight) or 0)
    local desiredFootprint=tonumber(footprint) or SUPPORT_FOOTPRINT_STUDS
    local desiredX=math.max(desiredFootprint,currentSize.X)
    local desiredZ=math.max(desiredFootprint,currentSize.Z)
    return {
        x=math.round((desiredX-currentSize.X)/math.max(pointStuds.x,0.0001)),
        y=math.round((desiredY-currentSize.Y)/math.max(pointStuds.y,0.0001)),
        z=math.round((desiredZ-currentSize.Z)/math.max(pointStuds.z,0.0001))
    }
end

local function supportPlacementCandidates(base,targetPoint,distanceStuds)
    local layout=GridMath.layout(base)
    local center=B.makeCenterPoint(base)
    local tx=tonumber(targetPoint.x) or 0
    local tz=tonumber(targetPoint.z) or 0
    local cx=tonumber(center.x) or 0
    local cz=tonumber(center.z) or 0
    local dirX=((tx-cx)/POINT_UNIT)*layout.cell.X
    local dirZ=((tz-cz)/POINT_UNIT)*layout.cell.Y
    local baseAngle=0
    if math.abs(dirX)+math.abs(dirZ)>0.001 then
        baseAngle=math.atan2(dirZ,dirX)
    end
    local candidates={}
    local seen={}
    local radii={tonumber(distanceStuds) or FALLBACK_START_DISTANCE_STUDS,24,20,16,12,8,4,0}
    for _,radius in ipairs(radii) do
        for i=0,SUPPORT_SEARCH_ANGLES-1 do
            local angle=baseAngle+(math.pi*2/SUPPORT_SEARCH_ANGLES)*i
            local px=math.clamp(math.round(tx-(math.cos(angle)*radius)/layout.cell.X*POINT_UNIT),0,layout.columns*POINT_UNIT)
            local pz=math.clamp(math.round(tz-(math.sin(angle)*radius)/layout.cell.Y*POINT_UNIT),0,layout.rows*POINT_UNIT)
            local sig=tostring(px)..":"..tostring(pz)
            if not seen[sig] then
                seen[sig]=true
                candidates[#candidates+1]={x=px,z=pz}
            end
        end
    end
    return candidates
end

local function removeTemporarySupportState(state)
    for i=#temporarySupportState,1,-1 do
        if temporarySupportState[i]==state then
            table.remove(temporarySupportState,i)
            return
        end
    end
end

local function destroyTemporarySupport(state,context)
    if not state then return true end
    removeTemporarySupportState(state)
    local object=state.object
    if not object or not object.Parent then
        debugLogVerbose("SUPPORT_ALREADY_GONE",context,state.point,state.height)
        return true
    end
    local ok,result=callRouteFast("Demolish",{kind="Item",key=tostring(object.Name)},context or "support-demolish")
    if ok then
        debugLog("SUPPORT_DESTROYED",context,state.point,state.height,object.Name)
        return true
    end
    table.insert(temporarySupportState,state)
    debugLog("SUPPORT_DESTROY_FAIL",context,result,state.point,state.height,object.Name)
    return false
end

local function cleanupTemporarySupports(context)
    if #temporarySupportState==0 then return end
    local snapshot=table.clone(temporarySupportState)
    temporarySupportState={}
    for _,state in ipairs(snapshot) do
        if state and state.object and state.object.Parent then
            local ok,result=callRouteFast("Demolish",{kind="Item",key=tostring(state.object.Name)},context or "support-cleanup")
            if ok then
                debugLog("SUPPORT_CLEANUP_OK",state.point,state.height,state.object.Name)
            else
                table.insert(temporarySupportState,state)
                debugLog("SUPPORT_CLEANUP_FAIL",result,state.point,state.height,state.object.Name)
            end
        end
    end
end

local function createTemporarySupport(targetItems,base,targetPlot,targetPoint,targetHeight,index,distanceStuds)
    targetHeight=math.max(0,tonumber(targetHeight) or 0)
    if targetHeight<=0.5 then return nil,"support-height-too-low" end
    local candidates=supportPlacementCandidates(base,targetPoint,distanceStuds or FALLBACK_START_DISTANCE_STUDS)
    for candidateIndex,candidate in ipairs(candidates) do
        local supportData={ItemId=SUPPORT_ID,PlaceHeight=0,PlaceRotation=0,PlaceStand=nil,Surface=nil}
        local supportObject,placeError=B.sendPlaceItemAndWait(
            targetItems,
            supportData,
            candidate,
            0,
            0,
            nil,
            nil,
            "support-create:"..tostring(index)..":"..tostring(candidateIndex)
        )
        if supportObject then
            local scaleResult=nil
            local supportScaleOK=false
            local refreshedObject=supportObject
            local stretch=nil
            for _,footprint in ipairs({SUPPORT_FOOTPRINT_STUDS,8,4}) do
                stretch=supportSizeStretch(base,supportObject,targetHeight,footprint)
                local ok,result,refreshed=B.applyScaleRobust(
                    targetItems,
                    tostring(supportObject.Name),
                    stretch,
                    {x=0,y=0,z=0},
                    "support-scale:"..tostring(index)..":"..tostring(candidateIndex)..":"..tostring(footprint),
                    SCALE_MIN_GAP
                )
                if ok then
                    supportScaleOK=true
                    refreshedObject=refreshed or supportObject
                    break
                end
                scaleResult=result
            end
            if supportScaleOK then
                supportObject=refreshedObject
                local actualHeight=targetHeight
                local supportHeight=B.supportHeightAtPoint(base,targetPlot,candidate)
                if supportHeight~=nil then actualHeight=supportHeight end
                local state={object=supportObject,point=candidate,height=actualHeight,stretch=stretch,targetPoint=targetPoint,index=index,owned=true}
                table.insert(temporarySupportState,state)
                debugLog("SUPPORT_CREATED",index,candidate,targetPoint,actualHeight,stretch,supportObject.Name)
                return state
            end
            debugLog("SUPPORT_SCALE_FAIL",index,candidate,targetHeight,stretch,scaleResult)
            pcall(function()
                callRouteFast("Demolish",{kind="Item",key=tostring(supportObject.Name)},"support-rollback:"..tostring(index)..":"..tostring(candidateIndex))
            end)
        else
            debugLog("SUPPORT_PLACE_FAIL",index,candidate,placeError)
        end
    end
    return nil,"support-create-failed"
end

local function recoverScaleFailure(targetItems,base,targetPlot,data,oldObject,targetPoint,targetHeight,rotation,index)
    local desiredStretch=vec3Data(data.Stretch,0,0,0)
    local desiredBias=vec3Data(data.Bias,0,0,0)
    local oldKey=tostring(oldObject.Name)
    for attempt=1,2 do
        local wantedDistance=attempt==1 and FALLBACK_START_DISTANCE_STUDS or FALLBACK_START_SECOND_DISTANCE_STUDS
        local candidate=nil
        local candidateHeight=0
        local candidateStand=nil
        local candidateSurface=nil
        local support=B.makeSupportPoint(base,targetPlot,targetPoint,targetHeight,wantedDistance)
        local scaffold=nil
        if support then
            candidate=support.point
            candidateHeight=support.height
            debugLog("SCALE_RECOVERY_SUPPORT",index,data.ItemId,attempt,candidate,candidateHeight,support.distance,support.part)
        else
            scaffold=createTemporarySupport(targetItems,base,targetPlot,targetPoint,targetHeight,index,wantedDistance)
            if scaffold then
                candidate=scaffold.point
                candidateHeight=scaffold.height
                debugLog("SCALE_RECOVERY_SCAFFOLD",index,data.ItemId,attempt,candidate,candidateHeight,scaffold.object.Name)
            else
                candidate=B.makeNearTargetPoint(base,targetPoint,wantedDistance)
                candidateHeight=0
                debugLog("SCALE_RECOVERY_NEAR_TARGET",index,data.ItemId,attempt,candidate,candidateHeight)
            end
        end
        local candidateData=table.clone(data)
        candidateData.Surface=nil
        candidateData.PlaceStand=nil
        local newObject,placeError=B.sendPlaceItemAndWait(
            targetItems,
            candidateData,
            candidate,
            rotation,
            candidateHeight,
            candidateStand,
            candidateSurface,
            "scale-recovery-place:"..tostring(index)..":"..tostring(attempt)
        )
        if newObject then
            local movedOK,movedResult,movedObject=B.movePlacedObjectWithScaleBias(
                targetItems,
                base,
                newObject,
                candidate,
                targetPoint,
                rotation,
                desiredStretch,
                desiredBias,
                candidateHeight,
                targetHeight
            )
            if movedOK and movedObject then
                if scaffold then
                    destroyTemporarySupport(scaffold,"scale-recovery-support-done:"..tostring(index)..":"..tostring(attempt))
                end
                local demolishOK,demolishResult=callRouteFast("Demolish",{kind="Item",key=oldKey},"scale-recovery-remove-old:"..tostring(index))
                if demolishOK then
                    debugLog("SCALE_RECOVERY_OK",index,data.ItemId,oldKey,tostring(movedObject.Name),candidate,targetPoint,desiredStretch,desiredBias)
                    return true,nil,movedObject
                end
                debugLog("SCALE_RECOVERY_REMOVE_OLD_FAIL",index,data.ItemId,demolishResult,oldKey,tostring(movedObject.Name))
                return true,nil,movedObject
            end
            debugLog("SCALE_RECOVERY_MOVE_FAIL",index,data.ItemId,movedResult,candidate,targetPoint)
            if scaffold then
                destroyTemporarySupport(scaffold,"scale-recovery-support-fail:"..tostring(index)..":"..tostring(attempt))
            end
            pcall(function()
                callRouteFast("Demolish",{kind="Item",key=tostring(newObject.Name)},"scale-recovery-rollback:"..tostring(index)..":"..tostring(attempt))
            end)
        else
            if scaffold then
                destroyTemporarySupport(scaffold,"scale-recovery-place-fail:"..tostring(index)..":"..tostring(attempt))
            end
            debugLog("SCALE_RECOVERY_PLACE_FAIL",index,data.ItemId,placeError,candidate,candidateHeight)
        end
    end
    return false,"scale-recovery-failed",oldObject
end

local function relocateTemporarySupportsToCenter(targetItems,base)
    cleanupTemporarySupports("support-end-cleanup")
end

local function setArtwork(targetObject,imageId)
    imageId=tonumber(imageId)
    if not imageId or imageId<=0 then return true end
    local success=callRoute("SetItemImage",{key=tostring(targetObject.Name),image=imageId},"item:"..tostring(targetObject.Name))
    if not success then return false end
    local deadline=os.clock()+0.5
    while os.clock()<deadline do
        local value=tonumber(targetObject:GetAttribute("ArtworkImage"))
        if value==imageId then return true end
        task.wait()
    end
    debugLog("IMAGE_REPLICATION_TIMEOUT",targetObject.Name,imageId)
    return true
end

local function parseWallName(name)
    local levelString,edgeString = tostring(name):match("^(%d+)|(.+)$")
    if not levelString or not edgeString then return nil end
    local a,b = edgeString:match("^([^>]+)>([^>]+)$")
    if not a or not b then return nil end
    local ax,az = a:match("^(%-?%d+),(%-?%d+)$")
    local bx,bz = b:match("^(%-?%d+),(%-?%d+)$")
    if not ax or not az or not bx or not bz then return nil end
    return {
        level=tonumber(levelString),
        a={x=tonumber(ax),z=tonumber(az)},
        b={x=tonumber(bx),z=tonumber(bz)}
    }
end

local function wallExpectedKeys(wallName)
    local parsed = parseWallName(wallName)
    if not parsed then return {} end
    local result = {}
    local Walls
    pcall(function() Walls=require(ReplicatedStorage.Shared.Building.Walls) end)
    if Walls and Walls.unitEdges then
        local ok,edges=pcall(Walls.unitEdges,{a=parsed.a,b=parsed.b})
        if ok and type(edges)=="table" and #edges>0 and Walls.edgeKey and Walls.levelKey then
            for _,edge in ipairs(edges) do
                table.insert(result,Walls.levelKey(parsed.level,Walls.edgeKey(edge)))
            end
            return result
        end
    end
    table.insert(result,tostring(wallName))
    return result
end

local function verifyMemberKey(container,attribute,key,beforeSet)
    return B.waitForChildMatch(container,function(obj)
        return tostring(obj:GetAttribute(attribute)) == tostring(key)
    end,REPLICATION_TIMEOUT,beforeSet)
end

local function placeWall(targetWalls,wallData,index)
    local parsed=parseWallName(wallData.Name)
    if not parsed then return false,"invalid-wall-key" end
    local success,result=callRouteFast("PlaceWalls",{mode="Chain",a=parsed.a,b=parsed.b,level=parsed.level},"wall:"..tostring(wallData.Name))
    debugLogVerbose("STRUCTURE_FAST_SEND","Wall",wallData.Name,success,result)
    return success,result
end

local function parsePathKey(key)
    local a,b = tostring(key):match("^([^>]+)>([^>]+)$")
    if not a or not b then return nil end
    local ax,az=a:match("^(%-?%d+),(%-?%d+)$")
    local bx,bz=b:match("^(%-?%d+),(%-?%d+)$")
    if not ax or not az or not bx or not bz then return nil end
    return {a={x=tonumber(ax),z=tonumber(az)},b={x=tonumber(bx),z=tonumber(bz)}}
end

local function parseFloorKey(memberKey,floorData)
    local levelString,pointsString=tostring(memberKey):match("^(%d+)|(.+)$")
    if not pointsString then return nil end
    local points={}
    for pointString in pointsString:gmatch("[^>]+") do
        local x,z=pointString:match("^([^,]+),([^,]+)$")
        x=tonumber(x); z=tonumber(z)
        if not x or not z then return nil end
        table.insert(points,{x=x,z=z})
    end
    if #points < 3 then return nil end
    local level=tonumber(floorData.Level) or tonumber(levelString)
    if not level then return nil end
    return {level=level,points=points}
end

local function parseOpeningPolygon(points)
    local parts={}
    for _,p in ipairs(points or {}) do
        table.insert(parts,tostring(math.floor(tonumber(p.u) or 0)))
        table.insert(parts,tostring(math.floor(tonumber(p.v) or 0)))
    end
    return table.concat(parts,",")
end

function B.isNoScaleBurstSafe(base,data)
    if not data or not data.ItemId then return false end
    local stretch=vec3Data(data.Stretch,1,1,1)
    local bias=vec3Data(data.Bias,0,0,0)
    if stretch.x~=1 or stretch.y~=1 or stretch.z~=1 or bias.x~=0 or bias.y~=0 or bias.z~=0 then return false end
    if B.dataHeight(base,data)>0.001 then return false end
    if B.dataStand(data)~=nil or data.Surface~=nil then return false end
    if math.abs(tonumber(data.PlacePitch) or 0)>0 or math.abs(tonumber(data.PlaceRoll) or 0)>0 then return false end
    return true
end

function B.collectNoScaleBurst(pendingObjects,objectTotal,base,blocked,maxCount)
    local batch={}
    maxCount=tonumber(maxCount) or NO_SCALE_BURST_SIZE
    for index=1,objectTotal do
        if #batch>=maxCount then break end
        local data=pendingObjects[index]
        if data and not blocked[index] and B.isNoScaleBurstSafe(base,data) then
            local point=B.dataPoint(base,data)
            if point then
                batch[#batch+1]={index=index,data=data,point=point}
            else
                blocked[index]=true
            end
        end
    end
    return batch
end

function B.placeNoScaleBurst(targetItems,batch)
    if not targetItems or not batch or #batch==0 then return {},batch or {} end
    local before=B.snapshotChildren(targetItems)
    local sent={}
    local failed={}
    for i=1,#batch do
        local entry=batch[i]
        local data=entry.data
        local request={
            itemId=tostring(data.ItemId),
            point={x=entry.point.x,z=entry.point.z},
            rotation=B.dataRotation(data),
            height=0,
            surface=nil,
            stand=nil
        }
        debugLog("PLACE_BURST_SEND",entry.index,data.ItemId,entry.point)
        local ok,promise=pcall(function()
            return Net.PlaceItem.invoke(request)
        end)
        if ok and promise then
            sent[#sent+1]={entry=entry,promise=promise}
        else
            entry.error=ok and "no-promise" or promise
            failed[#failed+1]=entry
            debugLog("PLACE_BURST_SEND_FAIL",entry.index,data.ItemId,entry.error)
        end
    end
    local placed={}
    local finished=0
    local deadline=os.clock()+REQUEST_TIMEOUT+1
    for i=1,#sent do
        local slot=sent[i]
        local entry=slot.entry
        local data=entry.data
        task.spawn(function()
            local ok,result
            local done=false
            slot.promise:andThen(function(value)
                ok=true
                result=value
                done=true
            end):catch(function(err)
                ok=false
                result=err
                done=true
            end)
            local localDeadline=os.clock()+REQUEST_TIMEOUT+1
            while not done and os.clock()<localDeadline do task.wait() end
            if not done then
                entry.error="await-timeout"
                failed[#failed+1]=entry
                debugLog("PLACE_BURST_FAIL",entry.index,data.ItemId,entry.error)
            else
                local reason=ok and routePayloadReason(result) or result
                if not ok or reason then
                    entry.error=reason or "server-rejected"
                    failed[#failed+1]=entry
                    debugLog("PLACE_BURST_FAIL",entry.index,data.ItemId,entry.error)
                else
                    local serverKey=type(result)=="table" and result.key or nil
                    local object=nil
                    if serverKey~=nil then
                        object=B.waitForObjectByKey(targetItems,serverKey,NO_SCALE_BURST_REPL_TIMEOUT,before)
                    else
                        object=B.waitForPlacedObject(targetItems,data,entry.point,0,B.dataRotation(data),before,NO_SCALE_BURST_REPL_TIMEOUT)
                    end
                    if object then
                        placed[#placed+1]={entry=entry,object=object}
                        debugLog("PLACE_BURST_OK",entry.index,data.ItemId,object.Name,entry.point)
                    else
                        entry.error=serverKey and "server-ok-but-key-not-replicated" or "server-ok-but-not-replicated"
                        failed[#failed+1]=entry
                        debugLog("PLACE_BURST_REPLICATION_FAIL",entry.index,data.ItemId,serverKey,entry.point)
                    end
                end
            end
            finished+=1
        end)
    end
    while finished<#sent and os.clock()<deadline do task.wait() end
    if finished<#sent then
        for i=1,#sent do
            local entry=sent[i].entry
            local known=false
            for j=1,#placed do if placed[j].entry==entry then known=true break end end
            if not known then
                local failedKnown=false
                for j=1,#failed do if failed[j]==entry then failedKnown=true break end end
                if not failedKnown then
                    entry.error="burst-timeout"
                    failed[#failed+1]=entry
                end
            end
        end
    end
    return placed,failed
end

function B.finalizeNoScaleBurstObject(object,data,index)
    if data.Paint then applyPaint("Item",tostring(object.Name),data.Paint,"burst-item-paint:"..tostring(index)) end
    if data.ArtworkImage then setArtwork(object,data.ArtworkImage) end
    if tostring(data.ItemId)=="circuit_panel" or data.CircuitClass=="Panel" then
        if data.SourceObject then
            local ok,result=cloneCircuit(data.SourceObject,object)
            if not ok then debugLog("CIRCUIT_FAIL",index,data.ItemId,result) end
        else
            debugLog("CIRCUIT_SKIPPED_NO_SOURCE",index,data.ItemId)
        end
    end
end

function B.processLateScaleQueue(queue,targetItems,base,targetPlot)
    if not queue or #queue==0 then return end
    debugLog("LATE_SCALE_BEGIN",#queue,LATE_SCALE_BATCH_SIZE)
    local batchStart=1
    local processed=0
    while batchStart<=#queue and not stopCopy do
        local batchEnd=math.min(batchStart+LATE_SCALE_BATCH_SIZE-1,#queue)
        JmodsBuildStatus:Update("Corrección de escala","Procesando escalas pendientes",processed,#queue)
        local finished=0
        for queueIndex=batchStart,batchEnd do
            local entry=queue[queueIndex]
            task.spawn(function()
                local currentObject=entry.object
                if currentObject and currentObject.Parent then
                    local retryOK,retryObject,scaleReason=B.scaleObjectExact(targetItems,currentObject,entry.data)
                    currentObject=retryObject or currentObject
                    if retryOK then
                        local restoreOK,restoredObject,restoreReason=B.restoreSavedPlacementAfterScale(targetItems,currentObject,entry.data,entry.point,entry.height,entry.rotation,"late-restore:"..tostring(entry.index))
                        currentObject=restoredObject or currentObject
                        retryOK=restoreOK
                        scaleReason=restoreReason
                    end
                    if retryOK then
                        debugLog("LATE_SCALE_AND_POSITION_OK",entry.index,entry.data.ItemId,currentObject.Name,currentObject:GetAttribute("Stretch"),currentObject:GetAttribute("StretchBias") or currentObject:GetAttribute("Bias"))
                        if entry.data.Paint then applyPaint("Item",tostring(currentObject.Name),entry.data.Paint,"late-item-paint:"..tostring(entry.index)) end
                        if entry.data.ArtworkImage then setArtwork(currentObject,entry.data.ArtworkImage) end
                    else
                        local reason=tostring(scaleReason or "scale-failed")
                        debugLog("LATE_SCALE_FAIL",entry.index,entry.data.ItemId,reason)
                        if reason=="rate-limited" or reason=="busy" or reason=="not-verified" or reason=="timeout" then
                            task.wait(0.25)
                            local retry2OK,retry2Object=B.scaleObjectExact(targetItems,currentObject,entry.data)
                            currentObject=retry2Object or currentObject
                            if retry2OK then
                                local restore2OK,restored2Object,restore2Reason=B.restoreSavedPlacementAfterScale(targetItems,currentObject,entry.data,entry.point,entry.height,entry.rotation,"late-restore-retry:"..tostring(entry.index))
                                currentObject=restored2Object or currentObject
                                retry2OK=restore2OK
                                retry2Object=restore2Reason
                            end
                            if retry2OK then
                                debugLog("LATE_SCALE_AND_POSITION_RETRY_OK",entry.index,entry.data.ItemId,currentObject.Name)
                                if entry.data.Paint then applyPaint("Item",tostring(currentObject.Name),entry.data.Paint,"late-item-paint-retry:"..tostring(entry.index)) end
                            else
                                debugLog("LATE_SCALE_RETRY_FAIL",entry.index,entry.data.ItemId)
                            end
                        elseif reason=="out-of-bounds" or reason=="bad-scale" then
                            JmodsBuildStatus:Update("Corrección de escala","#"..tostring(entry.index).." no admite el tamaño exacto; se deja en su posición")
                        else
                            debugLog("LATE_SCALE_NO_RECOVERY",entry.index,entry.data.ItemId,reason)
                        end
                    end
                else
                    debugLog("LATE_SCALE_OBJECT_MISSING",entry.index,entry.data.ItemId)
                end
                finished+=1
            end)
        end
        while finished<(batchEnd-batchStart+1) and not stopCopy do task.wait() end
        processed=batchEnd
        batchStart=batchEnd+1
        if batchStart<=#queue then task.wait() end
    end
    JmodsBuildStatus:Update("Corrección de escala","Escalas pendientes procesadas",#queue,#queue)
    debugLog("LATE_SCALE_END",#queue)
end


function sendFastBatched(dataList,routeName,payloadBuilder,contextBuilder)
    if type(dataList)~="table" or #dataList==0 then return end
    for index,data in ipairs(dataList) do
        if stopCopy then break end
        local payload
        local okBuild,buildResult=pcall(function()
            return payloadBuilder(data,index)
        end)
        if okBuild then
            payload=buildResult
        else
            debugLog("STRUCTURE_PAYLOAD_BUILD_FAIL",routeName,index,buildResult)
            payload=nil
        end
        if payload then
            local context
            if type(contextBuilder)=="function" then
                local okContext,resultContext=pcall(contextBuilder,data,index)
                context=okContext and resultContext or (routeName..":"..tostring(index))
            else
                context=routeName..":"..tostring(index)
            end
            local sent,result=callRouteFast(routeName,payload,context)
            if not sent then
                debugLog("STRUCTURE_FAST_SEND_FAIL",routeName,index,result,context)
            end
            if index<#dataList then task.wait(0.025) end
        end
    end
end

function syncMissingMembers(container,dataList,keyBuilder,stage,payloadBuilder,contextPrefix)
    local verified={}
    if not container or type(dataList)~="table" then return verified end
    task.wait(0.22)
    for index,data in ipairs(dataList) do
        local key
        local okKey,resultKey=pcall(keyBuilder,data,index)
        if okKey then key=resultKey end
        if key~=nil then
            verified[index]=B.waitForChildMatch(container,function(obj)
                return tostring(obj:GetAttribute("MemberKey"))==tostring(key)
            end,0.35,nil)~=nil
        else
            verified[index]=false
        end
    end
    return verified
end

function syncMissingWalls(targetWalls,dataList)
    local verified={}
    if not targetWalls or type(dataList)~="table" then return verified end
    local function wallReady(data)
        local expected=wallExpectedKeys(data.Name)
        if #expected==0 then return false end
        for _,key in ipairs(expected) do
            local found=B.waitForChildMatch(targetWalls,function(obj)
                local member=tostring(obj:GetAttribute("MemberKey"))
                return member==tostring(key) or tostring(obj.Name)==tostring(key)
            end,0.35,nil)
            if not found then return false end
        end
        return true
    end
    task.wait(0.22)
    for index,data in ipairs(dataList) do verified[index]=wallReady(data) end
    return verified
end

function syncMissingOpenings(targetOpenings,dataList)
    local verified={}
    if not targetOpenings or type(dataList)~="table" then return verified end
    local function openingReady(data)
        return B.waitForChildMatch(targetOpenings,function(obj)
            return tostring(obj:GetAttribute("OpeningHost"))==tostring(data.HostKey)
        end,0.35,nil)~=nil
    end
    task.wait(0.22)
    for index,data in ipairs(dataList) do verified[index]=openingReady(data) end
    return verified
end

function applyWallPaintFast(wallData)
    if not wallData or type(wallData.Paint)~="table" then return end
    local faces=wallData.Paint.Faces
    if type(faces)~="table" then return end
    local parsed=parseWallName(wallData.Name)
    if not parsed then return end
    local Walls
    pcall(function() Walls=require(ReplicatedStorage.Shared.Building.Walls) end)
    if not Walls or not Walls.unitEdges or not Walls.edgeKey or not Walls.levelKey then return end
    local ok,edges=pcall(Walls.unitEdges,{a=parsed.a,b=parsed.b})
    if not ok or type(edges)~="table" or not edges[1] then return end
    local baseKey=Walls.levelKey(parsed.level,Walls.edgeKey(edges[1]))
    for _,face in ipairs({1,-1}) do
        local faceData=faces[face]
        if type(faceData)=="table" then
            if faceData.Panel then applyPaint("Wall",baseKey.."|"..tostring(face),faceData.Panel,"wall-panel:"..tostring(wallData.Name)..":"..tostring(face)) end
            if faceData.Trim then applyPaint("Trim",baseKey.."|"..tostring(face),faceData.Trim,"wall-trim:"..tostring(wallData.Name)..":"..tostring(face)) end
        end
    end
end

function applyFloorPaintFast(floorData)
    if not floorData or type(floorData.Paint)~="table" then return end
    local key=floorData.MemberKey
    if key==nil then return end
    local half=floorData.SlabHalf
    if half=="top" or half=="bottom" then
        pcall(function()
            applyPaint("Floor",tostring(key).."|"..half,floorData.Paint,"floor-paint:"..tostring(key)..":"..half)
        end)
    else
        pcall(function()
            applyPaint("Floor",tostring(key),floorData.Paint,"floor-paint:"..tostring(key))
        end)
    end
end

function applyRoofPaintFast(roofData)
    if not roofData or type(roofData.Paint)~="table" then return end
    local key=roofData.MemberKey
    if key==nil then return end
    local paint=roofData.Paint
    if paint.Shell then
        pcall(function()
            applyPaint("Roof",tostring(key).."|Shell",paint.Shell,"roof-shell:"..tostring(key))
        end)
    end
    if paint.Trim then
        pcall(function()
            applyPaint("Trim",tostring(key).."|Trim",paint.Trim,"roof-trim:"..tostring(key))
        end)
    end
end

function applyStairPaintFast(stairData)
    if not stairData or type(stairData.Paint)~="table" then return end
    local key=stairData.MemberKey
    if key==nil then return end
    for _,slot in ipairs({"Steps","Frame","Rail"}) do
        local paint=stairData.Paint[slot]
        if paint then
            pcall(function()
                applyPaint("Stair",tostring(key).."|"..slot,paint,"stair-paint:"..tostring(key)..":"..slot)
            end)
        end
    end
end

function applyPathPaintFast(pathData)
    if not pathData or type(pathData.Paint)~="table" then return end
    local key=pathData.MemberKey
    if key==nil then return end
    pcall(function()
        applyPaint("Path",tostring(key),pathData.Paint,"path-paint:"..tostring(key))
    end)
end

local function pasteCacheToPlotInternal(targetPlot)
    stopCopy = false
    stopDemolish = true
    cleanupTemporarySupports("copy-start-cleanup")
    temporarySupportState = {}
    if not BuildCache then
        warn("Primero usa Copiar")
        return
    end
    local totalCached = #BuildCache.Objects + #BuildCache.Walls + #BuildCache.Paths + #BuildCache.Floors + #BuildCache.Openings + #BuildCache.Stairs + #BuildCache.Roofs
    if totalCached == 0 then
        warn("El cache está vacío")
        return
    end

    local useSelectedDestination = targetPlot == nil
    local MyPlot = targetPlot or DestinationPlot
    if not MyPlot or not MyPlot.Parent then
        if useSelectedDestination then
            MyPlot = restorePlotByIds(DestinationObjectId,DestinationOwnerId)
        else
            MyPlot = restorePlotByIds(SavedPasteObjectId,SavedPasteOwnerId)
        end
    end
    if not MyPlot and useSelectedDestination then MyPlot=getMyPlot() end
    if not MyPlot then
        warn("NO HAY PLOT DE DESTINO SELECCIONADO")
        return
    end
    if useSelectedDestination then
        DestinationPlot=MyPlot
        DestinationObjectId=MyPlot:GetAttribute("ObjectId")
        DestinationOwnerId=MyPlot:GetAttribute("OwnerId")
    end

    local TargetBase=MyPlot:FindFirstChild("Base")
    local TargetContainer=MyPlot:FindFirstChild("Container")
    local TargetItems=TargetContainer and TargetContainer:FindFirstChild("Items")
    local TargetWalls=TargetContainer and TargetContainer:FindFirstChild("Walls")
    local TargetPaths=TargetContainer and TargetContainer:FindFirstChild("Paths")
    local TargetFloors=TargetContainer and TargetContainer:FindFirstChild("Floors")
    local TargetOpenings=TargetContainer and TargetContainer:FindFirstChild("Openings")
    local TargetStairs=TargetContainer and TargetContainer:FindFirstChild("Stairs")
    local TargetRoofs=TargetContainer and TargetContainer:FindFirstChild("Roofs")
    if not TargetBase or not TargetContainer then
        warn("El Plot destino no tiene Base/Container")
        return
    end

    copyRunning=true
    JmodsBuildProgress:Start(totalCached)
    debugLog("COPY_BEGIN",COPY_VERSION,MyPlot,TargetBase.Size,totalCached)

    local progressCurrent=0
    local placed=0
    local skipped=0
    local wallPlaced,wallSkipped=0,0
    local pathPlaced,pathSkipped=0,0
    local floorPlaced,floorSkipped=0,0
    local openingPlaced,openingSkipped=0,0
    local stairPlaced,stairSkipped=0,0
    local roofPlaced,roofSkipped=0,0

    local function advance(stage,index,count)
        progressCurrent+=1
        JmodsBuildProgress:Update(progressCurrent,stage,index,count,totalCached)
    end

    JmodsBuildStatus:Start("Preparando copia")

    if #BuildCache.Walls>0 and TargetWalls then
        JmodsBuildStatus:Update("Paredes","Enviando paredes rápidamente...")
        for index,wallData in ipairs(BuildCache.Walls) do
            advance("Walls",index,#BuildCache.Walls)
        end
        sendFastBatched(BuildCache.Walls,"PlaceWalls",function(data)
            local parsed=parseWallName(data.Name)
            return {mode="Chain",a=parsed.a,b=parsed.b,level=parsed.level}
        end,function(data)
            return "wall:"..tostring(data.Name)
        end)
        task.wait(0.08)
        for index,wallData in ipairs(BuildCache.Walls) do
            if stopCopy then break end
            wallPlaced+=1
            applyWallPaintFast(wallData)
        end
    else
        wallSkipped+=#BuildCache.Walls
    end

    if #BuildCache.Paths>0 and TargetPaths then
        JmodsBuildStatus:Update("Caminos","Enviando caminos rápidamente...")
        for index in ipairs(BuildCache.Paths) do
            advance("Paths",index,#BuildCache.Paths)
        end
        local validPaths={}
        for _,data in ipairs(BuildCache.Paths) do
            if parsePathKey(data.MemberKey) then validPaths[#validPaths+1]=data end
        end
        sendFastBatched(validPaths,"PlacePath",function(data)
            local path=parsePathKey(data.MemberKey)
            return {mode="Chain",a=path.a,b=path.b}
        end,function(data)
            return "path:"..tostring(data.MemberKey)
        end)
        local verified=syncMissingMembers(TargetPaths,validPaths,function(data) return data.MemberKey end,"Caminos",function(data)
            local path=parsePathKey(data.MemberKey)
            return {mode="Chain",a=path.a,b=path.b}
        end,"path")
        local verifiedByKey={}
        for index,data in ipairs(validPaths) do if verified[index] then verifiedByKey[tostring(data.MemberKey)]=true end end
        for _,data in ipairs(BuildCache.Paths) do if verifiedByKey[tostring(data.MemberKey)] then pathPlaced+=1; applyPathPaintFast(data) else pathSkipped+=1 end end
    else
        pathSkipped+=#BuildCache.Paths
    end

    if #BuildCache.Floors>0 and TargetFloors then
        JmodsBuildStatus:Update("Suelos","Enviando suelos rápidamente...")
        for index in ipairs(BuildCache.Floors) do
            advance("Floors",index,#BuildCache.Floors)
        end
        local validFloors={}
        for index,data in ipairs(BuildCache.Floors) do
            if parseFloorKey(data.MemberKey,data) then
                validFloors[#validFloors+1]=data
            end
        end
        sendFastBatched(validFloors,"PlaceFloor",function(data)
            local parsed=parseFloorKey(data.MemberKey,data)
            return {mode="Manual",points=parsed.points,level=parsed.level}
        end,function(data)
            return "floor:"..tostring(data.MemberKey)
        end)
        local verified=syncMissingMembers(TargetFloors,validFloors,function(data) return data.MemberKey end,"Suelos",function(data)
            local parsed=parseFloorKey(data.MemberKey,data)
            return {mode="Manual",points=parsed.points,level=parsed.level}
        end,"floor")
        local verifiedByKey={}
        for index,data in ipairs(validFloors) do if verified[index] then verifiedByKey[tostring(data.MemberKey)]=true end end
        for _,data in ipairs(BuildCache.Floors) do
            if verifiedByKey[tostring(data.MemberKey)] then floorPlaced+=1; applyFloorPaintFast(data) else floorSkipped+=1 end
        end
    else
        floorSkipped+=#BuildCache.Floors
    end

    if #BuildCache.Openings>0 and TargetOpenings then
        JmodsBuildStatus:Update("Aberturas","Enviando aberturas rápidamente...")
        for index in ipairs(BuildCache.Openings) do
            advance("Openings",index,#BuildCache.Openings)
        end
        sendFastBatched(BuildCache.Openings,"PlaceOpening",function(data)
            return {hostKey=data.HostKey,points=data.Points}
        end,function(data)
            return "opening:"..tostring(data.HostKey)
        end)
        local verified=syncMissingOpenings(TargetOpenings,BuildCache.Openings)
        for index in ipairs(BuildCache.Openings) do if verified[index] then openingPlaced+=1 else openingSkipped+=1 end end
    else
        openingSkipped+=#BuildCache.Openings
    end

    if #BuildCache.Stairs>0 and TargetStairs then
        JmodsBuildStatus:Update("Escaleras","Enviando escaleras rápidamente...")
        for index in ipairs(BuildCache.Stairs) do
            advance("Stairs",index,#BuildCache.Stairs)
        end
        sendFastBatched(BuildCache.Stairs,"PlaceStairs",function(data)
            return {styleId=data.styleId,points=data.points,turns=data.turns,width=data.width,rise=data.rise,depth=data.depth,rails={left=data.rails.left,right=data.rails.right},level=data.level}
        end,function(data)
            return "stairs:"..tostring(data.MemberKey)
        end)
        local verified=syncMissingMembers(TargetStairs,BuildCache.Stairs,function(data) return data.MemberKey end,"Escaleras",function(data)
            return {styleId=data.styleId,points=data.points,turns=data.turns,width=data.width,rise=data.rise,depth=data.depth,rails={left=data.rails.left,right=data.rails.right},level=data.level}
        end,"stairs")
        for index in ipairs(BuildCache.Stairs) do if verified[index] then stairPlaced+=1; applyStairPaintFast(BuildCache.Stairs[index]) else stairSkipped+=1 end end
    else
        stairSkipped+=#BuildCache.Stairs
    end

    if #BuildCache.Roofs>0 and TargetRoofs then
        JmodsBuildStatus:Update("Techos","Enviando techos rápidamente...")
        for index in ipairs(BuildCache.Roofs) do
            advance("Roofs",index,#BuildCache.Roofs)
        end
        sendFastBatched(BuildCache.Roofs,"PlaceRoof",function(data)
            local request={mode="Manual",designId=data.designId,points=data.points,height=data.height,overhang=data.overhang,level=data.level}
            if tonumber(data.axis) then request.axis=math.floor(tonumber(data.axis)) end
            return request
        end,function(data)
            return "roof:"..tostring(data.MemberKey)
        end)
        local verified=syncMissingMembers(TargetRoofs,BuildCache.Roofs,function(data) return data.MemberKey end,"Techos",function(data)
            local request={mode="Manual",designId=data.designId,points=data.points,height=data.height,overhang=data.overhang,level=data.level}
            if tonumber(data.axis) then request.axis=math.floor(tonumber(data.axis)) end
            return request
        end,"roof")
        for index,data in ipairs(BuildCache.Roofs) do if verified[index] then roofPlaced+=1; applyRoofPaintFast(data) else roofSkipped+=1 end end
    else
        roofSkipped+=#BuildCache.Roofs
    end

    JmodsBuildStatus:Update("Objetos","Estructuras sincronizadas. Iniciando objetos...")

    local pendingObjects={}
    local lateScaleQueue={}
    local noScaleBurstBlocked={}
    for index,data in ipairs(BuildCache.Objects) do pendingObjects[index]=data end

    if TargetItems then
        B.clearSupportIndex()
        B.clearSupportRaycastCache(MyPlot)
        B.initSupportIndex(TargetBase,MyPlot,TargetItems)
        local objectTotal=#BuildCache.Objects
        local completed=0
        local pass=0
        while next(pendingObjects) ~= nil and pass < OBJECT_RETRY_PASSES and not stopCopy do
            pass += 1
            local deferred={}
            local acceptedThisPass=0
            JmodsBuildStatus:Update("Objetos","Pasada "..tostring(pass).." | pendientes "..tostring(#BuildCache.Objects))
            debugLog("OBJECT_PASS_BEGIN",pass)
            while not stopCopy do
                local batch=B.collectNoScaleBurst(pendingObjects,objectTotal,TargetBase,noScaleBurstBlocked,NO_SCALE_BURST_SIZE)
                if #batch==0 then break end
                local burstPlaced,burstFailed=B.placeNoScaleBurst(TargetItems,batch)
                for _,entry in ipairs(burstFailed) do noScaleBurstBlocked[entry.index]=true end
                if #burstPlaced==0 then break end
                for _,entry in ipairs(burstPlaced) do
                    local index=entry.entry.index
                    local data=entry.entry.data
                    local placedObject=entry.object
                    B.finalizeNoScaleBurstObject(placedObject,data,index)
                    if B.objectMatchesPlacement(placedObject,data,entry.entry.point,B.dataHeight(TargetBase,data),B.dataRotation(data)) then
                        B.registerSupportObject(placedObject,entry.entry.point,B.dataHeight(TargetBase,data))
                    end
                    placed += 1
                    acceptedThisPass += 1
                    completed += 1
                    pendingObjects[index]=nil
                    progressCurrent += 1
                    JmodsBuildProgress:Update(progressCurrent,"Objects",completed,objectTotal,totalCached)
                    debugLog("OBJECT_BURST_FINALIZED",index,data.ItemId,placedObject.Name,entry.entry.point)
                end
                if #burstPlaced < #batch then
                    task.wait()
                end
            end
            local function processPendingObject(index,data)
                if stopCopy then return end
                if not data.ItemId then
                    skipped += 1
                    completed += 1
                    pendingObjects[index]=nil
                    progressCurrent += 1
                    JmodsBuildProgress:Update(progressCurrent,"Objects",completed,objectTotal,totalCached)
                    debugLog("OBJECT_SKIP_NO_ID",index)
                    return
                end
                local point=B.dataPoint(TargetBase,data)
                if not point then
                    skipped += 1
                    completed += 1
                    pendingObjects[index]=nil
                    progressCurrent += 1
                    JmodsBuildProgress:Update(progressCurrent,"Objects",completed,objectTotal,totalCached)
                    debugLog("OBJECT_SKIP_NO_POINT",index,data.ItemId)
                    return
                end
                local height=B.dataHeight(TargetBase,data)
                local rotation=B.dataRotation(data)
                local stand=B.dataStand(data)
                local placedObject=nil
                local usedPoint=point
                local usedHeight=height
                local usedAttempt=0
                local requestError=nil
                local activeTemporarySupport=nil

                for attempt=0,2 do
                    if stopCopy then break end
                    local candidate=point
                    local candidateHeight=height
                    local candidateStand=stand
                    local candidateSurface=data.Surface
                    local candidateData=data
                    if attempt>0 then
                        local wantedDistance=attempt==1 and FALLBACK_START_DISTANCE_STUDS or FALLBACK_START_SECOND_DISTANCE_STUDS
                        local support=B.makeSupportPoint(TargetBase,MyPlot,point,height,wantedDistance)
                        if support then
                            candidate=support.point
                            candidateHeight=support.height
                            candidateStand=nil
                            candidateSurface=nil
                            candidateData=table.clone(data)
                            candidateData.Surface=nil
                            candidateData.PlaceStand=nil
                            debugLog("FALLBACK_SUPPORT_FOUND",index,data.ItemId,attempt,candidate,candidateHeight,support.distance,support.part)
                        else
                            local scaffold=createTemporarySupport(TargetItems,TargetBase,MyPlot,point,height,index,wantedDistance)
                            if scaffold then
                                activeTemporarySupport=scaffold
                                candidate=scaffold.point
                                candidateHeight=scaffold.height
                                candidateStand=nil
                                candidateSurface=nil
                                candidateData=table.clone(data)
                                candidateData.Surface=nil
                                candidateData.PlaceStand=nil
                                debugLog("FALLBACK_SCAFFOLD_FOUND",index,data.ItemId,attempt,candidate,candidateHeight,scaffold.object.Name)
                            else
                                candidate=B.makeNearTargetPoint(TargetBase,point,wantedDistance)
                                candidateHeight=0
                                candidateStand=nil
                                candidateSurface=nil
                                candidateData=table.clone(data)
                                candidateData.Surface=nil
                                candidateData.PlaceStand=nil
                                debugLog("FALLBACK_SUPPORT_NOT_FOUND",index,data.ItemId,attempt,candidate,candidateHeight)
                            end
                        end
                    end
                    debugLog("OBJECT_PLACED_CANDIDATE",index,data.ItemId,attempt,candidate,candidateHeight,point,height)
                    local found,err=B.sendPlaceItemAndWait(TargetItems,candidateData,candidate,rotation,candidateHeight,candidateStand,candidateSurface,"object:"..tostring(index)..":"..tostring(data.ItemId)..":pass"..tostring(pass)..":attempt"..tostring(attempt))
                    if found then
                        placedObject=found
                        usedPoint=candidate
                        usedHeight=candidateHeight
                        usedAttempt=attempt
                        break
                    end
                    requestError=err
                    if activeTemporarySupport then
                        destroyTemporarySupport(activeTemporarySupport,"support-place-fail:"..tostring(index)..":"..tostring(attempt))
                        activeTemporarySupport=nil
                    end
                    if err ~= "unsupported" and err ~= "not supported" then
                        if attempt < 2 and (err == "server-ok-but-key-not-replicated" or err == "server-ok-but-not-replicated") then continue end
                        if err ~= "rate-limited" and err ~= "busy" then break end
                    end
                end

                if not placedObject then
                    local retryable=requestError=="rate-limited" or requestError=="busy" or requestError=="server-ok-but-key-not-replicated" or requestError=="server-ok-but-not-replicated"
                    if retryable then
                        table.insert(deferred,index)
                        debugLog("OBJECT_DEFER",index,data.ItemId,requestError,pass)
                    else
                        skipped += 1
                        completed += 1
                        pendingObjects[index]=nil
                        progressCurrent += 1
                        JmodsBuildProgress:Update(progressCurrent,"Objects",completed,objectTotal,totalCached)
                        if requestError=="unsupported" or requestError=="not supported" then
                            debugLog("OBJECT_SKIP_UNSUPPORTED",index,data.ItemId,usedPoint,point)
                        else
                            debugLog("OBJECT_FAIL_FINAL",index,data.ItemId,requestError)
                        end
                    end
                    return
                end

                local hasSourceStretch=data.Stretch~=nil
                local transformStretch=hasSourceStretch and vec3Data(data.Stretch,0,0,0) or {x=0,y=0,z=0}
                local transformBias=vec3Data(data.Bias,0,0,0)
                local scaleNeeded=transformStretch.x~=0 or transformStretch.y~=0 or transformStretch.z~=0 or transformBias.x~=0 or transformBias.y~=0 or transformBias.z~=0

                if usedAttempt>0 then
                    local movedOK,movedResult,movedObject=B.movePlacedObjectWithScaleBias(TargetItems,TargetBase,placedObject,usedPoint,point,rotation,transformStretch,transformBias,usedHeight,height)
                    if movedOK and movedObject then
                        placedObject=movedObject
                        if activeTemporarySupport then
                            destroyTemporarySupport(activeTemporarySupport,"support-used:"..tostring(index))
                            activeTemporarySupport=nil
                        end
                        debugLog("OBJECT_FALLBACK_FINALIZED",index,data.ItemId,usedAttempt,usedPoint,point,placedObject:GetAttribute("Stretch"),placedObject:GetAttribute("StretchBias") or placedObject:GetAttribute("Bias"))
                    else
                        debugLog("OBJECT_MOVE_FALLBACK_FAIL",index,data.ItemId,movedResult,usedPoint,point)
                        if activeTemporarySupport then
                            destroyTemporarySupport(activeTemporarySupport,"support-move-fail:"..tostring(index))
                            activeTemporarySupport=nil
                        end
                        local recoverOK,recoverResult,recoverObject=recoverScaleFailure(
                            TargetItems,TargetBase,MyPlot,data,placedObject,point,height,rotation,index
                        )
                        if recoverOK and recoverObject then
                            placedObject=recoverObject
                            debugLog("OBJECT_FALLBACK_RECOVERED",index,data.ItemId,recoverResult,placedObject.Name)
                        else
                            local failKey=placedObject and tostring(placedObject.Name) or nil
                            if failKey then
                                callRouteFast("Demolish",{kind="Item",key=failKey},"fallback-failed-cleanup:"..tostring(index))
                            end
                            placedObject=nil
                            requestError=tostring(movedResult or recoverResult or "fallback-failed")
                            debugLog("OBJECT_FALLBACK_RECOVERY_FAILED",index,data.ItemId,recoverResult,requestError)
                        end
                    end
                end
                if not placedObject then
                    local retryable=requestError=="rate-limited" or requestError=="busy" or requestError=="server-ok-but-key-not-replicated" or requestError=="server-ok-but-not-replicated"
                    if retryable then
                        table.insert(deferred,index)
                        debugLog("OBJECT_DEFER_FALLBACK_FAIL",index,data.ItemId,requestError,pass)
                    else
                        skipped+=1
                        completed+=1
                        pendingObjects[index]=nil
                        progressCurrent+=1
                        JmodsBuildProgress:Update(progressCurrent,"Objects",completed,objectTotal,totalCached)
                        debugLog("OBJECT_FALLBACK_SKIPPED",index,data.ItemId,requestError)
                    end
                    return
                end

                if scaleNeeded then
                    local scaleOK,scaledObject,scaleReason=B.scaleObjectExact(TargetItems,placedObject,data)
                    placedObject=scaledObject or placedObject
                    if scaleOK then
                        local restoreOK,restoredObject,restoreReason=B.restoreSavedPlacementAfterScale(TargetItems,placedObject,data,point,height,rotation,"object-restore:"..tostring(index))
                        placedObject=restoredObject or placedObject
                        scaleOK=restoreOK
                        scaleReason=restoreReason
                    end
                    if not scaleOK then
                        local reason=tostring(scaleReason or "scale-or-position-failed")
                        if reason=="out-of-bounds" or reason=="bad-scale" then
                            debugLog("OBJECT_SCALE_SKIPPED_INVALID",index,data.ItemId,reason,data.Stretch,data.Bias)
                        else
                            lateScaleQueue[#lateScaleQueue+1]={index=index,data=data,object=placedObject,point=point,height=height,rotation=rotation}
                            debugLog("OBJECT_SCALE_QUEUED",index,data.ItemId,placedObject.Name,data.Stretch,data.Bias,#lateScaleQueue,reason)
                        end
                    end
                else
                    debugLog("OBJECT_NO_SCALE",index,data.ItemId)
                end

                local pitch=tonumber(data.PlacePitch) or 0
                local roll=tonumber(data.PlaceRoll) or 0
                if pitch~=0 or roll~=0 then
                    debugLog("PITCH_ROLL_NEEDS_TRANSFORM",index,data.ItemId,pitch,roll)
                    local transformOK,transformResult=callRoute("TransformItem",{
                        key=tostring(placedObject.Name),point={x=point.x,z=point.z},height=height,rotation=rotation,
                        pitch=math.round(pitch)%ROTATION_UNITS,roll=math.round(roll)%ROTATION_UNITS,
                        stretch=transformStretch,bias=transformBias,surface=data.Surface,stand=stand
                    },"pitch-roll:"..tostring(index))
                    debugLog("PITCH_ROLL_RESULT",index,data.ItemId,pitch,roll,transformOK,transformResult)
                end

                if scaleNeeded and (pitch~=0 or roll~=0) then
                    local verifyStretch=vec3Data(data.Stretch,0,0,0)
                    local verifyBias=vec3Data(data.Bias,0,0,0)
                    if usedAttempt>0 then
                        local _,currentBias=B.readExactScaleState(placedObject,TargetBase,rotation)
                        verifyBias=currentBias
                    end
                    local verifyOK,verifyResult,verifyObject=B.applyScaleRobust(TargetItems,tostring(placedObject.Name),verifyStretch,verifyBias,"item-final-scale:"..tostring(index),SCALE_MIN_GAP)
                    if verifyOK then
                        placedObject=verifyObject or placedObject
                        debugLog("ITEM_FINAL_SCALE_VERIFIED",index,data.ItemId,verifyStretch,verifyBias,placedObject:GetAttribute("Stretch"),placedObject:GetAttribute("StretchBias") or placedObject:GetAttribute("Bias"))
                    else
                        debugLog("ITEM_FINAL_SCALE_VERIFY_FAIL",index,data.ItemId,verifyResult,verifyStretch,verifyBias)
                    end
                end

                if activeTemporarySupport then
                    destroyTemporarySupport(activeTemporarySupport,"support-finalize:"..tostring(index))
                    activeTemporarySupport=nil
                end

                if data.Paint then applyPaint("Item",tostring(placedObject.Name),data.Paint,"item-paint:"..tostring(index)) end
                if data.ArtworkImage then setArtwork(placedObject,data.ArtworkImage) end
                if tostring(data.ItemId)=="circuit_panel" or data.CircuitClass=="Panel" then
                    if data.SourceObject then
                        local circuitOK,circuitResult=cloneCircuit(data.SourceObject,placedObject)
                        if not circuitOK then debugLog("CIRCUIT_FAIL",index,data.ItemId,circuitResult) end
                    else
                        debugLog("CIRCUIT_SKIPPED_NO_SOURCE",index,data.ItemId)
                    end
                end
                if B.objectMatchesPlacement(placedObject,data,point,height,rotation) then
                    B.registerSupportObject(placedObject,point,height)
                end
                placed += 1
                acceptedThisPass += 1
                completed += 1
                pendingObjects[index]=nil
                progressCurrent += 1
                JmodsBuildProgress:Update(progressCurrent,"Objects",completed,objectTotal,totalCached)
            end
            local workerCursor=1
            local activeWorkers=0
            while not stopCopy and (workerCursor<=objectTotal or activeWorkers>0) do
                while not stopCopy and activeWorkers<OBJECT_WORKERS and workerCursor<=objectTotal do
                    local index=workerCursor
                    workerCursor+=1
                    local data=pendingObjects[index]
                    if data then
                        activeWorkers+=1
                        task.spawn(function()
                            local ok,err=xpcall(function()
                                processPendingObject(index,data)
                            end,debug.traceback)
                            if not ok then
                                debugLog("OBJECT_WORKER_ERROR",index,data.ItemId,err)
                                warn("JmodsBuildingCopier object worker:",index,err)
                            end
                            activeWorkers-=1
                        end)
                    end
                end
                if activeWorkers>0 then
                    task.wait()
                else
                    break
                end
            end
            while activeWorkers>0 do task.wait() end
            JmodsBuildStatus:Update("Objetos","Pasada "..tostring(pass).." terminada | colocados "..tostring(acceptedThisPass).." | reintentos "..tostring(#deferred))
            debugLog("OBJECT_PASS_END",pass,acceptedThisPass,#deferred)
            local hasDeferred=false
            for _,index in ipairs(deferred) do if pendingObjects[index] then hasDeferred=true end end
            if not hasDeferred then break end
            task.wait(0.1)
        end
        for index in pairs(pendingObjects) do
            skipped += 1
            completed += 1
            pendingObjects[index]=nil
            progressCurrent += 1
            JmodsBuildProgress:Update(progressCurrent,"Objects",completed,objectTotal,totalCached)
            local data=BuildCache.Objects[index]
            debugLog("OBJECT_FINAL_SKIP",index,data and data.ItemId or "?",data and data.PlaceHeight or nil,data and data.PlaceStand or nil,data and data.Surface or nil)
        end
    else
        skipped += #BuildCache.Objects
        debugLog("OBJECTS_CONTAINER_MISSING",#BuildCache.Objects)
    end

    if not stopCopy and #lateScaleQueue>0 then
        JmodsBuildStatus:Update("Corrección de escala","Quedan "..tostring(#lateScaleQueue).." objetos por corregir",0,#lateScaleQueue)
        B.processLateScaleQueue(lateScaleQueue,TargetItems,TargetBase,MyPlot)
    end

    JmodsBuildStatus:Update("Limpieza","Eliminando soportes temporales...")
    B.clearSupportIndex()
    B.clearSupportRaycastCache(MyPlot)
    cleanupTemporarySupports(stopCopy and "support-stop-cleanup" or "support-copy-end-cleanup")

    JmodsBuildStatus:Update("Finalizando","Copia finalizada. Cerrando progreso...")
    JmodsBuildStatus:Finish()

    if stopCopy then
        JmodsBuildProgress:Update(progressCurrent,"Detenida",progressCurrent,totalCached,totalCached)
        JmodsBuildProgress:Finish(true)
    else
        JmodsBuildProgress:Update(totalCached,"Completado",totalCached,totalCached,totalCached)
        JmodsBuildProgress:Finish(false)
    end
    copyRunning=false
    stopDemolish=true
    debugLog("COPY_END",MyPlot,placed,skipped,wallPlaced,wallSkipped,pathPlaced,pathSkipped,floorPlaced,floorSkipped,openingPlaced,openingSkipped,stairPlaced,stairSkipped,roofPlaced,roofSkipped)
    JmodsLib:Notify({
        Title="Construcción terminada",
        Content="Objetos: "..tostring(placed).."/"..tostring(#BuildCache.Objects).." | Walls: "..tostring(wallPlaced).." | Floors: "..tostring(floorPlaced).." | Openings: "..tostring(openingPlaced).." | Stairs: "..tostring(stairPlaced).." | Roofs: "..tostring(roofPlaced).." | Paths: "..tostring(pathPlaced).." | Omitidos: "..tostring(skipped),
        Duration=7
    })
end


local DEMOLISH_SINGLE_GAP=0.045
local DEMOLISH_BURST_SIZE=20
local DEMOLISH_BURST_GAP=0.12

local function getContainerFolder(plot,name)
    local container=plot and plot:FindFirstChild("Container")
    return container and container:FindFirstChild(name) or nil
end

local function collectDemolishKeys(folder,isItems)
    local keys={}
    local seen={}
    if not folder then return keys end
    for _,object in ipairs(folder:GetChildren()) do
        if object and object.Parent then
            local key
            if isItems then
                key=object.Name
            else
                key=object:GetAttribute("MemberKey")
                    or object:GetAttribute("OpeningKey")
                    or object:GetAttribute("OpeningHost")
                    or object.Name
            end
            key=key and tostring(key) or nil
            if key and key~="" and not seen[key] then
                seen[key]=true
                keys[#keys+1]=key
            end
        end
    end
    return keys
end

local function sendDemolishFast(kind,key,context)
    local ok,err=pcall(function()
        Net.Demolish.invoke({kind=kind,key=tostring(key)})
    end)
    if not ok then
        debugLog("DEMOLISH_SEND_ERROR",kind,key,context,err)
        return false,err
    end
    debugLogVerbose("DEMOLISH_SENT",kind,key,context)
    return true,nil
end

local function demolishAllKeysFast(kind,keys,stage,counts)
    for index,key in ipairs(keys) do
        if stopDemolish then return end
        local ok=sendDemolishFast(kind,key,"demolish:"..stage..":"..tostring(index))
        if ok then
            counts.done+=1
        else
            counts.failed+=1
            counts.done+=1
        end
        JmodsBuildProgress:Update(counts.done,stage,counts.done,counts.total,counts.total)
        if index%DEMOLISH_BURST_SIZE==0 then
            task.wait(DEMOLISH_BURST_GAP)
        else
            task.wait(DEMOLISH_SINGLE_GAP)
        end
    end
end

