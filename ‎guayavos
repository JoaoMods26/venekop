    else
        JmodsBuildProgress:Update(counts.total,"Demolición completada",counts.total,counts.total,counts.total)
        JmodsBuildProgress:Finish(false)
        debugLog("DEMOLISH_ALL_END",plot,counts)
        JmodsLib:Notify({Title="Demoler/Vender todo",Content="Solicitudes enviadas: "..tostring(counts.done).." | Errores de envío: "..tostring(counts.failed),Duration=6})
    end
    demolishRunning=false
    stopDemolish=false
    stopCopy=false
end

