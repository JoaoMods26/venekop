local Serializer = {}
local Writer = {}
Writer.__index = Writer

function Serializer.newWriter()
    return setmetatable({len=0,b=buffer.create(64)},Writer)
end

function Writer:_ensure(amount)
    local needed = self.len + amount
    local size = buffer.len(self.b)
    if size >= needed then return end
    while size < needed do size *= 2 end
    local newBuffer = buffer.create(size)
    buffer.copy(newBuffer,0,self.b,0,self.len)
    self.b = newBuffer
end

function Writer:u8(value)
    self:_ensure(1)
    buffer.writeu8(self.b,self.len,value)
    self.len += 1
end

function Writer:u32(value)
    self:_ensure(4)
    buffer.writeu32(self.b,self.len,value)
    self.len += 4
end

function Writer:f64(value)
    self:_ensure(8)
    buffer.writef64(self.b,self.len,value)
    self.len += 8
end

function Writer:str(value)
    value = tostring(value or "")
    local length = #value
    self:u32(length)
    self:_ensure(length)
    buffer.writestring(self.b,self.len,value,length)
    self.len += length
end

function Writer:finish()
    local result = buffer.create(self.len)
    buffer.copy(result,0,self.b,0,self.len)
    return result
end

local Reader = {}
Reader.__index = Reader

function Serializer.newReader(b)
    return setmetatable({off=0,b=b},Reader)
end

function Reader:_need(amount)
    if self.off + amount > buffer.len(self.b) then
        error("JmodsNet: malformed response")
    end
end

function Reader:u8()
    self:_need(1)
    local value = buffer.readu8(self.b,self.off)
    self.off += 1
    return value
end

function Reader:u32()
    self:_need(4)
    local value = buffer.readu32(self.b,self.off)
    self.off += 4
    return value
end

function Reader:f64()
    self:_need(8)
    local value = buffer.readf64(self.b,self.off)
    self.off += 8
    return value
end

function Reader:str()
    local length = self:u32()
    self:_need(length)
    local value = buffer.readstring(self.b,self.off,length)
    self.off += length
    return value
end

function Reader:remaining()
    return buffer.len(self.b) - self.off
end

 function writeValue(writer,value)
    local valueType = typeof(value)
    if value == nil then
        writer:u8(0)
        return
    end
    if valueType == "boolean" then
        writer:u8(value and 2 or 1)
        return
    end
    if valueType == "number" then
        writer:u8(3)
        writer:f64(value)
        return
    end
    if valueType == "string" then
        writer:u8(4)
        writer:str(value)
        return
    end
    if valueType ~= "table" then
        error("JmodsNet serializer unsupported type: " .. valueType)
    end
    writer:u8(5)
    local arrayCount = #value
    writer:u32(arrayCount)
    for i=1,arrayCount do
        writeValue(writer,value[i])
    end
    local hashCount = 0
    for key in value do
        if typeof(key) ~= "number" or key < 1 or key > arrayCount or key % 1 ~= 0 then
            hashCount += 1
        end
    end
    writer:u32(hashCount)
    for key,val in value do
        if typeof(key) ~= "number" or key < 1 or key > arrayCount or key % 1 ~= 0 then
            writeValue(writer,key)
            writeValue(writer,val)
        end
    end
end

 function readValue(reader,depth)
    depth = depth or 0
    if depth > 16 then error("JmodsNet response too deep") end
    local tag = reader:u8()
    if tag == 0 then return nil end
    if tag == 1 then return false end
    if tag == 2 then return true end
    if tag == 3 then return reader:f64() end
    if tag == 4 then return reader:str() end
    if tag ~= 5 then error("JmodsNet unknown tag: " .. tostring(tag)) end
    local result = {}
    local arrayCount = reader:u32()
    if arrayCount > 2048 then error("JmodsNet response array too large") end
    for i=1,arrayCount do
        result[i] = readValue(reader,depth+1)
    end
    local hashCount = reader:u32()
    if arrayCount + hashCount > 2048 then error("JmodsNet response map too large") end
    for _=1,hashCount do
        local key = readValue(reader,depth+1)
        local value = readValue(reader,depth+1)
        result[key] = value
    end
    return result
end

 function hashRoute(name)
    local hash = 5381
    for i=1,#name do
        hash = (hash * 33 + string.byte(name,i)) % 4294967296
    end
    return hash
end

