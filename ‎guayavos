function ArturosDelivery.fireHandoffPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    if not prompt.Enabled then
        local t=time()
        while ArturosDelivery.Enabled and time()-t<2 and not prompt.Enabled do task.wait(0.05) end
    end
    if not prompt.Enabled then return false end
    local hold=math.max(tonumber(prompt.HoldDuration) or 0.35,0.35)
    local fired=false
    if fireproximityprompt then
        fired=pcall(function() fireproximityprompt(prompt,hold,true) end)
        if not fired then fired=pcall(function() fireproximityprompt(prompt) end) end
    end
    if not fired and getconnections then
        pcall(function()
            local connections=getconnections(prompt.Triggered)
            if connections then
                for _,connection in ipairs(connections) do
                    pcall(function() connection:Fire() end)
                end
                fired=true
            end
        end)
    end
    return fired
end

function ArturosDelivery.invokeHandoff(orderId)
    local ok,promise=pcall(function()
        return ArturosDelivery.Net.Handoff.invoke({orderId=tonumber(orderId)})
    end)
    if not ok or not promise then return false,nil end
    local result
    local finished=false
    pcall(function()
        promise:andThen(function(r)
            result=r
            finished=true
        end):catch(function(err)
            warn("[AUTO POLLO] Handoff rechazo:",err)
            finished=true
        end)
    end)
    local t=time()
    while not finished and time()-t<5 do task.wait() end
    return finished,result
end

function ArturosDelivery.beginMovementCollisionOverride()
    if ArturosDelivery.MovementCollision then return end
    ArturosDelivery.MovementCollision=true
    ArturosDelivery.CollisionStates={}
    ArturosDelivery.PlatformStandState=nil
    ArturosDelivery.AutoRotateState=nil
    local character=LocalPlayer.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        ArturosDelivery.PlatformStandState=humanoid.PlatformStand
        ArturosDelivery.AutoRotateState=humanoid.AutoRotate
        pcall(function() humanoid.PlatformStand=true end)
        pcall(function() humanoid.AutoRotate=false end)
    end
    if not character then return end
    for _,part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            ArturosDelivery.CollisionStates[part]=part.CanCollide
            pcall(function() part.CanCollide=false end)
            pcall(function() part.AssemblyLinearVelocity=Vector3.zero end)
            pcall(function() part.AssemblyAngularVelocity=Vector3.zero end)
        end
    end
end

function ArturosDelivery.enforceMovementState()
    if not ArturosDelivery.MovementCollision then return end
    local character=LocalPlayer.Character
    if not character then return end
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function() humanoid.PlatformStand=true end)
        pcall(function() humanoid.AutoRotate=false end)
    end
    for _,part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if ArturosDelivery.CollisionStates[part]==nil then
                ArturosDelivery.CollisionStates[part]=part.CanCollide
            end
            pcall(function() part.CanCollide=false end)
            pcall(function() part.AssemblyLinearVelocity=Vector3.zero end)
            pcall(function() part.AssemblyAngularVelocity=Vector3.zero end)
        end
    end
end

function ArturosDelivery.restoreMovementCollisionOverride()
    if not ArturosDelivery.MovementCollision then return end
    local character=LocalPlayer.Character
    if character then
        for part,original in pairs(ArturosDelivery.CollisionStates) do
            if part and part.Parent and part:IsA("BasePart") then
                pcall(function() part.CanCollide=original end)
            end
        end
        local humanoid=character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if ArturosDelivery.PlatformStandState~=nil then pcall(function() humanoid.PlatformStand=ArturosDelivery.PlatformStandState end) end
            if ArturosDelivery.AutoRotateState~=nil then pcall(function() humanoid.AutoRotate=ArturosDelivery.AutoRotateState end) end
        end
    end
    ArturosDelivery.CollisionStates={}
    ArturosDelivery.PlatformStandState=nil
    ArturosDelivery.AutoRotateState=nil
    ArturosDelivery.MovementCollision=false
end

