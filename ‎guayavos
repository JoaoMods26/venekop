 function makePromise()
    local promise = {
        state = "pending",
        value = nil,
        successCallbacks = {},
        failureCallbacks = {},
        finallyCallbacks = {}
    }

    function promise:resolve(value)
        if self.state ~= "pending" then return end
        self.state = "resolved"
        self.value = value
        for _,callback in ipairs(self.successCallbacks) do task.spawn(callback,value) end
        for _,callback in ipairs(self.finallyCallbacks) do task.spawn(callback) end
        table.clear(self.successCallbacks)
        table.clear(self.failureCallbacks)
        table.clear(self.finallyCallbacks)
    end

    function promise:reject(value)
        if self.state ~= "pending" then return end
        self.state = "rejected"
        self.value = value
        for _,callback in ipairs(self.failureCallbacks) do task.spawn(callback,value) end
        for _,callback in ipairs(self.finallyCallbacks) do task.spawn(callback) end
        table.clear(self.successCallbacks)
        table.clear(self.failureCallbacks)
        table.clear(self.finallyCallbacks)
    end

    function promise:andThen(callback)
        if type(callback) ~= "function" then return self end
        if self.state == "resolved" then
            task.spawn(callback,self.value)
        elseif self.state == "pending" then
            table.insert(self.successCallbacks,callback)
        end
        return self
    end

    function promise:catch(callback)
        if type(callback) ~= "function" then return self end
        if self.state == "rejected" then
            task.spawn(callback,self.value)
        elseif self.state == "pending" then
            table.insert(self.failureCallbacks,callback)
        end
        return self
    end

    function promise:finally(callback)
        if type(callback) ~= "function" then return self end
        if self.state == "pending" then
            table.insert(self.finallyCallbacks,callback)
        else
            task.spawn(callback)
        end
        return self
    end

    return promise
end

local function handleNetPacket(packet)
    if typeof(packet) ~= "buffer" then return end
    local ok,err = pcall(function()
        local reader = Serializer.newReader(packet)
        local kind = reader:u8()
        if kind ~= 2 then return end
        local id = reader:u32()
        local success = reader:u8() == 1
        local payload = readValue(reader,0)
        if reader:remaining() ~= 0 then
            error("JmodsNet: response had trailing bytes")
        end
        local promise = pendingRequests[id]
        if not promise then
            debugLogVerbose("NET_RESPONSE_ORPHAN",id,success,payload)
            return
        end
        pendingRequests[id] = nil
        debugLogVerbose("NET_RESPONSE",id,success,payload)
        if success then promise:resolve(payload) else promise:reject(payload) end
    end)
    if not ok then
        debugLog("NET_RESPONSE_PARSE_ERROR",err)
    end
end

if Replication then
    Replication.OnClientEvent:Connect(handleNetPacket)
end
if ReplicationFast then
    ReplicationFast.OnClientEvent:Connect(handleNetPacket)
