 function waitForVehicleSeat(timeout)
    timeout = timeout or CourierConfig.VehicleSeatTimeout

    local start = tick()

    while tick() - start < timeout do
        if not CourierConfig.Enabled then
            return nil
        end

        local _, hum = getCourierCharacterParts()

        if hum and hum.Health > 0 and hum.Sit and hum.SeatPart then
            return hum.SeatPart
        end

        RunService.Heartbeat:Wait()
    end

    return nil
end

 function getVehiclePartFromSeat(seat)
    if not seat then
        return nil
    end

    local vehicleModel = seat:FindFirstAncestorOfClass("Model")

    return (vehicleModel and vehicleModel.PrimaryPart) or seat
end

local courierVehicleMaintainConn = nil

 function setVehicleNoclipAndAnchor(vehicleModel, enable)
    if not vehicleModel then
        return
    end

    for _, part in ipairs(vehicleModel:GetDescendants()) do
        if part:IsA("BasePart") then
            if enable then
                if courierState.originalCollide[part] == nil then
                    courierState.originalCollide[part] = part.CanCollide
                end

                if courierState.originalAnchored[part] == nil then
                    courierState.originalAnchored[part] = part.Anchored
                end

                part.CanCollide = false

                if part ~= courierState.currentSeat then
                    part.Anchored = courierState.originalAnchored[part] or false
                end
            else
                local origCollide = courierState.originalCollide[part]
                local origAnchored = courierState.originalAnchored[part]

                pcall(function()
                    part.CanCollide = (origCollide == nil) and true or origCollide

                    if part ~= courierState.currentSeat then
                        part.Anchored = (origAnchored == nil) and false or origAnchored
                    end
                end)
            end
        end
    end

    if enable then
        if courierVehicleMaintainConn then
            courierVehicleMaintainConn:Disconnect()
            courierVehicleMaintainConn = nil
        end

        courierVehicleMaintainConn = RunService.Heartbeat:Connect(function()
            if not vehicleModel.Parent then
                return
            end

            for part in pairs(courierState.originalCollide) do
                if part and part.Parent and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)

        vehicleModel.DescendantAdded:Connect(function(newPart)
            if not CourierConfig.Enabled then
                return
            end

            if newPart:IsA("BasePart") then
                task.defer(function()
                    if not newPart.Parent then
                        return
                    end

                    if courierState.originalCollide[newPart] == nil then
                        courierState.originalCollide[newPart] = newPart.CanCollide
                    end

                    if courierState.originalAnchored[newPart] == nil then
                        courierState.originalAnchored[newPart] = newPart.Anchored
                    end

                    newPart.CanCollide = false
                end)
            end
        end)
    else
        if courierVehicleMaintainConn then
            courierVehicleMaintainConn:Disconnect()
            courierVehicleMaintainConn = nil
        end

        courierState.originalCollide = {}
        courierState.originalAnchored = {}
    end
end

local courierWorldMaintainConn = nil
local courierWorldDescendantConn = nil

 function setWorldCollision(enable)
    if enable then
        if courierState.worldNoclipApplied then
            return
        end

        courierState.worldNoclipApplied = true

         function shouldSkip(obj)
            if LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character) then
                return true
            end

            if courierState.vehicleModel and obj:IsDescendantOf(courierState.vehicleModel) then
                return true
            end

            return false
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not shouldSkip(obj) then
                pcall(function()
                    if obj.CanCollide then
                        courierState.originalWorldCollisions[obj] = true
                        obj.CanCollide = false
                    end
                end)
            end
        end

        if courierWorldMaintainConn then
            pcall(function()
                task.cancel(courierWorldMaintainConn)
            end)

            courierWorldMaintainConn = nil
        end

        courierWorldMaintainConn = task.spawn(function()
            while courierState.worldNoclipApplied and CourierConfig.Enabled do
                for part in pairs(courierState.originalWorldCollisions) do
                    if part and part.Parent then
                        if part.CanCollide then
                            pcall(function()
                                part.CanCollide = false
                            end)
                        end
                    else
                        courierState.originalWorldCollisions[part] = nil
                    end
                end

                task.wait(0.5)
            end
        end)

        if courierWorldDescendantConn then
            courierWorldDescendantConn:Disconnect()
            courierWorldDescendantConn = nil
        end

        courierWorldDescendantConn = workspace.DescendantAdded:Connect(function(obj)
            if not courierState.worldNoclipApplied then
                return
            end

            if not obj:IsA("BasePart") then
                return
            end

            task.defer(function()
                if not obj.Parent then
                    return
                end

                if shouldSkip(obj) then
                    return
                end

                pcall(function()
                    if obj.CanCollide then
                        courierState.originalWorldCollisions[obj] = true
                        obj.CanCollide = false
                    end
                end)
            end)
        end)
    else
        courierState.worldNoclipApplied = false

        if courierWorldMaintainConn then
            pcall(function()
                task.cancel(courierWorldMaintainConn)
            end)

            courierWorldMaintainConn = nil
        end

        if courierWorldDescendantConn then
            courierWorldDescendantConn:Disconnect()
            courierWorldDescendantConn = nil
        end

        for part in pairs(courierState.originalWorldCollisions) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide = true
                end)
            end
        end

        courierState.originalWorldCollisions = {}
    end
end

 function findNearestWorkAuraRing(fromPos)
    local nearest, nearestDist = nil, math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "WorkAuraRing" then
            local pos

            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") then
                local ok, pivot = pcall(function()
                    return obj:GetPivot()
                end)

                if ok then
                    pos = pivot.Position
                end
            end

            if pos then
                local dist = (pos - fromPos).Magnitude

                if dist < nearestDist then
                    nearest = obj
                    nearestDist = dist
                end
            end
        end
    end

    return nearest, nearestDist
end

 function startCourierDrive(vehiclePart, vehicleModel)
    if courierDriveConn then
        courierDriveConn:Disconnect()
        courierDriveConn = nil
    end

    if not vehiclePart or not vehiclePart.Parent then
        return
    end

    setVehicleNoclipAndAnchor(vehicleModel, true)

    local driveHeight = vehiclePart.Position.Y

    local driveLook = vehiclePart.CFrame.LookVector
    local currentLook = Vector3.new(driveLook.X, 0, driveLook.Z)

    if currentLook.Magnitude < 0.001 then
        currentLook = Vector3.new(0, 0, -1)
    else
        currentLook = currentLook.Unit
    end

    local currentSpeed = 0

    courierDriveConn = RunService.Heartbeat:Connect(function(dt)
        if not CourierConfig.Enabled or courierState.paused then
            if vehiclePart and vehiclePart.Parent then
                pcall(function()
                    vehiclePart.AssemblyLinearVelocity = Vector3.zero
                    vehiclePart.AssemblyAngularVelocity = Vector3.zero
                end)
            end

            currentSpeed = 0
            return
        end

        if not vehiclePart or not vehiclePart.Parent then
            return
        end

        local currentPos = vehiclePart.Position
        local horizontal = Vector3.zero
        local hasTarget = false

        if courierTargetPos then
            local diff = courierTargetPos - currentPos
            horizontal = Vector3.new(diff.X, 0, diff.Z)
            hasTarget = horizontal.Magnitude > CourierConfig.ArriveDistance
        end

        local targetSpeed = 0

        if hasTarget then
            local desiredDir = horizontal.Unit
            local turnAlpha = math.clamp(CourierConfig.TurnSmoothness * dt, 0, 1)
            local newLook = currentLook:Lerp(desiredDir, turnAlpha)

            if newLook.Magnitude > 0.001 then
                currentLook = newLook.Unit
            end

            targetSpeed = CourierConfig.DriveSpeed
        end

        local accelAlpha = math.clamp(CourierConfig.Acceleration * dt, 0, 1)
        currentSpeed = currentSpeed + (targetSpeed - currentSpeed) * accelAlpha

        pcall(function()
            vehiclePart.AssemblyLinearVelocity = Vector3.new(
                currentLook.X * currentSpeed,
                0,
                currentLook.Z * currentSpeed
            )
        end)

        pcall(function()
            local pos = vehiclePart.Position
            local fixedPos = Vector3.new(pos.X, driveHeight, pos.Z)

            vehiclePart.CFrame = CFrame.lookAt(
                fixedPos,
                fixedPos + currentLook
            )

            vehiclePart.AssemblyAngularVelocity = Vector3.zero
        end)

        local _, hum, hrp = getCourierCharacterParts()

        if hum and hum.Health > 0 and courierState.currentSeat then
            if not hum.Sit then
                hum.Sit = true
            end

            if hum.SeatPart ~= courierState.currentSeat and courierState.currentSeat.Parent then
                pcall(function()
                    courierState.currentSeat:Sit(hum)
                end)
            end

            if hrp and courierState.seatOffset and courierState.currentSeat.Parent then
                pcall(function()
                    hrp.CFrame = courierState.currentSeat.CFrame * courierState.seatOffset
                end)
            end
        end
    end)
end

 function stopCourierDrive()
    if courierDriveConn then
        courierDriveConn:Disconnect()
        courierDriveConn = nil
    end

    if courierState.vehicleModel then
        setVehicleNoclipAndAnchor(courierState.vehicleModel, false)
    end

    courierState.vehicleModel = nil
    courierState.vehiclePart = nil
end

 function prepareCourierVehicleState(seat)
    if not seat then
        return nil
    end

    local _, _, hrp = getCourierCharacterParts()

    local vehiclePart = getVehiclePartFromSeat(seat)
    local vehicleModel = seat:FindFirstAncestorOfClass("Model")

    if not vehiclePart or not vehiclePart.Parent then
        return nil
    end

    courierState.currentSeat = seat
    courierState.vehiclePart = vehiclePart
    courierState.vehicleModel = vehicleModel
    courierState.inVehicle = true

    if hrp and seat.Parent then
        courierState.seatOffset = seat.CFrame:ToObjectSpace(hrp.CFrame)
    else
        courierState.seatOffset = nil
    end

    setWorldCollision(true)
    startCourierDrive(vehiclePart, vehicleModel)

    return seat
end

 function forceInitialPromptRetry()
    local _, hum, hrp = getCourierCharacterParts()

    if not hrp or not hum or hum.Health <= 0 then
        return nil
    end

    if (hrp.Position - CourierConfig.InitialPosition).Magnitude > CourierConfig.InitialNearDistance then
        pcall(function()
            NoclipSystem:RequestAuto()
        end)

        TeleportSystem:Teleport(CourierConfig.InitialPosition)

        pcall(function()
            NoclipSystem:ReleaseAuto()
        end)

        RunService.Heartbeat:Wait()
    end

    removeCourierPromptCooldowns()
    activateCourierNearbyPrompts()

    local seat = waitForVehicleSeat(CourierConfig.VehicleSeatTimeout)

    if seat then
        return seat
    end

    for attempt = 1, CourierConfig.InitialRecoveryAttempts do
        if not CourierConfig.Enabled then
            return nil
        end

        _, hum, hrp = getCourierCharacterParts()

        if not hrp or not hum or hum.Health <= 0 then
            return nil
        end

        removeCourierPromptCooldowns()

        local look = hrp.CFrame.LookVector
        local forward = Vector3.new(look.X, 0, look.Z)

        if forward.Magnitude < 0.001 then
            forward = Vector3.new(0, 0, -1)
        else
            forward = forward.Unit
        end

        local offsetPosition =
            CourierConfig.InitialPosition
            + forward * CourierConfig.InitialRecoveryOffset

        pcall(function()
            NoclipSystem:RequestAuto()
        end)

        TeleportSystem:Teleport(offsetPosition)
        TeleportSystem:Teleport(CourierConfig.InitialPosition)

        pcall(function()
            NoclipSystem:ReleaseAuto()
        end)

        RunService.Heartbeat:Wait()

        removeCourierPromptCooldowns()
        activateCourierNearbyPrompts()

        seat = waitForVehicleSeat(CourierConfig.VehicleSeatTimeout)

        if seat then
            return seat
        end
    end

    return nil
end

 function courierResetAfterInitialTimeout()
    if courierState.resetInProgress or not CourierConfig.Enabled then
        return false
    end

    courierState.resetInProgress = true
    courierState.initialStuckSince = nil

    clearCourierTarget()
    stopCourierDrive()
    setWorldCollision(false)

    courierState.inVehicle = false
    courierState.currentSeat = nil
    courierState.vehiclePart = nil
    courierState.vehicleModel = nil
    courierState.seatOffset = nil
    courierMountInProgress = false

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if hum and hum.Health > 0 then
        pcall(function()
            hum.Health = 0
        end)
    end

    task.spawn(function()
        local newChar = LocalPlayer.CharacterAdded:Wait()
        if newChar then
            clearCourierTarget()
            courierState.inVehicle = false
            courierState.currentSeat = nil
            courierState.vehiclePart = nil
            courierState.vehicleModel = nil
            courierState.seatOffset = nil
            courierState.initialStuckSince = nil

            local newHum = newChar:WaitForChild("Humanoid", 5)
            if newHum and CourierConfig.Enabled then
                removeCourierPromptCooldowns()
            end
            courierMountInProgress = false
            courierState.resetInProgress = false
        else
            courierState.resetInProgress = false
        end
    end)

    return true
end

 function courierRecoverToVehicle()
    if courierMountInProgress then
        return false
    end

    if not courierState.initialStuckSince then
        courierState.initialStuckSince = tick()
    end

    if tick() - courierState.initialStuckSince >= CourierConfig.InitialWorkTimeout then
        courierResetAfterInitialTimeout()
        return false
    end

    courierMountInProgress = true
    courierState.currentTask = "Recuperando: volviendo al vehiculo"

    stopCourierDrive()
    setWorldCollision(false)

    clearCourierTarget()

    removeCourierPromptCooldowns()
    local seat = forceInitialPromptRetry()

    if seat then
        prepareCourierVehicleState(seat)

        courierState.initialStuckSince = nil
        courierState.consecutiveFailedRecoveries = 0
        courierState.currentTask = "Repartiendo"
        courierMountInProgress = false

        return true
    end

    courierMountInProgress = false

    courierState.inVehicle = false
    courierState.currentSeat = nil
    courierState.vehiclePart = nil
    courierState.vehicleModel = nil
    courierState.seatOffset = nil

    courierState.consecutiveFailedRecoveries += 1

    local now = tick()

    if now - courierState.lastRecoveryTime > CourierRecoveryConfig.FailureWindowSeconds then
        courierState.consecutiveFailedRecoveries = 1
    end

    courierState.lastRecoveryTime = now

    if courierState.consecutiveFailedRecoveries >= CourierRecoveryConfig.MaxConsecutiveFailures then
        courierState.consecutiveFailedRecoveries = 0

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hum then
            pcall(function()
                hum.Health = 0
            end)
        end
    end

    return false
end

local courierWatchdogActive = false

 function isCourierStillSeated()
    local _, hum = getCourierCharacterParts()

    if not hum or hum.Health <= 0 then
        return false
    end

    if not hum.Sit then
        return false
    end

    if courierState.currentSeat and hum.SeatPart ~= courierState.currentSeat then
        return false
    end

    return true
end

 function startCourierWatchdog()
    if courierWatchdogActive then
        return
    end

    courierWatchdogActive = true

    task.spawn(function()
        while CourierConfig.Enabled and courierWatchdogActive do
            task.wait(0.25)

            if not CourierConfig.Enabled or courierState.paused then
                continue
            end

            local _, hum, hrp = getCourierCharacterParts()

            if not hum or not hrp or hum.Health <= 0 then
                clearCourierTarget()

                courierState.inVehicle = false
                courierState.currentSeat = nil
                courierState.vehiclePart = nil
                courierState.vehicleModel = nil
                courierState.seatOffset = nil

                continue
            end

            if courierState.inVehicle and not isCourierStillSeated() then
                if not courierState.initialStuckSince then
                    courierState.initialStuckSince = tick()
                end
                courierRecoverToVehicle()
            elseif not courierState.inVehicle then
                if not courierState.initialStuckSince then
                    courierState.initialStuckSince = tick()
                end
                courierRecoverToVehicle()
            else
                courierState.initialStuckSince = nil
            end
        end
    end)
end

 function stopCourierWatchdog()
    courierWatchdogActive = false
end

 function courierMainLoop()
    bindCourierCharacterWatcher()
    clearCourierTarget()

    courierState.currentTask = "Yendo al punto inicial"

    local seat = forceInitialPromptRetry()

    if not CourierConfig.Enabled then
        return
    end

    if not seat then
        courierState.currentTask = "No se pudo montar"
        CourierConfig.Enabled = false
        return
    end

    if not prepareCourierVehicleState(seat) then
        courierState.currentTask = "No se pudo preparar vehiculo"
        CourierConfig.Enabled = false
        return
    end

    courierState.consecutiveFailedRecoveries = 0
    courierState.initialStuckSince = nil

    startCourierWatchdog()

    while CourierConfig.Enabled do
        if courierState.paused then
            RunService.Heartbeat:Wait()
            continue
        end

        if courierState.resetInProgress then
            RunService.Heartbeat:Wait()
            continue
        end

        local _, hum, hrp = getCourierCharacterParts()

        if not hum or not hrp or hum.Health <= 0 then
            clearCourierTarget()

            courierState.inVehicle = false
            courierState.currentSeat = nil

            RunService.Heartbeat:Wait()
            continue
        end

        if not courierState.inVehicle or not isCourierStillSeated() then
            if not courierState.initialStuckSince then
                courierState.initialStuckSince = tick()
            end
            courierRecoverToVehicle()

            RunService.Heartbeat:Wait()
            continue
        end

        courierState.initialStuckSince = nil

        local vehiclePart = courierState.vehiclePart

        if not vehiclePart or not vehiclePart.Parent then
            courierState.inVehicle = false
            if not courierState.initialStuckSince then
                courierState.initialStuckSince = tick()
            end
            courierRecoverToVehicle()

            RunService.Heartbeat:Wait()
            continue
        end

        local fromPos = vehiclePart.Position
        local ring, dist = findNearestWorkAuraRing(fromPos)

        if ring then
            local ringPos

            if ring:IsA("BasePart") then
                ringPos = ring.Position
            else
                local ok, pivot = pcall(function()
                    return ring:GetPivot()
                end)

                if ok then
                    ringPos = pivot.Position
                end
            end

            if ringPos then
                courierTargetPos = ringPos
                courierState.currentTask =
                    "Yendo a WorkAuraRing (" .. math.floor(dist) .. " studs)"

                if dist <= CourierConfig.ArriveDistance then
                    courierState.currentTask = "Entregando"

                    pcall(function()
                        vehiclePart.AssemblyLinearVelocity = Vector3.zero
                    end)
                end
            end
        else
            courierTargetPos = CourierConfig.InitialPosition
            courierState.currentTask =
                "Sin entregas, volviendo al punto inicial"
        end

        task.wait(CourierConfig.RingScanInterval)
    end

    stopCourierWatchdog()
    clearCourierTarget()
    stopCourierDrive()

    courierState.inVehicle = false
    courierState.currentSeat = nil
    courierState.currentTask = "Inactivo"

    stopCourierPromptNoCooldown()
end

 function startCourier()
    if CourierConfig.Enabled then
        return
    end

    CourierConfig.Enabled = true
    courierState.paused = false
    courierState.consecutiveFailedRecoveries = 0
    courierState.lastRecoveryTime = 0
    courierState.initialStuckSince = nil
    courierState.resetInProgress = false
    courierMountInProgress = false

    startCourierPromptNoCooldown()

    task.spawn(function()
        local ok, err = pcall(courierMainLoop)

        if not ok then
            warn("❌ Error en Repartidor:", err)
            stopCourierDrive()
            setWorldCollision(false)
            courierState.inVehicle = false
        end
    end)
end

 function stopCourier()
    CourierConfig.Enabled = false
    courierState.paused = false
    courierMountInProgress = false
    courierState.initialStuckSince = nil
    courierState.resetInProgress = false

