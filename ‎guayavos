function B.snapshotChildren(container)
    local set = {}
    if not container then return set end
    for _,child in ipairs(container:GetChildren()) do set[child] = true end
    return set
end

function B.waitForChildMatch(container,matcher,timeout,beforeSet)
    if not container then return nil end
    timeout = timeout or REPLICATION_TIMEOUT
    beforeSet = beforeSet or {}
    local found = nil
    local connection
    local deadline = os.clock() + timeout
    local function test(child)
        if found or beforeSet[child] then return end
        local ok,result = pcall(matcher,child)
        if ok and result then found = child end
    end
    for _,child in ipairs(container:GetChildren()) do
        test(child)
        if found then break end
    end
    if not found then
        connection = container.ChildAdded:Connect(function(child) test(child) end)
        while not found and os.clock() < deadline do task.wait(0.02) end
    end
    if connection then connection:Disconnect() end
    return found
end

function B.waitForObjectByKey(targetItems,key,timeout,beforeSet)
    if not targetItems or key == nil then return nil end
    local wanted = tostring(key)
    beforeSet = beforeSet or {}
    local current = targetItems:FindFirstChild(wanted)
    if current and not beforeSet[current] then return current end
    return B.waitForChildMatch(targetItems,function(obj)
        return tostring(obj.Name) == wanted
    end,timeout or OBJECT_REPLICATION_TIMEOUT,beforeSet)
end

function B.pointEquals(a,b)
    if typeof(a) == "Vector2" then
        return math.abs(a.X - b.x) < 0.5 and math.abs(a.Y - b.z) < 0.5
    end
    if type(a) == "table" then
        local x = tonumber(a.x) or tonumber(a.X)
        local z = tonumber(a.z) or tonumber(a.Z)
        return x ~= nil and z ~= nil and math.abs(x-b.x) < 0.5 and math.abs(z-b.z) < 0.5
    end
    return false
end

function B.objectMatchesPlacement(object,data,point,height,rotation)
    if not object then return false end
    if tostring(object:GetAttribute("ItemId")) ~= tostring(data.ItemId) then return false end
    local storedPoint = object:GetAttribute("PlacePoint")
    if storedPoint ~= nil and not B.pointEquals(storedPoint,point) then return false end
    local storedHeight = tonumber(object:GetAttribute("PlaceHeight"))
    if storedHeight ~= nil and math.abs(storedHeight - height) > 0.08 then return false end
    local storedRotation = tonumber(object:GetAttribute("PlaceRotation"))
    if storedRotation ~= nil and math.abs(storedRotation - rotation) > 1 then return false end
    return true
end

function B.waitForPlacedObject(targetItems,itemData,point,height,rotation,beforeItems,timeout)
    return B.waitForChildMatch(targetItems,function(obj)
        return B.objectMatchesPlacement(obj,itemData,point,height,rotation)
    end,timeout or OBJECT_REPLICATION_TIMEOUT,beforeItems)
end

