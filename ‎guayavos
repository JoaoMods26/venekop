end

function ArturosDelivery.getGiverApproachPosition(targetPosition)
    return targetPosition+Vector3.new(0,2.5,0)
end

function ArturosDelivery.moveToGiver(position,id)
    local root=getCleanRoot()
    if not root then return false end
    local target=ArturosDelivery.getGiverApproachPosition(position)
    local offset=root.Position-target
    local horizontal=Vector3.new(offset.X,0,offset.Z)
    local distance=horizontal.Magnitude
    local safeDistance=math.max(2,tonumber(ArturosDelivery.GiverApproachDistance) or 40)
    if distance>safeDistance then
        local away=horizontal.Unit
        local safePoint=Vector3.new(target.X+away.X*safeDistance,target.Y,target.Z+away.Z*safeDistance)
        if not ArturosDelivery.moveFastTo(safePoint,id,false) then return false end
    end
    return ArturosDelivery.moveGradualTo(target,id,120,false)
end

function ArturosDelivery.moveGradualTo(targetPosition,id,timeout,keepOverride)
    local root=getCleanRoot()
    if not root then return false end
    ArturosDelivery.beginMovementCollisionOverride()
    local target=targetPosition
    local started=time()
    local speed=math.max(1,tonumber(ArturosDelivery.MoveSpeed) or 30)
    while ArturosDelivery.running(id) and time()-started<(timeout or 120) do
        root=getCleanRoot()
        if not root then
            ArturosDelivery.restoreMovementCollisionOverride()
            return false
        end
        ArturosDelivery.enforceMovementState()
        local current=root.Position
        local delta=target-current
        local distance=delta.Magnitude
        if distance<=1.05 then
            pcall(function()
                root.AssemblyLinearVelocity=Vector3.zero
                root.AssemblyAngularVelocity=Vector3.zero
                root.CFrame=CFrame.lookAt(target,target+Vector3.new(0,0,-1))
            end)
            if not keepOverride then ArturosDelivery.restoreMovementCollisionOverride() end
            return true
        end
        local dt=RunService.Heartbeat:Wait()
        if not ArturosDelivery.running(id) then
            ArturosDelivery.restoreMovementCollisionOverride()
            return false
        end
        ArturosDelivery.enforceMovementState()
        root=getCleanRoot()
        if not root then
            ArturosDelivery.restoreMovementCollisionOverride()
            return false
        end
        local currentNow=root.Position
        local deltaNow=target-currentNow
        local distanceNow=deltaNow.Magnitude
        if distanceNow<=1.05 then
            pcall(function()
                root.AssemblyLinearVelocity=Vector3.zero
                root.AssemblyAngularVelocity=Vector3.zero
                root.CFrame=CFrame.lookAt(target,target+Vector3.new(0,0,-1))
            end)
            if not keepOverride then ArturosDelivery.restoreMovementCollisionOverride() end
            return true
        end
        local step=math.min(distanceNow,speed*math.max(dt,1/240))
        local direction=deltaNow.Unit
        local nextPosition=currentNow+direction*step
        if step>=distanceNow then nextPosition=target end
        pcall(function()
            root.AssemblyLinearVelocity=Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
            root.CFrame=CFrame.lookAt(nextPosition,nextPosition+direction)
        end)
    end
    root=getCleanRoot()
    local success=ArturosDelivery.running(id) and root and (root.Position-target).Magnitude<=1.5
    if not keepOverride or not success then ArturosDelivery.restoreMovementCollisionOverride() end
    return success
end

function ArturosDelivery.walkTo(position,id,keepOverride)
    local target=ArturosDelivery.getApproachPosition(position,3.75)
    pcall(function() GradualMoveSystem:Stop() end)
    return ArturosDelivery.moveGradualTo(target,id,180,keepOverride)
end

function ArturosDelivery.moveFastTo(position,id,keepOverride)
    local root=getCleanRoot()
    if not root then return false end
    local oldSpeed=ArturosDelivery.MoveSpeed
    ArturosDelivery.MoveSpeed=math.max(oldSpeed,tonumber(ArturosDelivery.FastMoveSpeed) or 120)
    local ok=ArturosDelivery.moveGradualTo(position,id,60,keepOverride)
    ArturosDelivery.MoveSpeed=oldSpeed
    return ok
end

function ArturosDelivery.moveToSafeStart(target,id,keepOverride)
    local root=getCleanRoot()
    if not root then return false end
    local approach=ArturosDelivery.getApproachPosition(target,0)
    local offset=root.Position-approach
    local away=Vector3.new(offset.X,0,offset.Z)
    if away.Magnitude<0.1 then
        local look=root.CFrame.LookVector
        away=Vector3.new(look.X,0,look.Z)
    end
    if away.Magnitude<0.1 then away=Vector3.new(1,0,0) end
    away=away.Unit
    local safeDistance=math.max(1,tonumber(ArturosDelivery.RetreatDistance) or 50)
    local safePoint=Vector3.new(approach.X+away.X*safeDistance,approach.Y,approach.Z+away.Z*safeDistance)
    return ArturosDelivery.moveFastTo(safePoint,id,keepOverride)
end

function ArturosDelivery.moveAwayFromGiver(position,id)
    local root=getCleanRoot()
    if not root then return false end
    local approach=ArturosDelivery.getApproachPosition(position,0)
    local offset=root.Position-approach
    local away=Vector3.new(offset.X,0,offset.Z)
    if away.Magnitude<0.1 then
        local look=root.CFrame.LookVector
        away=Vector3.new(look.X,0,look.Z)
    end
    if away.Magnitude<0.1 then away=Vector3.new(1,0,0) end
    away=away.Unit
    local distance=math.max(1,tonumber(ArturosDelivery.GiverRecoveryDistance) or 30)
    local safePoint=Vector3.new(approach.X+away.X*distance,approach.Y,approach.Z+away.Z*distance)
    return ArturosDelivery.moveFastTo(safePoint,id,false)
end

function ArturosDelivery.hasOrder(orderId)
    local wanted=tonumber(orderId)
    if not wanted then return false end
    for _,current in ipairs(ArturosDelivery.getOrders()) do
        if tonumber(current.id or current.orderId)==wanted then return true end
    end
    return false
end

function ArturosDelivery.retreatAndReturn(target,id)
    local root=getCleanRoot()
    if not root then return false end
    local approach=ArturosDelivery.getApproachPosition(target,0)
    local offset=root.Position-approach
    local away=Vector3.new(offset.X,0,offset.Z)
    if away.Magnitude<0.1 then
        local look=root.CFrame.LookVector
        away=Vector3.new(look.X,0,look.Z)
    end
    if away.Magnitude<0.1 then away=Vector3.new(1,0,0) else away=away.Unit end
    local retreatDistance=math.max(1,tonumber(ArturosDelivery.RetreatDistance) or 50)
    local retreat=Vector3.new(approach.X+away.X*retreatDistance,approach.Y,approach.Z+away.Z*retreatDistance)
    if not ArturosDelivery.moveGradualTo(retreat,id,12,true) then return false end
    task.wait(0.12)
    return ArturosDelivery.moveGradualTo(approach,id,12,true)
end

function ArturosDelivery.activateJob(id)
    if not ArturosDelivery.running(id) then return false end
    local data=ArturosDelivery.findPrompt()
    if not data or not data.position or not data.prompt then
        warn("[AUTO POLLO] No encontre el Giver de Arturos")
        return false
    end
    local root=getCleanRoot()
    if not root then return false end
    pcall(function() GradualMoveSystem:Stop() end)
    pcall(function() TeleportSystem:StopForcePosition() end)
    local giverApproach=ArturosDelivery.getGiverApproachPosition(data.position)
    if not ArturosDelivery.moveToGiver(data.position,id) then
        warn("[AUTO POLLO] No pude moverme al Giver")
        return false
    end
    task.wait(0.3)
    if not ArturosDelivery.running(id) then return false end
    root=getCleanRoot()
    if not root then return false end
    if not ArturosDelivery.moveToGiver(data.position,id) then return false end
    task.wait(0.15)
    if not ArturosDelivery.running(id) then return false end
    local fired=ArturosDelivery.fireHandoffPrompt(data.prompt)
    if not fired and fireproximityprompt then
        pcall(function() fireproximityprompt(data.prompt) end)
    end
    local t=time()
    while ArturosDelivery.running(id) and time()-t<6 do
        if #ArturosDelivery.getOrders()>0 then return true end
        task.wait(0.15)
    end
    if #ArturosDelivery.getOrders()>0 then return true end
    if not ArturosDelivery.running(id) then return false end
    if not ArturosDelivery.moveAwayFromGiver(data.position,id) then return false end
    task.wait(0.35)
    if not ArturosDelivery.running(id) then return false end
    giverApproach=ArturosDelivery.getGiverApproachPosition(data.position)
    if not ArturosDelivery.moveToGiver(data.position,id) then return false end
    task.wait(0.2)
    ArturosDelivery.fireHandoffPrompt(data.prompt)
    local t2=time()
    while ArturosDelivery.running(id) and time()-t2<4 do
        if #ArturosDelivery.getOrders()>0 then return true end
        task.wait(0.15)
    end
    return ArturosDelivery.running(id) and #ArturosDelivery.getOrders()>0
end

function ArturosDelivery.handoff(order,id)
    if not ArturosDelivery.running(id) or not ArturosDelivery.Net then return false end
    local data=ArturosDelivery.findCustomer(order)
    if not data then
        warn("[AUTO POLLO] No encontre el cliente del pedido:",order.id or order.orderId)
        return false
    end
    ArturosDelivery.exitVehicle()
    local target=data.position
    local customerPosition=ArturosDelivery.getCustomerPosition(data.object)
    if customerPosition then target=customerPosition end
    if not customerPosition and data.prompt and data.prompt:IsA("ProximityPrompt") then
        local promptPosition=ArturosDelivery.getPromptPosition(data.prompt)
        if promptPosition then target=promptPosition end
    end
    if not ArturosDelivery.moveToSafeStart(target,id,true) then
        ArturosDelivery.restoreMovementCollisionOverride()
        warn("[AUTO POLLO] No pude llegar a la distancia segura del cliente:",data.id)
        return false
    end
    if not ArturosDelivery.running(id) then
        ArturosDelivery.restoreMovementCollisionOverride()
        return false
    end
    if not ArturosDelivery.walkTo(target,id,true) then
        ArturosDelivery.restoreMovementCollisionOverride()
        warn("[AUTO POLLO] No pude moverme gradualmente al cliente:",data.id)
        return false
    end
    if not ArturosDelivery.running(id) then
        ArturosDelivery.restoreMovementCollisionOverride()
        return false
    end
    task.wait(0.25)
    local attempts=0
    while ArturosDelivery.running(id) do
        attempts+=1
        ArturosDelivery.enforceMovementState()
        if data.object and data.object.Parent then
            local customerPosition=ArturosDelivery.getCustomerPosition(data.object)
            if customerPosition then target=customerPosition end
        elseif data.prompt and data.prompt.Parent then
            local promptPosition=ArturosDelivery.getPromptPosition(data.prompt)
            if promptPosition then target=promptPosition end
        end
        if (getCleanRoot().Position-target).Magnitude>8 then
            if not ArturosDelivery.moveGradualTo(target,id,12,true) then
                ArturosDelivery.restoreMovementCollisionOverride()
                return false
            end
        end
        ArturosDelivery.restoreMovementCollisionOverride()
        task.wait(0.08)
        ArturosDelivery.fireHandoffPrompt(data.prompt)
        local finished,result=ArturosDelivery.invokeHandoff(data.id)
        task.wait(0.25)
        if not ArturosDelivery.hasOrder(data.id) then
            return true
        end
        if not ArturosDelivery.running(id) then
            ArturosDelivery.restoreMovementCollisionOverride()
            return false
        end
        task.wait(0.8)
        if not ArturosDelivery.hasOrder(data.id) then
            return true
        end
        ArturosDelivery.beginMovementCollisionOverride()
        if not ArturosDelivery.retreatAndReturn(target,id) then
            ArturosDelivery.restoreMovementCollisionOverride()
            return false
        end
        task.wait(0.15)
        if attempts%3==0 then
            local refreshed=ArturosDelivery.findHandoffPrompt(data.id)
            if refreshed then
                data.prompt, target=refreshed
            end
        end
    end
    ArturosDelivery.restoreMovementCollisionOverride()
    return false
end

function ArturosDelivery.run()
    if ArturosDelivery.Enabled then return end
    ArturosDelivery.runId+=1
    local id=ArturosDelivery.runId
    ArturosDelivery.Enabled=true
    task.spawn(function()
        local ok,err=pcall(function()
            while ArturosDelivery.running(id) do
                local orders=ArturosDelivery.getOrders()
                if #orders==0 then
                    if not ArturosDelivery.activateJob(id) then
                        task.wait(0.5)
                        continue
                    end
                    local t=time()
                    while ArturosDelivery.running(id) and time()-t<5 do
                        orders=ArturosDelivery.getOrders()
                        if #orders>0 then break end
                        task.wait(0.15)
                    end
                end
                if #orders>0 then
                    ArturosDelivery.HadBag=true
                    for _,order in ipairs(orders) do
                        if not ArturosDelivery.running(id) then break end
                        local orderId=tonumber(order.id or order.orderId)
                        if orderId then
                            local delivered=ArturosDelivery.handoff(order,id)
                            if delivered then
                                local t=time()
                                while ArturosDelivery.running(id) and time()-t<3 do
                                    local still=false
                                    for _,current in ipairs(ArturosDelivery.getOrders()) do
                                        if tonumber(current.id or current.orderId)==orderId then
                                            still=true
                                            break
                                        end
                                    end
                                    if not still then break end
                                    task.wait(0.1)
                                end
                            end
                            task.wait(0.15)
                        end
                    end
                else
                    task.wait(0.5)
                end
            end
        end)
        if not ok then warn("[AUTO POLLO] Error:",err) end
    end)
end

function ArturosDelivery.stop()
    ArturosDelivery.Enabled=false
    ArturosDelivery.runId+=1
    ArturosDelivery.HadBag=false
    pcall(function() GradualMoveSystem:Stop() end)
    pcall(function() TeleportSystem:StopForcePosition() end)
    pcall(function() ArturosDelivery.restoreMovementCollisionOverride() end)
    pcall(RestoreCharacterState)
end

