local function invokeRoute(routeName,payload)
    local routeId = ROUTES[routeName]
    if not routeId then
        local p = makePromise()
        p:reject("unknown route")
        return p
    end
    requestId += 1
    local id = requestId
    local promise = makePromise()
    pendingRequests[id] = promise
    local ok,err = pcall(function()
        local writer = Serializer.newWriter()
        writer:u8(1)
        writer:u32(routeId)
        writer:u32(id)
        writeValue(writer,payload)
        Replication:FireServer(writer:finish())
    end)
    if not ok then
        pendingRequests[id] = nil
        promise:reject(err)
        return promise
    end
    debugLogVerbose("NET_SEND",id,routeName,payload)
    task.delay(REQUEST_TIMEOUT,function()
        local current = pendingRequests[id]
        if current == promise and promise.state == "pending" then
            pendingRequests[id] = nil
            promise:reject("timeout")
            debugLog("NET_TIMEOUT",id,routeName)
        end
    end)
    return promise
end

local Net = {}
for routeName in pairs(ROUTES) do
    Net[routeName] = {invoke=function(payload)
        return invokeRoute(routeName,payload)
    end}
end

local function awaitNet(promise,timeout)
    if not promise then return false,"no-promise" end
    local finished = false
    local success = false
    local result = nil
    promise:andThen(function(value)
        success = true
        result = value
        finished = true
    end):catch(function(err)
        success = false
        result = err
        finished = true
    end)
    local deadline = tick() + (timeout or REQUEST_TIMEOUT + 1)
    while not finished and tick() < deadline do task.wait() end
    if not finished then return false,"await-timeout" end
    return success,result
end

local function routePayloadReason(payload)
    if type(payload) ~= "table" then return nil end
    if payload.ok == false then
        return tostring(payload.reason or payload.code or payload.message or "server-rejected")
    end
    return nil
end

local function callRoute(routeName,payload,context,timeout)
    local ok, promise = pcall(function()
        return Net[routeName].invoke(payload)
    end)
    if not ok then
        debugLog("ROUTE_INVOKE_ERROR",routeName,context,promise)
        return false,promise,nil
    end
    local success,result = awaitNet(promise,timeout or (REQUEST_TIMEOUT + 1))
    if not success then
        debugLog("SERVER_TRANSPORT_REJECT",routeName,context,result)
        return false,result,nil
    end
    local logicalReason = routePayloadReason(result)
    if logicalReason then
        debugLog("SERVER_LOGICAL_REJECT",routeName,context,logicalReason,result)
        return false,logicalReason,result
    end
    debugLogVerbose("SERVER_OK",routeName,context,result)
    return true,result,result
end

local function callRouteFast(routeName,payload,context)
    local routeId=ROUTES[routeName]
    if not routeId then
        return false,"unknown-route"
    end
    requestId+=1
    local id=requestId
    local ok,err=pcall(function()
        local writer=Serializer.newWriter()
        writer:u8(1)
        writer:u32(routeId)
        writer:u32(id)
        writeValue(writer,payload)
        Replication:FireServer(writer:finish())
    end)
    if not ok then
        debugLog("FAST_ROUTE_ERROR",routeName,context,err)
        return false,err
    end
    debugLogVerbose("FAST_ROUTE_SEND",id,routeName,context,payload)
    return true,nil
end

