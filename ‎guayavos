        local cleanPolygon2,axisString2=polygonString:match("^(.-)|(%d+)$")
        if cleanPolygon2 then
            polygonString=cleanPolygon2
            axis=tonumber(axisString2)
        end
    end
    local points={}
    for pointString in polygonString:gmatch("[^>]+") do
        local xString,zString=pointString:match("^([^,]+),([^,]+)$")
        local x=tonumber(xString)
        local z=tonumber(zString)
        if not x or not z then return nil end
        table.insert(points,{x=x,z=z})
    end
    if #points < 3 then return nil end
    return {designId=designId,points=points,height=height,overhang=overhang,level=level,axis=axis}
