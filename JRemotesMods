safeWrap = function(f)
    if E.ncc then return newcclosure(E.clf and clonefunction(f) or f) end
    return f
end

HooksT = {}
AdonisT = {}

_HookFn = function(orig, repl)
    if not E.hkf then return orig end
    if E.ncc and type(repl)=="function" then
        local ok,cc=pcall(newcclosure,repl); if ok then repl=cc end
    end
    local ok,r=pcall(hookfunction,orig,repl)
    return ok and r or orig
end

AdonisDetect = function()
    if not E.greg or not E.ggc or not E.ifh then return false end
    local ok,reg=pcall(getreg); if not ok or type(reg)~="table" then return false end
    local found=false
    for _,t in reg do
        if typeof(t)~="thread" then continue end
        local ok2,src=pcall(debug.info,t,1,"s")
        if ok2 and src and (src:match("%.Core%.Anti") or src:match("%.Plugins%.Anti_Cheat")) then
            found=true; table.insert(AdonisT,t)
        end
    end
    return found
end

AdonissBypass = function()
    for _,t in AdonisT do pcall(coroutine.close,t) end
    local tbls={}
    if E.fgc then
        local ok,res=pcall(filtergc,"table",{Keys={"Detected","RLocked"}},false)
        if ok and res then
            for _,tb in res do
                if typeof(rawget(tb,"Detected"))=="function" then table.insert(tbls,tb) end
            end
        end
    elseif E.ggc then
        local ok,gc=pcall(getgc,true)
        if ok and gc then
            for _,tb in gc do
                if typeof(tb)~="table" then continue end
                if typeof(rawget(tb,"Detected"))=="function" and rawget(tb,"RLocked") then
                    table.insert(tbls,tb)
                end
            end
        end
    end
    for _,adb in tbls do
        for _,fn in adb do
            if typeof(fn)~="function" then continue end
            local ok2,hooked=pcall(isfunctionhooked,fn)
            if ok2 and hooked then continue end
            HooksT[fn]=_HookFn(fn,function() coroutine.yield(); return task.wait(9e9) end)
        end
    end
    return true
end

do
    if AdonisDetect() then
        AdonissBypass()
        task.defer(function() print("[JRM] Adonis bypass ✓") end)
    end
end

