Enqueue=function(log,cd)
    if not _JRM_Alive then return end
    totalCalls=totalCalls+1
    table.insert(UIQueue,{log=log,call=cd})
end

Record=function(inst,dir,method,args,origin,isExec)
    if not _JRM_Alive then return false end
    if Blocked[inst] then return true end
    if Ignored[inst] then return false end
    local delay=Delayed[inst]
    if delay and delay>0 then
        local now=tick()
        local last=LastCall[inst] or 0
        if now-last < delay then return true end
        LastCall[inst]=now
    end
    local log=GetLog(inst,dir,method)
    if log.Blocked then return true end
    if log.Ignored then return false end
    local cd={Arguments=args,Origin=origin,IsExecutor=isExec or false,
        Time=tick(),Index=#log.Calls+1}
    table.insert(log.Calls,cd)
    task.defer(Enqueue,log,cd)
    return false
end

FFC={
    Outgoing={RemoteEvent="FireServer",UnreliableRemoteEvent="FireServer",
        RemoteFunction="InvokeServer",BindableEvent="Fire",BindableFunction="Invoke"},
    Incoming={RemoteEvent="OnClientEvent",UnreliableRemoteEvent="OnClientEvent",
        RemoteFunction="OnClientInvoke",BindableEvent="Event",BindableFunction="OnInvoke"},
}

BuildCode=function(log,cd)
    local inst=log.Instance; local dir=log.Type
    local method=FFC[dir][inst.ClassName] or log.Method
    local path=GetPath(inst)
    local aStr=BuildArgs(cd.Arguments)
    local hasA=(cd.Arguments.n or #cd.Arguments)>0
    local hdr=("-- [%s] %s | %s\n"):format(dir,inst.ClassName,inst.Name)
    if cd.Origin then hdr=hdr..("-- Origen: %s\n"):format(GetPath(cd.Origin)) end
    if dir=="Outgoing" then
        if hasA then return hdr..("\nlocal args = {\n%s\n}\n%s:%s(table.unpack(args,1,args.n))"):format(aStr,path,method) end
        return hdr..("\n%s:%s()"):format(path,method)
    else
        if hasA then return hdr..("\n-- Args recibidos:\nlocal args = {\n%s\n}\nfiresignal(%s.%s,table.unpack(args,1,args.n))"):format(aStr,path,method) end
        return hdr..("-- Sin argumentos\n-- firesignal(%s.%s)"):format(path,method)
    end
end

GetOriginFromConn=function(sig)
    local origin=nil
    if E.gcn then
        for _,c in ipairs(getconnections(sig)) do
            if c.Function and not OwnConns[c.Function] then
                if E.gsft and c.Thread then origin=getscriptfromthread(c.Thread) end
                if not origin then
                    local ok,s=pcall(function() return rawget(getfenv(c.Function),"script") end)
                    if ok and typeof(s)=="Instance" then origin=s end
                end
                break
            end
        end
    end
    return origin
end

HookIn=function(inst)
    if HandledIn[inst] then return end; HandledIn[inst]=true
    local cls=inst.ClassName; local sig,meth
    if cls=="RemoteEvent" or cls=="UnreliableRemoteEvent" then sig=inst.OnClientEvent; meth="OnClientEvent"
    elseif cls=="BindableEvent" then sig=inst.Event; meth="Event"
    else return end
    local fn=function(...)
        Record(inst,"Incoming",meth,table.pack(...),GetOriginFromConn(sig),false)
    end
    OwnConns[fn]=true; AddConn(sig:Connect(fn))
end

CreateDetour=function(inst,method,original)
    local det=safeWrap(function(...)
        local origin=nil
        if E.gsft then
            local ok2,s=pcall(getscriptfromthread,coroutine.running())
            if ok2 and typeof(s)=="Instance" then origin=s end
        end
        if not origin then
            local ok3,s=pcall(function() return rawget(getfenv(original),"script") end)
            if ok3 and typeof(s)=="Instance" then origin=s end
        end
        local isExec=E.iec and isexecutorclosure(debug.info(2,"f") or function()end) or false
        if Record(inst,"Incoming",method,table.pack(...),origin,isExec) then return end
        return original(...)
    end)
    if E.ssh then pcall(setstackhidden,det,true) end
    return det
end

HookCB=function(inst)
    if HandledIn[inst] then return end; HandledIn[inst]=true
    if not E.gcb then return end
    local cls=inst.ClassName
    local method=cls=="RemoteFunction" and "OnClientInvoke" or "OnInvoke"
    local ok,cb=pcall(getcallbackvalue,inst,method)
    local isCallable=ok and (type(cb)=="function" or (E.grm and type(cb)~="nil" and type((getRM(cb) or {}).__call)=="function"))
    if not isCallable then return end
    pcall(function() inst[method]=CreateDetour(inst,method,cb) end)
end

AllCls={RemoteEvent=true,UnreliableRemoteEvent=true,RemoteFunction=true,BindableEvent=true,BindableFunction=true}
NCMths={FireServer=true,InvokeServer=true,Fire=true,Invoke=true,fireServer=true,invokeServer=true,fire=true,invoke=true}
CBMths={RemoteFunction="OnClientInvoke",BindableFunction="OnInvoke"}

GetOrigin=function()
    if not E.gsft then return nil end
    local ok,s=pcall(getscriptfromthread,coroutine.running())
    return (ok and typeof(s)=="Instance") and s or nil
end

NCHook=nil; NIHook=nil

if FULL then
    NCHook=hookmetamethod(game,"__namecall",safeWrap(function(...)
        local self=...; local m=getnamecallmethod()
        if typeof(self)=="Instance" and AllCls[self.ClassName] and NCMths[m] and not chkCall() then
            if not Blocked[self] and not Ignored[self] then
                local args=table.pack(select(2,...))
                local isExec=E.iec and isexecutorclosure(debug.info(2,"f") or function()end) or false
                if self.ClassName=="RemoteFunction" and (m=="InvokeServer" or m=="invokeServer") then
                    local result=table.pack(NCHook(...))
                    task.defer(function()
                        local origin=GetOrigin()
                        Record(self,"Outgoing",m,args,origin,isExec)
                        local logIn=Logs.Incoming[self]
                        if not logIn or not logIn.Ignored then Record(self,"Incoming",m,result,origin,isExec) end
                    end)
                    return table.unpack(result,1,result.n)
                end
                local delay=Delayed[self]
                if delay and delay>0 then
                    local now=tick(); local last=LastCall[self] or 0
                    if now-last < delay then return end
                    LastCall[self]=now
                end
                task.defer(function() Record(self,"Outgoing",m,args,GetOrigin(),isExec) end)
            elseif Blocked[self] then return end
        end
        return NCHook(...)
    end))

    NIHook=hookmetamethod(game,"__newindex",safeWrap(function(...)
        local self,key,value=...
        if typeof(self)=="Instance" then
            local cbM=CBMths[self.ClassName]
            if cbM and key==cbM then
                local isCallable=type(value)=="function" or (value~=nil and E.grm and type((getRM(value) or {}).__call)=="function")
                if isCallable then return NIHook(self,key,CreateDetour(self,cbM,value)) end
            end
        end
        return NIHook(...)
    end))
end

