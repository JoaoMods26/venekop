-- ── Cache de decompilaciones lazy ──────────────────────────────────
_decompCache = {}   -- [Instance] = {src=string, status="ok"|"err"|"pending"}

DecompLazy=function(scr, onDone)
    if _decompCache[scr] then
        if onDone then onDone(_decompCache[scr]) end
        return
    end
    if not E.dec or not E.gsb then
        local r={src="-- decompile() no disponible en este executor",status="err"}
        _decompCache[scr]=r; if onDone then onDone(r) end; return
    end
    task.spawn(function()
        local ok1,bc=pcall(getscriptbytecode,scr)
        if not ok1 or not bc or #bc==0 then
            local r={src="-- Sin bytecode (script protegido o vacío)",status="err"}
            _decompCache[scr]=r; if onDone then onDone(r) end; return
        end
        local ok2,raw=pcall(decompile,scr)
        if not ok2 or type(raw)~="string" or #raw<2 then
            local r={src="-- Decompilación fallida",status="err"}
            _decompCache[scr]=r; if onDone then onDone(r) end; return
        end
        -- ── Anotar con comentarios útiles ──────────────────────────
        local header=table.concat({
            "-- ╔══════════════════════════════════════════════════════╗",
            "-- ║  Decompilado por Joao_Mods                          ║",
            "-- ╠══════════════════════════════════════════════════════╣",
            ("-- ║  Nombre  : %-40s║"):format(scr.Name:sub(1,40)),
            ("-- ║  Clase   : %-40s║"):format(scr.ClassName:sub(1,40)),
            ("-- ║  ID      : %-40s║"):format(tostring(scr):sub(1,40)),
            ("-- ║  Ruta    : %-40s║"):format(scr:GetFullName():sub(1,40)),
            "-- ╚══════════════════════════════════════════════════════╝",
            "",
        },"\n")
        -- Anotar require() calls con comentario inline
        local annotated=raw:gsub("(require%s*%(%s*)([^%)]+)(%s*%))",function(pre,arg,post)
            return pre..arg..post.."  --[[ require: "..arg:gsub("%s",""):sub(1,40).." ]]"
        end)
        -- Anotar FireServer / InvokeServer con comentario
        annotated=annotated:gsub("(:[Ff]ire[Ss]erver%s*%()",function(m)
            return m.."  --[[ → FireServer ]]"
        end)
        annotated=annotated:gsub("(:[Ii]nvoke[Ss]erver%s*%()",function(m)
            return m.."  --[[ → InvokeServer ]]"
        end)
        local r={src=header..annotated,status="ok",name=scr.Name,
            path=scr:GetFullName(),stype=scr.ClassName}
        _decompCache[scr]=r; if onDone then onDone(r) end
    end)
end

-- ── Busca módulos requeridos por un script ──────────────────────────
FindRequiredModules=function(scr)
    local mods={}; local seen={}
    if not _decompCache[scr] or _decompCache[scr].status~="ok" then return mods end
    local src=_decompCache[scr].src
    for arg in src:gmatch("require%s*%(%s*([^%)]+)%s*%)") do
        arg=arg:match("^%s*(.-)%s*$")
        if not seen[arg] then
            seen[arg]=true
            -- intentar resolver la instancia
            local inst=nil
            pcall(function()
                -- buscar por nombre en todo el juego
                for _,d in ipairs(game:GetDescendants()) do
                    if (d:IsA("ModuleScript") or d:IsA("LocalScript")) and d.Name==arg then
                        inst=d; break
                    end
                end
            end)
            table.insert(mods,{arg=arg,inst=inst})
        end
    end
    return mods
end

