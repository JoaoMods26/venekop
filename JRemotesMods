CARD_H=M and 62 or 72
MakeCard=function(data,qLow,hits)
    if not _JRM_Alive then return end
    local icon=data.stype=="LocalScript" and "📜" or "📦"
    local card=N("Frame",{Name="TarjetaScript",Size=UDim2.new(1,-2,0,CARD_H),
        BackgroundColor3=C.ITEM,Parent=ScanResults},
        {Cor(7),Str(C.BORDER,1)})
    N("Frame",{Name="FranjaScript",Size=UDim2.new(0,3,1,0),BackgroundColor3=C.PURP,
        BackgroundTransparency=0.25,Parent=card})
    N("TextLabel",{Name="NombreScript",Size=UDim2.new(1,-110,0,M and 16 or 18),Position=UDim2.new(0,8,0,4),
        BackgroundTransparency=1,Text=icon.." "..data.name,
        Font=Enum.Font.GothamBold,TextSize=FSS,TextColor3=C.PURP,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,Parent=card})
    -- Si hits > 0 mostrar badge de hits, si no mostrar tipo solamente
    if hits and hits > 0 then
        N("TextLabel",{Name="BadgeHits",Size=UDim2.new(0,44,0,13),Position=UDim2.new(1,-48,0,5),
            BackgroundColor3=C.HIT,BackgroundTransparency=0.72,
            Text=tostring(hits).." hit"..(hits~=1 and "s" or ""),
            Font=Enum.Font.GothamBold,TextSize=7,TextColor3=C.HIT,Parent=card},{Cor(3)})
    end
    local tCol=data.stype=="LocalScript" and C.CYAN or C.MAG
    local badgeXOff = (hits and hits > 0) and -100 or -52
    N("TextLabel",{Name="BadgeTipoScript",Size=UDim2.new(0,54,0,13),Position=UDim2.new(1,badgeXOff,0,5),
        BackgroundColor3=tCol,BackgroundTransparency=0.72,
        Text=data.stype=="LocalScript" and "LocalScript" or "Module",
        Font=Enum.Font.GothamBold,TextSize=7,TextColor3=tCol,Parent=card},{Cor(3)})
    N("TextLabel",{Name="RutaScript",Size=UDim2.new(1,-8,0,M and 13 or 15),Position=UDim2.new(0,8,0,M and 22 or 25),
        BackgroundTransparency=1,Text=data.path,Font=Enum.Font.Gotham,TextSize=FSX,TextColor3=C.DIM,
        TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=card})
    -- Contexto solo si hay query
    if qLow and qLow ~= "" then
        local matchPos=data.src:lower():find(qLow,1,true)
        local ctxLine=""
        if matchPos then ctxLine=GetContext(data.src,matchPos,0):gsub("^[→%s]+",""):sub(1,80) end
        N("TextLabel",{Name="LineaContexto",Size=UDim2.new(1,-8,0,M and 14 or 17),
            Position=UDim2.new(0,8,0,M and 38 or 43),
            BackgroundTransparency=1,Text=ctxLine,Font=Enum.Font.Code,TextSize=FSX,TextColor3=C.HIT,
            TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=card})
    end
    local capData=data
    local cb2=N("TextButton",{Name="AreaClickTarjeta",Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
        Text="",AutoButtonColor=false,ZIndex=3,Parent=card})
    cb2.MouseEnter:Connect(function() card.BackgroundColor3=C.ITEMH end)
    cb2.MouseLeave:Connect(function() card.BackgroundColor3=C.ITEM end)
cb2.MouseButton1Click:Connect(function()
    if DetailView.Visible then NavPush() end
    if _DEditMode then
        if _DEditBox and _DEditBox.Parent then _DEditBox.Visible = false end
        DCode.Visible = true
        _DEditMode = false
        if BtnDEdit then
            BtnDEdit.Text = "✏ Edit"
            BtnDEdit.BackgroundColor3 = C.ORANGE:Lerp(Color3.fromRGB(0,0,0),0.38)
        end
    end
    if DeepPanel then DeepPanel.Visible = false end
    local src = capData.src
    local preview = src
    if #preview > 12000 then
        preview = src:sub(1,12000).."\n\n-- [... truncado]"
    end
    DCode.Text = preview
    DNameLbl.Text = icon.." "..capData.name.." ("..capData.stype..")"
    _DetailSrc = src
    _DetailPath = capData.path
    DetailView.Visible = true
    DScroll.CanvasPosition = Vector2.new(0,0)
end)
end
