-- ── Stack de navegación ──────────────────────────────────────────
_NavStack = {}
_FwdStack = {}   -- stack hacia adelante (para botón ➡)

NavPush=function()
    -- Al navegar hacia adelante se limpia el stack de forward
    _FwdStack = {}
    local editText = nil
    if _DEditMode and _DEditBox and _DEditBox.Parent then
        editText = _DEditBox.Text
    end
    local srcToSave = _DetailSrc or (DCode and DCode.Text) or ""
    table.insert(_NavStack, {
        src         = srcToSave,
        path        = _DetailPath,
        name        = DNameLbl and DNameLbl.Text or "",
        codeText    = DCode and DCode.Text or "",
        deepVisible = DeepPanel and DeepPanel.Visible or false,
        editMode    = _DEditMode or false,
        editText    = editText,
        scrollY     = DScroll and DScroll.CanvasPosition.Y or 0,
    })
    -- Actualizar botón forward si existe
    if BtnFwd then BtnFwd.TextColor3 = C.DIM end
    if BtnBack then BtnBack.TextColor3 = #_NavStack > 0 and C.TEXT or C.DIM end
end

NavSaveCurrentToFwd=function()
    -- Guarda el estado actual en el stack forward antes de ir atrás
    local editText = nil
    if _DEditMode and _DEditBox and _DEditBox.Parent then
        editText = _DEditBox.Text
    end
    table.insert(_FwdStack, {
        src         = _DetailSrc,
        path        = _DetailPath,
        name        = DNameLbl and DNameLbl.Text or "",
        codeText    = DCode and DCode.Text or "",
        deepVisible = DeepPanel and DeepPanel.Visible or false,
        editMode    = _DEditMode or false,
        editText    = editText,
        scrollY     = DScroll and DScroll.CanvasPosition.Y or 0,
    })
end

NavRestore=function(entry)
    if not entry then return false end
_DetailSrc  = entry.src or entry.codeText or ""
    _DetailPath = entry.path
    if DNameLbl then DNameLbl.Text = entry.name end

    if _DEditMode then
        if _DEditBox and _DEditBox.Parent then _DEditBox.Visible = false end
        DCode.Visible = true
        _DEditMode = false
        if BtnDEdit and BtnDEdit.Parent then
            BtnDEdit.Text = "✏ Edit"
            BtnDEdit.BackgroundColor3 = C.ORANGE:Lerp(Color3.fromRGB(0,0,0),0.38)
        end
    end

    if DCode then
        DCode.Text = entry.codeText or entry.src or "-- (vacío)"
        DCode.Visible = true
    end

    if DeepPanel then DeepPanel.Visible = entry.deepVisible end

    if entry.editMode and entry.editText then
        _DEditMode = true
        if not _DEditBox or not _DEditBox.Parent then
            _DEditBox = N("TextBox",{
                Name="EditorDetalleInline",
                Size=UDim2.new(1,-18,0,20),
                Position=UDim2.new(0,9,0,8),
                AutomaticSize=Enum.AutomaticSize.Y,
                BackgroundTransparency=1,
                Text=entry.editText,
                Font=Enum.Font.Code, TextSize=FS,
                TextColor3=Color3.fromRGB(180,240,200),
                TextXAlignment=Enum.TextXAlignment.Left,
                TextYAlignment=Enum.TextYAlignment.Top,
                TextWrapped=true, MultiLine=true,
                ClearTextOnFocus=false,
                ZIndex=203, Parent=DScroll
            })
        else
            _DEditBox.Text = entry.editText
            _DEditBox.Visible = true
        end
        DCode.Visible = false
        if BtnDEdit then
            BtnDEdit.Text = "👁 Ver"
            BtnDEdit.BackgroundColor3 = C.ORANGE
        end
    end

    task.defer(function()
        if DScroll and DScroll.Parent then
            DScroll.CanvasPosition = Vector2.new(0, entry.scrollY or 0)
        end
        if DCode and DCode.Parent then
            local h = DCode.AbsoluteSize.Y + 32
            DScroll.CanvasSize = UDim2.new(0,0,0,
                h > DScroll.AbsoluteSize.Y and h or 0)
        end
    end)

    -- Actualizar colores de botones nav
    if BtnBack then BtnBack.TextColor3 = #_NavStack > 0 and C.TEXT or C.DIM end
    if BtnFwd  then BtnFwd.TextColor3  = #_FwdStack > 0 and C.TEXT or C.DIM end
    return true
end

NavPop=function()
    if #_NavStack == 0 then return false end
    NavSaveCurrentToFwd()
    local entry = table.remove(_NavStack)
    return NavRestore(entry)
end

NavFwd=function()
    if #_FwdStack == 0 then return false end
    -- Guardar actual en back stack SIN limpiar forward
    local editText = nil
    if _DEditMode and _DEditBox and _DEditBox.Parent then
        editText = _DEditBox.Text
    end
    table.insert(_NavStack, {
        src         = _DetailSrc,
        path        = _DetailPath,
        name        = DNameLbl and DNameLbl.Text or "",
        codeText    = DCode and DCode.Text or "",
        deepVisible = DeepPanel and DeepPanel.Visible or false,
        editMode    = _DEditMode or false,
        editText    = editText,
        scrollY     = DScroll and DScroll.CanvasPosition.Y or 0,
    })
    local entry = table.remove(_FwdStack)
    return NavRestore(entry)
end
