_selectorTool=nil
_selectorToolConn=nil

CreateSelectorTool=function()
    local lp=Players.LocalPlayer
    if not lp then return end
    local ch=lp.Character
    if not ch then return end
    if _selectorTool and _selectorTool.Parent then
        _selectorTool:Destroy(); _selectorTool=nil
    end
    local tool=Instance.new("Tool")
    tool.Name="JRM"
    tool.RequiresHandle=false
    tool.ToolTip="JRM Selector — Click para inspeccionar"
    tool.CanBeDropped=false
    _selectorToolConn=tool.Activated:Connect(function()
        if not _selectorActive then return end
        local cam=workspace.CurrentCamera
        local mp=UIS:GetMouseLocation()
        local ray=cam:ScreenPointToRay(mp.X,mp.Y)
        local params=RaycastParams.new()
        params.FilterDescendantsInstances={ch}
        params.FilterType=Enum.RaycastFilterType.Exclude
        local result=workspace:Raycast(ray.Origin,ray.Direction*500,params)
        if result and result.Instance then
            UpdateObjPanel(result.Instance)
        end
    end)
    tool.Parent=lp.Backpack
    _selectorTool=tool
end

RemoveSelectorTool=function()
    if _selectorTool then
        if _selectorToolConn then _selectorToolConn:Disconnect(); _selectorToolConn=nil end
        pcall(function() _selectorTool:Destroy() end)
        _selectorTool=nil
    end
end

