-- Actualiza la barra de paginación
UpdatePageBar=function(total)
    local pages = math.max(1, math.ceil(total / _pageSize))
    local show  = total > 0
    PageBar.Visible = show
    if show then
        PageInfoLbl.Text = ("Pág %d / %d  [%d scripts]"):format(_currentPage, pages, total)
        BtnPagePrev.TextColor3 = _currentPage > 1   and C.CYAN or C.DIM
        BtnPageNext.TextColor3 = _currentPage < pages and C.CYAN or C.DIM
    end
end

-- Renderiza la página actual de _pageData
RenderPage=function()
    ClearRes()
    if not _JRM_Alive then return end
    local total   = #_pageData
    local pages   = math.max(1, math.ceil(total / _pageSize))
    _currentPage  = math.max(1, math.min(_currentPage, pages))
    UpdatePageBar(total)

    local startI  = (_currentPage - 1) * _pageSize + 1
    local endI    = math.min(_currentPage * _pageSize, total)

    local qLow = ScanInput.Text:lower()  -- puede estar vacío en modo "all"

    task.spawn(function()
        for i = startI, endI do
            if not _JRM_Alive then return end
            local entry = _pageData[i]
            if entry then
                MakeCard(entry.data, qLow, entry.hits)
            end
            if (i - startI) % 8 == 0 then task.wait() end
        end
        -- scroll al tope
        if ScanResults and ScanResults.Parent then
            ScanResults.CanvasPosition = Vector2.new(0,0)
        end
    end)
end

-- Construye _pageData con TODOS los scripts (sin filtro de texto)
BuildAllPageData=function()
    _pageData = {}
    for _,data in pairs(decompiledScripts) do
        if not _JRM_Alive then return end
        local typeOk   = scanType   == "All" or data.stype == scanType
        local srcOk    = scanOrigin == "All"
            or (scanOrigin == "game" and not data.isExec)
            or (scanOrigin == "exec" and data.isExec)
        if typeOk and srcOk then
            table.insert(_pageData, {data=data, hits=0})
        end
    end
    -- ordenar por nombre o tipo (hits=0 para todos)
    if scanSort == "name" then
        table.sort(_pageData, function(a,b) return a.data.name:lower() < b.data.name:lower() end)
    elseif scanSort == "type" then
        table.sort(_pageData, function(a,b) return a.data.stype < b.data.stype end)
    else
        -- sin query → ordena por nombre por defecto
        table.sort(_pageData, function(a,b) return a.data.name:lower() < b.data.name:lower() end)
    end
end

-- Muestra todos los scripts paginados (se llama al terminar el scan)
ShowAllScripts=function()
    if scanBusy then return end
    if not scanReady then return end
    scanBusy = true
    _pageMode    = "all"
    _currentPage = 1
    DetailView.Visible = false
    task.spawn(function()
        BuildAllPageData()
        local total = #_pageData
        if total == 0 then
            ScanStatus.Text = "⚠ Sin scripts descompilados"
            PageBar.Visible = false
            scanBusy = false
            return
        end
        ScanStatus.Text = ("📂 %d scripts — usa Buscar para filtrar"):format(total)
        RenderPage()
        scanBusy = false
    end)
end

StartScan=function()
    if _scanStarted then return end; _scanStarted=true
    if not E.dec or not E.gsb then
        ScanStatus.Text="⚠ decompile() no disponible en este executor"; return
    end
    task.spawn(function()
        ScanStatus.Text="Recolectando scripts..."; task.wait(0.05)
        local list=CollectScripts(); scanTotal=#list
        if scanTotal==0 then ScanStatus.Text="⚠ Sin scripts encontrados"; return end
        ScanStatus.Text=("Descompilando 0 / %d..."):format(scanTotal)
        for i,scr in ipairs(list) do
            if not _JRM_Alive then return end
            DecompOne(scr)
            if i%12==0 then task.wait(); ScanStatus.Text=("Descompilando %d / %d..."):format(scanDone,scanTotal) end
        end
        local t0=tick()
        while scanDone<scanTotal and tick()-t0<45 do
            if not _JRM_Alive then return end
            task.wait(0.4)
            ScanStatus.Text=("Descompilando %d / %d..."):format(scanDone,scanTotal)
        end
        if not _JRM_Alive then return end
        local cnt=0; for _ in pairs(decompiledScripts) do cnt=cnt+1 end
        scanReady=true
        -- ── NUEVO: mostrar todos automáticamente en páginas ──
        ScanStatus.Text=("✅ %d scripts listos — cargando lista..."):format(cnt)
        ShowAllScripts()
    end)
end

-- Búsqueda con texto (igual que antes, pero usando _pageData y paginación)
DoSearch=function(rawQ)
    if scanBusy then return end
    local q=(rawQ or ""):match("^%s*(.-)%s*$")
    -- Si la query está vacía, mostrar todos
    if q=="" then
        if scanReady then
            _currentPage=1; ShowAllScripts()
        end
        return
    end
    if not scanReady then ScanStatus.Text="⏳ Todavía descompilando..."; return end
    AddHistory(q); ShowHistory(false)
    scanBusy=true; ClearRes(); DetailView.Visible=false
    task.spawn(function()
        if not _JRM_Alive then scanBusy=false; return end
        local qLow=q:lower(); local hits={}; local total=0
        for _,data in pairs(decompiledScripts) do
            if not _JRM_Alive then scanBusy=false; return end
            local typeOk=scanType=="All" or data.stype==scanType
            local srcOk=scanOrigin=="All" or (scanOrigin=="game" and not data.isExec) or (scanOrigin=="exec" and data.isExec)
            if typeOk and srcOk then
                local sLow=data.src:lower()
                if sLow:find(qLow,1,true) then
                    local count,p2=0,1
                    while true do local np=sLow:find(qLow,p2,true); if not np then break end; count=count+1; p2=np+1 end
                    table.insert(hits,{data=data,hits=count}); total=total+1
                end
            end
            if total%200==0 then task.wait() end
        end
        if not _JRM_Alive then scanBusy=false; return end
        if scanSort=="hits" then table.sort(hits,function(a,b) return a.hits>b.hits end)
        elseif scanSort=="name" then table.sort(hits,function(a,b) return a.data.name:lower()<b.data.name:lower() end)
        elseif scanSort=="type" then table.sort(hits,function(a,b) return a.data.stype<b.data.stype end) end
        if total==0 then
            ScanStatus.Text=('❌ "%s" no encontrado'):format(q)
            _pageData={}; PageBar.Visible=false
            scanBusy=false; return
        end
        -- Guardar en _pageData y paginar
        _pageData    = hits
        _pageMode    = "search"
        _currentPage = 1
        ScanStatus.Text=('🔎 %d resultado(s) para "%s"'):format(total,q)
        RenderPage()
        scanBusy=false
    end)
end

