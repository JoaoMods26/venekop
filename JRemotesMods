-- Función principal que rellena el panel
RunDeepAnalysis=function()
    if not _DetailSrc or #_DetailSrc<2 then
        Flash(BtnDDeep,"Sin código!"); return
    end
    -- limpiar contenido anterior
    for _,v in ipairs(DeepContent:GetChildren()) do
        if not v:IsA("UIListLayout") and not v:IsA("UIPadding") then v:Destroy() end
    end
    DeepPanel.Visible=true
    DeepScroll.CanvasPosition=Vector2.new(0,0)

    local name=DNameLbl.Text:gsub("[📜📦%s]",""):match("^(.-)%s*%(") or "script"
    local analysis=AnalyzeDeep(_DetailSrc, name)
    if not analysis then Flash(BtnDDeep,"Error!"); return end

    _deepAnalysisText=analysis.summary

    -- ── WebSocket / callRemote ──────────────────────────────────────
    if #analysis.websockets>0 then
        local wItems={}
        for _,w in ipairs(analysis.websockets) do
            table.insert(wItems,{
                label="🌐 "..w.remote.."  →  "..w.method,
                color=C.CYAN, remote=w.remote, method=w.method
            })
        end
        MakeDeepSection("🌐 WebSocket / callRemote",C.CYAN,wItems,function(item)
            -- Copiar template de llamada
            if E.sclip then
                local code=('-- Llamada detectada por JRM\n%s.callRemote("%s", "%s", --[[args]])'):format(
                    "ws",item.remote,item.method)
                setclipboard(code); Flash(BtnDeepCopy,"✓ Copiado!")
            end
        end)
    end

    -- ── FireServer / InvokeServer ───────────────────────────────────
    if #analysis.remotes>0 then
        local rItems={}
        for _,r in ipairs(analysis.remotes) do
            table.insert(rItems,{
                label="🔥 "..r.path.."  →  "..r.method,
                color=C.YELLOW, path=r.path, method=r.method
            })
        end
        MakeDeepSection("🔥 FireServer / InvokeServer",C.YELLOW,rItems,function(item)
            if E.sclip then
                local code=('-- Remote detectado por JRM\ngame:GetService("ReplicatedStorage"):FindFirstChild("%s"):FireServer(--[[args]])'):format(item.path)
                setclipboard(code); Flash(BtnDeepCopy,"✓ Copiado!")
            end
        end)
    end

    -- ── Módulos requeridos (clickables para decompile) ──────────────
    if #analysis.requires>0 then
        local modItems={}
        for _,r in ipairs(analysis.requires) do
            table.insert(modItems,{
                label="📦 "..r.name.."  ("..r.raw:sub(1,38)..")",
                color=C.MAG, raw=r.raw, name=r.name
            })
        end
        MakeDeepSection("📦 Módulos requeridos",C.MAG,modItems,function(item)
            -- Intentar abrir el módulo
            local inst=ResolveRequireInst(item.raw)
            DeepPanel.Visible=false
            if not inst then
                DCode.Text="-- Módulo '"..item.name.."' no localizado en el árbol\n-- Raw: "..item.raw
                DNameLbl.Text="📦 "..item.name
                _DetailSrc=DCode.Text; return
            end
            local icon2=inst:IsA("ModuleScript") and "📦" or "📜"
            DCode.Text="-- ⏳ Descompilando "..inst.Name.."..."
            DNameLbl.Text=icon2.." "..inst.Name.." ("..inst.ClassName..")"
            _DetailSrc=nil; _DetailPath=inst:GetFullName()
            DScroll.CanvasPosition=Vector2.new(0,0)
            DecompLazy(inst,function(res)
                local preview=res.src
                if #preview>14000 then preview=res.src:sub(1,14000).."\n\n-- [... truncado]" end
                DCode.Text=preview; _DetailSrc=res.src
                task.defer(function()
                    if DCode and DCode.Parent then
                        local h=DCode.AbsoluteSize.Y+40
                        DScroll.CanvasSize=UDim2.new(0,0,0,h>DScroll.AbsoluteSize.Y and h or 0)
                    end
                end)
            end)
        end)
    end

    -- ── Funciones ───────────────────────────────────────────────────
    if #analysis.functions>0 then
        local fnItems={}
        for _,f in ipairs(analysis.functions) do
            table.insert(fnItems,{label="ƒ  "..f, color=C.GREEN})
        end
        MakeDeepSection("ƒ Funciones definidas",C.GREEN,fnItems,nil)
    end

    -- ── Strings relevantes ──────────────────────────────────────────
    if #analysis.strings>0 then
        local strItems={}
        for _,s in ipairs(analysis.strings) do
            table.insert(strItems,{
                label='"'..s..'"', color=C.ORANGE, str=s
            })
        end
        MakeDeepSection("📝 Strings relevantes",C.ORANGE,strItems,function(item)
            if E.sclip then setclipboard(item.str); Flash(BtnDeepCopy,'✓ "'..item.str:sub(1,16)..'"') end
        end)
    end

    -- Si no hay nada
    local total=#analysis.websockets+#analysis.remotes+#analysis.requires+#analysis.functions
    if total==0 then
        N("TextLabel",{Name="SinResultados",
            Size=UDim2.new(1,-12,0,40),
            BackgroundTransparency=1,
            Text="Sin patrones detectados en este script.\nPuede estar ofuscado o ser muy simple.",
            Font=Enum.Font.Gotham,TextSize=FSS,TextColor3=C.DIM,
            TextXAlignment=Enum.TextXAlignment.Center,
            TextYAlignment=Enum.TextYAlignment.Center,
            TextWrapped=true,ZIndex=213,Parent=DeepContent})
    end
end

