GetPath=function(inst)
    if typeof(inst)~="Instance" then return tostring(inst) end
    local parts,cur={},inst
    while cur and cur~=game do table.insert(parts,1,cur.Name); cur=cur.Parent end
    if #parts==0 then return "game" end
    local svc=parts[1]
    if pcall(function() game:GetService(svc) end) then
        local rest=#parts>1 and ("."..table.concat(parts,"."):sub(#svc+2)) or ""
        return ('game:GetService("%s")'):format(svc)..rest
    end
    return "game."..table.concat(parts,".")
end

Fn=function(n)
    if n==math.huge then return "math.huge" end
    if n==-math.huge then return "-math.huge" end
    if n~=n then return "0/0" end
    if n%1==0 then return tostring(n) end
    return ("%.6g"):format(n)
end

Ser=function(v,d)
    d=d or 0; if d>5 then return "{--[[...]]}" end
    local t=typeof(v)
    if t=="nil" then return "nil" end
    if t=="boolean" then return tostring(v) end
    if t=="number" then return Fn(v) end
    if t=="string" then return ("%q"):format(v) end
    if t=="Instance" then return GetPath(v) end
    if t=="Vector3" then return ("Vector3.new(%s,%s,%s)"):format(Fn(v.X),Fn(v.Y),Fn(v.Z)) end
    if t=="Vector2" then return ("Vector2.new(%s,%s)"):format(Fn(v.X),Fn(v.Y)) end
    if t=="CFrame" then
        local cc={v:GetComponents()}; for i,x in ipairs(cc) do cc[i]=Fn(x) end
        return "CFrame.new("..table.concat(cc,",")..")"
    end
    if t=="Color3" then return ("Color3.fromRGB(%d,%d,%d)"):format(math.round(v.R*255),math.round(v.G*255),math.round(v.B*255)) end
    if t=="UDim2" then return ("UDim2.new(%s,%s,%s,%s)"):format(Fn(v.X.Scale),Fn(v.X.Offset),Fn(v.Y.Scale),Fn(v.Y.Offset)) end
    if t=="UDim" then return ("UDim.new(%s,%s)"):format(Fn(v.Scale),Fn(v.Offset)) end
    if t=="BrickColor" then return ('BrickColor.new("%s")'):format(tostring(v)) end
    if t=="EnumItem" then return "Enum."..tostring(v.EnumType).."."..v.Name end
    if t=="table" then
        local rows,i={},0
        for k,val in pairs(v) do
            i=i+1; if i>40 then table.insert(rows,"--[[...más]]"); break end
            local ks=type(k)=="number" and "" or ("["..Ser(k,d+1).."] = ")
            table.insert(rows,("    "):rep(d+1)..ks..Ser(val,d+1))
        end
        return "{\n"..table.concat(rows,",\n").."\n"..("    "):rep(d).."}"
    end
    return ("%q"):format(tostring(v))
end

BuildArgs=function(args)
    local rows,n={},args.n or #args
    for i=1,n do table.insert(rows,("    [%d] = %s"):format(i,Ser(args[i]))) end
    return table.concat(rows,",\n")
end

