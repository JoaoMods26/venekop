BtnRecStart.MouseButton1Click:Connect(function()
    if _posRecording then return end
    _posRecording=true
    RecStatusLbl.TextColor3=C.GREEN
    task.spawn(function()
        local lastT=tick()
        while _posRecording and _JRM_Alive do
            local now=tick()
            if now-lastT >= GetRecDelay() then
                lastT=now; AddRoutePoint()
            end
            task.wait(0.05)
        end
    end)
end)

