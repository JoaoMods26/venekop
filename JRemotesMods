GetContext=function(src,pos,around)
    around=around or 3
    local lineNum,p=1,1
    while p<pos do
        local nl=src:find("\n",p,true)
        if not nl or nl>=pos then break end
        lineNum=lineNum+1; p=nl+1
    end
    local s0=math.max(1,lineNum-around); local s1=lineNum+around
    local lines,cur,ln={},1,1
    while ln<=s1 do
        local nl=src:find("\n",cur,true); local le=nl and nl-1 or #src
        if ln>=s0 then
            local mark=ln==lineNum and "→ " or "  "
            table.insert(lines,mark..src:sub(cur,le))
        end
        if not nl then break end; cur=nl+1; ln=ln+1
    end
    return table.concat(lines,"\n")
end

DecompOne=function(scr)
    task.spawn(function()
        if not _JRM_Alive then return end
        while SEM>=SEM_MAX do
            if not _JRM_Alive then return end
            task.wait(0.05)
        end
        SEM=SEM+1
        local ok1,bc=pcall(getscriptbytecode,scr)
        if ok1 and bc and #bc>0 then
            local ok2,src=pcall(decompile,scr)
            if ok2 and type(src)=="string" and #src>2 then
                local _,fp=pcall(function() return scr:GetFullName() end)
                decompiledScripts[scr]={src=src,name=scr.Name,
                    path=type(fp)=="string" and fp or scr.Name,
                    stype=scr.ClassName,isExec=false}
            end
        end
        scanDone=scanDone+1; SEM=SEM-1
    end)
end

CollectScripts=function()
    local seen,list={},{}
    local CORE=game:GetService("CoreGui")
    local add=function(v)
        if seen[v] then return end; seen[v]=true
        if not (v:IsA("LocalScript") or v:IsA("ModuleScript")) then return end
        local ok,inCore=pcall(function() return v:IsDescendantOf(CORE) end)
        if ok and inCore then return end; table.insert(list,v)
    end
    if E.gist then local ok,res=pcall(getinstances); if ok and res then for _,v in ipairs(res) do add(v) end end end
    if E.gnil then local ok,res=pcall(getnilinstances); if ok and res then for _,v in ipairs(res) do add(v) end end end
    for _,v in ipairs(game:GetDescendants()) do add(v) end
    return list
end

StartScan=function()
    if _scanStarted then return end; _scanStarted=true
    if not E.dec or not E.gsb then
        ScanStatus.Text="⚠ decompile() no disponible en este executor"; return
    end
    task.spawn(function()
        ScanStatus.Text="Recolectando scripts..."; task.wait(0.05)
        local list=CollectScripts(); scanTotal=#list
        if scanTotal==0 then ScanStatus.Text="⚠ Sin scripts encontrados"; return end
        ScanStatus.Text=("Descompilando 0 / %d..."):format(scanTotal)
        for i,scr in ipairs(list) do
            if not _JRM_Alive then return end
            DecompOne(scr)
            if i%12==0 then task.wait(); ScanStatus.Text=("Descompilando %d / %d..."):format(scanDone,scanTotal) end
        end
        local t0=tick()
        while scanDone<scanTotal and tick()-t0<45 do
            if not _JRM_Alive then return end
            task.wait(0.4)
            ScanStatus.Text=("Descompilando %d / %d..."):format(scanDone,scanTotal)
        end
        if not _JRM_Alive then return end
        local cnt=0; for _ in pairs(decompiledScripts) do cnt=cnt+1 end
        scanReady=true
        ScanStatus.Text=("✅ %d scripts listos · escribe y presiona Buscar"):format(cnt)
    end)
end

