BtnPlayAll.MouseButton1Click:Connect(function()
    if _playbackActive then return end
    if #_routePoints==0 then Flash(BtnPlayAll,"Sin puntos!"); return end
    _playbackActive=true
    BtnPlayAll.Text="⏳"
    BtnPlayAll.BackgroundColor3=C.ORANGE:Lerp(Color3.fromRGB(0,0,0),0.40)
    task.spawn(function()
        for i,pt in ipairs(_routePoints) do
            if not _playbackActive or not _JRM_Alive then break end
            TeleportTo(pt.cf)
            RecStatusLbl.Text=("▶"..i.."/"..#_routePoints)
            task.wait(GetRecDelay())
        end
        if _JRM_Alive then
            _playbackActive=false
            BtnPlayAll.Text="▶▶ Play"
            BtnPlayAll.BackgroundColor3=C.PURP:Lerp(Color3.fromRGB(0,0,0),0.35)
            RecStatusLbl.Text=tostring(#_routePoints).."pts"
        end
    end)
end)

