dTgt=nil; dStart=nil; dPos=nil

BeginDrag=function(tgt)
    return function(inp)
        local ut=inp.UserInputType
        if ut==Enum.UserInputType.MouseButton1 or ut==Enum.UserInputType.Touch then
            dTgt=tgt; dStart=inp.Position; dPos=tgt.Position
        end
    end
end

