    "remote","fire","invoke","event","call","signal",
    "network","send","request","replicate","dispatch","emit"
}

local function SafeGet(obj,prop)
    local ok,v=pcall(function() return obj[prop] end); return ok and v or nil
end
local function SafeFullName(obj)
    local ok,v=pcall(function() return obj:GetFullName() end)
    return ok and type(v)=="string" and v or (SafeGet(obj,"Name") or "?")
end
local function HasNetKey(k)
    if type(k)~="string" then return false end
    local kl=k:lower()
    for _,pat in ipairs(NET_KEYS) do if kl:find(pat,1,true) then return true end end
    return false
end
local function IsCallable(t)
    if type(t)~="table" then return false end
    local ok,mt=pcall(getmetatable,t)
    if ok and type(mt)=="table" and type(rawget(mt,"__call"))=="function" then return true end
    if E.grm then
        local ok2,rmt=pcall(getrawmetatable,t)
        if ok2 and type(rmt)=="table" and type(rawget(rmt,"__call"))=="function" then return true end
    end
    return false
end
local function FuncDebugInfo(f)
    local name,src="?","?"
    pcall(function() name=debug.info(f,"n") or "?"; src=debug.info(f,"s") or "?" end)
    return name,src
end
local function TableNetSummary(t)
    local keys,fns,netKeys=0,0,{}
    for k,v in pairs(t) do
        keys=keys+1; if type(v)=="function" then fns=fns+1 end
        if HasNetKey(k) then table.insert(netKeys,tostring(k)) end
        if keys>100 then break end
    end
    return keys,fns,netKeys
end


-- ── Filtro de búsqueda sobre _gcData ─────────────────────────────
local function GetGCFiltered()
_gcData = _gcData or {}
    local q = GCSearchInput and GCSearchInput.Text:lower():match("^%s*(.-)%s*$") or ""
if q == nil or q == "" or q:match("^%s*$") then
    return _gcData or {}
end
    local out = {}
    for _, entry in ipairs(_gcData) do
        local name  = (entry.name  or ""):lower()
        local path  = (entry.path  or ""):lower()
        local cls   = (entry.cls   or ""):lower()
        local extra = (entry.extra or ""):lower()
        local typ   = (entry.type  or ""):lower()
        if name:find(q,1,true) or path:find(q,1,true)
        or cls:find(q,1,true)  or extra:find(q,1,true)
        or typ:find(q,1,true)  then
            table.insert(out, entry)
        end
    end
    return out
end

