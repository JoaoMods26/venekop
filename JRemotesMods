        Font=Enum.Font.GothamBold,TextSize=8,TextColor3=Color3.new(1,1,1),
        AutoButtonColor=false,ZIndex=3,Parent=row},{Cor(3)})
    -- ×
    local bDel=N("TextButton",{Size=UDim2.new(0,20,0,rowH-6),Position=UDim2.new(1,-32,0,3),
