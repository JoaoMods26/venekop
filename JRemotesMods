end
AddHistory=function(q)
    for i,v in ipairs(searchHistory) do if v==q then table.remove(searchHistory,i); break end end
    table.insert(searchHistory,1,q); if #searchHistory>10 then table.remove(searchHistory) end
    for _,v in ipairs(HistList:GetChildren()) do
        if not v:IsA("UIListLayout") and not v:IsA("UIPadding") then v:Destroy() end
    end
    for _,h in ipairs(searchHistory) do
        local hb=N("TextButton",{Name="ItemHistorial",Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,
            Text="🕐 "..h,Font=Enum.Font.Gotham,TextSize=9,TextColor3=C.DIM,
            TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,ZIndex=22,Parent=HistList})
        Hvr(hb,Color3.new(0,0,0),C.ITEMH)
        local hc=h; hb.MouseButton1Click:Connect(function() ScanInput.Text=hc; ShowHistory(false) end)
    end
end
