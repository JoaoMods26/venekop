TopBar.TouchLongPress:Connect(function(touches)
    if #touches>0 then dTgt=Main; dStart=touches[1].Position; dPos=Main.Position end
end)
UIS.InputChanged:Connect(function(inp)
    if not dTgt then return end
    local ut=inp.UserInputType
    if ut==Enum.UserInputType.MouseMovement or ut==Enum.UserInputType.Touch then
        local d=inp.Position-dStart
        dTgt.Position=UDim2.new(dPos.X.Scale,dPos.X.Offset+d.X,dPos.Y.Scale,dPos.Y.Offset+d.Y)
    end
end)
UIS.InputEnded:Connect(function(inp)
    local ut=inp.UserInputType
    if ut==Enum.UserInputType.MouseButton1 or ut==Enum.UserInputType.Touch then dTgt=nil end
end)

rAct=false; rStart=nil; rSz=nil
ResBtn.InputBegan:Connect(function(inp)
