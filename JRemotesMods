-- 4. LÓGICA DE ESCANEO  (snapshot único, procesado SÍNCRONO)
-- ══════════════════════════════════════════════════════════════════
local function RunGCScan()
    if _gcBusy then return end
    if not E.ggc then
        GCStatus.Text="⚠ getgc() no disponible en este executor"; return
    end
    _gcBusy=true
    ClearGCRes(); GCPageBar.Visible=false
    BtnGCScan.Text="⏳ Tomando snapshot..."
    BtnGCScan.BackgroundColor3=C.ORANGE:Lerp(Color3.fromRGB(0,0,0),0.45)
    GCStatus.Text="Llamando getgc(true)..."

    task.spawn(function()
        -- ┌─────────────────────────────────────────────────────────┐
        -- │ PASO 1: Obtener snapshot completo ANTES de cualquier    │
        -- │ task.wait(). Así el array gc no cambia mientras lo      │
        -- │ procesamos.                                             │
        -- └─────────────────────────────────────────────────────────┘
        local ok, gcRaw = pcall(getgc, true)
        if not ok or type(gcRaw)~="table" then
            GCStatus.Text="⚠ Error al llamar getgc(true)"
            BtnGCScan.Text="▶ Escanear Memoria  (getgc)"
            BtnGCScan.BackgroundColor3=C.CYAN:Lerp(Color3.fromRGB(0,0,0),0.38)
            _gcBusy=false; return
        end

        -- Copiar a tabla LOCAL para que el GC no la mueva mientras iteramos
        -- (algunos executors retornan una referencia viva que puede cambiar)
        local gcSnap = table.move(gcRaw, 1, #gcRaw, 1, table.create(#gcRaw))

        -- NilInstances (también copiamos)
        local nilSnap={}
        if _gcNilInst and E.gnil then
            local ok2,res=pcall(getnilinstances)
            if ok2 and type(res)=="table" then
                nilSnap=table.move(res,1,#res,1,table.create(#res))
            end
        end

        local totalSnap=#gcSnap+#nilSnap
        GCStatus.Text=("Procesando %d objetos..."):format(totalSnap)
        BtnGCScan.Text="⏳ Procesando..."

        -- ┌─────────────────────────────────────────────────────────┐
        -- │ PASO 2: Procesar el snapshot usando tablas hash para    │
        -- │ deduplicar. Usamos rawequal() para comparar userdata    │
        -- │ porque tostring() de userdata NO es estable entre GCs.  │
        -- └─────────────────────────────────────────────────────────┘
        -- Usamos weak tables para no retener refs innecesariamente
        local seenInst   = {}   -- [Instance ref] = true
        local seenFnKey  = {}   -- [name|src] = true
        local seenTblKey = {}   -- [tostring addr] = true  (tablas son menos críticas)

        local remotes   = {}
        local tables    = {}
        local callables = {}
        local funcs     = {}

        -- ── Función para intentar buscar el script de origen de una fn ──
        local function FindOriginScript(srcStr)
            if not srcStr or srcStr=="?" then return nil end
            -- El source en Roblox suele ser algo como "LocalScript" o el nombre del script
            local scriptName = srcStr:match("@(.+)$") or srcStr:match("=(.+)$") or srcStr
            -- Quitar path completo, quedarnos con el último segmento
            scriptName = scriptName:match("([^%.]+)$") or scriptName:match("([^/]+)$") or scriptName
            scriptName = scriptName:gsub("[^%w_]",""):sub(1,50)
            if scriptName=="" then return nil end
            for _,d in ipairs(game:GetDescendants()) do
                if (d:IsA("LocalScript") or d:IsA("ModuleScript")) and d.Name==scriptName then
                    return d
                end
            end
            return nil
        end

        -- ── Procesador (síncrono, sin task.wait aquí dentro) ─────
        local function Proc(item)
            local t=type(item)

            -- ════ USERDATA → posible Instance / Remote ═══════════
            if t=="userdata" then
                -- Verificar que sea una Instance de Roblox de forma segura
                local ok2,isInst=pcall(function() return typeof(item)=="Instance" end)
                if not (ok2 and isInst) then return end

                -- Dedup por referencia directa (rawequal)
                if seenInst[item] then return end
                seenInst[item]=true

                local ok3,cls=pcall(function() return item.ClassName end)
                if not ok3 or type(cls)~="string" then return end

                if not REMOTE_CLS[cls] then return end

                -- Filtro de categoría
                if gcCat~="remote" and gcCat~="all" then return end
                -- Filtro de clase
                if gcCls~="All" and gcCls~=cls then return end

                local name   = SafeGet(item,"Name") or "?"
                local par    = SafeGet(item,"Parent")
                local parName= par and (SafeGet(par,"Name") or "?") or "nil"
                local path

                if _gcShowFull then
                    path=SafeFullName(item)
                else
                    path=par and SafeFullName(item) or "[⚠ sin parent — oculto en memoria]"
                end

                table.insert(remotes,{
                    type="remote", name=name, cls=cls,
                    path=path, inst=item,
                    extra="Parent: "..(par and parName or "nil  ← remote oculto")
                })
                return
            end

            -- ════ TABLA ══════════════════════════════════════════
            if t=="table" then
                local addr=tostring(item)
                if seenTblKey[addr] then return end
                seenTblKey[addr]=true

                -- Ignorar tablas propias del JRM
                local isSelf=pcall(function()
                    if rawget(item,"__JRMINTERNAL") then error() end
                    if rawget(item,"_JRM_Alive")    then error() end
                end)
                if not isSelf then return end

                -- ¿Es callable?
                if IsCallable(item) then
                    if gcCat=="callable" or gcCat=="all" or gcCat=="table" then
                        local keys,fns=0,0
                        pcall(function()
                            for _,v in pairs(item) do
                                keys=keys+1
                                if type(v)=="function" then fns=fns+1 end
                                if keys>80 then return end
                            end
                        end)
                        table.insert(callables,{
                            type="callable",name="callable_obj",cls="Table+__call",
                            path="GC: "..addr:sub(1,32),
                            extra=("keys:%d  fns:%d  __call presente"):format(keys,fns)
                        })
                    end
                    return
                end

                -- Tabla con claves de red
                if (gcCat=="table" or gcCat=="all") and _gcDeepTbl then
                    local ok4,keys,fns,netKeys=pcall(TableNetSummary,item)
                    if ok4 and #netKeys>0 then
                        local keyStr=table.concat(netKeys,", "):sub(1,60)
                        table.insert(tables,{
                            type="table",
                            name=("net_table[%d keys]"):format(keys),
                            cls="Table",
                            path="GC: "..addr:sub(1,32),
                            extra=("keys:%d  fns:%d  🔑 %s"):format(keys,fns,keyStr),
                            rawKeys=netKeys
                        })
                    end
                end
                return
            end

            -- ════ FUNCIÓN ════════════════════════════════════════
            if t=="function" then
                if gcCat~="func" and gcCat~="all" then return end

                local name,src=FuncDebugInfo(item)

                if not src or src=="?" then return end
                -- Filtrar JRM y executor internals
                if src:find("JRemotesMods") or src:find("JRM") then return end
                if src:find("CoreScript") or src=="=[C]" then return end

                -- Solo scripts de juego
                local isGame=src:find("LocalScript") or src:find("ModuleScript")
                           or src:find("Script") or src:match("^@")
                           or src:match("^=[A-Z][a-z]")
                if not isGame then return end

                local fkey=(name or "?").."|"..(src or "?")
                if seenFnKey[fkey] then return end
                seenFnKey[fkey]=true

                local originScript=FindOriginScript(src)

                table.insert(funcs,{
                    type="func",
                    name=name~="?" and name or ("fn@"..src:sub(-26)),
                    cls="Function",
                    path=src:sub(1,64),
                    extra="",
                    originScript=originScript
                })
                return
            end
        end

        -- ── Iterar snapshot en batches CON task.wait entre ellos ─
        -- Importante: task.wait es ENTRE batches, no dentro de Proc()
        -- Así el snapshot no cambia (ya está copiado en gcSnap)
        local BATCH=500
        local n=#gcSnap
        for bStart=1,n,BATCH do
            if not _JRM_Alive then _gcBusy=false; return end
            local bEnd=math.min(bStart+BATCH-1,n)
            for i=bStart,bEnd do
                pcall(Proc,gcSnap[i])
            end
            local pct=math.floor(bEnd/n*100)
            GCStatus.Text=("Procesando... %d%% (%d/%d)"):format(pct,bEnd,n)
            task.wait()   -- ceder frame SOLO entre batches, no dentro del loop
        end

        -- NilInstances (pocas, procesamos de corrido)
        for _,item in ipairs(nilSnap) do
            if not _JRM_Alive then _gcBusy=false; return end
            local ok5,cls=pcall(function() return item.ClassName end)
            if ok5 and REMOTE_CLS[cls] and not seenInst[item] then
                seenInst[item]=true
                if (gcCat=="remote" or gcCat=="all") and (gcCls=="All" or gcCls==cls) then
                    local name=SafeGet(item,"Name") or "?"
                    table.insert(remotes,{
                        type="remote",name=name,cls=cls,
                        path="[NilInstance — parent=nil]",inst=item,
                        extra="⚠ NilInstance: parent = nil"
                    })
                end
            end
        end

        if not _JRM_Alive then _gcBusy=false; return end

        -- ┌─────────────────────────────────────────────────────────┐
        -- │ PASO 3: Construir _gcData de forma FINAL e inmutable    │
        -- │ Orden: remote → callable → table → func                │
        -- └─────────────────────────────────────────────────────────┘
        table.sort(remotes,   function(a,b) return a.name:lower()<b.name:lower() end)
