AnalyzeDeep=function(src, scriptName)
    if not src or #src < 2 then return nil end

    local result = {
        remotes      = {},   -- llamadas a remotes detectadas
        requires     = {},   -- módulos requeridos
        functions    = {},   -- funciones definidas
        websockets   = {},   -- patrones WebSocket / callRemote
        strings      = {},   -- strings relevantes encontrados
        summary      = "",
    }

    -- ── 1. Detectar callRemote / WebSocket patterns ─────────────────
    -- Patrón: algo.callRemote("RemoteName", "Method", ...)
    for varName, remoteName, method in src:gmatch(
        '([%w_]+)%.callRemote%s*%(%s*"([^"]+)"%s*,%s*"([^"]+)"'
    ) do
        table.insert(result.websockets, {
            var=varName, remote=remoteName, method=method,
            label=varName..'.callRemote("'..remoteName..'", "'..method..'")'
        })
    end
    -- Patrón alternativo: algo.callRemote("RemoteName", "Method" sin segundo arg
    for varName, remoteName in src:gmatch(
        '([%w_]+)%.callRemote%s*%(%s*"([^"]+)"%s*[,%)]'
    ) do
        local already=false
        for _,w in ipairs(result.websockets) do
            if w.var==varName and w.remote==remoteName then already=true; break end
        end
        if not already then
            table.insert(result.websockets,{var=varName,remote=remoteName,method="?",
                label=varName..'.callRemote("'..remoteName..'")'})
        end
    end

    -- ── 2. FireServer / InvokeServer directos ──────────────────────
    for remotePath, method in src:gmatch('([%w%._%[%]"]+)%s*:%s*(FireServer|InvokeServer|fireServer|invokeServer)%s*%(') do
        table.insert(result.remotes, {path=remotePath, method=method})
    end
    -- Patrón más corto: variable:FireServer(
    for varName, method in src:gmatch('([%w_]+)%s*:%s*(FireServer|InvokeServer)%s*%(') do
        local already=false
        for _,r in ipairs(result.remotes) do
            if r.path==varName and r.method==method then already=true; break end
        end
        if not already then
            table.insert(result.remotes,{path=varName,method=method})
        end
    end

    -- ── 3. Require calls con nombre ────────────────────────────────
    for arg in src:gmatch('require%s*%(%s*([^%)]+)%s*%)') do
        arg=arg:match("^%s*(.-)%s*$")
        -- intentar obtener nombre legible
        local niceName=arg
        -- si es algo como v1.Modules.WebSocket → WebSocket
        niceName=arg:match('%.([%w_]+)%s*$') or arg
        table.insert(result.requires,{raw=arg, name=niceName})
    end

    -- ── 4. Funciones definidas ─────────────────────────────────────
    for cls, fn in src:gmatch('function%s+([%w_]+)%.([%w_]+)%s*%(') do
        table.insert(result.functions, cls.."."..fn)
    end
    for fn in src:gmatch('function%s+([%w_]+)%s*%(') do
        -- solo funciones sueltas
        if not fn:find("%.") then
            table.insert(result.functions, fn)
        end
    end

    -- ── 5. Strings relevantes (rutas, nombres, IDs) ───────────────
    local seenStr={}
    for s in src:gmatch('"([^"]{4,60})"') do
        if not seenStr[s] and not s:match("^%-%-") then
            seenStr[s]=true
            -- filtrar strings que parecen nombres de remote / método
            if s:match("^[A-Z]") or s:match("spawn") or s:match("Vehicle")
            or s:match("Handler") or s:match("System") or s:match("Remote")
            or s:match("Event") or s:match("Module") then
                table.insert(result.strings,s)
            end
        end
    end

    -- ── Resumen ────────────────────────────────────────────────────
    local lines={}
    table.insert(lines, "═══ ANÁLISIS: "..scriptName.." ═══\n")

    if #result.websockets>0 then
        table.insert(lines,"── WebSocket / callRemote ──")
        for _,w in ipairs(result.websockets) do
            table.insert(lines,"  🌐 Remote : "..w.remote)
            table.insert(lines,"     Método : "..w.method)
            table.insert(lines,"     Var    : "..w.var)
        end
        table.insert(lines,"")
    end

    if #result.remotes>0 then
        table.insert(lines,"── FireServer / InvokeServer ──")
        for _,r in ipairs(result.remotes) do
            table.insert(lines,"  🔥 "..r.path.." → "..r.method)
        end
        table.insert(lines,"")
    end

    if #result.requires>0 then
        table.insert(lines,"── Módulos requeridos ──")
        for _,r in ipairs(result.requires) do
            table.insert(lines,"  📦 "..r.name.."  ("..r.raw:sub(1,50)..")")
        end
        table.insert(lines,"")
    end

    if #result.functions>0 then
        table.insert(lines,"── Funciones definidas ──")
        for _,f in ipairs(result.functions) do
            table.insert(lines,"  ƒ  "..f)
        end
        table.insert(lines,"")
    end

    if #result.strings>0 then
        table.insert(lines,"── Strings relevantes ──")
        for _,s in ipairs(result.strings) do
            table.insert(lines,'  "  '..s..'"')
        end
        table.insert(lines,"")
    end

    if #result.websockets==0 and #result.remotes==0 and #result.requires==0 then
        table.insert(lines,"  (sin patrones detectados en este script)")
    end

    result.summary=table.concat(lines,"\n")
    return result
end

-- Busca instancia de módulo por nombre raw del require
ResolveRequireInst=function(rawArg)
    -- limpiar variable prefixes como v1.Modules.X → buscar X
    local lastName = rawArg:match('%.([%w_]+)%s*$') or rawArg:match('^([%w_]+)$')
    if not lastName then return nil end
    for _,d in ipairs(game:GetDescendants()) do
        if (d:IsA("ModuleScript") or d:IsA("LocalScript")) and d.Name==lastName then
            return d
        end
    end
    return nil
end

