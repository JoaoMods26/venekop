-- Lógica selector
_selectorActive=false
_selectedObjData={name="",path="",posV3="",posCF="",size="",parent=""}

UpdateObjPanel=function(inst)
    if not inst or typeof(inst)~="Instance" then return end
    local name=inst.Name
    local cls=inst.ClassName
    local path=GetPath(inst)
    local posV3s,cfs,sizeS="—","—","—"
    local parentName=inst.Parent and inst.Parent.Name or "nil"
    -- Intentar obtener posicion / size
    local ok1,pos=pcall(function() return inst.Position end)
    local ok2,cf=pcall(function() return inst.CFrame end)
    local ok3,sz=pcall(function() return inst.Size end)
    if ok1 and typeof(pos)=="Vector3" then
        posV3s=("Vector3.new(%.3f, %.3f, %.3f)"):format(pos.X,pos.Y,pos.Z)
    end
    if ok2 and typeof(cf)=="CFrame" then
        local c={cf:GetComponents()}
        cfs=("CFrame.new(%.3f,%.3f,%.3f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f)"):format(table.unpack(c))
    end
    if ok3 and typeof(sz)=="Vector3" then
        sizeS=("Vector3.new(%.3f, %.3f, %.3f)"):format(sz.X,sz.Y,sz.Z)
    end
    ObjNameLbl.Text="Nombre: "..name
    ObjClassLbl.Text="Clase: "..cls
    ObjPathLbl.Text="Ruta: "..path
    ObjPosLbl.Text="Pos: "..posV3s
    ObjCFLbl.Text="CF: "..cfs:sub(1,55)
    ObjSizeLbl.Text="Size: "..sizeS
    ObjParentLbl.Text="Parent: "..parentName
    _selectedObjData={name=name,path=path,posV3=posV3s,posCF=cfs,size=sizeS,parent=parentName}
end

