    if ut==Enum.UserInputType.MouseButton1 or ut==Enum.UserInputType.Touch then
        rAct=true; rStart=inp.Position; rSz=Main.Size
    end
end)
UIS.InputChanged:Connect(function(inp)
    if not rAct then return end
    local ut=inp.UserInputType
    if ut==Enum.UserInputType.MouseMovement or ut==Enum.UserInputType.Touch then
        local d=inp.Position-rStart
        Main.Size=UDim2.new(0,math.max(MINW,rSz.X.Offset+d.X),0,math.max(MINH,rSz.Y.Offset+d.Y))
    end
