GetCharPos=function()
    local lp=Players.LocalPlayer
    if not lp then return nil,nil end
    local ch=lp.Character
    if not ch then return nil,nil end
    local hrp=ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChildWhichIsA("BasePart")
    if not hrp then return nil,nil end
    return hrp.Position, hrp.CFrame
end

TeleportTo=function(cf)
    local lp=Players.LocalPlayer
    if not lp then return end
    local ch=lp.Character
    if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame=cf end
end

UpdatePosLabels=function()
    local v3,cf=GetCharPos()
    if not v3 then
        PosV3Label.Text="V3: sin personaje"
        PosCFLabel.Text="CF: sin personaje"
        return
    end
    local v3s=("Vector3.new(%.3f, %.3f, %.3f)"):format(v3.X,v3.Y,v3.Z)
    local cfc={cf:GetComponents()}
    local cfs=("CFrame.new(%.3f,%.3f,%.3f, %.4f,%.4f,%.4f, %.4f,%.4f,%.4f, %.4f,%.4f,%.4f)"):format(table.unpack(cfc))
    PosV3Label.Text="V3: "..("%.2f, %.2f, %.2f"):format(v3.X,v3.Y,v3.Z)
    PosCFLabel.Text="CF: "..("%.2f, %.2f, %.2f"):format(v3.X,v3.Y,v3.Z)
    _lastV3Str=v3s; _lastCFStr=cfs
end

GetLiveDelay=function()
    local v=tonumber(LiveDelayBox and LiveDelayBox.Text) or 0.1
    return math.max(0.05,math.min(v,60))
end
GetRecDelay=function()
    local v=tonumber(RecDelayBox and RecDelayBox.Text) or 0.25
    return math.max(0.05,math.min(v,60))
end

