    local GridMath = {}

    GridMath.UNIT = 2
    GridMath.TILE_STUDS = 8

    function GridMath.layout(base)

        local size = base.Size

        return {
            columns = math.floor(
                size.X / GridMath.TILE_STUDS
            ),

            rows = math.floor(
                size.Z / GridMath.TILE_STUDS
            )
        }

    end

    function GridMath.nearestCorner(base, worldPosition)

        local localPosition =
            base.CFrame:PointToObjectSpace(
                worldPosition
            )

        return {
            x =
                math.floor(
                    localPosition.X / GridMath.UNIT + 0.5
                ) * GridMath.UNIT,

            z =
                math.floor(
                    localPosition.Z / GridMath.UNIT + 0.5
                ) * GridMath.UNIT
        }

    end

    function GridMath.cornerToWorld(base, corner)

        return base.CFrame:PointToWorldSpace(
            Vector3.new(
                corner.x,
                0,
                corner.z
            )
        )

    end


    --==================================================
    -- SERIALIZER LOCAL
    --==================================================

    local Serializer = {}

    local Writer = {}
    Writer.__index = Writer

    function Serializer.newWriter()

        return setmetatable({
            len = 0,
            b = buffer.create(64)
        }, Writer)

    end

    function Writer:_ensure(amount)

        local needed = self.len + amount
        local size = buffer.len(self.b)

        if size >= needed then
            return
        end

        while size < needed do
            size *= 2
        end

        local newBuffer = buffer.create(size)

        buffer.copy(
            newBuffer,
            0,
            self.b,
            0,
            self.len
        )

        self.b = newBuffer

    end

    function Writer:u8(value)

        self:_ensure(1)

        buffer.writeu8(
            self.b,
            self.len,
            value
        )

        self.len += 1

    end

    function Writer:u32(value)

        self:_ensure(4)

        buffer.writeu32(
            self.b,
            self.len,
            value
        )

        self.len += 4

    end

    function Writer:f64(value)

        self:_ensure(8)

        buffer.writef64(
            self.b,
            self.len,
            value
        )

        self.len += 8

    end

    function Writer:str(value)

        local length = #value

        self:u32(length)

        self:_ensure(length)

        buffer.writestring(
            self.b,
            self.len,
            value,
            length
        )

        self.len += length

    end

    function Writer:finish()

        local result =
            buffer.create(self.len)

        buffer.copy(
            result,
            0,
            self.b,
            0,
            self.len
        )

        return result

    end


    --==================================================
    -- SERIALIZAR VALOR
    --==================================================

    local function writeValue(writer, value)

        local valueType = typeof(value)

        if value == nil then

            writer:u8(0)

            return

        end

        if valueType == "boolean" then

            writer:u8(
                value and 2 or 1
            )

            return

        end

        if valueType == "number" then

            writer:u8(3)
            writer:f64(value)

            return

        end

        if valueType == "string" then

            writer:u8(4)
            writer:str(value)

            return

        end

        if valueType ~= "table" then

            error(
                "Jmods Serializer: tipo no soportado: "
                .. tostring(valueType)
            )

        end

        writer:u8(5)

        local arrayCount = #value

        writer:u32(arrayCount)

        for i = 1, arrayCount do

            writeValue(
                writer,
                value[i]
            )

        end

        local hashCount = 0

        for key in value do

            if typeof(key) ~= "number"
                or key < 1
                or key > arrayCount
                or key % 1 ~= 0 then

                hashCount += 1

            end

        end

        writer:u32(hashCount)

        for key, val in value do

            if typeof(key) ~= "number"
                or key < 1
                or key > arrayCount
                or key % 1 ~= 0 then

                writeValue(writer, key)
                writeValue(writer, val)

            end

        end

    end


