    local function getPlaqueInfo(plot)

        local container = plot:FindFirstChild("Container")
        if not container then
            return "Desconocido", "?", "?"
        end

        local sign = container:FindFirstChild("Sign")
        if not sign then
            return "Desconocido", "?", "?"
        end

        local cube = sign:FindFirstChild("Cube")
        if not cube then
            return "Desconocido", "?", "?"
        end

        local surfaceGui = cube:FindFirstChild("SurfaceGui")
        if not surfaceGui then
            return "Desconocido", "?", "?"
        end

        local plaque = surfaceGui:FindFirstChild("Plaque")
        if not plaque then
            return "Desconocido", "?", "?"
        end

        -- EXACTAMENTE como aparece en tu Explorer
        local nameLabel = plaque:FindFirstChild("name")
        local priceLabel = plaque:FindFirstChild("price")
        local userLabel = plaque:FindFirstChild("user")

        local name = "Desconocido"
        local price = "?"
        local user = "Desconocido"

        if nameLabel then
            if nameLabel:IsA("TextLabel")
            or nameLabel:IsA("TextButton")
            or nameLabel:IsA("TextBox") then

                name = nameLabel.Text
            end
        end

        if priceLabel then
            if priceLabel:IsA("TextLabel")
            or priceLabel:IsA("TextButton")
            or priceLabel:IsA("TextBox") then

                price = priceLabel.Text
            end
        end

        if userLabel then
            if userLabel:IsA("TextLabel")
            or userLabel:IsA("TextButton")
            or userLabel:IsA("TextBox") then

                user = userLabel.Text
            end
        end

        return name, price, user
    end

