        local function edgeContainsPoint(
            a,
            b,
            px,
            pz
        )

            local ax =
                a.x * POINTS_PER_CORNER

            local az =
                a.z * POINTS_PER_CORNER

            local bx =
                b.x * POINTS_PER_CORNER

            local bz =
                b.z * POINTS_PER_CORNER

            local dx =
                bx - ax

            local dz =
                bz - az

            if dx == 0 and dz == 0 then
                return false
            end

            if dx * (pz - az)
            ~= dz * (px - ax) then

                return false
            end

            if px < math.min(ax, bx)
            or px > math.max(ax, bx)
            or pz < math.min(az, bz)
            or pz > math.max(az, bz) then

                return false
            end

            return true
        end

        local function edgeParallel(
            a,
            b,
            sx,
            sz
        )

            local dx =
                b.x - a.x

            local dz =
                b.z - a.z

            return
                sx * dz
                == sz * dx
        end

        local function edgeKey(a, b)

            local ax = a.x
            local az = a.z
            local bx = b.x
            local bz = b.z

            if bx < ax
            or (bx == ax and bz < az) then

                ax, az, bx, bz =
                    bx, bz, ax, az

            end

            return
                tostring(ax)
                .. ","
                .. tostring(az)
                .. ">"
                .. tostring(bx)
                .. ","
                .. tostring(bz)
        end

