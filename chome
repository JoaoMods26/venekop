                local pointAString,
                    pointBString =
                    wallPoints:match(
                        "^([^>]+)>([^>]+)$"
                    )

                if pointAString
                and pointBString then

                    local ax, az =
                        pointAString:match(
                            "^(%-?%d+),(%-?%d+)$"
                        )

                    local bx, bz =
                        pointBString:match(
                            "^(%-?%d+),(%-?%d+)$"
                        )

                    ax = tonumber(ax)
                    az = tonumber(az)
                    bx = tonumber(bx)
                    bz = tonumber(bz)

                    if ax and az and bx and bz then

                        local dx =
                            bx - ax

                        local dz =
                            bz - az

                        local count =
                            math.max(
                                math.abs(dx),
                                math.abs(dz)
                            )

                        if count > 0 then

                            local stepWallX =
                                dx / count

                            local stepWallZ =
                                dz / count

                            local currentX =
                                ax

                            local currentZ =
                                az

                            for i = 1, count do

                                local nextX =
                                    currentX
