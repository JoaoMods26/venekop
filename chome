    --==================================================

    local function invokeRoute(routeId, payload)

        requestId += 1

        local currentRequestId =
            requestId

        local writer =
            Serializer.newWriter()

        -- packet type
        writer:u8(1)

        -- route ID
        writer:u32(routeId)

        -- request ID
        writer:u32(currentRequestId)

        -- payload
        writeValue(
            writer,
            payload
        )

        local packet =
            writer:finish()

        --print(
    --        "[JMODS NET] Enviando request:",
    --        currentRequestId,
    --        "Route:",
    --        routeId
    --    )

        Replication:FireServer(packet)

        return {

            requestId = currentRequestId,

            andThen = function(self, callback)
                pcall(callback, true)
                return self
            end,

            catch = function(self, callback)

                return self

            end

        }

    end


