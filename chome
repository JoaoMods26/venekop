    local function parseRoofKey(key)

        if typeof(key) ~= "string" then
            return nil
        end

        local levelString
        local designId
        local heightString
        local overhangString
        local polygonString

        levelString,
        designId,
        heightString,
        overhangString,
        polygonString =
            string.match(
                key,
                "^(%d+)|([^|]+)|([^|]+)|([^|]+)|(.+)$"
            )

        if not levelString
        or not designId
        or not polygonString then
            return nil
        end

        local level = tonumber(levelString)
        local height = tonumber(heightString)
        local overhang = tonumber(overhangString)

        if not level
        or not height
        or not overhang then
            return nil
        end

        local points = {}

        for pointString in string.gmatch(
            polygonString,
            "[^>]+"
        ) do

            local xString
            local zString =
                pointString:match(
                    "^([^,]+),([^,]+)$"
                )

            xString, zString =
                pointString:match(
                    "^([^,]+),([^,]+)$"
                )

            local x = tonumber(xString)
            local z = tonumber(zString)

            if not x or not z then
                return nil
            end

            table.insert(points, {
                x = x,
                z = z
            })

        end

        if #points < 3 then
            return nil
        end

        return {
            designId = designId,
            points = points,
            height = height,
            overhang = overhang,
            level = level
        }

    end
    local function getPaintData(object)
        local part = nil

        if object:IsA("BasePart") then
            part = object
        else
            for _, descendant in ipairs(object:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    part = descendant
                    break
                end
            end
        end

        if not part then
            return nil
        end

        local color = part.Color

        local colorNumber =
            math.round(color.R * 255) * 65536
            + math.round(color.G * 255) * 256
            + math.round(color.B * 255)

        local material = part.Material
        local variant = part.MaterialVariant

        local paint = {
            c = colorNumber
        }

        if material ~= Enum.Material.Plastic
            or variant ~= "" then

            paint.m = material.Name

            if variant ~= "" then
                paint.v = variant
            end
        end

        return paint
    end

