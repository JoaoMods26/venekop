    local function parseStairKey(key)

        if typeof(key) ~= "string" then
            return nil
        end

        local levelString
        local styleId
        local widthString
        local riseString
        local depthString
        local railsString
        local turnsString
        local pointsString

        levelString,
        styleId,
        widthString,
        riseString,
        depthString,
        railsString,
        turnsString,
        pointsString =
            string.match(
                key,
                "^(%d+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)|(%d+)|(%a*)|([%d%-,]+)$"
            )

        if not levelString
        or not styleId
        or not pointsString then
            return nil
        end

        local level = tonumber(levelString)
        local width = tonumber(widthString)
        local rise = tonumber(riseString)
        local depth = tonumber(depthString)
        local railsCode = tonumber(railsString)

        if not level
        or not width
        or not rise
        or not depth
        or railsCode == nil then
            return nil
        end

        --==============================
        -- POINTS
        --==============================

        local numbers = {}

        for numberString in string.gmatch(pointsString, "[^,]+") do

            local number = tonumber(numberString)

            if not number or number % 1 ~= 0 then
                return nil
            end

            table.insert(numbers, number)

        end

        if #numbers < 4
        or #numbers % 2 ~= 0 then
            return nil
        end

        local points = {}

        for i = 1, #numbers, 2 do

            table.insert(points, {
                x = numbers[i],
                z = numbers[i + 1]
            })

        end

        --==============================
        -- TURNS
        --==============================

        local turns = {}

        for i = 1, #turnsString do

            local character =
                string.sub(
                    turnsString,
                    i,
                    i
                )

            if character == "l" then

                table.insert(
                    turns,
                    "landing"
                )

            elseif character == "w" then

                table.insert(
                    turns,
                    "winder"
                )

            else

                return nil

            end

        end

        --==============================
        -- RAILS
        --==============================

        local rails = {
            left = railsCode % 2 == 1,
            right = railsCode % 4 >= 2
        }

        -- Una escalera con N puntos
        -- necesita N - 2 turns.
        if #turns ~= math.max(0, #points - 2) then
            return nil
        end

        return {
            styleId = styleId,
            level = level,
            points = points,
            turns = turns,
            width = width,
            rise = rise,
            depth = depth,
            rails = rails
        }

    end


