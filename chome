    local function normalizeUser(text)
        text = tostring(text or "")
        text = text:gsub("^@", "")
        text = text:gsub("^%s+", "")
        text = text:gsub("%s+$", "")
        return text:lower()
    end

    local function getMyPlot()
        local myName = normalizeUser(LocalPlayer.Name)
        local myDisplayName = normalizeUser(LocalPlayer.DisplayName)

        for _, plot in ipairs(PlotsFolder:GetChildren()) do
            if plot:IsA("Model") then
                local _, _, user = getPlaqueInfo(plot)
                local plaqueUser = normalizeUser(user)

                if plaqueUser == myName or plaqueUser == myDisplayName then
                    return plot
                end
            end
        end

        return nil
    end

    local function makePlotText(plot, index)
        local name, price, user = getPlaqueInfo(plot)

        return tostring(name)
            .. " | "
            .. tostring(user)
            .. " | $"
            .. tostring(price)
            .. " | SLOT "
            .. tostring(index)
    end

