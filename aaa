 function ActivarAntiCaida()
    local Jugador = game.Players.LocalPlayer
    local personaje = Jugador.Character or Jugador.CharacterAdded:Wait()
    local Raiz = personaje:WaitForChild("HumanoidRootPart")
    
    if antiCaidaConnection then
        antiCaidaConnection:Disconnect()
    end
    
    antiCaidaConnection = Latido:Connect(function()
        if not Raiz.Parent then
            antiCaidaConnection:Disconnect()
            antiCaidaConnection = nil
            return
        end
        local velocidadAnt = Raiz.AssemblyLinearVelocity
        Raiz.AssemblyLinearVelocity = VelocidadNula
        Render:Wait()
        Raiz.AssemblyLinearVelocity = velocidadAnt
    end)
end

function DesactivarAntiCaida()
    if antiCaidaConnection then
        antiCaidaConnection:Disconnect()
        antiCaidaConnection = nil
    end
end

function VerificarYActualizarAntiCaida()
    if doggyEnabled or pataEnabled or cariEnabled or wataEnabled or perroEnabled then
        if not antiCaidaConnection then
            ActivarAntiCaida()
        end
    else
        DesactivarAntiCaida()
    end
end

 function SetNoCollision(char, state)
    if state then
        savedCollisions[char] = {}
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                savedCollisions[char][part] = part.CanCollide
                part.CanCollide = false
            end
        end
    else
        if savedCollisions[char] then
            for part, original in pairs(savedCollisions[char]) do
                if part and part:IsA("BasePart") then
                    part.CanCollide = original
                end
            end
            savedCollisions[char] = nil
        end
    end
end

 function PlayWata(target)
    if not target or not target.Character then return end
    local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    local targetRoot = target.Character:WaitForChild("HumanoidRootPart")
    if not humanoid or not root or not targetRoot then return end

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. wataAnimId
    local track = humanoid:LoadAnimation(anim)
    track:Play()
    track.TimePosition = wataAnimTime
    track:AdjustSpeed(0)

    humanoid.AutoRotate = false
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    SetNoCollision(char, true)

    do
        local offsetPosition = targetRoot.Position + targetRoot.CFrame.LookVector * wataCurrentDistance + Vector3.new(0, 0.23, 0)
        SetPhysicsRepRootPart(root, targetRoot)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.lookAt(offsetPosition, targetRoot.Position)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    wataConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if not targetRoot.Parent then return end

        wataCurrentDistance = wataCurrentDistance + (wataSpeed * wataDirection * dt)

        if wataCurrentDistance >= (movementDistanceChanged and movementDistance or wataTargetDistance) then
            wataDirection = -1
        elseif wataCurrentDistance <= 1.2 then
            wataDirection = 1
        end

        local offsetPosition = targetRoot.Position + targetRoot.CFrame.LookVector * wataCurrentDistance + Vector3.new(0, 0.23, 0)
        SetPhysicsRepRootPart(root, targetRoot)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.lookAt(offsetPosition, targetRoot.Position)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

 function StopWata()
    local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if wataConnection then
        wataConnection:Disconnect()
        wataConnection = nil
    end

    if humanoid then
        humanoid.AutoRotate = true
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        for _, track in humanoid:GetPlayingAnimationTracks() do
            if tostring(track.Animation.AnimationId):find(tostring(wataAnimId)) then
                track:Stop()
            end
        end
    end

    if char then
        SetNoCollision(char, false)
    end
end

