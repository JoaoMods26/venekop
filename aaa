local espHighlight = nil
 
local function ApplyESPHighlight(character)
    if not character then return end
 
    if espHighlight then
        espHighlight:Destroy()
        espHighlight = nil
    end
 
    espHighlight = Instance.new("Highlight")
    espHighlight.Name = "SelectedPlayerESP"
    espHighlight.FillColor = Color3.fromRGB(255, 60, 60)
    espHighlight.FillTransparency = 0.5
    espHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    espHighlight.OutlineTransparency = 0
    espHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    espHighlight.Parent = character
end
 
local function RemoveESPHighlight()
    if espHighlight then
        espHighlight:Destroy()
        espHighlight = nil
    end
end

 
local espBoxDrawing = nil
local espNameDrawing = nil
local espBoxConnection = nil
 
local function CreateESPBoxDrawings()
    espBoxDrawing = Drawing.new("Square")
    espBoxDrawing.Thickness = 1.5
    espBoxDrawing.Color = Color3.fromRGB(255, 60, 60)
    espBoxDrawing.Filled = false
    espBoxDrawing.Visible = false
 
    espNameDrawing = Drawing.new("Text")
    espNameDrawing.Size = 14
    espNameDrawing.Center = true
    espNameDrawing.Outline = true
    espNameDrawing.Color = Color3.fromRGB(255, 255, 255)
    espNameDrawing.Visible = false
end
 
local function RemoveESPBoxDrawings()
    if espBoxDrawing then
        espBoxDrawing:Remove()
        espBoxDrawing = nil
    end
    if espNameDrawing then
        espNameDrawing:Remove()
        espNameDrawing = nil
    end
end
 
local function StartESPBox()
    if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then
        Rayfield:Notify({
            Title = "ESP Box",
            Content = "Tu executor no soporta la librería Drawing.",
            Duration = 3,
            Image = 4483362458
        })
        return
    end
 
    CreateESPBoxDrawings()
 
    espBoxConnection = RunService.RenderStepped:Connect(function()
        if not espEnabled or not espTarget then
            if espBoxDrawing then espBoxDrawing.Visible = false end
            if espNameDrawing then espNameDrawing.Visible = false end
            return
        end
 
        local char = espTarget.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
 
        if not hrp or not head then
            espBoxDrawing.Visible = false
            espNameDrawing.Visible = false
            return
        end
 
        local camera = workspace.CurrentCamera
        local topPos, topVisible = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.4, 0))
        local botPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
 
        if not topVisible or topPos.Z < 0 then
            espBoxDrawing.Visible = false
            espNameDrawing.Visible = false
            return
        end
 
        local height = math.abs(topPos.Y - botPos.Y)
        local width = height * 0.55
 
        espBoxDrawing.Size = Vector2.new(width, height)
        espBoxDrawing.Position = Vector2.new(topPos.X - width / 2, topPos.Y)
        espBoxDrawing.Visible = true
 
        espNameDrawing.Text = espTarget.Name
        espNameDrawing.Position = Vector2.new(topPos.X, topPos.Y - 16)
        espNameDrawing.Visible = true
    end)
end
 
local function StopESPBox()
    if espBoxConnection then
        espBoxConnection:Disconnect()
        espBoxConnection = nil
    end
    RemoveESPBoxDrawings()
end
 
 
local function ApplyESPForType(character)
    if espType == "Highlight" or espType == "Ambos" then
        ApplyESPHighlight(character)
    end
    if espType == "Box" or espType == "Ambos" then
        if not espBoxConnection then
            StartESPBox()
        end
    end
end
 
local function RemoveAllESP()
