local function SetPhysicsRepRootPart(root, targetRoot)
    if not root or not targetRoot or not targetRoot.Parent then
        return
    end

    pcall(function()
        if type(sethiddenproperty) == "function" then sethiddenproperty(root, "PhysicsRepRootPart", targetRoot) end
    end)
end

