local function ReapplyOrbit()
    if not orbitEnabled or not selectedPlayer or not selectedPlayer.Character then
        return
    end

    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end

    local localChar = LocalPlayer.Character
    if not localChar then
        return
    end

    local angle = 0
    SaveCollisions(localChar)

    orbitConnection = RunService.Heartbeat:Connect(function(dt)
        if not orbitEnabled or not selectedPlayer then
            return
        end

        local currentChar = LocalPlayer.Character
        local targetChar = selectedPlayer.Character
        local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

        if not hrp or not targetHRP then
            return
        end

        angle = angle + orbitSpeed * dt

        local offset = Vector3.new(
            math.cos(angle) * orbitDistance,
            0,
            math.sin(angle) * orbitDistance
        )

        SetPhysicsRepRootPart(hrp, targetHRP)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(targetHRP.Position + offset, targetHRP.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)

    for _, part in pairs(localChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

