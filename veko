-- ────────────────────────────────────────────────────────────────
-- Reposicionar
-- ────────────────────────────────────────────────────────────────
function RepositionObject(guid, obj, targetCFrame, finalSize)
	local rootObj = ResolveRootObject(obj)
	if not rootObj or not rootObj.Parent then return false end

	local function readCF()
		if not rootObj or not rootObj.Parent then return nil end
		return GetObjectCFrame(rootObj)
	end

	local targetPos = targetCFrame.Position
	local startCF   = readCF()
	local startPos  = startCF and startCF.Position or nil

	local function doMoveToPoint(destCF)
		local MAX_ITER  = 80
		local MAX_STALL = CONFIG.REPOS_MAX_STALLS
		local stallCount = 0
		local noChangeFrames = 0
		local lastPos = (readCF() or destCF).Position

		for _ = 1, 3 do
			pcall(function() PlotSystemRemote:InvokeServer("moveFurniture", guid, destCF) end)
		end
		task.wait(0)

		local checkNow = readCF()
		if checkNow and (checkNow.Position - destCF.Position).Magnitude < CONFIG.REPOS_FINAL_TOLERANCE then
			return true
		end

		for iter = 1, MAX_ITER do
			if stopPlacement then return false end
			local nowCF  = readCF()
			local nowPos = nowCF and nowCF.Position or nil
			if not nowPos then return false end

			local dist = (nowPos - destCF.Position).Magnitude
			if dist < CONFIG.REPOS_FINAL_TOLERANCE then
				for _ = 1, CONFIG.REPOS_FINAL_ATTEMPTS do
					pcall(function() PlotSystemRemote:InvokeServer("moveFurniture", guid, destCF) end)
				end
				task.wait(0)
				return true
			end

			local prog = (nowPos - lastPos).Magnitude
			if prog < 0.005 then
				noChangeFrames = noChangeFrames + 1
				if noChangeFrames >= 2 then
					stallCount = stallCount + 1
					noChangeFrames = 0
					if stallCount >= MAX_STALL then break end
				end
			else
				noChangeFrames = 0
				stallCount = 0
			end
			lastPos = nowPos
			pcall(function() PlotSystemRemote:InvokeServer("moveFurniture", guid, destCF) end)
			task.wait(0)
		end

		for _ = 1, CONFIG.REPOS_FINAL_ATTEMPTS do
			pcall(function() PlotSystemRemote:InvokeServer("moveFurniture", guid, destCF) end)
		end
		task.wait(0)
		local final = readCF()
		return final ~= nil and (final.Position - destCF.Position).Magnitude < CONFIG.REPOS_FINAL_TOLERANCE * 2
	end

	local function doMoveGradual(fromPos, destCF)
		local toPos = destCF.Position
		local _,_,_, r00,r01,r02, r10,r11,r12, r20,r21,r22 = destCF:GetComponents()
		local function makeWayCF(pos)
			return CFrame.new(pos.X, pos.Y, pos.Z, r00,r01,r02, r10,r11,r12, r20,r21,r22)
		end

		-- ── FASE RÁPIDA ──────────────────────────────────────────────
		-- Distancia a partir de la cual activamos la fase rápida
		local FAST_THRESHOLD   = 6.0   -- studs: si estamos a más de esto → fast
		-- Hasta qué distancia del destino viaja la fase rápida
		local FAST_STOP_DIST   = 4.0   -- studs: frenamos cuando quedamos a ~4 studs
		-- Tamaño de cada salto en la fase rápida (grande = más rápido)
		local FAST_STEP        = 50.0  -- studs por salto
		-- Cuántas veces enviamos el remote por waypoint en fase rápida
		local FAST_BURST       = 6
		-- Tiempo de espera entre bursts en fase rápida (0 = lo más rápido posible)
		local FAST_WAIT        = 0

		local initDist = (toPos - fromPos).Magnitude
		local deadlineT = tick() + CONFIG.REPOS_OBJ_TIMEOUT

		if initDist > FAST_THRESHOLD then
			-- Calcular cuántos waypoints de FAST_STEP caben hasta llegar a FAST_STOP_DIST del target
			local safeTarget = toPos  -- por defecto mandamos al target
			local dir0 = (toPos - fromPos)
			if dir0.Magnitude > (FAST_STOP_DIST + FAST_STEP) then
				-- Punto donde paramos la fase rápida: a FAST_STOP_DIST del target
				safeTarget = toPos - dir0.Unit * FAST_STOP_DIST
			end

			local fastIter = 0
			local MAX_FAST = math.ceil((safeTarget - fromPos).Magnitude / FAST_STEP) + 10

			while fastIter < MAX_FAST do
				if stopPlacement then return end
				if tick() > deadlineT then break end

				local nowCF  = readCF()
				local nowPos = nowCF and nowCF.Position or toPos

				-- Si ya estamos dentro de la zona de aterrizaje, salir de la fase rápida
				local distToFinal = (toPos - nowPos).Magnitude
				if distToFinal <= FAST_STOP_DIST then break end

				local dir    = (safeTarget - nowPos)
				local nextPos = dir.Magnitude <= FAST_STEP and safeTarget
					or (nowPos + dir.Unit * FAST_STEP)

				-- Enviar varias veces para asegurar que el servidor lo reciba
				local wayCF = makeWayCF(nextPos)
				for _ = 1, FAST_BURST do
					pcall(function() PlotSystemRemote:InvokeServer("moveFurniture", guid, wayCF) end)
				end
				if FAST_WAIT > 0 then task.wait(FAST_WAIT) else task.wait(0) end

				fastIter = fastIter + 1
			end
		end

		-- ── FASE PRECISA ─────────────────────────────────────────────
		-- Desde aquí en adelante usa el sistema original con waypoints pequeños
		-- y detección de stall — igual que antes pero solo para los últimos studs
		local STEP  = CONFIG.REPOS_WAYPOINT_STEP
		local consecutiveFails = 0
		-- Empieza con el tamaño de la zona de frenado (FAST_STOP_DIST) para
		-- que el primer waypoint sea directo al target si ya estamos cerca
		local currentStep = FAST_STOP_DIST
		local globalIter = 0
		local nowAfterFast = readCF()
		local posAfterFast = nowAfterFast and nowAfterFast.Position or toPos
		local MAX_GLOBAL = math.max(30, math.ceil((toPos - posAfterFast).Magnitude / STEP) * 10)

		while globalIter < MAX_GLOBAL do
			if stopPlacement then return end
			if tick() > deadlineT then return end

			local nowCF  = readCF()
			local nowPos = nowCF and nowCF.Position or toPos
			local remaining = (toPos - nowPos).Magnitude
			if remaining < CONFIG.REPOS_FINAL_TOLERANCE then break end

			local dir     = (toPos - nowPos)
			local nextPos = dir.Magnitude <= currentStep and toPos
				or (nowPos + dir.Unit * currentStep)

			local ok = doMoveToPoint(makeWayCF(nextPos))
			globalIter = globalIter + 1

			if not ok then
				consecutiveFails = consecutiveFails + 1
				if consecutiveFails >= CONFIG.REPOS_MAX_CONSECUTIVE_FAILS then return end
				currentStep = math.max(currentStep * 0.6, 0.3)
				local nowCF2  = readCF()
				local nowPos2 = nowCF2 and nowCF2.Position or nowPos
				local dir2 = (toPos - nowPos2)
				if dir2.Magnitude > CONFIG.REPOS_FINAL_TOLERANCE then
					local ok2 = doMoveToPoint(makeWayCF(nowPos2 + dir2.Unit * currentStep))
					globalIter = globalIter + 1
					if not ok2 then
						consecutiveFails = consecutiveFails + 1
						if consecutiveFails >= CONFIG.REPOS_MAX_CONSECUTIVE_FAILS then return end
					else
						consecutiveFails = 0
						currentStep = math.min(currentStep * 1.5, STEP)
					end
				end
			else
				consecutiveFails = 0
				currentStep = math.min(currentStep * 1.5, STEP)
			end
		end
		doMoveToPoint(destCF)
	end

	if not startPos then
		doMoveGradual(targetPos, targetCFrame)
		return true
	end

	local totalDist = (targetPos - startPos).Magnitude
	if totalDist < CONFIG.REPOS_FINAL_TOLERANCE then
		for _ = 1, CONFIG.REPOS_FINAL_ATTEMPTS do
			pcall(function() PlotSystemRemote:InvokeServer("moveFurniture", guid, targetCFrame) end)
		end
		return true
	end

	doMoveGradual(startPos, targetCFrame)
	return true
end

-- ────────────────────────────────────────────────────────────────
-- Esperar objeto nuevo
-- ────────────────────────────────────────────────────────────────
function WaitForNewObject(plotRoot, knownIds, timeout)
	timeout = timeout or CONFIG.OBJ_APPEAR_TIMEOUT
	local found = nil

	local function scanAll()
		if found then return end
		for _, desc in pairs(plotRoot:GetDescendants()) do
			if not knownIds[desc] then
				if (desc:IsA("Model") or desc:IsA("BasePart")) and IsUUID(desc.Name) then
					found = desc; return
				end
			end
		end
		for _, desc in pairs(plotRoot:GetDescendants()) do
			if not knownIds[desc] then
				if desc:IsA("Model") or desc:IsA("BasePart") then
					local p = desc.Parent
					if p and knownIds[p] then found = desc; return end
				end
			end
		end
	end

	scanAll()
	if found then return found end

	local conn = plotRoot.DescendantAdded:Connect(function(desc)
		if found then return end
		if knownIds[desc] then return end
		if not (desc:IsA("Model") or desc:IsA("BasePart")) then return end
		if IsUUID(desc.Name) then found = desc; return end
		local p = desc.Parent
		if p and knownIds[p] then found = desc end
	end)

	local deadline = tick() + timeout
	while not found and tick() < deadline do
		scanAll()
		if not found then task.wait(0.02) end
	end

	conn:Disconnect()
	return found
end

-- ════════════════════════════════════════════════════════════════
-- FUNCIÓN PRINCIPAL: PasteToPlotOptimized (REESCRITA)
-- Nuevo flujo:
--   Fase 1 → Colocar + escalar INLINE bloque por bloque
--   Fase 2 → Verificación rápida (3s de espera) → reescalar fallidos
--   Fase 3 → Reposicionar todos
--   Fase 4 → Pintar
-- ════════════════════════════════════════════════════════════════
function PasteToPlotOptimized(targetPlot)
	if isPlacing then return end
	if not copiedData or not copiedData.Objects or #copiedData.Objects == 0 then return end

	_containerCache[targetPlot] = nil
	local furnitureContainer
	for attempt = 1, 5 do
		_containerCache[targetPlot] = nil
		furnitureContainer = FindFurnitureContainer(targetPlot, true)
		if furnitureContainer then break end
		task.wait(0.5)
	end

	if not furnitureContainer then
		JmodsLib:Notify({Title="Error",Content="Container no encontrado.\nColoca un objeto manualmente primero.",Duration=5}); return
	end

	local targetBasePart = targetPlot:FindFirstChild("BasePart")
	if not targetBasePart then return end

	CheckPaintTool()
	isPlacing           = true
	stopPlacement       = false
	local destCFrame    = targetBasePart.CFrame
	guidCache           = {}
	totalObjectsToPlace = #copiedData.Objects
	objectsPlaced       = 0
	objectsFailed       = 0
	failedPlacements    = {}
	scaleAccuracyStats  = {perfect=0,close=0,partial=0,minimal=0}

	ProgressBar:Reset(); ProgressBar:Show()
	ProgressBar:Update(0, totalObjectsToPlace, "Iniciando...")
	if hasPaintTool then StartAutoEquipPaintTool() end
	StartSlotManagement(totalObjectsToPlace)

	activeThread = task.spawn(function()
		local startTime = tick()
		local bounds    = GetBasePartBounds(targetBasePart)

		-- Tabla de todos los objetos conocidos en el plot (para detectar nuevos)
		local knownIds = {}
		local function absorbAll(inst, depth)
			if depth > 6 then return end
			knownIds[inst] = true
			for _, child in pairs(inst:GetChildren()) do absorbAll(child, depth + 1) end
		end
		absorbAll(targetPlot, 0)

		-- resolvedObjects: registra cada objeto colocado con su guid, cframe target, etc.
		local resolvedObjects = {}

		-- ────────────────────────────────────────────────────────
		-- ════════════════════════════════════════════════════════════
		-- FASE ÚNICA: Colocar + Escalar + Reposicionar bloque a bloque
		-- Cada objeto se coloca, se escala si hace falta, y si quedó
		-- desviado (usó center-scale o tiene drift) se reposiciona,
		-- todo en el mismo ciclo antes de pasar al siguiente objeto.
		-- ════════════════════════════════════════════════════════════
		for objIndex, itemData in ipairs(copiedData.Objects) do
			if stopPlacement then break end

			local absoluteCF       = ApplyRelativeTransform(destCFrame, itemData.RelativeTransform)
			local originalTargetCF = absoluteCF

			-- Corrección de borde si el objeto se sale del plot
			if bounds then
				local objSize = itemData.ActualSize and TableToVector3(itemData.ActualSize) or Vector3.new(1,1,1)
				if IsNearBoundary(absoluteCF.Position, objSize, bounds, CONFIG.BOUNDARY_SAFETY_MARGIN) then
					local safePos = CalculateSafePosition(absoluteCF.Position, objSize, bounds, CONFIG.BOUNDARY_SAFETY_MARGIN)
					absoluteCF = CFrame.new(safePos) * (absoluteCF - absoluteCF.Position)
				end
			end

			-- ¿Necesita escalado?
			local needsScaleNow = itemData.NeedsScale
			if not needsScaleNow and itemData.ActualSize and itemData.ModelName then
				needsScaleNow = SizeNeedsScaling(itemData.ModelName, itemData.ActualSize)
			end

			-- ── COLOCAR ──────────────────────────────────────────────
			local placeOk = false
			for attempt = 1, CONFIG.MAX_RETRIES do
				if stopPlacement then break end
				local ok, result = pcall(function()
					return PlotSystemRemote:InvokeServer("placeFurniture", itemData.ModelName, absoluteCF)
				end)
				if ok and result ~= false then
					placeOk = true
					objectsPlaced = objectsPlaced + 1
					break
				else
					local err = tostring(result):lower()
					if string.find(err,"limit") or string.find(err,"max") or string.find(err,"full") or string.find(err,"slot") then
						if slotsBuyingActive and not buyingInProgress then task.spawn(BuyExtraSlots) end
						task.wait(CONFIG.RETRY_DELAY * 2)
					else
						task.wait(CONFIG.RETRY_DELAY)
					end
				end
			end

			if not placeOk then
				objectsFailed = objectsFailed + 1
				table.insert(failedPlacements, itemData)
				absorbAll(targetPlot, 0)
				ProgressBar:Update(objIndex, totalObjectsToPlace, string.format("Fallo place: %s", itemData.ModelName))
				task.wait(0.03)
				continue
			end

			-- Esperar a que el objeto aparezca en el mundo
			local newObj = WaitForNewObject(targetPlot, knownIds, CONFIG.OBJ_APPEAR_TIMEOUT)
			absorbAll(targetPlot, 0)

			-- Fallback: escanear container manualmente si no lo detectó
			if not newObj then
				local fc = FindFurnitureContainer(targetPlot, false)
				if fc then
					for _, child in pairs(fc:GetChildren()) do
						if child:IsA("Model") or child:IsA("BasePart") then
							local alreadyUsed = false
							for _, r in pairs(resolvedObjects) do
								if r.obj == child then alreadyUsed = true; break end
							end
							if not alreadyUsed and IsUUID(child.Name) then
								newObj = child; break
							end
						end
					end
				end
			end

			-- Actualizar container si el objeto apareció en uno diferente
			if newObj and newObj.Parent and newObj.Parent ~= targetPlot
			   and newObj.Parent ~= furnitureContainer then
				furnitureContainer = newObj.Parent
				_containerCache[targetPlot] = furnitureContainer
			end

			local earlyGuid = newObj and SearchGUID(newObj) or nil

			-- ── ESCALAR ──────────────────────────────────────────────
			local inlineScaleOk  = false
			local inlineFinalSz  = nil
			local usedCenterScale = false

			if needsScaleNow and newObj and newObj.Parent then
				task.wait(CONFIG.INLINE_SCALE_WAIT)

				local rootObjInline = ResolveRootObject(newObj)
				if rootObjInline and rootObjInline.Parent then
					local guidInline = earlyGuid
					if not guidInline then
						guidInline = WaitForGUID(rootObjInline, CONFIG.MAX_GUID_ATTEMPTS, SCALABLE_BLOCKS[itemData.ModelName] == true)
						earlyGuid = guidInline
					end

					if guidInline then
						local targetV = nil
						if type(itemData.ActualSize) == "table" and #itemData.ActualSize == 3 then
							targetV = Vector3.new(itemData.ActualSize[1], itemData.ActualSize[2], itemData.ActualSize[3])
						elseif typeof(itemData.ActualSize) == "Vector3" then
							targetV = itemData.ActualSize
						end

						if targetV then
							inlineScaleOk, inlineFinalSz = ScaleObject(guidInline, rootObjInline, targetV, originalTargetCF, bounds)

							-- ¿Es bloque grande relativo al plot? (usó center-scale)
							do
								local pw = bounds and (bounds.MaxX - bounds.MinX) or 0
								local pd = bounds and (bounds.MaxZ - bounds.MinZ) or 0
								usedCenterScale = CONFIG.LARGE_BLOCK_CENTER_MOVE and bounds ~= nil and (
									(pw > 0 and targetV.X >= pw * 0.60) or
									(pd > 0 and targetV.Z >= pd * 0.60) or
									targetV.X > CONFIG.LARGE_BLOCK_THRESHOLD or
									targetV.Z > CONFIG.LARGE_BLOCK_THRESHOLD
								) or false
							end

							-- Stats de precisión
							if inlineScaleOk and inlineFinalSz then
								local diff = (inlineFinalSz - targetV).Magnitude
								local acc  = targetV.Magnitude > 0 and (1 - diff/targetV.Magnitude) or 0
								if     acc >= 0.99 then scaleAccuracyStats.perfect  = scaleAccuracyStats.perfect  + 1
								elseif acc >= 0.95 then scaleAccuracyStats.close    = scaleAccuracyStats.close    + 1
								elseif acc >= 0.50 then scaleAccuracyStats.partial  = scaleAccuracyStats.partial  + 1
								else                    scaleAccuracyStats.minimal  = scaleAccuracyStats.minimal  + 1 end
							end

							newObj = rootObjInline
						end
					end
				end
			end

			-- ── REPOSICIONAR (solo si es necesario) ──────────────────
			-- Condición: fue al centro para escalar (usedCenterScale)
			--            O quedó desviado del target (drift > threshold)
			local reposOk = false
			if newObj and newObj.Parent then
				local needsReposNow = usedCenterScale
				if not needsReposNow then
					local curCF = GetObjectCFrame(newObj)
					if curCF then
						local dist = (curCF.Position - originalTargetCF.Position).Magnitude
						needsReposNow = dist > CONFIG.SCALE_DRIFT_REPOS_THRESHOLD
					end
				end

				if needsReposNow then
					-- Asegurar GUID
					local guidRepos = earlyGuid
					if not guidRepos then
						guidRepos = WaitForGUID(newObj, CONFIG.MAX_GUID_ATTEMPTS_REPOS)
						earlyGuid = guidRepos
					end

					if guidRepos then
						reposOk = RepositionObject(guidRepos, newObj, originalTargetCF, nil)
					end
				end
			end

			-- Registrar para la verificación final y para pintura
			table.insert(resolvedObjects, {
				obj             = newObj,
				guid            = earlyGuid,
				itemData        = itemData,
				targetCFrame    = originalTargetCF,
				placedCFrame    = absoluteCF,
				needsScale      = needsScaleNow,
				inlineScaleOk   = inlineScaleOk,
				inlineFinalSz   = inlineFinalSz,
				usedCenterScale = usedCenterScale,
				reposOk         = reposOk,
			})

			-- Barra de progreso con estado compacto
			local statusParts = {}
			table.insert(statusParts, string.format("%d/%d", objIndex, totalObjectsToPlace))
			if needsScaleNow  then table.insert(statusParts, inlineScaleOk and "esc✓" or "esc~") end
			if usedCenterScale then table.insert(statusParts, reposOk       and "rep✓" or "rep~") end
			ProgressBar:Update(objIndex, totalObjectsToPlace,
				"Procesando " .. table.concat(statusParts, " "))
			task.wait(CONFIG.PLACE_DELAY)
		end -- fin bucle principal

		if stopPlacement then
			StopAutoEquipPaintTool(); StopSlotManagement()
			isPlacing = false; activeThread = nil; ProgressBar:Hide(); return
		end

		-- ════════════════════════════════════════════════════════════
		-- VERIFICACIÓN FINAL: escanear todo lo que quedó mal
		-- (escala incorrecta o posición desviada) y corregirlo
		-- ════════════════════════════════════════════════════════════
		ProgressBar:Update(0, 1, string.format("Verificando en %.0fs...", CONFIG.VERIFY_WAIT_TIME))
		task.wait(CONFIG.VERIFY_WAIT_TIME)

		local verifyScale = {}   -- bloques con tamaño incorrecto
		local verifyRepos = {}   -- objetos con posición incorrecta

		for _, r in ipairs(resolvedObjects) do
			if not r.obj or not r.obj.Parent then continue end
			local rootNow = ResolveRootObject(r.obj)
			if not rootNow or not rootNow.Parent then continue end

			-- Verificar escala
			if r.needsScale then
				local itemData = r.itemData
				local targetV  = nil
				if type(itemData.ActualSize) == "table" and #itemData.ActualSize == 3 then
					targetV = Vector3.new(itemData.ActualSize[1], itemData.ActualSize[2], itemData.ActualSize[3])
				elseif typeof(itemData.ActualSize) == "Vector3" then
					targetV = itemData.ActualSize
				end
				if targetV then
					local sizeNow = GetRealSizeFromObject(rootNow)
					local diff    = sizeNow and (sizeNow - targetV).Magnitude or 9999
					if diff > CONFIG.VERIFY_TOLERANCE then
						table.insert(verifyScale, {r=r, rootObj=rootNow, targetV=targetV, diff=diff})
					end
				end
			end

			-- Verificar posición (solo objetos que debían reposicionarse)
			if r.usedCenterScale then
				local curCF = GetObjectCFrame(rootNow)
				if curCF then
					local dist = (curCF.Position - r.targetCFrame.Position).Magnitude
					if dist > CONFIG.REPOS_FINAL_TOLERANCE * 3 then
						table.insert(verifyRepos, {r=r, rootObj=rootNow})
					end
				end
			end
		end

		-- Re-escalar los que fallaron
		if #verifyScale > 0 and not stopPlacement then
			ProgressBar:Update(0, #verifyScale, string.format("Re-escalando %d...", #verifyScale))
			local vDone = 0; local vOk = 0
			local batchIdx = 1
			while batchIdx <= #verifyScale and not stopPlacement do
				local batchEnd  = math.min(batchIdx + CONFIG.SCALE_BATCH_SIZE - 1, #verifyScale)
				local batchSize = batchEnd - batchIdx + 1
				local batchDone = 0
				for bi = batchIdx, batchEnd do
					local entry = verifyScale[bi]
					local r     = entry.r
					task.spawn(function()
						if not r.guid then
							r.guid = WaitForGUID(entry.rootObj, CONFIG.MAX_GUID_ATTEMPTS, SCALABLE_BLOCKS[r.itemData.ModelName] == true)
						end
						if r.guid then
							local ok2, sz2 = ScaleObject(r.guid, entry.rootObj, entry.targetV, r.targetCFrame, bounds)
							if ok2 then
								vOk = vOk + 1
								r.inlineScaleOk = true; r.inlineFinalSz = sz2
								if sz2 then
									local d2 = (sz2 - entry.targetV).Magnitude
									local a2 = entry.targetV.Magnitude > 0 and (1 - d2/entry.targetV.Magnitude) or 0
									if     a2 >= 0.99 then scaleAccuracyStats.perfect = scaleAccuracyStats.perfect + 1
									elseif a2 >= 0.95 then scaleAccuracyStats.close   = scaleAccuracyStats.close   + 1
									elseif a2 >= 0.50 then scaleAccuracyStats.partial  = scaleAccuracyStats.partial  + 1
									else                   scaleAccuracyStats.minimal  = scaleAccuracyStats.minimal  + 1 end
								end
								-- Si ahora se convirtió en bloque grande, reposicionar también
								do
									local pw = bounds and (bounds.MaxX - bounds.MinX) or 0
									local pd = bounds and (bounds.MaxZ - bounds.MinZ) or 0
									if CONFIG.LARGE_BLOCK_CENTER_MOVE and bounds ~= nil and (
										(pw > 0 and entry.targetV.X >= pw * 0.60) or
										(pd > 0 and entry.targetV.Z >= pd * 0.60) or
										entry.targetV.X > CONFIG.LARGE_BLOCK_THRESHOLD or
										entry.targetV.Z > CONFIG.LARGE_BLOCK_THRESHOLD
									) then
										r.usedCenterScale = true
										table.insert(verifyRepos, {r=r, rootObj=entry.rootObj})
									end
								end
							end
						end
						batchDone = batchDone + 1; vDone = vDone + 1
					end)
				end
				local wt = 0
				while batchDone < batchSize and wt < 10000 do
					task.wait(0.01); wt = wt + 1
					if wt % 20 == 0 then
						ProgressBar:Update(vDone, #verifyScale, string.format("Re-esc %d/%d ok:%d", vDone, #verifyScale, vOk))
					end
				end
				batchIdx = batchEnd + 1
			end
		end

		-- Re-reposicionar los que quedaron desviados en la verificación final.
		-- SOLO AQUÍ: achicamos el bloque un 2% para que el servidor lo pueda mover
		-- (bloques pegados al borde no se mueven si están al tamaño exacto),
		-- lo llevamos al target, y luego lo restauramos al tamaño original.
		-- La reposición normal del bucle inline NO usa este truco.
		if #verifyRepos > 0 and not stopPlacement then
			ProgressBar:Update(0, #verifyRepos, string.format("Re-repos %d...", #verifyRepos))
			local vrDone = 0; local vrMoved = 0
			for _, entry in ipairs(verifyRepos) do
				if stopPlacement then break end
				local r  = entry.r
				local ro = entry.rootObj
				if not ro or not ro.Parent then vrDone = vrDone + 1; continue end

				-- Obtener GUID si falta
				if not r.guid then
					r.guid = WaitForGUID(ro, CONFIG.MAX_GUID_ATTEMPTS_REPOS)
				end

				if r.guid then
					-- 1) Leer tamaño real actual del bloque
					local realSize = GetRealSizeFromObject(ro)

					-- 2) Achicamos 2% para despegarlo del borde
					if realSize then
						local shrinkSize = Vector3.new(
							realSize.X * 0.98,
							realSize.Y * 0.98,
							realSize.Z * 0.98
						)
						local curCF = GetObjectCFrame(ro) or r.targetCFrame
						-- Enviar scaleFurniture varias veces para que el servidor lo procese
						for _ = 1, 10 do
							pcall(function()
								PlotSystemRemote:InvokeServer("scaleFurniture", r.guid, curCF, shrinkSize)
							end)
						end
						task.wait(0.08)  -- pequeña pausa para que el servidor aplique el shrink
					end

					-- 3) Mover al target (ahora sí puede moverse porque no está pegado)
					if RepositionObject(r.guid, ro, r.targetCFrame, nil) then
						vrMoved = vrMoved + 1

						-- 4) Restaurar al tamaño original
						if realSize then
							task.wait(0.04)
							local finalCF = GetObjectCFrame(ro) or r.targetCFrame
							for _ = 1, 10 do
								pcall(function()
									PlotSystemRemote:InvokeServer("scaleFurniture", r.guid, finalCF, realSize)
								end)
							end
							task.wait(0.06)
						end
					end
				end

				vrDone = vrDone + 1
				ProgressBar:Update(vrDone, #verifyRepos, string.format("Re-repos %d/%d (%d mov)", vrDone, #verifyRepos, vrMoved))
			end
		end

		ProgressBar:Update(1, 1, string.format("Verificacion completa | esc_fix:%d repos_fix:%d", #verifyScale, #verifyRepos))
		task.wait(0.3)



		-- ────────────────────────────────────────────────────────
		-- FASE 4: Pintar
		-- ────────────────────────────────────────────────────────
		local paintQueue = {}
		if hasPaintTool then
			for _, r in ipairs(resolvedObjects) do
				if r.obj and r.obj.Parent and r.itemData.Colors and #r.itemData.Colors > 0 then
					table.insert(paintQueue, {obj=r.obj, colors=r.itemData.Colors})
				end
			end
		end

		if hasPaintTool and #paintQueue > 0 and not stopPlacement then
			ProgressBar:Update(0, #paintQueue, string.format("Pintando %d...", #paintQueue))
			task.wait(CONFIG.COLOR_WAIT_TIME)
			EquipPaintTool(); task.wait(0.05)

			local painted = 0; local pidx = 1
			local paintBatch  = math.min(CONFIG.PAINT_BATCH_SIZE, 8)
			local reequipEvery = 40

			while pidx <= #paintQueue and not stopPlacement do
				local batchEnd  = math.min(pidx + paintBatch - 1, #paintQueue)
				local batchSize = batchEnd - pidx + 1
				local done = 0

				if painted > 0 and painted % reequipEvery == 0 then
					EquipPaintTool(); task.wait(0.05)
				end

				for i = pidx, batchEnd do
					local pData = paintQueue[i]
					task.spawn(function()
						if pData.obj and pData.obj.Parent then
							local n = ApplyObjectColors(pData.obj, pData.colors)
							painted = painted + (n or 0)
						end
						done = done + 1
					end)
				end

				local w = 0
				while done < batchSize and w < 1000 do task.wait(0.01); w = w + 1 end

				pidx = batchEnd + 1
				ProgressBar:Update(pidx-1, #paintQueue,
					string.format("Pintando %d/%d (partes: %d)", pidx-1, #paintQueue, painted))
			end
		end -- fin Fase 4

		-- ── Finalización ──────────────────────────────────────
		local elapsed = tick() - startTime
		StopAutoEquipPaintTool(); StopSlotManagement()
		isPlacing = false; activeThread = nil

		local finalMsg = string.format("Listo en %.1fs | ok:%d fail:%d", elapsed, objectsPlaced, objectsFailed)
		if totalSlotsBought > 0 then finalMsg = finalMsg .. string.format(" | %d slots", totalSlotsBought) end
		ProgressBar:Update(totalObjectsToPlace, totalObjectsToPlace, finalMsg)
		task.wait(3); ProgressBar:Hide()
		guidCache = {}
	end)
end

-- ────────────────────────────────────────────────────────────────
-- Reintentar fallidos
-- ────────────────────────────────────────────────────────────────
function RetryFailedPlacements(targetPlot)
	if #failedPlacements==0 or isPlacing then return end
	local originalData=copiedData
	copiedData={Objects={},OriginCFrame=copiedData.OriginCFrame}
	for _,item in pairs(failedPlacements) do table.insert(copiedData.Objects,item) end
	failedPlacements={}
	PasteToPlotOptimized(targetPlot)
	task.spawn(function() task.wait(2); copiedData=originalData end)
end

-- ────────────────────────────────────────────────────────────────
-- Serialización / guardado
-- ────────────────────────────────────────────────────────────────
function SerializeForSave(data)
	if not data or not data.Objects or not data.OriginCFrame then return nil end
	local s={Objects={},OriginCFrame=CFrameToTable(data.OriginCFrame)}
	for _,obj in pairs(data.Objects) do
		table.insert(s.Objects,{
			ModelName=obj.ModelName,
			RelativeTransform=SerializeRelativeTransform(obj.RelativeTransform),
			ActualSize=obj.ActualSize,OriginalSize=obj.OriginalSize,
			NeedsScale=obj.NeedsScale,IsScalableBlock=obj.IsScalableBlock,
			Colors=SerializeColors(obj.Colors),
			DetectionMethod=obj.DetectionMethod,
		})
	end
	return s
end
function DeserializeFromSave(data)
	if not data or not data.Objects or not data.OriginCFrame then return nil end
	local d={Objects={},OriginCFrame=TableToCFrame(data.OriginCFrame)}
	for _,obj in pairs(data.Objects) do
		local esBloque=obj.IsScalableBlock
		if esBloque==nil then esBloque=IsScalableBlock(obj.ModelName,obj.ActualSize,obj.OriginalSize) end
		table.insert(d.Objects,{
			ModelName=obj.ModelName,
			RelativeTransform=DeserializeRelativeTransform(obj.RelativeTransform),
			ActualSize=obj.ActualSize,OriginalSize=obj.OriginalSize,
			NeedsScale=obj.NeedsScale or esBloque,IsScalableBlock=esBloque,
			Colors=DeserializeColors(obj.Colors),
			DetectionMethod=obj.DetectionMethod,
		})
	end
	return d
end
function LoadSavedPlots()
	local saves={}; savedPlots={}
	if isfolder(folderName) then
		for _,filePath in pairs(listfiles(folderName)) do
			local fileName=string.match(filePath,"([^/\\]+)$")
			if fileName then
				local saveName=string.match(fileName,"(.+)%.json$")
				if saveName then
					table.insert(saves,saveName)
					pcall(function()
						local content=readfile(filePath)
						local decoded=HttpService:JSONDecode(content)
						local deserialized=DeserializeFromSave(decoded)
						if deserialized then savedPlots[saveName]=deserialized end
					end)
				end
			end
		end
	end
	if #saves==0 then table.insert(saves,"No hay guardados") end
	return saves
end

