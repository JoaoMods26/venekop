-- FUNCIÓN PARA TRACKEAR UBICACIÓN DEL NPC
 function trackVeneyorNPCLocation(npcData)
    -- Verificar si es el mismo NPC
    if veneyorState.lastNPCName == npcData.npc.Name then
        -- Verificar si es la misma ubicación
        if isVeneyorSameLocation(npcData.position) then
            veneyorState.sameLocationCount = veneyorState.sameLocationCount + 1
            
            JmodsLib:Notify({
                Title = "⚠️ Misma Ubicación",
                Content = "Intento " .. veneyorState.sameLocationCount .. "/" .. VeneyorConfig.MaxSameLocationAttempts,
                Duration = 1.5
            })
            
            -- Si llegamos al límite, reiniciar
            if veneyorState.sameLocationCount >= VeneyorConfig.MaxSameLocationAttempts then
                resetVeneyorCharacter()
                return true  -- Indica que se reinició
            end
        else
            -- Nueva ubicación, resetear contador
            veneyorState.sameLocationCount = 1
        end
    else
        -- Nuevo NPC, resetear todo
        veneyorState.sameLocationCount = 1
        veneyorState.lastNPCName = npcData.npc.Name
    end
    
    -- Guardar posición (mantener solo las últimas 5)
    table.insert(veneyorState.lastNPCPositions, npcData.position)
    if #veneyorState.lastNPCPositions > 5 then
        table.remove(veneyorState.lastNPCPositions, 1)
    end
    
    return false  -- No se reinició
end

-- LOOP SUPER OPTIMIZADO PARA MÓVIL
 function veneyorAutoFarmLoop()
    while VeneyorConfig.AutoFarm do
        veneyorState.currentTask = "Yendo a posición inicial"
        
        if not veneyorTeleportDirect(VeneyorConfig.InitialPosition) then
            task.wait(0.5)
            continue
        end
        
        task.wait(VeneyorConfig.WaitAfterTP)
        
        veneyorState.currentTask = "Activando prompts"
        -- PASAR TRUE como tercer parámetro para indicar que es punto inicial
        fireNearbyProximityPrompts(false, true)
        
        task.wait(VeneyorConfig.WaitAfterPrompt)
        
        veneyorState.currentTask = "Buscando NPCs"
        
        local allNPCs = getAllNPCs()
        
        if allNPCs and #allNPCs > 0 then
            local targetNPC = allNPCs[1]
            
            -- VERIFICAR SI ES LA MISMA UBICACIÓN Y TRACKEAR
            local wasReset = trackVeneyorNPCLocation(targetNPC)
            
            -- Si se reinició, esperar y continuar
            if wasReset then
                task.wait(3)
                continue
            end
            
            veneyorState.currentTask = "Yendo a NPC: " .. targetNPC.npc.Name
            veneyorState.stats.npcsVisited = veneyorState.stats.npcsVisited + 1
            
            if veneyorTeleportDirect(targetNPC.position) then
                task.wait(VeneyorConfig.WaitAfterTP)
                
                local npcStillExists = true
                local activationThread = task.spawn(function()
                    -- PASAR FALSE como tercer parámetro (no es punto inicial)
                    fireNearbyProximityPrompts(true, false)
                end)
                
                local checkStartTime = tick()
                while npcStillExists and tick() - checkStartTime < 1.5 do
                    if not targetNPC.npc.Parent then
                        npcStillExists = false
                        veneyorState.stats.deliveriesCompleted = veneyorState.stats.deliveriesCompleted + 1
                        -- Resetear contador cuando se completa exitosamente
                        veneyorState.sameLocationCount = 0
                        break
                    end
                    task.wait(0.05)
                end
                
                if not npcStillExists then
                    task.wait(VeneyorConfig.WaitBetweenNPCs)
                    
                    -- MODO LENTO: Espera adicional después de completar NPC
                    if VeneyorConfig.SlowMode then
                        veneyorState.currentTask = "Modo Lento: Esperando..."
                        task.wait(VeneyorConfig.SlowModeWaitPerNPC)
                    end
                else
                    task.wait(VeneyorConfig.WaitAfterPrompt)
                end
            end
        else
            task.wait(0.5)
        end
    end
    
    veneyorState.currentTask = "Inactivo"
end

 function startVeneyorAutoFarm()
    VeneyorConfig.AutoFarm = true
    
    if VeneyorConfig.NoCooldown then
        removeVeneyorProximityPromptCooldown()
    end
    
    spawn(function()
        veneyorAutoFarmLoop()
    end)
end

