-- DETECCIÓN DE PLATAFORMA
local PlatformDetector = {
    isMobile = false,
    isPC = false,
    platform = "Unknown"
}

function PlatformDetector:Detect()
    local touchEnabled = UserInputService.TouchEnabled
    local mouseEnabled = UserInputService.MouseEnabled
    local keyboardEnabled = UserInputService.KeyboardEnabled
    
    if touchEnabled and not keyboardEnabled then
        self.isMobile = true
        self.isPC = false
        self.platform = "Mobile"
    elseif mouseEnabled and keyboardEnabled then
        self.isMobile = false
        self.isPC = true
        self.platform = "PC"
    else
        self.isMobile = touchEnabled
        self.isPC = not touchEnabled
        self.platform = touchEnabled and "Mobile" or "PC"
    end
    
    return self.platform
end

