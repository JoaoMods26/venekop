PlotsTab:CreateButton({Name="Vender TODO (loop continuo)",Callback=function()
	if isSelling then
		stopSelling = true
		JmodsLib:Notify({Title="Deteniendo venta...",Content="Se detendra tras el round actual",Duration=3})
		return
	end
	isSelling = true
	stopSelling = false
	task.spawn(function()
		local totalDeleted = 0
		local round = 0
		ProgressBar:Reset(); ProgressBar:Show()

		local function findMyFurnitureContainer()
			local myName = LocalPlayer.Name
			local terrenos = game:GetService("Workspace"):FindFirstChild("Terrenos")
			if not terrenos then return nil end
			for _, plotFolder in pairs(terrenos:GetChildren()) do
				if not plotFolder:IsA("Folder") then continue end
				local letrero = plotFolder:FindFirstChild("LETRERO")
				if not letrero then continue end
				local cube = letrero:FindFirstChild("Cube")
				if not cube then continue end
				local sg = cube:FindFirstChild("SurfaceGui")
				if not sg then continue end
				local tl = sg:FindFirstChild("TextLabel")
				if not tl then continue end
				local labelText = CleanName(tl.Text)
				if not string.find(labelText, myName) then continue end
				local fc = plotFolder:FindFirstChild("FurnitureContainer")
				if fc then return fc end
				for _, child in pairs(plotFolder:GetChildren()) do
					if child:IsA("Folder") or child:IsA("Model") then
						for _, item in pairs(child:GetChildren()) do
							if IsUUID(item.Name) then return child end
						end
					end
				end
			end
			return nil
		end

		local ok, err = pcall(function()
			while not stopSelling do
				round = round + 1
				local fc = findMyFurnitureContainer()
				if not fc then ProgressBar:Update(1,1,"No se encontro FurnitureContainer"); break end

				local guids = {}
				for _, obj in pairs(fc:GetChildren()) do
					if IsUUID(obj.Name) then
						table.insert(guids, obj.Name)
					elseif obj:IsA("Model") or obj:IsA("BasePart") then
						for _, child in pairs(obj:GetChildren()) do
							if IsUUID(child.Name) then table.insert(guids, child.Name); break end
						end
					end
				end

				if #guids == 0 then ProgressBar:Update(1,1,"Parcela vacia"); break end

				local roundTotal = #guids
				local roundDeleted = 0
				local roundFailed = 0
				local roundProcessed = 0
				local SELL_BATCH = 50
				local sellIdx = 1

				while sellIdx <= roundTotal and not stopSelling do
					local sbEnd = math.min(sellIdx + SELL_BATCH - 1, roundTotal)
					local sbDone = 0

					for si = sellIdx, sbEnd do
						local guid = guids[si]
						task.spawn(function()
							local ok2, result = pcall(function()
								return PlotSystemRemote:InvokeServer("deleteFurniture", guid)
							end)
							if ok2 and result ~= false then roundDeleted = roundDeleted + 1
							else roundFailed = roundFailed + 1 end
							roundProcessed = roundProcessed + 1
							sbDone = sbDone + 1
						end)
					end

					local batchSize = sbEnd - sellIdx + 1
					local waitCount = 0
					while sbDone < batchSize and waitCount < 300 do
						task.wait(0.01); waitCount = waitCount + 1
					end

					ProgressBar:Update(totalDeleted + roundDeleted, totalDeleted + roundTotal,
						string.format("Rnd%d: %d/%d (ok:%d fail:%d)", round, roundProcessed, roundTotal, roundDeleted, roundFailed))
					sellIdx = sbEnd + 1
				end

				totalDeleted = totalDeleted + roundDeleted
				if roundDeleted == 0 then ProgressBar:Update(1,1,"Sin progreso, deteniendo"); break end
				task.wait(0.05)
			end
		end)

		guidCache = {}
		isSelling = false
		stopSelling = false
		ProgressBar:Update(1,1,string.format("Vendidos %d en %d rounds", totalDeleted, round))
		task.wait(3); ProgressBar:Hide()
		JmodsLib:Notify({Title="Venta Completada",Content=string.format("Total: %d objetos en %d pasadas",totalDeleted,round),Duration=5})
	end)
end})
