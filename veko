            table.insert(npcList, {
                npc = npc,
                position = targetPos,
                distance = distance
            })
        end
    end
    
    table.sort(npcList, function(a, b) return a.distance < b.distance end)
    
    return npcList
end

-- FUNCIÓN PARA VERIFICAR SI ES LA MISMA UBICACIÓN (AREPAMOVIL)
 function isArepamovilSameLocation(newPos)
    if #arepamovilState.lastNPCPositions == 0 then
        return false
    end
    
    local lastPos = arepamovilState.lastNPCPositions[#arepamovilState.lastNPCPositions]
    local distance = (newPos - lastPos).Magnitude
    
    return distance < ArepamovilConfig.SameLocationRadius
end

-- FUNCIÓN PARA REINICIAR PERSONAJE (AREPAMOVIL)
 function resetArepamovilCharacter()
    JmodsLib:Notify({
        Title = "⚠️ Bucle Detectado",
        Content = "Reiniciando personaje en 2 segundos...",
        Duration = 2
    })
    
    wait(2)
    
    local char = getArepamovilCharacter()
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
        end
    end
    
    -- Esperar a que el personaje reaparezca
    LocalPlayer.CharacterAdded:Wait()
    wait(2)
    
    -- Resetear contadores
    arepamovilState.lastNPCPositions = {}
    arepamovilState.sameLocationCount = 0
    arepamovilState.lastNPCName = nil
    
    JmodsLib:Notify({
        Title = "✅ Reinicio Completo",
        Content = "Continuando AutoFarm...",
        Duration = 2
    })
end

-- FUNCIÓN PARA TRACKEAR UBICACIÓN DEL NPC (AREPAMOVIL)
 function trackArepamovilNPCLocation(npcData)
    -- Verificar si es el mismo NPC
    if arepamovilState.lastNPCName == npcData.npc.Name then
        -- Verificar si es la misma ubicación
        if isArepamovilSameLocation(npcData.position) then
            arepamovilState.sameLocationCount = arepamovilState.sameLocationCount + 1
            
            JmodsLib:Notify({
                Title = "⚠️ Misma Ubicación",
                Content = "Intento " .. arepamovilState.sameLocationCount .. "/" .. ArepamovilConfig.MaxSameLocationAttempts,
                Duration = 1.5
            })
            
            -- Si llegamos al límite, reiniciar
            if arepamovilState.sameLocationCount >= ArepamovilConfig.MaxSameLocationAttempts then
                resetArepamovilCharacter()
                return true  -- Indica que se reinició
            end
        else
            -- Nueva ubicación, resetear contador
            arepamovilState.sameLocationCount = 1
        end
    else
        -- Nuevo NPC, resetear todo
        arepamovilState.sameLocationCount = 1
        arepamovilState.lastNPCName = npcData.npc.Name
    end
    
    -- Guardar posición (mantener solo las últimas 5)
    table.insert(arepamovilState.lastNPCPositions, npcData.position)
    if #arepamovilState.lastNPCPositions > 5 then
        table.remove(arepamovilState.lastNPCPositions, 1)
    end
    
    return false  -- No se reinició
end

 function arepamovilAutoFarmLoop()
    while ArepamovilConfig.AutoFarm do
        arepamovilState.currentTask = "Yendo a posición inicial"
        
        if not arepamovilTeleportDirect(ArepamovilConfig.InitialPosition) then
            task.wait(0.5)
            continue
        end
        
        task.wait(ArepamovilConfig.WaitAfterTP)
        
        arepamovilState.currentTask = "Activando prompts"
        fireArepamovilNearbyProximityPrompts(false, true)
        
        task.wait(ArepamovilConfig.WaitAfterPrompt)
        
        arepamovilState.currentTask = "Buscando NPCs"
        
        local allNPCs = getAllArepamovilNPCs()
        
        if allNPCs and #allNPCs > 0 then
            local targetNPC = allNPCs[1]
            
            -- VERIFICAR SI ES LA MISMA UBICACIÓN Y TRACKEAR
            local wasReset = trackArepamovilNPCLocation(targetNPC)
            
            -- Si se reinició, esperar y continuar
            if wasReset then
                task.wait(3)
                continue
            end
            
            arepamovilState.currentTask = "Yendo a NPC: " .. targetNPC.npc.Name
            arepamovilState.stats.npcsVisited = arepamovilState.stats.npcsVisited + 1
            
            if arepamovilTeleportDirect(targetNPC.position) then
                task.wait(ArepamovilConfig.WaitAfterTP)
                
                local npcStillExists = true
                local activationThread = task.spawn(function()
                    fireArepamovilNearbyProximityPrompts(true, false)
                end)
                
                local checkStartTime = tick()
                while npcStillExists and tick() - checkStartTime < 1.5 do
                    if not targetNPC.npc.Parent then
                        npcStillExists = false
                        arepamovilState.stats.deliveriesCompleted = arepamovilState.stats.deliveriesCompleted + 1
                        -- Resetear contador cuando se completa exitosamente
                        arepamovilState.sameLocationCount = 0
                        break
                    end
                    task.wait(0.05)
                end
                
                if not npcStillExists then
                    task.wait(ArepamovilConfig.WaitBetweenNPCs)
                    
                    -- MODO LENTO: Espera adicional después de completar NPC
                    if ArepamovilConfig.SlowMode then
                        arepamovilState.currentTask = "Modo Lento: Esperando..."
                        task.wait(ArepamovilConfig.SlowModeWaitPerNPC)
                    end
                else
                    task.wait(ArepamovilConfig.WaitAfterPrompt)
                end
            end
        else
            task.wait(0.5)
        end
    end
    
    arepamovilState.currentTask = "Inactivo"
end

 function startArepamovilAutoFarm()
    ArepamovilConfig.AutoFarm = true
    
    if ArepamovilConfig.NoCooldown then
        removeArepamovilProximityPromptCooldown()
    end
    
    spawn(function()
        arepamovilAutoFarmLoop()
    end)
end

 function stopArepamovilAutoFarm()
    ArepamovilConfig.AutoFarm = false
    arepamovilState.isMoving = false
    arepamovilState.currentTask = "Inactivo"
end

