function VehicleSystem:ScanVehicles()
    self.State.vehicles = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") then
            local currentParent = obj.Parent
            local vehicleModel = nil
            
            while currentParent and currentParent ~= Workspace do
                if currentParent:IsA("Model") and currentParent.Parent == Workspace then
                    vehicleModel = currentParent
                    break
                end
                currentParent = currentParent.Parent
            end
            
            if vehicleModel and not self.State.vehicles[vehicleModel] then
                self.State.vehicles[vehicleModel] = obj
            end
        end
    end
    
    return self.State.vehicles
end

function VehicleSystem:GetVehicleList()
    local list = {}
    
    for model, seat in pairs(self.State.vehicles) do
        if model and model.Parent then
            local vehicleName = model.Name
            local ownerName = "Sin dueño"
            
            local scripts = model:FindFirstChild("Scripts")
            if scripts then
                local playerOwner = scripts:FindFirstChild("PlayerOwner")
                if playerOwner then
                    if playerOwner:IsA("StringValue") or playerOwner:IsA("ObjectValue") then
                        if playerOwner.Value and playerOwner.Value ~= "" then
                            if typeof(playerOwner.Value) == "Instance" and playerOwner.Value:IsA("Player") then
                                ownerName = playerOwner.Value.Name
                            else
                                ownerName = tostring(playerOwner.Value)
                            end
                        end
                    end
                end
            end
            
            -- CREAR IDENTIFICADOR ÚNICO: Nombre + Dueño + ID único del modelo
            local uniqueID = tostring(model:GetDebugId())  -- ID único del objeto
            local displayName = vehicleName .. " (Dueño: " .. ownerName .. ")"
            
            table.insert(list, {
                displayName = displayName,
                vehicleName = vehicleName,
                ownerName = ownerName,
                modelID = uniqueID,
                model = model  -- Guardar referencia directa
            })
        end
    end
    
    if #list == 0 then
        table.insert(list, "No hay vehículos disponibles")
    end
    
    return list
end

function VehicleSystem:TeleportToVehicle(selectedDisplay)
    -- Si es mensaje de error, salir
    if selectedDisplay == "No hay vehículos disponibles" or 
       selectedDisplay == "Presiona 'Escanear' para buscar vehículos" then
        return false
    end
    
    local targetModel = nil
    local targetSeat = nil
    
    -- Extraer nombre del vehículo y dueño del string de display
    local vehicleName = selectedDisplay:match("^(.-)%s*%(Dueño:")
    local ownerName = selectedDisplay:match("Dueño:%s*(.-)%)")
    
    if not vehicleName or not ownerName then
        JmodsLib:Notify({
            Title = "Error",
            Content = "No se pudo identificar el vehículo",
            Duration = 3
        })
        return false
    end
    
    -- Buscar el vehículo EXACTO que coincida con nombre Y dueño
    for model, seat in pairs(self.State.vehicles) do
        if model.Name == vehicleName and model.Parent then
            -- Verificar el dueño
            local currentOwner = "Sin dueño"
            
            local scripts = model:FindFirstChild("Scripts")
            if scripts then
                local playerOwner = scripts:FindFirstChild("PlayerOwner")
                if playerOwner then
                    if playerOwner:IsA("StringValue") or playerOwner:IsA("ObjectValue") then
                        if playerOwner.Value and playerOwner.Value ~= "" then
                            if typeof(playerOwner.Value) == "Instance" and playerOwner.Value:IsA("Player") then
                                currentOwner = playerOwner.Value.Name
                            else
                                currentOwner = tostring(playerOwner.Value)
                            end
                        end
                    end
                end
            end
            
            -- SOLO si coinciden AMBOS: nombre Y dueño
            if currentOwner == ownerName then
                targetModel = model
                targetSeat = seat
                break
            end
        end
    end
    
    if not targetModel or not targetSeat then
        JmodsLib:Notify({
            Title = "Error",
            Content = "Vehículo no encontrado: " .. vehicleName .. " de " .. ownerName,
            Duration = 3
        })
        return false
    end
    
    local char = self:GetCharacter()
    if not char then return false end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if not hum or not hrp then return false end
    
    targetModel:PivotTo(hrp.CFrame * CFrame.new(0, 0, -12))
    
    task.wait(0.2)
    
    hrp.CFrame = targetSeat.CFrame * CFrame.new(0, 2, 0)
    targetSeat:Sit(hum)
    
    JmodsLib:Notify({
        Title = "Vehículo Teleportado ✅",
        Content = vehicleName .. " de " .. ownerName,
        Duration = 3
    })
    
    return true
end

