local function AnimationsHaveChanged()
    for key, value in pairs(AnimationIds) do
        if PreviousAnimationIds[key] ~= value then return true end
    end
    return false
end

local function UpdateAnimationCache()
    for key, value in pairs(AnimationIds) do
        PreviousAnimationIds[key] = value
    end
end

local function SyncCurrentAnimations()
    local desc = GetLocalDescription()
    if not desc then return end
    AnimationIds.ClimbAnimation = desc.ClimbAnimation or 0
    AnimationIds.FallAnimation  = desc.FallAnimation  or 0
    AnimationIds.IdleAnimation  = desc.IdleAnimation  or 0
    AnimationIds.JumpAnimation  = desc.JumpAnimation  or 0
    AnimationIds.RunAnimation   = desc.RunAnimation   or 0
    AnimationIds.SwimAnimation  = desc.SwimAnimation  or 0
