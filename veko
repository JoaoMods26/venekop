-- Función para enviar dinero
function sendMoney(playerId, amount)
    if not playerId then
        return false
    end
    
    if not amount or amount <= 0 then
        return false
    end
    
    local success, result = pcall(function()
        local response = Event:InvokeServer(
            "sendPagoMovil",
            playerId,
            amount
        )
        return response
    end)
    
    if success then
        if result == true or (type(result) == "table" and result[1] == true) then
            return true
        else
            return false
        end
    else
        return false
    end
end

-- Función para obtener lista de jugadores
function getPlayersList()
    local playersList = {}
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playersList, player.Name)
        end
    end
    
    if #playersList == 0 then
        return {"No hay jugadores disponibles"}
    end
    
    return playersList
end

function getVehicleModel(seat)
    if not seat then return nil end
    local modeloIntermedio = seat.Parent
    local modeloPrincipal = modeloIntermedio and modeloIntermedio.Parent
    
    if modeloPrincipal and modeloPrincipal:IsA("Model") and modeloPrincipal.Parent == workspace then
        return modeloPrincipal
    end
    
    return nil
end

function setVehicleAttribute(attributeName, value)
    if not currentVehicle then
        return false
    end
    
    local success = pcall(function()
        currentVehicle:SetAttribute(attributeName, value)
    end)
    
    return success
end

function checkVehicle()
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    if humanoid.SeatPart then
        local vehicle = getVehicleModel(humanoid.SeatPart)
        
        if vehicle and vehicle ~= currentVehicle then
            currentVehicle = vehicle
            isInVehicle = true
            
            local success, frontValue = pcall(function()
                return currentVehicle:GetAttribute("StrutSpringStiffnessFront")
            end)
            if success and frontValue then
                originalSuspensionFront = frontValue
            else
                originalSuspensionFront = 1000
            end
            
            local success2, rearValue = pcall(function()
                return currentVehicle:GetAttribute("StrutSpringStiffnessRear")
            end)
            if success2 and rearValue then
                originalSuspensionRear = rearValue
            else
                originalSuspensionRear = 1000
            end
        end
    else
        if isInVehicle then
            if lowriderEnabled then
                lowriderEnabled = false
                if lowriderConnection then
                    lowriderConnection:Disconnect()
                end
            end
            
            currentVehicle = nil
            isInVehicle = false
            originalSuspensionFront = nil
            originalSuspensionRear = nil
        end
    end
end

-- ═══════════════════════════════════════════════════════
-- FUNCIONES DE SALTO
-- ═══════════════════════════════════════════════════════

 function JumpFront()
    if not currentVehicle or isJumping then return end
    
    isJumping = true
    
    setVehicleAttribute("StrutSpringStiffnessFront", 1000)
    task.wait(0.2)
    setVehicleAttribute("StrutSpringStiffnessFront", 200000)
    task.wait(0.5)
    
    if currentVehicle and originalSuspensionFront then
        setVehicleAttribute("StrutSpringStiffnessFront", originalSuspensionFront)
    else
        setVehicleAttribute("StrutSpringStiffnessFront", 20000)
    end
    
    isJumping = false
end

 function JumpRear()
    if not currentVehicle or isJumping then return end
    
    isJumping = true
    
    setVehicleAttribute("StrutSpringStiffnessRear", 1000)
    task.wait(0.2)
    setVehicleAttribute("StrutSpringStiffnessRear", 200000)
    task.wait(0.5)
    
    if currentVehicle and originalSuspensionRear then
        setVehicleAttribute("StrutSpringStiffnessRear", originalSuspensionRear)
    else
        setVehicleAttribute("StrutSpringStiffnessRear", 20000)
    end
    
    isJumping = false
end

 function JumpComplete()
    if not currentVehicle or isJumping then return end
    
    isJumping = true
    
    setVehicleAttribute("StrutSpringStiffnessFront", 1000)
    setVehicleAttribute("StrutSpringStiffnessRear", 1000)
    task.wait(0.2)
    setVehicleAttribute("StrutSpringStiffnessFront", 200000)
    setVehicleAttribute("StrutSpringStiffnessRear", 200000)
    task.wait(0.5)
    
    if currentVehicle and originalSuspensionFront and originalSuspensionRear then
        setVehicleAttribute("StrutSpringStiffnessFront", originalSuspensionFront)
        setVehicleAttribute("StrutSpringStiffnessRear", originalSuspensionRear)
    else
        setVehicleAttribute("StrutSpringStiffnessFront", 20000)
        setVehicleAttribute("StrutSpringStiffnessRear", 20000)
    end
    
    isJumping = false
end

