 function clickBasuritaButton(button)
    if not button or not button.Parent then return false end
    
    local success = false
    
    pcall(function()
        local connections = getconnections(button.MouseButton1Click)
        if connections and #connections > 0 then
            for i, connection in pairs(connections) do
                connection:Fire()
                success = true
            end
        end
    end)
    
    pcall(function()
        firesignal(button.MouseButton1Click)
        success = true
    end)
    
    pcall(function()
        local downConnections = getconnections(button.MouseButton1Down)
        if downConnections then
            for _, connection in pairs(downConnections) do
                connection:Fire()
            end
        end
        
        wait(0.03)
        
        local upConnections = getconnections(button.MouseButton1Up)
        if upConnections then
            for _, connection in pairs(upConnections) do
                connection:Fire()
            end
        end
        success = true
    end)
    
    pcall(function()
        local absPos = button.AbsolutePosition
        local absSize = button.AbsoluteSize
        local centerX = absPos.X + absSize.X / 2
        local centerY = absPos.Y + absSize.Y / 2
        
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
        wait(0.03)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
        success = true
    end)
    
    if success then
        basuritaState.stats.buttonsClicked = basuritaState.stats.buttonsClicked + 1
    end
    
    return success
end

 function findPointButtons()
    local buttons = {}
    
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return buttons end
    
    local withInset = playerGui:FindFirstChild("WithInset")
    if not withInset then return buttons end
    
    local points = withInset:FindFirstChild("Points")
    if not points then return buttons end
    
    for _, point in pairs(points:GetChildren()) do
        if point.Name == "Point" and point:IsA("Frame") then
            for _, child in pairs(point:GetDescendants()) do
                if child:IsA("TextButton") and child.Visible then
                    local exists = false
                    for _, btn in pairs(buttons) do
                        if btn == child then
                            exists = true
                            break
                        end
                    end
                    if not exists then
                        table.insert(buttons, child)
                    end
                end
            end
        end
    end
    
    return buttons
end

local previousPointCount = 0
 function detectNewPointButtons()
    local currentButtons = findPointButtons()
    
    if #currentButtons > previousPointCount then
        local newButtons = {}
        
        for _, button in pairs(currentButtons) do
            local isNew = true
            for _, oldButton in pairs(basuritaState.detectedButtons) do
                if button == oldButton then
                    isNew = false
                    break
                end
            end
            if isNew then
                table.insert(newButtons, button)
            end
        end
        
        return newButtons
    end
    
    previousPointCount = #currentButtons
    return {}
end

 function basuritaButtonDetectorLoop()
    while basuritaState.buttonDetectorActive and BasuritaConfig.AutoClickButtons do
        local newButtons = detectNewPointButtons()
        
        if #newButtons > 0 then
            for i, button in pairs(newButtons) do
                if button and button.Parent then
                    wait(BasuritaConfig.ButtonClickDelay)
                    clickBasuritaButton(button)
                    table.insert(basuritaState.detectedButtons, button)
                    wait(0.05)
                end
            end
        end
        
        local cleanedButtons = {}
        for _, button in pairs(basuritaState.detectedButtons) do
            if button and button.Parent then
                table.insert(cleanedButtons, button)
            end
        end
        basuritaState.detectedButtons = cleanedButtons
        
        wait(BasuritaConfig.ButtonDetectionInterval)
    end
end

 function findBasurita()
    local works = Workspace:FindFirstChild("Works")
    if not works then return nil end
    
    local farmatodo = works:FindFirstChild("Farmatodo")
    if not farmatodo then return nil end
    
    for _, child in pairs(farmatodo:GetChildren()) do
        if child.Name == "Limpiador" then
            local basurita = child:FindFirstChild("Basurita")
            if basurita then
                return basurita, child
            end
        end
    end
    
    return nil
end

 function activateBasuritaProximityPrompt(object)
    if not object then return false end
    
    local proximityPrompt = object:FindFirstChildOfClass("ProximityPrompt")
    if not proximityPrompt then
        for _, child in pairs(object:GetDescendants()) do
            if child:IsA("ProximityPrompt") then
                proximityPrompt = child
                break
            end
        end
    end
    
    if proximityPrompt then
        local targetPos
        if object:IsA("BasePart") then
            targetPos = object.Position + Vector3.new(0, 3, 0)
            basuritaTeleportDirect(targetPos)
            wait(0.2)
        end
        
        local success = ProximityActivator:Activate(proximityPrompt, targetPos)
        
        return success
    end
    
    return false
end

 function findAllManchas()
    local manchas = {}
    
    if not basuritaState.limpiadorFolder or not basuritaState.limpiadorFolder.Parent then
        local works = Workspace:FindFirstChild("Works")
        if works then
            local farmatodo = works:FindFirstChild("Farmatodo")
            if farmatodo then
                for _, child in pairs(farmatodo:GetChildren()) do
                    if child.Name == "Limpiador" then
                        if child:FindFirstChild("Basurita") then
                            basuritaState.limpiadorFolder = child
                            break
                        end
                    end
                end
            end
        end
    end
    
    if basuritaState.limpiadorFolder then
        for _, obj in pairs(basuritaState.limpiadorFolder:GetDescendants()) do
            if obj.Name == "Mancha" and obj:IsA("BasePart") then
                if obj.Transparency < 1 then
                    table.insert(manchas, obj)
                end
            end
        end
    end
    
    return manchas
end

 function findNearestMancha()
    local manchas = findAllManchas()
    if #manchas == 0 then return nil end
    
    local rootPart = getBasuritaHRP()
    if not rootPart then return nil end
    
    local nearestMancha = nil
    local shortestDistance = math.huge
    
    for _, mancha in pairs(manchas) do
        if mancha and mancha.Parent then
            local distance = (mancha.Position - rootPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearestMancha = mancha
            end
        end
    end
    
    return nearestMancha
end

 function manchaExists(mancha)
    if not mancha or not mancha.Parent or not mancha:IsDescendantOf(Workspace) then
        return false
    end
    
    if mancha.Transparency >= 1 then
        return false
    end
    
    return true
end

 function farmBasuritaMancha(mancha)
    if not mancha or not manchaExists(mancha) then
        return false
    end
    
    basuritaState.currentMancha = mancha
    
    local targetPos = mancha.Position + Vector3.new(0, 3, 0)
    basuritaTeleportDirect(targetPos)
    
    while manchaExists(mancha) and BasuritaConfig.AutoFarm do
        local rootPart = getBasuritaHRP()
        if rootPart and (rootPart.Position - mancha.Position).Magnitude > 5 then
            rootPart.CFrame = CFrame.new(mancha.Position + Vector3.new(0, 3, 0))
        end
        
        wait(BasuritaConfig.CheckInterval)
    end
    
    basuritaState.stats.manchasCleaned = basuritaState.stats.manchasCleaned + 1
    basuritaState.currentMancha = nil
    return true
end

