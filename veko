-- Obtiene el HumanoidDescription de un jugador por su nombre en el dropdown
local function GetTargetDescription(displayText)
    if displayText == "No hay otros jugadores" then return nil, nil end
    local targetName = string.match(displayText, "@(.+)%)")
    if not targetName then return nil, nil end

    local targetPlayer = game.Players:FindFirstChild(targetName)
    if not targetPlayer then
        JmodsLib:Notify({Title="Error", Content="Jugador no encontrado", Duration=3})
        return nil, nil
    end
    local targetChar = targetPlayer.Character
    if not targetChar then
        JmodsLib:Notify({Title="Error", Content="El jugador no tiene personaje cargado", Duration=3})
        return nil, nil
    end
    local targetHum = targetChar:FindFirstChild("Humanoid")
    if not targetHum then
        JmodsLib:Notify({Title="Error", Content="No se encontro Humanoid", Duration=3})
        return nil, nil
    end
    local success, desc = pcall(function() return targetHum:GetAppliedDescription() end)
    if not success or not desc then
        JmodsLib:Notify({Title="Error", Content="No se pudo obtener HumanoidDescription", Duration=3})
        return nil, nil
    end
    return desc, targetName
end



