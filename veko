local function ApplyAnimations()
    local success1, AnimEvent = pcall(function()
        return game:GetService("ReplicatedStorage").Connections.Remotes.avatarEditor
    end)
    if not success1 then return false end

    local animArray = {}
    local keys = {"RunAnimation","WalkAnimation","FallAnimation","JumpAnimation",
                  "IdleAnimation","SwimAnimation","ClimbAnimation"}
    for _, key in ipairs(keys) do
        local id = AnimationIds[key]
        if id and id > 0 then
            table.insert(animArray, {AssetType=key, Id=id})
        end
    end
    if #animArray == 0 then return false end

    local success2 = pcall(function()
        AnimEvent:InvokeServer("equipBatchItem", animArray)
    end)
    if success2 then UpdateAnimationCache() end
    return success2
end



local function BuildOutfitArray()
    local outfitArray = {}
    local typeRemap = {HatAccessory="Hat", GraphicTShirt="TShirt"}
    for _, item in pairs(OutfitItems) do
        local finalType = typeRemap[item.AssetType] or item.AssetType
        table.insert(outfitArray, {AssetType=finalType, Id=item.Id})
    end
    return outfitArray
end



local function SendToServer(outfitArray, colors, scales)
    local success, Event = pcall(function()
        return game:GetService("ReplicatedStorage").Connections.Remotes.outfitMarket
    end)
    if not success then
        JmodsLib:Notify({Title="Error", Content="No se encontro outfitMarket remote", Duration=5})
        return false
    end
    local ok, result = pcall(function()
        return Event:InvokeServer("equipOuftit", outfitArray, colors, scales)
    end)
    if not ok then
        JmodsLib:Notify({Title="Error", Content=tostring(result), Duration=5})
    end
    return ok
end



local function ApplyOutfit()
    -- Sincronizar solo lo que NO sea manual
    if not RainbowEnabled and not IsCopyingFromPlayer then
        SyncCurrentColors()   -- respeta ColorsManuallySet
        SyncCurrentScales()   -- respeta ScalesManuallySet (FIX principal del tamaño)
    end
    SyncCurrentAnimations()

    local ok = SendToServer(BuildOutfitArray(), BodyColors, BodyScales)
    if ok then
        JmodsLib:Notify({Title="Outfit Aplicado", Content="Cambios aplicados correctamente", Duration=3})
        wait(0.3)
        if AnimationsHaveChanged() then ApplyAnimations() end
    end
end

