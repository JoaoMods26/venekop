local _containerCache={}
function FindFurnitureContainer(plotFolder, forceRefresh)
	if not forceRefresh and _containerCache[plotFolder] then
		local cached=_containerCache[plotFolder]
		if cached.Parent then return cached end
		_containerCache[plotFolder]=nil
	end
	local knownNames={"FurnitureContainer","Furniture","Items","Objects","Muebles","furniture","items","objects"}
	for _,name in ipairs(knownNames) do
		local fc=plotFolder:FindFirstChild(name)
		if fc and (fc:IsA("Folder") or fc:IsA("Model")) then
			_containerCache[plotFolder]=fc; return fc
		end
	end
	local bestContainer,bestCount=nil,0
	local function scanLevel(parent,depth)
		if depth>3 then return end
		for _,child in pairs(parent:GetChildren()) do
			if child:IsA("Folder") or child:IsA("Model") then
				local cnt=0
				for _,gc in pairs(child:GetChildren()) do if gc:IsA("Model") or gc:IsA("BasePart") then cnt=cnt+1 end end
				if cnt>bestCount then bestCount=cnt; bestContainer=child end
				scanLevel(child,depth+1)
			end
		end
	end
	scanLevel(plotFolder,0)
	if bestContainer and bestCount>0 then _containerCache[plotFolder]=bestContainer; return bestContainer end
	local directCount=0
	for _,child in pairs(plotFolder:GetChildren()) do if child:IsA("Model") then directCount=directCount+1 end end
	if directCount>0 then _containerCache[plotFolder]=plotFolder; return plotFolder end
	return nil
end

