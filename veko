function ProgressBar:Show()
	if not self.GUI then self:Create() end
	self.Frame.Visible=true; self.IsVisible=true
end
function ProgressBar:Hide()
	if self.Frame then self.Frame.Visible=false end
	self.IsVisible=false
end
function ProgressBar:Update(current, total, status)
	local now=tick()
	if now-self.LastUpdate<0.05 and current<total then return end
	self.LastUpdate=now
	if not self.GUI then self:Create() end
	if not self.IsVisible then self:Show() end
	local percent=total>0 and math.floor(current/total*1000)/10 or 0
	if self.PercentText then self.PercentText.Text=string.format("%.1f%%",percent) end
	if self.InfoText then self.InfoText.Text=string.format("%d/%d objetos",current,total) end
	if status and self.StatusText then self.StatusText.Text=status end
	if self.BarFill then
		self.BarFill.Size=UDim2.new(percent/100,0,1,0)
		if percent>=100 then self.BarFill.BackgroundColor3=Color3.fromRGB(0,255,100)
		elseif percent>=66 then self.BarFill.BackgroundColor3=Color3.fromRGB(0,200,255)
		elseif percent>=33 then self.BarFill.BackgroundColor3=Color3.fromRGB(0,170,255)
		else self.BarFill.BackgroundColor3=Color3.fromRGB(100,140,255) end
	end
end
function ProgressBar:Reset()
	self.LastUpdate=0
	if self.BarFill then self.BarFill.Size=UDim2.new(0,0,1,0); self.BarFill.BackgroundColor3=Color3.fromRGB(0,170,255) end
	if self.PercentText then self.PercentText.Text="0%" end
	if self.InfoText then self.InfoText.Text="0/0 objetos" end
	if self.StatusText then self.StatusText.Text="Iniciando..." end
end

