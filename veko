 function fireNearbyProximityPrompts(isNPC, isInitialPoint)
    local char = getVeneyorCharacter()
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local currentPos = hrp.Position
    local activated = 0
    
    local maxDistance = isNPC and 25 or 8
    
    local nearbyPrompts = {}
    
    if isNPC then
        local works = workspace:FindFirstChild("Works")
        if works then
            local deliveryNpcs = works:FindFirstChild("DeliveryNpcs")
            if deliveryNpcs then
                for _, npc in pairs(deliveryNpcs:GetChildren()) do
                    for _, obj in pairs(npc:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") and obj.Enabled then
                            local parent = obj.Parent
                            if parent and parent:IsA("BasePart") then
                                local distance = (parent.Position - currentPos).Magnitude
                                
                                if distance < maxDistance then
                                    table.insert(nearbyPrompts, {
                                        prompt = obj,
                                        parent = parent,
                                        distance = distance
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    else
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local parent = obj.Parent
                if parent and parent:IsA("BasePart") then
                    local distance = (parent.Position - currentPos).Magnitude
                    
                    if distance < maxDistance then
                        table.insert(nearbyPrompts, {
                            prompt = obj,
                            parent = parent,
                            distance = distance
                        })
                    end
                end
            end
        end
    end
    
    table.sort(nearbyPrompts, function(a, b) return a.distance < b.distance end)
    
    -- CONFIGURACIÓN ESPECIAL PARA PUNTO INICIAL EN MÓVIL
    local maxAttempts = 5
    if isInitialPoint and PlatformDetector.isMobile then
        maxAttempts = VeneyorConfig.MaxInitialPromptAttempts  -- Solo 2 intentos
    end
    
    for _, data in pairs(nearbyPrompts) do
        local success = false
        local attempts = 0
        
        -- INTENTOS REDUCIDOS EN PUNTO INICIAL MÓVIL
        while not success and attempts < maxAttempts do
            attempts = attempts + 1
            
            success = ProximityActivator:Activate(data.prompt, data.parent.Position)
            
            if success then
                activated = activated + 1
                veneyorState.stats.promptsActivated = veneyorState.stats.promptsActivated + 1
                break
            end
            
            -- ESPERA MUY CORTA EN PUNTO INICIAL MÓVIL
            if isInitialPoint and PlatformDetector.isMobile then
                task.wait(0.03)  -- Espera mínima
            else
                task.wait(0.08)
            end
            
            success = ProximityActivator:Activate(data.prompt, data.parent.Position)
            
            if success then
                activated = activated + 1
                veneyorState.stats.promptsActivated = veneyorState.stats.promptsActivated + 1
                break
            end
            
            -- Si falla rápido en móvil en punto inicial, salir
            if isInitialPoint and PlatformDetector.isMobile and attempts >= 1 then
                break
            end
            
            task.wait(0.10)
        end
        
        -- SKIP métodos avanzados en punto inicial móvil
        if isInitialPoint and PlatformDetector.isMobile then
            if success then
                task.wait(0.03)
            end
            continue
        end
        
        if not success and attempts >= 5 and attempts < 7 then
            local oldPos = hrp.Position
            hrp.CFrame = CFrame.new(data.parent.Position + Vector3.new(0, 2, 0))
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            task.wait(0.12)
            
            success = ProximityActivator:Activate(data.prompt, data.parent.Position)
            
            if success then
                activated = activated + 1
                veneyorState.stats.promptsActivated = veneyorState.stats.promptsActivated + 1
            else
                task.wait(0.08)
                success = ProximityActivator:Activate(data.prompt, data.parent.Position)
                
                if success then
                    activated = activated + 1
                    veneyorState.stats.promptsActivated = veneyorState.stats.promptsActivated + 1
                end
            end
            
            hrp.CFrame = CFrame.new(oldPos)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            attempts = attempts + 1
        end
        
        if not success and isNPC and attempts >= 7 then
            local centerPos = currentPos
            local radius = 4
            
            for i = 1, 4 do
                local angle = (i / 4) * math.pi * 2
                local offsetX = math.cos(angle) * radius
                local offsetZ = math.sin(angle) * radius
                
                local newPos = Vector3.new(
                    centerPos.X + offsetX,
                    centerPos.Y,
                    centerPos.Z + offsetZ
                )
                
                hrp.CFrame = CFrame.new(newPos)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                
                task.wait(0.08)
                
                success = ProximityActivator:Activate(data.prompt, data.parent.Position)
                
                if success then
                    activated = activated + 1
                    veneyorState.stats.promptsActivated = veneyorState.stats.promptsActivated + 1
                    break
                end
            end
            
            hrp.CFrame = CFrame.new(centerPos)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        
        if success then
            task.wait(0.08)
        else
            task.wait(0.10)
        end
    end
    
    return activated > 0
end

