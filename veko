function EquipPaintTool()
	if not hasPaintTool then return false end
	local character=LocalPlayer.Character
	if not character then return false end
	local humanoid=character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	if character:FindFirstChild("PaintBucket") then paintToolEquipped=true; return true end
	local paintInBackpack=LocalPlayer.Backpack:FindFirstChild("PaintBucket")
	if paintInBackpack then
		local ok=pcall(function() humanoid:EquipTool(paintInBackpack) end)
		if ok then task.wait(0.05); paintToolEquipped=character:FindFirstChild("PaintBucket")~=nil; return paintToolEquipped end
	end
	return false
end
function StartAutoEquipPaintTool()
	if autoEquipRunning or not hasPaintTool then return end
	autoEquipRunning=true
	task.spawn(function()
		while isPlacing and hasPaintTool do
			if stopPlacement then break end
			if not EquipPaintTool() then task.wait(0.5) else task.wait(CONFIG.TOOL_EQUIP_INTERVAL) end
		end
		autoEquipRunning=false
	end)
end
function StopAutoEquipPaintTool() autoEquipRunning=false end
function CheckPaintTool()
	hasPaintTool=false; paintToolEquipped=false
	local ok,res=pcall(function() return ToolsRemote:InvokeServer("paintTool") end)
	if ok and res==true then hasPaintTool=true; return true end
	if LocalPlayer.Backpack:FindFirstChild("PaintBucket") then hasPaintTool=true; return true end
	local ch=LocalPlayer.Character
	if ch and ch:FindFirstChild("PaintBucket") then hasPaintTool=true; return true end
	return false
end
