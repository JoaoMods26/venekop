 function EnableJumpControls()
    jumpControlsEnabled = true
    
    if isMobile then
        CreateMobileButtons()
        JmodsLib:Notify({
            Title = "Controles Móviles",
            Content = "Botones de salto activados",
            Duration = 3
        })
    else
        SetupPCBinds()
        JmodsLib:Notify({
            Title = "Binds PC Activados",
            Content = "Q=Adelante | R=Atrás | T=Completo",
            Duration = 3
        })
    end
end

 function DisableJumpControls()
    jumpControlsEnabled = false
    
    if isMobile then
        RemoveMobileButtons()
    else
        RemovePCBinds()
    end
    
    JmodsLib:Notify({
        Title = "Controles Desactivados",
        Content = "Binds y botones removidos",
        Duration = 2
    })
end


