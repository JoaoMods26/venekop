        ColorsManuallySet = false  -- Desbloquear
        -- Forzar lectura directa del avatar (bypassea la bandera ya limpia)
        local desc = GetLocalDescription()
        if desc then
            BodyColors.HeadColor     = Color3ToHex(desc.HeadColor)
            BodyColors.TorsoColor    = Color3ToHex(desc.TorsoColor)
            BodyColors.LeftArmColor  = Color3ToHex(desc.LeftArmColor)
            BodyColors.RightArmColor = Color3ToHex(desc.RightArmColor)
            BodyColors.LeftLegColor  = Color3ToHex(desc.LeftLegColor)
            BodyColors.RightLegColor = Color3ToHex(desc.RightLegColor)
            if not ScalesManuallySet then SyncCurrentScales() end
            SendToServer(BuildOutfitArray(), BodyColors, BodyScales)
            JmodsLib:Notify({Title="Colores Restablecidos", Content="Colores del avatar actual aplicados", Duration=3})
        else
            JmodsLib:Notify({Title="Error", Content="No se pudo leer el avatar", Duration=3})
        end
    end
})

