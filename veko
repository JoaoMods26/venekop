local inputConnection = nil

 function SetupPCBinds()
    if inputConnection then
        inputConnection:Disconnect()
    end
    
    inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not jumpControlsEnabled then return end
        if not isInVehicle then return end
        
        if input.KeyCode == jumpFrontKey then
            task.spawn(JumpFront)
        elseif input.KeyCode == jumpRearKey then
            task.spawn(JumpRear)
        elseif input.KeyCode == jumpCompleteKey then
            task.spawn(JumpComplete)
        end
    end)
end

 function RemovePCBinds()
    if inputConnection then
        inputConnection:Disconnect()
        inputConnection = nil
    end
end

-- ═══════════════════════════════════════════════════════
-- SISTEMA DE BOTONES MÓVILES (Pequeños, discretos y DRAGGABLES)
-- ═══════════════════════════════════════════════════════

 function CreateMobileButtons()
    for _, btn in pairs(mobileButtons) do
        if btn.gui then
            btn.gui:Destroy()
        end
    end
    mobileButtons = {}
    
    local coreGui = game:GetService("CoreGui")
    
    local buttonConfigs = {
        {
            name = "JumpFrontBtn",
            text = "Q",
            color = Color3.fromRGB(100, 200, 255),
            position = UDim2.new(1, -120, 0.7, -20),
            callback = JumpFront
        },
        {
            name = "JumpRearBtn",
            text = "R",
            color = Color3.fromRGB(255, 200, 100),
            position = UDim2.new(1, -70, 0.7, -20),
            callback = JumpRear
        },
        {
            name = "JumpCompleteBtn",
            text = "T",
            color = Color3.fromRGB(100, 255, 100),
            position = UDim2.new(1, -195, 0.7, -20),
            callback = JumpComplete
        }
    }
    
    for _, config in pairs(buttonConfigs) do
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "VehicleJump_" .. config.name
        screenGui.ResetOnSpawn = false
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.Parent = coreGui
        
        -- Frame principal (este será draggable)
        local button = Instance.new("Frame")
        button.Name = config.name
        button.Size = UDim2.new(0, 45, 0, 45)
        button.Position = config.position
        button.BackgroundColor3 = config.color
        button.BorderSizePixel = 0
        button.BackgroundTransparency = 0.2
        button.Parent = screenGui
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = button
        
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Thickness = 2
        stroke.Transparency = 0.5
        stroke.Parent = button
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = config.text
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextSize = 20
        label.Font = Enum.Font.GothamBold
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Parent = button
        
        -- Sistema de drag mejorado
        local dragging = false
        local dragInput
        local dragStart
        local startPos
        local pressing = false
        
         function update(input)
            local delta = input.Position - dragStart
            button.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
        
        button.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or 
               input.UserInputType == Enum.UserInputType.MouseButton1 then
                
                pressing = true
                dragging = false
                dragStart = input.Position
                startPos = button.Position
                
                -- Detectar si es un drag o un tap
                local connection
                connection = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        connection:Disconnect()
                    end
                end)
                
                -- Esperar un poco para ver si es drag
                task.wait(0.1)
                
                if pressing and input.UserInputState ~= Enum.UserInputState.End then
                    dragging = true
                end
            end
        end)
        
        button.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or 
               input.UserInputType == Enum.UserInputType.MouseMovement then
                dragInput = input
                
                if dragging then
                    update(input)
                end
            end
        end)
        
        button.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or 
               input.UserInputType == Enum.UserInputType.MouseButton1 then
                
                -- Si NO estaba dragging, entonces fue un tap/click
                if pressing and not dragging then
                    if jumpControlsEnabled and isInVehicle then
                        -- Efecto visual
                        button.Size = UDim2.new(0, 42, 0, 42)
                        button.BackgroundTransparency = 0
                        
                        -- Ejecutar salto
                        task.spawn(config.callback)
                        
                        -- Restaurar tamaño
                        task.wait(0.15)
                        button.Size = UDim2.new(0, 45, 0, 45)
                        button.BackgroundTransparency = 0.2
                    end
                end
                
                dragging = false
                pressing = false
            end
        end)
        
        table.insert(mobileButtons, {
            gui = screenGui,
            button = button,
            config = config
        })
    end
    
    mobileButtonsVisible = true
end

 function RemoveMobileButtons()
    for _, btn in pairs(mobileButtons) do
        if btn.gui then
            btn.gui:Destroy()
        end
    end
    mobileButtons = {}
    mobileButtonsVisible = false
end

