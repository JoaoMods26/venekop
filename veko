	if not paintToolEquipped then EquipPaintTool(); task.wait(0.02) end
	local serverControls=GetPaintBucketRemote()
	if not serverControls then return false end
	if not part or not part.Parent then return false end
	return pcall(function() serverControls:InvokeServer("PaintPart",{Part=part,Color=color}) end)
end
function ApplyObjectColors(obj, colorDataList)
	if not hasPaintTool or not colorDataList or #colorDataList==0 then return 0 end
	local count=0
	if obj:IsA("BasePart") then
		for _,cd in pairs(colorDataList) do
			if cd.PartName==obj.Name and cd.Index==1 then
				if ApplyColorToPart(obj,cd.Color) then count=count+1 end; break
			end
		end
	elseif obj:IsA("Model") then
		local currentIndex={}
		for _,child in ipairs(obj:GetDescendants()) do
			if child:IsA("BasePart") then
				local n=child.Name; currentIndex[n]=(currentIndex[n] or 0)+1
				for _,cd in pairs(colorDataList) do
					if cd.PartName==n and cd.Index==currentIndex[n] then
						if ApplyColorToPart(child,cd.Color) then count=count+1 end; break
					end
				end
			end
		end
	end
	return count
end
function CleanName(name)
	if not name then return "" end
	name=string.gsub(name,"<[^>]+>","")
	name=string.gsub(name,"[%c%z]","")
	return string.match(name,"^%s*(.-)%s*$") or name
end
function CFrameToTable(cf)
	local x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22=cf:GetComponents()
	return {x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22}
end
function TableToCFrame(tbl)
	if not tbl then return CFrame.new(0,0,0) end
	if #tbl==12 then return CFrame.new(tbl[1],tbl[2],tbl[3],tbl[4],tbl[5],tbl[6],tbl[7],tbl[8],tbl[9],tbl[10],tbl[11],tbl[12]) end
	if tbl.Position then
		local p=tbl.Position; local pos=CFrame.new(p[1],p[2],p[3])
		if tbl.Rotation then local r=tbl.Rotation; return pos*CFrame.Angles(r[1],r[2],r[3]) end
		return pos
	end
	return CFrame.new(0,0,0)
end
function Vector3ToTable(v) return {v.X,v.Y,v.Z} end
function TableToVector3(t) return t and Vector3.new(t[1],t[2],t[3]) or Vector3.new(1,1,1) end
function Color3ToTable(c)  return {c.R,c.G,c.B} end
function TableToColor3(t)  return t and Color3.new(t[1],t[2],t[3]) or Color3.new(1,1,1) end
function SerializeColors(colorDataList)
	if not colorDataList then return nil end
	local s={}
	for i,cd in pairs(colorDataList) do s[i]={Color=Color3ToTable(cd.Color),PartName=cd.PartName,Index=cd.Index or 1} end
	return s
end
function DeserializeColors(data)
	if not data then return nil end
	local d={}
	for i,ci in pairs(data) do d[i]={Color=TableToColor3(ci.Color),PartName=ci.PartName,Index=ci.Index or 1} end
	return d
end
function CalculateRelativeTransform(baseCF, objectCF)
	return {FullCFrame=CFrameToTable(baseCF:Inverse()*objectCF)}
end
function ApplyRelativeTransform(baseCF, relativeData)
	if relativeData.FullCFrame then return baseCF*TableToCFrame(relativeData.FullCFrame) end
	if relativeData.Position then
		local relPos=TableToVector3(relativeData.Position)
		local worldPos=baseCF:PointToWorldSpace(relPos)
		if relativeData.Rotation then local r=relativeData.Rotation; return CFrame.new(worldPos)*(baseCF.Rotation*CFrame.Angles(r[1],r[2],r[3])) end
		return CFrame.new(worldPos)
	end
	return baseCF
end
function SerializeRelativeTransform(t) return {FullCFrame=t.FullCFrame} end
function DeserializeRelativeTransform(d)
	if not d then return nil end
	return {FullCFrame=d.FullCFrame,Position=d.Position,Rotation=d.Rotation}
end
