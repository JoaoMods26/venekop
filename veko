local function GetClothingInfo()
    local desc = GetLocalDescription()
    if not desc then return end

    local function getAccIds(accType)
        local ids = {}
        local ok, result = pcall(function() return desc:GetAccessories(true) end)
        if ok then
            for _, acc in pairs(result) do
                if acc.AccessoryType.Name == accType then
                    table.insert(ids, acc.AssetId)
                end
            end
        end
        return table.concat(ids, ",")
    end

    local hash = string.format("%d_%d_%d_%d_%d_%d_%d_%d_%d_%d_%s_%s_%s_%s_%s_%s_%s_%s",
        desc.Shirt or 0, desc.Pants or 0, desc.GraphicTShirt or 0,
        desc.Face or 0, desc.Head or 0, desc.Torso or 0,
        desc.LeftArm or 0, desc.RightArm or 0, desc.LeftLeg or 0, desc.RightLeg or 0,
        getAccIds("Hair"), getAccIds("Hat"), getAccIds("Back"), getAccIds("Face"),
        getAccIds("Neck"), getAccIds("Shoulder"), getAccIds("Front"), getAccIds("Waist"))

    if hash == LastDescCache then return end
    LastDescCache = hash
    Debug("Cambios en avatar detectados (silencioso)")

    OutfitItems = {}
    if not RainbowEnabled then SyncCurrentColors() end
    -- NO sincronizamos escalas aqui para no pisar las del usuario
    SyncCurrentAnimations()

    local clothingProps = {
        {prop="Shirt",type="Shirt"},{prop="Pants",type="Pants"},
        {prop="GraphicTShirt",type="GraphicTShirt"},{prop="Face",type="Face"},
        {prop="Head",type="Head"},{prop="Torso",type="Torso"},
        {prop="LeftArm",type="LeftArm"},{prop="RightArm",type="RightArm"},
        {prop="LeftLeg",type="LeftLeg"},{prop="RightLeg",type="RightLeg"}
    }
    for _, item in pairs(clothingProps) do
        local id = desc[item.prop]
        if id and id > 0 then table.insert(OutfitItems, {AssetType=item.type, Id=id}) end
    end

    local ok2, accessories = pcall(function() return desc:GetAccessories(true) end)
    if ok2 and accessories then
        for _, acc in pairs(accessories) do
            local serverType = AccessoryTypeMapping[acc.AccessoryType.Name]
            if serverType and acc.AssetId and acc.AssetId > 0 then
                table.insert(OutfitItems, {AssetType=serverType, Id=acc.AssetId})
            end
        end
    end

    -- Sin notificacion (FIX: se elimino el notify molesto)
    Debug(string.format("%d items detectados", #OutfitItems))
end

