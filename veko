function GetObjectColors(obj)
	local colors={}
	if obj:IsA("BasePart") then
		table.insert(colors,{Color=obj.Color,PartName=obj.Name,Index=1})
	elseif obj:IsA("Model") then
		local partIndex={}
		for _,child in pairs(obj:GetDescendants()) do
			if child:IsA("BasePart") then
				local n=child.Name; partIndex[n]=(partIndex[n] or 0)+1
				table.insert(colors,{Color=child.Color,PartName=n,Index=partIndex[n]})
			end
		end
	end
	return colors
end
