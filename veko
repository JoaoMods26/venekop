local UUID_PATTERN = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
function IsUUID(s)
	if type(s) ~= "string" then return false end
	return s:match(UUID_PATTERN) ~= nil
end
function SearchGUID(target)
	if not target or not target.Parent then return nil end
	if guidCache[target] then return guidCache[target] end
	if IsUUID(target.Name) then guidCache[target] = target.Name; return target.Name end
	local attrs={"GUID","guid","Id","id","UUID","uuid","FurnitureId","furnitureId","ObjectId","objectId","FBID","fbid"}
	for _,a in ipairs(attrs) do
		local ok, v = pcall(function() return target:GetAttribute(a) end)
		if ok and v and v ~= "" then guidCache[target]=v; return v end
	end
	for _,child in pairs(target:GetChildren()) do
		if IsUUID(child.Name) then guidCache[target] = child.Name; return child.Name end
		for _,a in ipairs(attrs) do
			local ok, v = pcall(function() return child:GetAttribute(a) end)
			if ok and v and v ~= "" then guidCache[target]=v; return v end
		end
	end
	for _,desc in pairs(target:GetDescendants()) do
		if IsUUID(desc.Name) then guidCache[target] = desc.Name; return desc.Name end
		for _,a in ipairs(attrs) do
			local ok, v = pcall(function() return desc:GetAttribute(a) end)
			if ok and v and v ~= "" then guidCache[target]=v; return v end
		end
	end
	return nil
end
function WaitForGUID(obj, maxAttempts, isBlock)
	maxAttempts = maxAttempts or CONFIG.MAX_GUID_ATTEMPTS
	local waitTime = isBlock and CONFIG.BLOCK_GUID_WAIT or CONFIG.GUID_WAIT_TIME
	for attempt = 1, maxAttempts do
		if not obj or not obj.Parent then return nil end
		local guid = SearchGUID(obj)
		if guid then return guid end
		if obj:IsA("Model") then
			for _,child in pairs(obj:GetChildren()) do
				guid=SearchGUID(child); if guid then guidCache[obj]=guid; return guid end
			end
			if attempt > 2 then
				for _,desc in pairs(obj:GetDescendants()) do
					guid=SearchGUID(desc); if guid then guidCache[obj]=guid; return guid end
				end
			end
		end
		if attempt < maxAttempts then task.wait(waitTime) end
	end
	return nil
end

