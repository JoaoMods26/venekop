	local ok2,wl=pcall(function() return loadstring(result)() end)
	if not ok2 or type(wl)~="table" then return false end
	if wl.owner and type(wl.owner)=="table" then
		for userId,isActive in pairs(wl.owner) do
			local numId=tonumber(userId)
			if numId and isActive==true then ownerUserIds[numId]=true; allowedUserIds[numId]=true end
		end
	end
	for userId,isActive in pairs(wl) do
		if userId~="owner" then
			local numId=tonumber(userId)
			if numId and isActive==true then allowedUserIds[numId]=true end
		end
	end
	return true
end
function IsOwner(userId)   return ownerUserIds[userId]==true end
function HasAccess(userId) return allowedUserIds[userId]==true or _G.TemporaryAccessList[userId]==true end
