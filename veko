function GetMaterialVariantName(part)
	if not part or not part:IsA("BasePart") then return nil end
	local mv = nil
	local ok1, v1 = pcall(function() return part:GetAttribute("MaterialVariant") end)
	if ok1 and v1 and v1 ~= "" then mv = v1 end
	if not mv then
		local ok2, v2 = pcall(function() return part.MaterialVariant end)
		if ok2 and v2 and tostring(v2) ~= "" and tostring(v2) ~= "nil" then
			mv = tostring(v2)
		end
	end
	return mv
end

function GetBlockSignature(mainPart)
	if not mainPart or not mainPart:IsA("BasePart") then return nil end
	local cn = mainPart.ClassName
	if cn ~= "Part" and cn ~= "WedgePart" and cn ~= "CornerWedgePart" then return nil end
	local mat   = tostring(mainPart.Material)
	local mv    = GetMaterialVariantName(mainPart) or ""
	local shape = ""
	if cn == "Part" then
		local ok, s = pcall(function() return tostring(mainPart.Shape) end)
		shape = ok and s or "Block"
	end
	return cn .. "|" .. mat .. "|" .. shape .. "|" .. mv
end

local meshIdToTemplate    = nil
local textureIdToTemplate = nil

function BuildMeshTextureIndex()
	if meshIdToTemplate then return end
	meshIdToTemplate    = {}
	textureIdToTemplate = {}
	local function regMesh(rawId, name)
		if not rawId or rawId == "" then return end
		local n = NormalizeAssetId(rawId)
		if n ~= "" then
			if not meshIdToTemplate[n]     then meshIdToTemplate[n]     = name end
			if not meshIdToTemplate[rawId] then meshIdToTemplate[rawId] = name end
		end
	end
	local function regTex(rawId, name)
		if not rawId or rawId == "" then return end
		local n = NormalizeAssetId(rawId)
		if n ~= "" then
			if not textureIdToTemplate[n]     then textureIdToTemplate[n]     = name end
			if not textureIdToTemplate[rawId] then textureIdToTemplate[rawId] = name end
		end
	end
	for _, fItem in pairs(Furnitures:GetChildren()) do
		if SCALABLE_BLOCKS[fItem.Name] then continue end
		if BLACKLISTED_NAMES[fItem.Name] then continue end
		local function scan(inst)
			if inst:IsA("SpecialMesh") or inst:IsA("FileMesh") then
				regMesh(inst.MeshId, fItem.Name); regTex(inst.TextureId, fItem.Name)
			elseif inst:IsA("MeshPart") then
				regMesh(inst.MeshId, fItem.Name); regTex(inst.TextureID, fItem.Name)
			elseif inst:IsA("Texture") or inst:IsA("Decal") then
				regTex(inst.Texture, fItem.Name)
			end
		end
		scan(fItem)
		if fItem:IsA("Model") then
			for _, d in pairs(fItem:GetDescendants()) do scan(d) end
		end
	end
end

function FindTemplateByMeshTexture(obj)
	if not meshIdToTemplate then BuildMeshTextureIndex() end
	local found, score = nil, 0
	local function tryM(rawId)
		if not rawId or rawId=="" then return end
		local n = NormalizeAssetId(rawId)
		local t = meshIdToTemplate[n] or meshIdToTemplate[rawId]
		if t and not BLACKLISTED_NAMES[t] and VALID_OBJECTS[t] and score < 3 then found=t; score=3 end
	end
	local function tryT(rawId)
		if not rawId or rawId=="" then return end
		local n = NormalizeAssetId(rawId)
		local t = textureIdToTemplate[n] or textureIdToTemplate[rawId]
		if t and not BLACKLISTED_NAMES[t] and VALID_OBJECTS[t] and score < 2 then found=t; score=2 end
	end
	local function scan(inst)
		if inst:IsA("SpecialMesh") or inst:IsA("FileMesh") then
			tryM(inst.MeshId); tryT(inst.TextureId)
		elseif inst:IsA("MeshPart") then
			tryM(inst.MeshId); tryT(inst.TextureID)
		elseif inst:IsA("Texture") or inst:IsA("Decal") then
			tryT(inst.Texture)
		end
	end
	scan(obj)
	if obj:IsA("Model") then
		for _, d in pairs(obj:GetDescendants()) do scan(d) end
	end
	if found and not BLACKLISTED_NAMES[found] and VALID_OBJECTS[found] then
		return found
	end
	return nil
end

function DetectBlockTemplate(item)
	local mainPart = nil
	if item:IsA("BasePart") then mainPart = item
	elseif item:IsA("Model") then
		mainPart = item.PrimaryPart
		if not mainPart then
			for _, c in pairs(item:GetDescendants()) do
				if c:IsA("BasePart") then mainPart = c; break end
			end
		end
	end
	if not mainPart then return nil end
	local cn = mainPart.ClassName
	if cn ~= "Part" and cn ~= "WedgePart" and cn ~= "CornerWedgePart" then return nil end
	local mat = tostring(mainPart.Material)
	local itemMV = GetMaterialVariantName(mainPart) or ""
	local itemShape = ""
	if cn == "Part" then
		local ok, s = pcall(function() return tostring(mainPart.Shape) end)
		itemShape = ok and s or "Block"
	end

	local function collectVisual(inst)
		local texIds, hasSA, saProps = {}, false, {}
		local function scan(obj)
			if obj:IsA("Texture") or obj:IsA("Decal") then
				if obj.Texture ~= "" then table.insert(texIds, NormalizeAssetId(obj.Texture)) end
			elseif obj:IsA("SpecialMesh") or obj:IsA("FileMesh") then
				if obj.MeshId ~= "" then table.insert(texIds, "mesh:"..NormalizeAssetId(obj.MeshId)) end
				if obj.TextureId ~= "" then table.insert(texIds, NormalizeAssetId(obj.TextureId)) end
			elseif obj:IsA("MeshPart") then
				if obj.MeshId ~= "" then table.insert(texIds, "mesh:"..NormalizeAssetId(obj.MeshId)) end
				if obj.TextureID ~= "" then table.insert(texIds, NormalizeAssetId(obj.TextureID)) end
			elseif obj.ClassName == "SurfaceAppearance" then
				hasSA = true
				if obj.ColorMap ~= "" then table.insert(saProps, "cm:"..NormalizeAssetId(obj.ColorMap)) end
				if obj.NormalMap ~= "" then table.insert(saProps, "nm:"..NormalizeAssetId(obj.NormalMap)) end
				if obj.RoughnessMap ~= "" then table.insert(saProps, "rm:"..NormalizeAssetId(obj.RoughnessMap)) end
				if obj.MetalnessMap ~= "" then table.insert(saProps, "mm:"..NormalizeAssetId(obj.MetalnessMap)) end
			end
		end
		scan(inst)
		for _, d in pairs(inst:GetDescendants()) do scan(d) end
		return texIds, hasSA, saProps
	end

	local itemTexIds, itemHasSA, itemSAProps = collectVisual(mainPart)
	if item:IsA("Model") then
		for _, d in pairs(item:GetDescendants()) do
			if d:IsA("BasePart") and d ~= mainPart then
				local t, sa, sap = collectVisual(d)
				for _, v in ipairs(t) do table.insert(itemTexIds, v) end
				if sa then itemHasSA = true; for _, v in ipairs(sap) do table.insert(itemSAProps, v) end end
			end
		end
	end

	local itemHasVisual = (#itemTexIds > 0) or itemHasSA
	local bestName, bestScore = nil, -9999

	for templateName in pairs(SCALABLE_BLOCKS) do
		if BLACKLISTED_NAMES[templateName] then continue end
		local template = Furnitures:FindFirstChild(templateName)
		if not template then continue end
		local tPart = nil
		if template:IsA("BasePart") then tPart = template
		elseif template:IsA("Model") then
			tPart = template.PrimaryPart
			if not tPart then
				for _, c in pairs(template:GetDescendants()) do
					if c:IsA("BasePart") then tPart = c; break end
				end
			end
		end
		if not tPart then continue end
		if tPart.ClassName ~= cn then continue end

		local tTexIds, tHasSA, tSAProps = collectVisual(tPart)
		if template:IsA("Model") then
			for _, d in pairs(template:GetDescendants()) do
				if d:IsA("BasePart") and d ~= tPart then
					local t, sa, sap = collectVisual(d)
					for _, v in ipairs(t) do table.insert(tTexIds, v) end
					if sa then tHasSA = true; for _, v in ipairs(sap) do table.insert(tSAProps, v) end end
				end
			end
		end

		local tHasVisual = (#tTexIds > 0) or tHasSA
		if itemHasVisual ~= tHasVisual then continue end

		local score = 0
		if mat == tostring(tPart.Material) then score = score + 50 else score = score - 30 end
		if cn == "Part" then
			local tOk, tShape = pcall(function() return tostring(tPart.Shape) end)
			local tShapeStr = tOk and tShape or "Block"
			if itemShape == tShapeStr then score = score + 60 else score = score - 100 end
		end
		local tMV = GetMaterialVariantName(tPart) or ""
		if itemMV ~= "" and tMV ~= "" then
			if itemMV == tMV then score = score + 40 else score = score - 20 end
		elseif itemMV == "" and tMV == "" then
			score = score + 10
		end
		if math.abs(mainPart.Transparency - tPart.Transparency) < 0.05 then score = score + 8 end
		if not itemHasVisual then score = score + 20 end
		if #itemTexIds > 0 and #tTexIds > 0 then
			local tSet = {}; for _, t in ipairs(tTexIds) do tSet[t] = true end
			for _, t in ipairs(itemTexIds) do if tSet[t] then score = score + 30 end end
		end
		if itemHasSA and tHasSA then
			local tSet = {}; for _, p in ipairs(tSAProps) do tSet[p] = true end
			for _, p in ipairs(itemSAProps) do if tSet[p] then score = score + 25 end end
		end
		if score > bestScore then bestScore = score; bestName = templateName end
	end

	if bestName and bestScore > 0 then return bestName end
	if cn == "Part" then return "part_cube" end
	if cn == "WedgePart" then return "wedge" end
	if cn == "CornerWedgePart" then return "wedge3" end
	return nil
end

function IsScalableBlock(modelName, actualSize, originalSize)
	if SCALABLE_BLOCKS[modelName] then return true end
	if actualSize and originalSize then
		local aV = type(actualSize)=="table" and TableToVector3(actualSize) or actualSize
		local oV = type(originalSize)=="table" and TableToVector3(originalSize) or originalSize
		if oV.X > 0.01 and oV.Y > 0.01 and oV.Z > 0.01 then
			local diffX = math.abs(aV.X - oV.X)
			local diffY = math.abs(aV.Y - oV.Y)
			local diffZ = math.abs(aV.Z - oV.Z)
			if diffX > 0.05 or diffY > 0.05 or diffZ > 0.05 then return true end
		end
	end
	return false
end

function SizeNeedsScaling(modelName, actualSizeTable)
	if not actualSizeTable then return false end
	local targetV = TableToVector3(actualSizeTable)
	local originalSize = GetOriginalModelSize(modelName)
	if not originalSize then return false end
	local diff = (targetV - originalSize).Magnitude
	return diff > 0.05
end

function GenerateFingerprint(obj)
	local fp={meshIds={},textureIds={},imageIds={},attributes={},partCount=0,totalVolume=0,className=obj.ClassName,childPartNames={},specialMeshTypes={}}
	local function proc(inst)
		if inst:IsA("SpecialMesh") or inst:IsA("FileMesh") then
			if inst.MeshId~="" then fp.meshIds[NormalizeAssetId(inst.MeshId)]=true end
			if inst.TextureId~="" then fp.textureIds[NormalizeAssetId(inst.TextureId)]=true end
			if inst:IsA("SpecialMesh") then local mt=tostring(inst.MeshType); fp.specialMeshTypes[mt]=(fp.specialMeshTypes[mt] or 0)+1 end
		elseif inst:IsA("Texture") or inst:IsA("Decal") then
			if inst.Texture~="" then fp.imageIds[NormalizeAssetId(inst.Texture)]=true end
		elseif inst:IsA("MeshPart") then
			if inst.MeshId~="" then fp.meshIds[NormalizeAssetId(inst.MeshId)]=true end
			if inst.TextureID~="" then fp.textureIds[NormalizeAssetId(inst.TextureID)]=true end
		end
		if inst:IsA("BasePart") then
			fp.partCount=fp.partCount+1; fp.totalVolume=fp.totalVolume+(inst.Size.X*inst.Size.Y*inst.Size.Z)
			local n=inst.Name; fp.childPartNames[n]=(fp.childPartNames[n] or 0)+1
		end
		local ok,attrs=pcall(function() return inst:GetAttributes() end)
		if ok and attrs then for k,v in pairs(attrs) do fp.attributes[k.."="..tostring(v)]=true end end
	end
	proc(obj)
	if obj:IsA("Model") then for _,d in pairs(obj:GetDescendants()) do proc(d) end end
	return fp
end
function FingerprintScore(fpA,fpB)
	local score=0
	for id in pairs(fpA.meshIds) do if fpB.meshIds[id] then score=score+3 end end
	for id in pairs(fpA.textureIds) do if fpB.textureIds[id] then score=score+2 end end
	for id in pairs(fpA.imageIds) do if fpB.imageIds[id] then score=score+1 end end
	for attr in pairs(fpA.attributes) do if fpB.attributes[attr] then score=score+1 end end
	for mt,cnt in pairs(fpA.specialMeshTypes) do if fpB.specialMeshTypes[mt]==cnt then score=score+1 end end
	return score
end
function FingerprintMatches(fpA,fpB)
	if fpA.className~=fpB.className then return false end
	local strong=FingerprintScore(fpA,fpB)
	local samePartCount=(fpA.partCount==fpB.partCount and fpA.partCount>0)
	local sameVolume=false
	if fpA.totalVolume>0 and fpB.totalVolume>0 then local r=fpA.totalVolume/fpB.totalVolume; sameVolume=(r>=0.90 and r<=1.10) end
	local childMatch,childTotal=0,0
	for name,count in pairs(fpA.childPartNames) do childTotal=childTotal+1; if fpB.childPartNames[name]==count then childMatch=childMatch+1 end end
	local childRatio=childTotal>0 and (childMatch/childTotal) or 0
	if strong>=6 then return true end
	if strong>=3 and samePartCount and sameVolume then return true end
	if strong>=2 and samePartCount and sameVolume and childRatio>=0.8 then return true end
	if samePartCount and sameVolume and fpA.partCount>=4 and childRatio>=0.85 then return true end
	return false
end

