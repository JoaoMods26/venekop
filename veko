function GetBasePartBounds(basePart)
	if not basePart then return nil end
	local size=basePart.Size; local pos=basePart.Position
	return {MinX=pos.X-size.X/2,MaxX=pos.X+size.X/2,MinZ=pos.Z-size.Z/2,MaxZ=pos.Z+size.Z/2,CenterY=pos.Y,CenterX=pos.X,CenterZ=pos.Z}
end
function IsNearBoundary(objPos, objSize, bounds, margin)
	if not bounds then return false end
	local hx = objSize.X / 2; local hz = objSize.Z / 2
	return (objPos.X + hx) > (bounds.MaxX - margin)
		or (objPos.X - hx) < (bounds.MinX + margin)
		or (objPos.Z + hz) > (bounds.MaxZ - margin)
		or (objPos.Z - hz) < (bounds.MinZ + margin)
end
function CalculateSafePosition(targetPos, targetSize, bounds, margin)
	if not bounds then return targetPos end
	local hx = targetSize.X / 2; local hz = targetSize.Z / 2
	local safeX = targetPos.X; local safeZ = targetPos.Z
	if   (safeX + hx) > (bounds.MaxX - margin) then safeX = bounds.MaxX - margin - hx
	elseif (safeX - hx) < (bounds.MinX + margin) then safeX = bounds.MinX + margin + hx end
	if   (safeZ + hz) > (bounds.MaxZ - margin) then safeZ = bounds.MaxZ - margin - hz
	elseif (safeZ - hz) < (bounds.MinZ + margin) then safeZ = bounds.MinZ + margin + hz end
	return Vector3.new(safeX, targetPos.Y, safeZ)
end

