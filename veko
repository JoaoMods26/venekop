-- SISTEMA DE ACTIVACIÓN DE PROXIMITY PROMPTS MEJORADO
local ProximityActivator = {
    Config = {
        maxActivationAttempts = 10,
        delayBetweenAttempts = 0.15,
        holdDurationOverride = 0,
        forceWaitTime = 1.5,
        useAlternativeMethods = true,
        extraSecurityTouch = true,
        extraTouchDelay = 0.10
    }
}

function ProximityActivator:MethodDirect(prompt)
    if not prompt or not prompt.Parent then return false end
    
    local success = false
    
    pcall(function()
        prompt.HoldDuration = self.Config.holdDurationOverride
        prompt:InputHoldBegin()
        wait(0.1)
        prompt:InputHoldEnd()
        success = true
    end)
    
    return success
end

function ProximityActivator:MethodFirePrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    
    local success = false
    
    pcall(function()
        fireproximityprompt(prompt)
        success = true
    end)
    
    return success
end

function ProximityActivator:MethodConnectionFire(prompt)
    if not prompt or not prompt.Parent then return false end
    
    local success = false
    
    pcall(function()
        local triggered = prompt.Triggered
        if triggered then
            for _, connection in pairs(getconnections(triggered)) do
                connection:Fire()
                success = true
            end
        end
    end)
    
    pcall(function()
        local promptShown = prompt.PromptShown
        if promptShown then
            for _, connection in pairs(getconnections(promptShown)) do
                connection:Fire()
            end
        end
    end)
    
    return success
end

function ProximityActivator:MethodForceHold(prompt)
    if not prompt or not prompt.Parent then return false end
    
    local success = false
    
    pcall(function()
        local holdBegan = prompt.PromptButtonHoldBegan
        if holdBegan then
            for _, connection in pairs(getconnections(holdBegan)) do
                connection:Fire()
            end
        end
        
        wait(0.1)
        
        local holdEnded = prompt.PromptButtonHoldEnded
        if holdEnded then
            for _, connection in pairs(getconnections(holdEnded)) do
                connection:Fire()
            end
        end
        
        success = true
    end)
    
    return success
end

function ProximityActivator:MethodProximityWait(prompt, playerPosition)
    if not prompt or not prompt.Parent then return false end
    
    local parent = prompt.Parent
    if not parent:IsA("BasePart") then return false end
    
    local char = LocalPlayer.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local originalHoldDuration = prompt.HoldDuration
    prompt.HoldDuration = 0
    
    local startTime = tick()
    local activated = false
    
    local connection
    connection = prompt.Triggered:Connect(function()
        activated = true
        if connection then
            connection:Disconnect()
        end
    end)
    
    while tick() - startTime < self.Config.forceWaitTime and not activated do
        hrp.CFrame = CFrame.new(parent.Position) * CFrame.new(0, 2, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        wait(0.05)
    end
    
    if connection and connection.Connected then
        connection:Disconnect()
    end
    
    prompt.HoldDuration = originalHoldDuration
    
    return activated
end

function ProximityActivator:MethodCombined(prompt, playerPosition)
    if not prompt or not prompt.Parent then return false end
    
    local results = {
        method1 = false,
        method2 = false,
        method3 = false,
        method4 = false
    }
    
    results.method1 = self:MethodDirect(prompt)
    wait(0.1)
    
    results.method2 = self:MethodFirePrompt(prompt)
    wait(0.1)
    
    results.method3 = self:MethodConnectionFire(prompt)
    wait(0.1)
    
    if PlatformDetector.isMobile or not (results.method1 or results.method2 or results.method3) then
        results.method4 = self:MethodProximityWait(prompt, playerPosition)
    end
    
    return results.method1 or results.method2 or results.method3 or results.method4
end

function ProximityActivator:Activate(prompt, playerPosition)
    if not prompt or not prompt.Parent then return false end
    
    local originalHoldDuration = prompt.HoldDuration
    prompt.HoldDuration = self.Config.holdDurationOverride
    
    local success = false
    local attempts = 0
    
    while not success and attempts < self.Config.maxActivationAttempts do
        attempts = attempts + 1
        
        if PlatformDetector.isMobile then
            success = self:MethodCombined(prompt, playerPosition)
            
            if self.Config.extraSecurityTouch and attempts <= 7 then
                wait(self.Config.extraTouchDelay)
                local extraSuccess = self:MethodFirePrompt(prompt)
                success = success or extraSuccess
            end
            
            if not success and attempts < self.Config.maxActivationAttempts then
                wait(self.Config.delayBetweenAttempts)
            end
        else
            success = self:MethodFirePrompt(prompt)
            
            if not success then
                success = self:MethodDirect(prompt)
            end
            
            if not success then
                success = self:MethodConnectionFire(prompt)
            end
            
            if not success then
                success = self:MethodForceHold(prompt)
            end
            
            if self.Config.extraSecurityTouch and attempts <= 7 then
                wait(self.Config.extraTouchDelay)
                local extraSuccess = self:MethodFirePrompt(prompt)
                success = success or extraSuccess
                
                if not success then
                    extraSuccess = self:MethodDirect(prompt)
                    success = success or extraSuccess
                end
            end
            
            if not success and attempts >= 2 then
                success = self:MethodProximityWait(prompt, playerPosition)
            end
            
            if not success and attempts < self.Config.maxActivationAttempts then
                wait(self.Config.delayBetweenAttempts)
            end
        end
    end
    
    prompt.HoldDuration = originalHoldDuration
    
    return success
end

-- SISTEMA DE TELETRANSPORTE DIRECTO ULTRA-RÁPIDO
local TeleportSystem = {
    Config = {
        antiRollbackDelay = 0.02,
        confirmations = 8,
        useDirectTP = true,
        freezePlayerDuringTP = true,
        forcePositionDuration = 1.5,
        instantMode = true
    },
    
    State = {
        isTeleporting = false,
        targetPosition = nil,
        forcePositionConnection = nil
    }
}

function TeleportSystem:StartForcePosition(targetPos)
    if self.State.forcePositionConnection then
        self.State.forcePositionConnection:Disconnect()
        self.State.forcePositionConnection = nil
    end
    
    self.State.targetPosition = targetPos
    
    local startTime = tick()
    self.State.forcePositionConnection = RunService.RenderStepped:Connect(function()
        if not self.State.targetPosition then
            self.State.forcePositionConnection:Disconnect()
            self.State.forcePositionConnection = nil
            return
        end
        
        if tick() - startTime > self.Config.forcePositionDuration then
            self.State.targetPosition = nil
            self.State.forcePositionConnection:Disconnect()
            self.State.forcePositionConnection = nil
            return
        end
        
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Parent then
                hrp.CFrame = CFrame.new(self.State.targetPosition)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end)
end

function TeleportSystem:InstantTeleport(targetPos)
    local char = LocalPlayer.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local wasAnchored = hrp.Anchored
    local originalCanCollide = hrp.CanCollide
    
    hrp.Anchored = true
    hrp.CanCollide = false
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    
    hrp.CFrame = CFrame.new(targetPos)
    
    for i = 1, self.Config.confirmations do
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        if i % 3 == 0 then
            task.wait(self.Config.antiRollbackDelay)
        end
    end
    
    self:StartForcePosition(targetPos)
    
    task.wait(0.2)
    
    hrp.CanCollide = originalCanCollide
    hrp.Anchored = wasAnchored
    
    return true
end

function TeleportSystem:Teleport(position)
    if self.State.isTeleporting then
        return false
    end
    
    self.State.isTeleporting = true
    local success = self:InstantTeleport(position)
    self.State.isTeleporting = false
    return success
end

LocalPlayer.CharacterAdded:Connect(function()
    if TeleportSystem.State.forcePositionConnection then
        TeleportSystem.State.forcePositionConnection:Disconnect()
        TeleportSystem.State.forcePositionConnection = nil
    end
    TeleportSystem.State.targetPosition = nil
    TeleportSystem.State.isTeleporting = false
end)

