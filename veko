-- Servicios
local RunService = game:GetService("RunService")

-- Configuración de Teleport
local TeleportConfig = {
    WaitAfterTP = PlatformDetector.isMobile and 0.05 or 0.15,
    VehicleFlightSpeed = 3000,
    VehicleFlightHeight = 3000,
    VehicleDescentHeight = 50,
    HoverTime = 0.5
}

-- Variable para guardar posición
local SavedPosition = nil

-- Variables de vuelo
local VehicleFlyConnection = nil
local VehicleFlyActive = false
local CurrentVehicleModel = nil

 function GetVehicleModel()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    
    if humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
        local seat = humanoid.SeatPart
        local modeloIntermedio = seat.Parent
        local modeloPrincipal = modeloIntermedio and modeloIntermedio.Parent
        
        if modeloPrincipal and modeloPrincipal:IsA("Model") and modeloPrincipal.Parent == workspace then
            return modeloPrincipal, seat
        end
    end
    
    return nil, nil
end

 function GetVehiclePrimaryPart(vehicleModel)
    if not vehicleModel then return nil end
    return vehicleModel.PrimaryPart or vehicleModel:FindFirstChildWhichIsA("BasePart")
end

 function ResetVehicleVelocity(vehicleModel)
    if not vehicleModel then return end
    
    for _, obj in pairs(vehicleModel:GetDescendants()) do
        if obj:IsA("BasePart") then
            pcall(function()
                obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                obj.Velocity = Vector3.new(0, 0, 0)
                obj.RotVelocity = Vector3.new(0, 0, 0)
            end)
        end
    end
end

 function StopVehicleFlight()
    if VehicleFlyConnection then
        VehicleFlyConnection:Disconnect()
        VehicleFlyConnection = nil
    end
    
    if CurrentVehicleModel then
        ResetVehicleVelocity(CurrentVehicleModel)
        
        task.wait(0.1)
        ResetVehicleVelocity(CurrentVehicleModel)
    end
    
    VehicleFlyActive = false
    CurrentVehicleModel = nil
end

 function VehicleFlyToPosition(vehicleModel, seat, targetPosition, locationName)
    local vehiclePart = GetVehiclePrimaryPart(vehicleModel)
    if not vehiclePart then
        return false
    end
    
    VehicleFlyActive = true
    CurrentVehicleModel = vehicleModel
    
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if not humanoid then
        StopVehicleFlight()
        return false
    end
    
    local initialRotation = vehiclePart.CFrame - vehiclePart.Position
    local startPosition = vehiclePart.Position
    
    local ascentPosition = Vector3.new(
        startPosition.X,
        TeleportConfig.VehicleFlightHeight,
        startPosition.Z
    )
    
    local approachPosition = Vector3.new(
        targetPosition.X,
        TeleportConfig.VehicleFlightHeight,
        targetPosition.Z
    )
    
    local finalPosition = Vector3.new(
        targetPosition.X,
        targetPosition.Y + TeleportConfig.VehicleDescentHeight,
        targetPosition.Z
    )
    
    local currentPhase = "ASCENT"
    local phaseStartTime = tick()
    
    VehicleFlyConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not VehicleFlyActive then return end
        
        if not humanoid.Sit or humanoid.SeatPart ~= seat then
            StopVehicleFlight()
            return
        end
        
        local currentPos = vehiclePart.Position
        local moveDirection = Vector3.new(0, 0, 0)
        
        if currentPhase == "ASCENT" then
            moveDirection = (ascentPosition - currentPos).Unit
            
            if currentPos.Y >= TeleportConfig.VehicleFlightHeight - 10 then
                currentPhase = "HORIZONTAL"
                phaseStartTime = tick()
            end
            
        elseif currentPhase == "HORIZONTAL" then
            local horizontalDirection = Vector3.new(
                approachPosition.X - currentPos.X,
                0,
                approachPosition.Z - currentPos.Z
            )
            
            if horizontalDirection.Magnitude > 10 then
                moveDirection = horizontalDirection.Unit
            else
                currentPhase = "HOVER"
                phaseStartTime = tick()
                moveDirection = Vector3.new(0, 0, 0)
            end
            
        elseif currentPhase == "HOVER" then
            moveDirection = Vector3.new(0, 0, 0)
            
            if tick() - phaseStartTime >= TeleportConfig.HoverTime then
                currentPhase = "DESCENT"
                phaseStartTime = tick()
            end
            
        elseif currentPhase == "DESCENT" then
            moveDirection = (finalPosition - currentPos).Unit
            
            if currentPos.Y <= finalPosition.Y + 10 then
                currentPhase = "COMPLETE"
            end
            
        elseif currentPhase == "COMPLETE" then
            ResetVehicleVelocity(vehicleModel)
            StopVehicleFlight()
            return
        end
        
        if moveDirection.Magnitude == 0 then
            vehiclePart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        else
            vehiclePart.AssemblyLinearVelocity = moveDirection.Unit * TeleportConfig.VehicleFlightSpeed
        end
        
        vehiclePart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        vehiclePart.CFrame = CFrame.new(vehiclePart.Position) * initialRotation
    end)
    
    return true
end

 function TeleportToPosition(position, locationName)
    local vehicleModel, seat = GetVehicleModel()
    
    if vehicleModel and seat then
        return VehicleFlyToPosition(vehicleModel, seat, position, locationName)
    end
    
    local character = LocalPlayer.Character
    if not character then
        return false
    end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return false
    end
    
    local success = TeleportSystem:Teleport(position)
    
    task.wait(TeleportConfig.WaitAfterTP)
    return success
end

