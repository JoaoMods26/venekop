-- ────────────────────────────────────────────────────────────────
-- Copia de parcela
-- ────────────────────────────────────────────────────────────────
function CopyPlotFurniture(plotFolder)
	BuildMeshTextureIndex()
	local furnitureContainer=FindFurnitureContainer(plotFolder,true)
	if not furnitureContainer then return nil end
	local basePart=plotFolder:FindFirstChild("BasePart")
	if not basePart then return nil end
	local originCFrame=basePart.CFrame
	local copiedItems={Objects={},OriginCFrame=originCFrame}
	local copiedCount,skippedCount=0,0
	local methodStats={nombre=0,firma_bloque=0,mesh_id=0,fingerprint=0,fallback=0}

	for _,item in pairs(furnitureContainer:GetChildren()) do
		local modelName=item.Name
		if BLACKLISTED_NAMES[modelName] then
			skippedCount=skippedCount+1
			local detected=DetectBlockTemplate(item)
			if detected and not BLACKLISTED_NAMES[detected] then
				modelName=detected
			else
				local mp = item:IsA("BasePart") and item or (item.PrimaryPart)
				if mp then
					local cn = mp.ClassName
					if cn == "WedgePart" then modelName="wedge"
					elseif cn == "CornerWedgePart" then modelName="wedge3"
					else modelName="part_cube" end
				else
					continue
				end
			end
		end

		local esValido=VALID_OBJECTS[modelName]==true
		local detectionMethod="nombre"
		if esValido then methodStats.nombre=methodStats.nombre+1 end

		if not esValido then
			local detected=DetectBlockTemplate(item)
			if detected and not BLACKLISTED_NAMES[detected] then
				modelName=detected; esValido=true; detectionMethod="firma_bloque"
				methodStats.firma_bloque=methodStats.firma_bloque+1
			end
		end
		if not esValido then
			local byMesh=FindTemplateByMeshTexture(item)
			if byMesh and not SCALABLE_BLOCKS[byMesh] and not BLACKLISTED_NAMES[byMesh] then
				modelName=byMesh; esValido=true; detectionMethod="mesh_id"
				methodStats.mesh_id=methodStats.mesh_id+1
			end
		end
		if not esValido then
			local objFP=GenerateFingerprint(item); local bestFP,bestScore=nil,0
			for _,fItem in pairs(Furnitures:GetChildren()) do
				if not SCALABLE_BLOCKS[fItem.Name] and not BLACKLISTED_NAMES[fItem.Name] then
					local fFP=GenerateFingerprint(fItem)
					if FingerprintMatches(objFP,fFP) then
						local sc=FingerprintScore(objFP,fFP)
						if sc>bestScore then bestScore=sc; bestFP=fItem.Name end
					end
				end
			end
			if bestFP and not BLACKLISTED_NAMES[bestFP] then
				modelName=bestFP; esValido=true; detectionMethod="fingerprint"
				methodStats.fingerprint=methodStats.fingerprint+1
			end
		end
		if not esValido then skippedCount=skippedCount+1; continue end
		if BLACKLISTED_NAMES[modelName] then modelName = "part_cube" end

		local objCFrame=GetObjectCFrame(item)
		if not objCFrame then skippedCount=skippedCount+1; continue end
		local relativeTransform=CalculateRelativeTransform(originCFrame,objCFrame)
		local actualSize=GetActualModelSize(item)
		local originalSize=GetOriginalModelSize(modelName)
		local colors=GetObjectColors(item)
		local esBloque=IsScalableBlock(modelName,actualSize,originalSize)
		local needsScale = esBloque
		if SCALABLE_BLOCKS[modelName] and actualSize and originalSize then
			local diffMag = ((actualSize.X-originalSize.X)^2 + (actualSize.Y-originalSize.Y)^2 + (actualSize.Z-originalSize.Z)^2)^0.5
			needsScale = diffMag > 0.05
		end

		local actualSizeTable = nil
		if actualSize then
			actualSizeTable = {
				math.floor(actualSize.X * 10000 + 0.5) / 10000,
				math.floor(actualSize.Y * 10000 + 0.5) / 10000,
				math.floor(actualSize.Z * 10000 + 0.5) / 10000
			}
		end

		table.insert(copiedItems.Objects,{
			ModelName        = modelName,
			RelativeTransform = relativeTransform,
			ActualSize       = actualSizeTable,
			OriginalSize     = originalSize and Vector3ToTable(originalSize) or nil,
			NeedsScale       = needsScale,
			IsScalableBlock  = esBloque,
			Colors           = colors,
			DetectionMethod  = detectionMethod,
		})
		copiedCount=copiedCount+1
	end

	if copiedCount==0 then return nil end
	return copiedItems
end

-- ────────────────────────────────────────────────────────────────
-- Escalado (sin cambios internos, solo se llama distinto)
-- ────────────────────────────────────────────────────────────────
function ResolveRootObject(obj)
	if not obj then return nil end
	if IsUUID(obj.Name) then return obj end
	local cur = obj
	for _ = 1, 8 do
		if not cur or not cur.Parent then break end
		if IsUUID(cur.Name) then return cur end
		cur = cur.Parent
	end
	if obj:IsA("Model") then return obj end
	if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then return obj.Parent end
	return obj
end

function GetRealSizeFromObject(rootObj)
	if rootObj:IsA("Model") then
		if rootObj.PrimaryPart then return rootObj.PrimaryPart.Size end
		for _, c in pairs(rootObj:GetDescendants()) do
			if c:IsA("BasePart") then return c.Size end
		end
	elseif rootObj:IsA("BasePart") then
		return rootObj.Size
	end
	return nil
end

function ScaleObject(guid, obj, targetSizeVec, originalCF, plotBounds)
	local rootObj = ResolveRootObject(obj)
	if not rootObj or not rootObj.Parent then return false, nil end

	local originalTemplateSize = GetOriginalModelSize(rootObj.Name) or Vector3.new(1,1,1)
	local currentSizeVec = nil

	for _sizeAttempt = 1, CONFIG.SCALE_SIZE_WAIT_RETRIES do
		local sz = GetRealSizeFromObject(rootObj)
		local minT = CONFIG.SCALE_SIZE_MIN_THRESHOLD
		if sz and sz.X > minT and sz.Y > minT and sz.Z > minT then
			currentSizeVec = sz; break
		end
		if _sizeAttempt < CONFIG.SCALE_SIZE_WAIT_RETRIES then task.wait(CONFIG.SCALE_SIZE_WAIT_DELAY) end
	end
	if not currentSizeVec then currentSizeVec = originalTemplateSize end

	local diffMag = (targetSizeVec - currentSizeVec).Magnitude
	if diffMag < 0.03 then return true, currentSizeVec end

	local function makeScaleCF(pos3)
		if originalCF then
			local _,_,_, r00,r01,r02, r10,r11,r12, r20,r21,r22 = originalCF:GetComponents()
			return CFrame.new(pos3.X, pos3.Y, pos3.Z, r00,r01,r02, r10,r11,r12, r20,r21,r22)
		end
		return CFrame.new(pos3)
	end

	local function runScaleLoop(loopTarget, maxIter, maxStalls)
		maxIter   = maxIter   or 120
		maxStalls = maxStalls or 8
		local lastRealSize  = GetRealSizeFromObject(rootObj) or loopTarget
		local stallCount    = 0
		local noChangeFrames = 0

		local cf0 = GetObjectCFrame(rootObj)
		if cf0 then
			for _ = 1, 5 do
				pcall(function()
					PlotSystemRemote:InvokeServer("scaleFurniture", guid, makeScaleCF(cf0.Position), loopTarget)
				end)
			end
			task.wait(0)
		end

		local checkNow = GetRealSizeFromObject(rootObj)
		if checkNow and (checkNow - loopTarget).Magnitude < 0.05 then
			return true, checkNow
		end

		for iteration = 1, maxIter do
			if stopPlacement then return false, GetRealSizeFromObject(rootObj) or lastRealSize end
			local realNow = GetRealSizeFromObject(rootObj)
			if not realNow then break end
			local remaining = (realNow - loopTarget).Magnitude
			if remaining < 0.05 then return true, realNow end

			local prog = (realNow - lastRealSize).Magnitude
			if prog < 0.005 then
				noChangeFrames = noChangeFrames + 1
				if noChangeFrames >= CONFIG.SCALE_LOOP_STALL_FRAMES then
					stallCount    = stallCount + 1
					noChangeFrames = 0
					if stallCount >= maxStalls then break end
				end
			else
				noChangeFrames = 0
				stallCount = 0
			end
			lastRealSize = realNow

			local cf = GetObjectCFrame(rootObj)
			if not cf then break end
			pcall(function()
				PlotSystemRemote:InvokeServer("scaleFurniture", guid, makeScaleCF(cf.Position), loopTarget)
			end)
			task.wait(0)
		end
		return false, GetRealSizeFromObject(rootObj) or lastRealSize
	end

	local function doMoveSimple(destCF, maxIter)
		maxIter = maxIter or 80
		for _ = 1, maxIter do
			if stopPlacement then return end
			local cf = GetObjectCFrame(rootObj)
			if cf and (cf.Position - destCF.Position).Magnitude < 0.3 then return end
			pcall(function() PlotSystemRemote:InvokeServer("moveFurniture", guid, destCF) end)
			task.wait(CONFIG.REPOS_STEP_DELAY)
		end
		pcall(function() PlotSystemRemote:InvokeServer("moveFurniture", guid, destCF) end)
	end

	-- Detectar si el bloque es "grande relativo al plot":
	-- Un bloque que ocupa >= 60% del ancho/largo del plot quedará pegado al borde
	-- al crecer, así que hay que moverlo al centro ANTES de escalarlo.
	-- Esto cubre pisos completos, paredes del tamaño del plot, etc.
	local plotWidth  = plotBounds and (plotBounds.MaxX - plotBounds.MinX) or 0
	local plotDepth  = plotBounds and (plotBounds.MaxZ - plotBounds.MinZ) or 0
	local RELATIVE_THRESHOLD = 0.60  -- 60% del tamaño del plot = "bloque grande"
	local isLargeBlock = CONFIG.LARGE_BLOCK_CENTER_MOVE and plotBounds and (
		(plotWidth  > 0 and targetSizeVec.X >= plotWidth  * RELATIVE_THRESHOLD) or
		(plotDepth  > 0 and targetSizeVec.Z >= plotDepth  * RELATIVE_THRESHOLD) or
		-- fallback: threshold absoluto para plots muy grandes
		targetSizeVec.X > CONFIG.LARGE_BLOCK_THRESHOLD or
		targetSizeVec.Z > CONFIG.LARGE_BLOCK_THRESHOLD
	)

	if isLargeBlock then
		local curCF  = GetObjectCFrame(rootObj) or originalCF or CFrame.new()
		local centerPos = Vector3.new(plotBounds.CenterX, curCF.Position.Y, plotBounds.CenterZ)
		local centerCF = makeScaleCF(centerPos)
		-- Mover al centro con suficientes intentos para que el servidor lo acepte
		doMoveSimple(centerCF, 120)
		task.wait(0.12)

		local okA, sizeAfterA = runScaleLoop(targetSizeVec, CONFIG.SCALE_PHASE_A_MAX_ITER, 40)
		if stopPlacement then return false, sizeAfterA end
		local realAfterA = GetRealSizeFromObject(rootObj) or sizeAfterA or currentSizeVec
		if not okA and (realAfterA - targetSizeVec).Magnitude >= 0.05 and not stopPlacement then
			runScaleLoop(targetSizeVec, CONFIG.SCALE_PHASE_B_MAX_ITER, CONFIG.SCALE_PHASE_B_STALLS)
		end
		local finalReal = GetRealSizeFromObject(rootObj) or realAfterA
		local finalDiff = (finalReal - targetSizeVec).Magnitude
		return finalDiff < (diffMag * 0.9) or finalDiff < 1.0, finalReal
	else
		local okA, sizeAfterA = runScaleLoop(targetSizeVec, CONFIG.SCALE_PHASE_A_MAX_ITER, 40)
		if stopPlacement then return false, sizeAfterA end
		local realAfterA = GetRealSizeFromObject(rootObj) or sizeAfterA or currentSizeVec
		if okA or (realAfterA - targetSizeVec).Magnitude < 0.05 then
			return true, realAfterA
		end
		if not stopPlacement then
			runScaleLoop(targetSizeVec, CONFIG.SCALE_PHASE_B_MAX_ITER, CONFIG.SCALE_PHASE_B_STALLS)
		end
		local finalReal = GetRealSizeFromObject(rootObj) or realAfterA
		local finalDiff = (finalReal - targetSizeVec).Magnitude
		return finalDiff < (diffMag * 0.9), finalReal
	end
end

