function GrantTemporaryAccess(targetPlayerName)
	local tp=nil
	for _,p in pairs(game.Players:GetPlayers()) do
		if p.Name:lower()==targetPlayerName:lower() or p.DisplayName:lower()==targetPlayerName:lower() then tp=p; break end
	end
	if not tp then JmodsLib:Notify({Title="Error",Content="Jugador no encontrado",Duration=4}); return false end
	_G.TemporaryAccessList[tp.UserId]=true
	JmodsLib:Notify({Title="Acceso Concedido",Content="Acceso temporal: "..tp.DisplayName,Duration=4})
	if tp==player then JmodsLib:Notify({Title="Recargando...",Content="En 2s",Duration=2}); task.wait(2); ReloadScript() end
	return true
end
function RevokeTemporaryAccess(targetPlayerName)
	local tp=nil
	for _,p in pairs(game.Players:GetPlayers()) do
		if p.Name:lower()==targetPlayerName:lower() or p.DisplayName:lower()==targetPlayerName:lower() then tp=p; break end
	end
	if not tp then JmodsLib:Notify({Title="Error",Content="Jugador no encontrado",Duration=4}); return false end
	if IsOwner(tp.UserId) then JmodsLib:Notify({Title="Error",Content="No puedes quitar acceso a owner",Duration=4}); return false end
	if allowedUserIds[tp.UserId] and not _G.TemporaryAccessList[tp.UserId] then
		JmodsLib:Notify({Title="Error",Content=tp.DisplayName.." tiene acceso permanente",Duration=4}); return false
	end
	_G.TemporaryAccessList[tp.UserId]=nil
	JmodsLib:Notify({Title="Acceso Revocado",Content=tp.DisplayName,Duration=4})
	if tp==player then
		task.wait(3)
		if Window then pcall(function() Window:Destroy() end) end
		player:Kick("Acceso revocado.")
	end
	return true
end
function ProcessOwnerChatCommand(senderUserId, rawMessage)
	if not IsOwner(senderUserId) then return end
	local msg=CleanChatMessage(rawMessage); local lower=msg:lower()
	if lower:sub(1,1)~="." then return end
	if lower:sub(1,7)==".acceso" then
		local t=msg:sub(8):match("^%s*(.-)%s*$")
		if t and t~="" then GrantTemporaryAccess(t) else JmodsLib:Notify({Title="Error",Content="Uso: .acceso <nombre>",Duration=3}) end
	elseif lower:sub(1,7)==".quitar" then
		local t=msg:sub(8):match("^%s*(.-)%s*$")
		if t and t~="" then RevokeTemporaryAccess(t) else JmodsLib:Notify({Title="Error",Content="Uso: .quitar <nombre>",Duration=3}) end
	end
end
