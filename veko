function NormalizeAssetId(id)
	if not id or id == "" then return "" end
	id = tostring(id):lower()
	local num = id:match("rbxassetid://(%d+)")
		or id:match("rbxasset://[^?]+%?id=(%d+)")
		or id:match("^(%d+)$")
	if num then return num end
	return id:gsub("rbxassetid://",""):gsub("%s+","")
end

