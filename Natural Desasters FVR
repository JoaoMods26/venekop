local function makeNumericRow(parent, label, val, onChange)
    local row = Instance.new("Frame"); row.Size, row.BackgroundTransparency = UDim2.new(1,0,0,22), 1; row.Parent = parent
    local lbl = Instance.new("TextLabel"); lbl.Size, lbl.Position, lbl.BackgroundTransparency, lbl.Text, lbl.TextColor3, lbl.TextSize, lbl.Font, lbl.TextXAlignment = UDim2.new(0,80,1,0), UDim2.new(0,0,0,0), 1, label, Color3.fromRGB(200,200,200), 12, Enum.Font.SourceSans, Enum.TextXAlignment.Left; lbl.Parent = row
    local input = Instance.new("TextBox"); input.Size, input.Position, input.BackgroundColor3, input.TextColor3, input.Text, input.TextSize, input.Font, input.ClearTextOnFocus = UDim2.new(1,-85,1,0), UDim2.new(0,85,0,0), Color3.fromRGB(40,40,45), Color3.fromRGB(255,255,255), tostring(val), 12, Enum.Font.SourceSans, false; input.Parent = row
    input.FocusLost:Connect(function()
        local nv = tonumber(input.Text)
        if nv then onChange(nv) else input.Text = tostring(val) end
    end)
    return row
end

local function makeColorRow(parent, label, val, onChange)
    -- 
    local container = Instance.new("Frame")
    container.Size, container.BackgroundTransparency = UDim2.new(1,0,0,46), 1
    container.Parent = parent

    local row = Instance.new("Frame"); row.Size, row.Position, row.BackgroundTransparency = UDim2.new(1,0,0,22), UDim2.new(0,0,0,0), 1; row.Parent = container
    local lbl = Instance.new("TextLabel"); lbl.Size, lbl.Position, lbl.BackgroundTransparency, lbl.Text, lbl.TextColor3, lbl.TextSize, lbl.Font, lbl.TextXAlignment = UDim2.new(0,80,1,0), UDim2.new(0,0,0,0), 1, label, Color3.fromRGB(200,200,200), 12, Enum.Font.SourceSans, Enum.TextXAlignment.Left; lbl.Parent = row
    local cf = Instance.new("Frame"); cf.Size, cf.Position, cf.BackgroundTransparency = UDim2.new(1,-85,1,0), UDim2.new(0,85,0,0), 1; cf.Parent = row
    local rBox = Instance.new("TextBox"); rBox.Size, rBox.Position, rBox.BackgroundColor3, rBox.TextColor3, rBox.Text, rBox.TextSize, rBox.Font, rBox.ClearTextOnFocus = UDim2.new(0,35,1,0), UDim2.new(0,0,0,0), Color3.fromRGB(40,40,45), Color3.fromRGB(255,255,255), tostring(val.R), 11, Enum.Font.SourceSans, false; rBox.Parent = cf
    local gBox = rBox:Clone(); gBox.Position = UDim2.new(0,40,0,0); gBox.Parent = cf
    local bBox = rBox:Clone(); bBox.Position = UDim2.new(0,80,0,0); bBox.Parent = cf
    local function update()
        local r = tonumber(rBox.Text) or 0; local g = tonumber(gBox.Text) or 0; local b = tonumber(bBox.Text) or 0
        onChange({R=math.clamp(r,0,255), G=math.clamp(g,0,255), B=math.clamp(b,0,255)})
    end
    rBox.FocusLost:Connect(update); gBox.FocusLost:Connect(update); bBox.FocusLost:Connect(update)

    -- Paleta rápida: un clic pone el color sin tener que escribir números
    local swatchRow = Instance.new("Frame")
    swatchRow.Size, swatchRow.Position, swatchRow.BackgroundTransparency = UDim2.new(1,-85,0,18), UDim2.new(0,85,0,25), 1
    swatchRow.Parent = container
    local swatchLayout = Instance.new("UIListLayout")
    swatchLayout.FillDirection, swatchLayout.Padding, swatchLayout.SortOrder = Enum.FillDirection.Horizontal, UDim.new(0,3), Enum.SortOrder.LayoutOrder
    swatchLayout.Parent = swatchRow
    for _, col in ipairs(PALETTE) do
        local sw = Instance.new("TextButton")
        sw.Size, sw.Text, sw.AutoButtonColor, sw.BorderSizePixel = UDim2.new(0,16,0,16), "", false, 1
        sw.BackgroundColor3 = Color3.fromRGB(col[1], col[2], col[3])
        sw.BorderColor3 = Color3.fromRGB(255,255,255)
        sw.Parent = swatchRow
        local swc = Instance.new("UICorner"); swc.CornerRadius = UDim.new(1,0); swc.Parent = sw
        sw.MouseButton1Click:Connect(function()
            rBox.Text, gBox.Text, bBox.Text = tostring(col[1]), tostring(col[2]), tostring(col[3])
            update()
        end)
    end
    return container
end

actualizarPanelPropiedades = function()
    for _, c in ipairs(propFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    local cfgKey = selectedElement:gsub(" ","").."Pad"
    if selectedElement == "Toggle" then cfgKey = "ToggleBtn" end
    if selectedElement == "Izquierdo Z" then cfgKey = "IzquierdoZPad" end
    if selectedElement == "Derecho Z" then cfgKey = "DerechoZPad" end
    local data = config[cfgKey]
    if not data then return end
    makeNumericRow(propFrame, "Pos X", data.Position.X, function(v) data.Position.X = math.floor(v); aplicarParcial() end)
    makeNumericRow(propFrame, "Pos Y", data.Position.Y, function(v) data.Position.Y = math.floor(v); aplicarParcial() end)
    makeNumericRow(propFrame, "Ancho", data.Size.Width, function(v) data.Size.Width = math.max(10, math.floor(v)); aplicarParcial() end)
    makeNumericRow(propFrame, "Alto", data.Size.Height, function(v) data.Size.Height = math.max(10, math.floor(v)); aplicarParcial() end)
    if data.BgColor then makeColorRow(propFrame, "Color Fondo", data.BgColor, function(v) data.BgColor = v; aplicarParcial() end) end
    if data.BgTrans ~= nil then makeNumericRow(propFrame, "Transp. Fondo", data.BgTrans, function(v) data.BgTrans = math.clamp(v,0,1); aplicarParcial() end) end
    if data.ThumbColor then makeColorRow(propFrame, "Color Pulgar", data.ThumbColor, function(v) data.ThumbColor = v; aplicarParcial() end) end
    if data.ThumbTrans ~= nil then makeNumericRow(propFrame, "Transp. Pulgar", data.ThumbTrans, function(v) data.ThumbTrans = math.clamp(v,0,1); aplicarParcial() end) end
    updateCanvas()
end

aplicarParcial = function()
    applyConfigToUI(config)
    if menuVisible then actualizarPanelPropiedades() end
end

