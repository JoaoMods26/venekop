local function deepMerge(t1, t2)
    local merged = {}
    for k,v in pairs(t1) do merged[k] = v end
    for k,v in pairs(t2) do
        if type(v)=="table" and type(merged[k])=="table" then merged[k] = deepMerge(merged[k], v) else merged[k] = v end
    end
    return merged
end

local function applyConfigToUI(cfg)
    local function applyPad(padKey, thumbKey, data)
        if not data then return end
        local pad, thumb = UI_ELEMENTS[padKey], UI_ELEMENTS[thumbKey]
        if pad and thumb then
            local xS, yS = pad.Position.X.Scale, pad.Position.Y.Scale
            pad.Position = UDim2.new(xS, data.Position.X, yS, data.Position.Y)
            pad.Size = UDim2.new(0, data.Size.Width, 0, data.Size.Height)
            pad.BackgroundColor3 = Color3.fromRGB(data.BgColor.R, data.BgColor.G, data.BgColor.B)
            pad.BackgroundTransparency = data.BgTrans
            thumb.BackgroundColor3 = Color3.fromRGB(data.ThumbColor.R, data.ThumbColor.G, data.ThumbColor.B)
            thumb.BackgroundTransparency = data.ThumbTrans
        end
    end
    applyPad("IzquierdoPad","IzquierdoThumb", cfg.IzquierdoPad)
    applyPad("IzquierdoZPad","IzquierdoZThumb", cfg.IzquierdoZPad)
    applyPad("DerechoPad","DerechoThumb", cfg.DerechoPad)
    applyPad("DerechoZPad","DerechoZThumb", cfg.DerechoZPad)
    local tb = UI_ELEMENTS.ToggleBtn
    if tb and cfg.ToggleBtn then
        local xS, yS = tb.Position.X.Scale, tb.Position.Y.Scale
        tb.Position = UDim2.new(xS, cfg.ToggleBtn.Position.X, yS, cfg.ToggleBtn.Position.Y)
        tb.Size = UDim2.new(0, cfg.ToggleBtn.Size.Width, 0, cfg.ToggleBtn.Size.Height)
        tb.BackgroundColor3 = Color3.fromRGB(cfg.ToggleBtn.BgColor.R, cfg.ToggleBtn.BgColor.G, cfg.ToggleBtn.BgColor.B)
        tb.BackgroundTransparency = cfg.ToggleBtn.BgTrans
        tb.TextColor3 = Color3.fromRGB(cfg.ToggleBtn.TextColor.R, cfg.ToggleBtn.TextColor.G, cfg.ToggleBtn.TextColor.B)
    end
end

local function saveConfig(cfg)
    if not writefile then return false end
    local json = HttpService:JSONEncode(cfg)
    local ok, err = pcall(function() writefile(CONFIG_FILE, json) end)
    return ok
end

local function loadConfig()
    if not readfile then return nil end
    local content
    local ok, err = pcall(function() content = readfile(CONFIG_FILE) end)
    if not ok or not content then return nil end
    local decoded = HttpService:JSONDecode(content)
    if type(decoded)=="table" then return deepMerge(getDefaultConfig(), decoded) end
    return nil
end

