-- Crear joysticks
local function crearJoystick(nombre, posicion, color)
    local pad = Instance.new("Frame")
    pad.Name = nombre.."_Pad"
    pad.Size, pad.Position, pad.BackgroundColor3, pad.BackgroundTransparency = UDim2.new(0,125,0,125), posicion, Color3.fromRGB(20,20,20), 0.6
    pad.BorderSizePixel, pad.Active, pad.Visible = 0, true, false
    pad.Parent = ScreenGui
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1,0); corner.Parent = pad

    local thumb = Instance.new("ImageButton")
    thumb.Name, thumb.Size, thumb.Position, thumb.BackgroundColor3, thumb.BackgroundTransparency = "Thumb", UDim2.new(0,50,0,50), UDim2.new(0.5,-25,0.5,-25), color, 0.2
    thumb.BorderSizePixel = 0
    thumb.Parent = pad
    local tcorner = Instance.new("UICorner"); tcorner.CornerRadius = UDim.new(1,0); tcorner.Parent = thumb

    UI_ELEMENTS[nombre.."Pad"], UI_ELEMENTS[nombre.."Thumb"] = pad, thumb

    local dragging, startPos, currentInput = false, Vector2.new(), nil
    local function actualizar(inputPos)
        if not dragging then return end
        actualizarJoystickPrincipal(nombre, inputPos - startPos, thumb)
    end
    thumb.InputBegan:Connect(function(input)
        -- FIX: si el modo edición está activo, no procesamos el arrastre
        -- normal del joystick (que movía la mano en el juego). Así el
        -- input queda libre para que el sistema de edición mueva el pad.
        if editEnabled then return end
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not dragging then
            dragging, startPos, currentInput = true, input.Position, input
            if nombre == "Derecho" then rightLargeDragging = true else leftLargeDragging = true end
            actualizar(input.Position)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == currentInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            actualizar(input.Position)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and (input == currentInput or (not currentInput and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragging, currentInput = false, nil
            if nombre == "Derecho" then rightLargeDragging = false else leftLargeDragging = false end
        end
    end)
end

local function crearJoystickZ(nombre, posicion, color)
    local pad = Instance.new("Frame")
    pad.Name = nombre.."_Z_Pad"
    pad.Size, pad.Position, pad.BackgroundColor3, pad.BackgroundTransparency = UDim2.new(0,75,0,75), posicion, Color3.fromRGB(20,20,20), 0.6
    pad.BorderSizePixel, pad.Active, pad.Visible = 0, true, false
    pad.Parent = ScreenGui
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1,0); corner.Parent = pad

    local thumb = Instance.new("ImageButton")
    thumb.Name, thumb.Size, thumb.Position, thumb.BackgroundColor3, thumb.BackgroundTransparency = "Thumb", UDim2.new(0,30,0,30), UDim2.new(0.5,-15,0.5,-15), color, 0.2
    thumb.BorderSizePixel = 0
    thumb.Parent = pad
    local tcorner = Instance.new("UICorner"); tcorner.CornerRadius = UDim.new(1,0); tcorner.Parent = thumb

    UI_ELEMENTS[nombre.."ZPad"], UI_ELEMENTS[nombre.."ZThumb"] = pad, thumb

    local dragging, startPos, currentInput = false, Vector2.new(), nil
    local maxDist = 25
    local function actualizar(inputPos)
        if not dragging then return end
        local padCenterY = pad.AbsolutePosition.Y + pad.AbsoluteSize.Y/2
        local relativeY = inputPos.Y - padCenterY
        local clampedY = math.clamp(relativeY, -maxDist, maxDist)
        thumb.Position = UDim2.new(0.5, -15, 0.5, -15 + clampedY)
        local intensidad = -clampedY / maxDist
        if nombre == "Derecho" then rightZMove = intensidad else leftZMove = intensidad end
    end
    thumb.InputBegan:Connect(function(input)
        -- FIX: mismo motivo que en crearJoystick; liberamos el input para
        -- que el sistema de edición pueda mover el pad completo.
        if editEnabled then return end
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not dragging then
            dragging, startPos, currentInput = true, input.Position, input
            actualizar(input.Position)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == currentInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            actualizar(input.Position)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and (input == currentInput or (not currentInput and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragging, currentInput = false, nil
        end
    end)
end

