    elseif key == Enum.KeyCode.E then keyStates.E, keyOrigins.E = true, mouse
    elseif key == Enum.KeyCode.R then keyStates.R, keyOrigins.R = true, mouse
    elseif key == Enum.KeyCode.Z then keyStates.Z, keyOrigins.Z = true, mouse
    elseif key == Enum.KeyCode.X then keyStates.X, keyOrigins.X = true, mouse
    elseif key == Enum.KeyCode.C then keyStates.C, keyOrigins.C = true, mouse end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    local key = input.KeyCode
