-- Detectamos el toque/click directamente sobre cada pad (evento propio del
-- objeto, no depende de "gameProcessedEvent") para saber exactamente cuál
-- fue tocado y arrancar el arrastre + la selección al instante.
for key, obj in pairs(UI_ELEMENTS) do
    if PAD_LABELS[key] and obj:IsA("Frame") then
        obj.InputBegan:Connect(function(input)
            if not editEnabled or draggingPad then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            draggingPad, dragPadKey, dragStartMouse, dragInput = obj, key, input.Position, input
            leftLargeDragging, rightLargeDragging = true, true
            seleccionarElemento(PAD_LABELS[key])
        end)
    end
end


UserInputService.InputChanged:Connect(function(input)
    if not draggingPad or not editEnabled then return end
    local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
    local isSameTouch = input.UserInputType == Enum.UserInputType.Touch and input == dragInput
    if not isMouse and not isSameTouch then return end
    local delta = input.Position - dragStartMouse
    dragStartMouse = input.Position
    local xS, yS = draggingPad.Position.X.Scale, draggingPad.Position.Y.Scale
    local newOffsetX = draggingPad.Position.X.Offset + delta.X
    local newOffsetY = draggingPad.Position.Y.Offset + delta.Y
    draggingPad.Position = UDim2.new(xS, newOffsetX, yS, newOffsetY)
    local cfgKey = dragPadKey:gsub("Pad","")
    if cfgKey == "IzquierdoZ" then cfgKey = "IzquierdoZPad"
    elseif cfgKey == "DerechoZ" then cfgKey = "DerechoZPad"
    elseif cfgKey == "Izquierdo" then cfgKey = "IzquierdoPad"
    elseif cfgKey == "Derecho" then cfgKey = "DerechoPad"
    elseif cfgKey == "ToggleVR_UI" then cfgKey = "ToggleBtn"
    end
    local data = config[cfgKey]
    if data then
        data.Position.X, data.Position.Y = math.round(newOffsetX), math.round(newOffsetY)
        if menuVisible then actualizarPanelPropiedades() end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or (input.UserInputType == Enum.UserInputType.Touch and input == dragInput)) then
        if draggingPad then
            draggingPad.BorderColor3 = Color3.fromRGB(255,255,0)
            draggingPad, dragStartMouse, dragPadKey, dragInput = nil, nil, nil, nil
            leftLargeDragging, rightLargeDragging = false, false
        end
    end
end)

