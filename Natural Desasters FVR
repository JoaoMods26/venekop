toggleEditMode = function()
    editEnabled = not editEnabled
    if editEnabled then
        editModeBtn.BackgroundColor3 = Color3.fromRGB(0,150,200)
        editModeBtn.Text = "✏️ Editar (ON)"
        for key, obj in pairs(UI_ELEMENTS) do
            if PAD_LABELS[key] and obj:IsA("Frame") then
                obj.BackgroundTransparency = 0.35
            end
        end
    else
        editModeBtn.BackgroundColor3 = Color3.fromRGB(60,60,70)
        editModeBtn.Text = "✏️ Editar"
        for key, obj in pairs(UI_ELEMENTS) do
