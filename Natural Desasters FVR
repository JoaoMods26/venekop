local keyStates = {Q=false, E=false, R=false, Z=false, X=false, C=false}
local keyOrigins = {Q=nil, E=nil, R=nil, Z=nil, X=nil, C=nil}

local function actualizarJoystickPrincipal(nombre, delta, thumb)
    local maxDist = 45
    local distance = math.clamp(delta.Magnitude, 0, maxDist)
    local direction = delta.Magnitude > 0 and delta.Unit or Vector2.new(0,0)
    local intensidad = distance / maxDist
    local mov = Vector2.new(direction.X * intensidad, -direction.Y * intensidad)
    if nombre == "Izquierdo" then
        leftJoyMove = mov
        if thumb then thumb.Position = UDim2.new(0.5, -25 + direction.X*distance, 0.5, -25 + direction.Y*distance) end
    elseif nombre == "Derecho" then
        rightJoyMove = mov
        if thumb then thumb.Position = UDim2.new(0.5, -25 + direction.X*distance, 0.5, -25 + direction.Y*distance) end
    end
end

local function actualizarJoystickZ(nombre, deltaY, thumb)
    local maxDist = 25
    local clampedY = math.clamp(deltaY, -maxDist, maxDist)
    local intensidad = -clampedY / maxDist
    if nombre == "Izquierdo" then
        leftZMove = intensidad
        if thumb then thumb.Position = UDim2.new(0.5, -15, 0.5, -15 + clampedY) end
    else
        rightZMove = intensidad
        if thumb then thumb.Position = UDim2.new(0.5, -15, 0.5, -15 + clampedY) end
    end
end

