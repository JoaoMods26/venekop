RunService.RenderStepped:Connect(function()
    if not leftLargeDragging then
        leftJoyMove = leftJoyMove:Lerp(Vector2.new(0,0), 0.07)
        local p = ScreenGui:FindFirstChild("Izquierdo_Pad")
        local t = p and p:FindFirstChild("Thumb")
        if t then t.Position = t.Position:Lerp(UDim2.new(0.5,-25,0.5,-25), 0.07) end
    end
    if not rightLargeDragging then
        rightJoyMove = rightJoyMove:Lerp(Vector2.new(0,0), 0.07)
        local p = ScreenGui:FindFirstChild("Derecho_Pad")
        local t = p and p:FindFirstChild("Thumb")
        if t then t.Position = t.Position:Lerp(UDim2.new(0.5,-25,0.5,-25), 0.07) end
    end

    local mouse = UserInputService:GetMouseLocation()
    if keyStates.Q and not leftLargeDragging and keyOrigins.Q then
        local d = mouse - keyOrigins.Q
        local p = ScreenGui:FindFirstChild("Izquierdo_Pad")
        local t = p and p:FindFirstChild("Thumb")
        actualizarJoystickPrincipal("Izquierdo", d, t)
    end
    if keyStates.E and not rightLargeDragging and keyOrigins.E then
        local d = mouse - keyOrigins.E
        local p = ScreenGui:FindFirstChild("Derecho_Pad")
        local t = p and p:FindFirstChild("Thumb")
        actualizarJoystickPrincipal("Derecho", d, t)
    end
    if keyStates.R and keyOrigins.R then
        local d = mouse - keyOrigins.R
        if not leftLargeDragging then
            local p = ScreenGui:FindFirstChild("Izquierdo_Pad")
            local t = p and p:FindFirstChild("Thumb")
            actualizarJoystickPrincipal("Izquierdo", d, t)
        end
        if not rightLargeDragging then
            local p = ScreenGui:FindFirstChild("Derecho_Pad")
            local t = p and p:FindFirstChild("Thumb")
            actualizarJoystickPrincipal("Derecho", d, t)
        end
    end
    if keyStates.Z and keyOrigins.Z then
        local dy = mouse.Y - keyOrigins.Z.Y
        local p = ScreenGui:FindFirstChild("Izquierdo_Z_Pad")
        local t = p and p:FindFirstChild("Thumb")
        actualizarJoystickZ("Izquierdo", dy, t)
    end
    if keyStates.X and keyOrigins.X then
        local dy = mouse.Y - keyOrigins.X.Y
        local p = ScreenGui:FindFirstChild("Derecho_Z_Pad")
        local t = p and p:FindFirstChild("Thumb")
        actualizarJoystickZ("Derecho", dy, t)
    end
    if keyStates.C and keyOrigins.C then
        local dy = mouse.Y - keyOrigins.C.Y
        local pL = ScreenGui:FindFirstChild("Izquierdo_Z_Pad")
        local tL = pL and pL:FindFirstChild("Thumb")
        local pR = ScreenGui:FindFirstChild("Derecho_Z_Pad")
        local tR = pR and pR:FindFirstChild("Thumb")
        actualizarJoystickZ("Izquierdo", dy, tL)
        actualizarJoystickZ("Derecho", dy, tR)
    end

    local char = plr.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local root = char.HumanoidRootPart.CFrame
        local lx, ly, lz = cam.CFrame:ToEulerAnglesXYZ()
        headCF = CFrame.new(root.Position + Vector3.new(0,2,0)) * CFrame.Angles(lx,ly,lz)
        local zL = math.clamp(-1.2 - leftZMove*1.2, -2.2, -0.5)
        local zR = math.clamp(-1.2 - rightZMove*1.2, -2.2, -0.5)
        leftHandCF = root * CFrame.new(-1.2 + math.clamp(leftJoyMove.X*1.4,-1.4,1.4), 0.5 + math.clamp(leftJoyMove.Y*1.4,-1.4,1.4), zL) * CFrame.Angles(math.rad(leftJoyMove.Y*45), math.rad(-leftJoyMove.X*30), math.rad(-leftJoyMove.X*20))
        rightHandCF = root * CFrame.new(1.2 + math.clamp(rightJoyMove.X*1.4,-1.4,1.4), 0.5 + math.clamp(rightJoyMove.Y*1.4,-1.4,1.4), zR) * CFrame.Angles(math.rad(rightJoyMove.Y*45), math.rad(-rightJoyMove.X*30), math.rad(rightJoyMove.X*20))
        local t = os.clock()
        if t - tAnterior >= TASA_ENVIO then remote:FireServer(headCF, leftHandCF, rightHandCF); tAnterior = t end
    end
end)

