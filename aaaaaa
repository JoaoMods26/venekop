local function EnsurePhysicsVisualFolder()
    if physicsVisualFolder and physicsVisualFolder.Parent then
        return physicsVisualFolder
    end
    local existing = workspace:FindFirstChild(physicsVisualFolderName)
    if existing and existing:IsA("Folder") then
        physicsVisualFolder = existing
    else
        physicsVisualFolder = Instance.new("Folder")
        physicsVisualFolder.Name = physicsVisualFolderName
        physicsVisualFolder.Parent = workspace
    end
    return physicsVisualFolder
end

local function ZeroPlacementVelocity(root)
    if not root or not root.Parent then return end
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
    end)
end

local function EnsureStabilityGround(root)
    if not root or not root.Parent then return end
    local folder = EnsurePhysicsVisualFolder()
    if not stabilityGround or not stabilityGround.Parent then
        stabilityGround = Instance.new("Part")
        stabilityGround.Name = "JmodsUniversal_InvisibleStabilityFloor_" .. tostring(LocalPlayer.UserId)
        stabilityGround.Size = Vector3.new(6, 1, 6)
        stabilityGround.Transparency = 1
        stabilityGround.Anchored = true
        stabilityGround.CanCollide = true
        stabilityGround.CanTouch = false
        stabilityGround.CanQuery = false
        stabilityGround.CastShadow = false
        stabilityGround.TopSurface = Enum.SurfaceType.Smooth
        stabilityGround.BottomSurface = Enum.SurfaceType.Smooth
        stabilityGround.Parent = folder
    end
    stabilityGround.CFrame = root.CFrame * CFrame.new(0, -3.5, 0)
    if not stabilityGroundConnection then
        stabilityGroundConnection = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            local currentRoot = character and character:FindFirstChild("HumanoidRootPart")
            if not currentRoot or not currentRoot.Parent then return end
            if stabilityGround and stabilityGround.Parent then
                stabilityGround.CFrame = currentRoot.CFrame * CFrame.new(0, -3.5, 0)
            end
        end)
    end
end

local function RemoveStabilityGround()
    if stabilityGroundConnection then
        stabilityGroundConnection:Disconnect()
        stabilityGroundConnection = nil
    end
    if stabilityGround then
        pcall(function() stabilityGround:Destroy() end)
        stabilityGround = nil
    end
    if physicsVisualFolder and physicsVisualFolder.Parent and #physicsVisualFolder:GetChildren() == 0 then
        pcall(function() physicsVisualFolder:Destroy() end)
        physicsVisualFolder = nil
    end
end

local function DestroyPhysicsClone()
    local clone = physicsClone
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local returnCFrame
    if clone and clone.Parent then
        pcall(function() returnCFrame = clone:GetPivot() end)
    end
    if physicsPoseConnection then
        physicsPoseConnection:Disconnect()
        physicsPoseConnection = nil
    end
    for sourceTrack, cloneTrack in pairs(physicsMirroredTracks) do
        local animationObject
        pcall(function() animationObject = cloneTrack.Animation end)
        pcall(function() cloneTrack:Stop(0) end)
        pcall(function() cloneTrack:Destroy() end)
        if animationObject then pcall(function() animationObject:Destroy() end) end
        physicsMirroredTracks[sourceTrack] = nil
    end
    if root then
        if type(sethiddenproperty) == "function" then
            pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", root) end)
        end
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end)
    end
    if character and returnCFrame and physicsCharacter == character then
        pcall(function() character:PivotTo(returnCFrame) end)
        if root and root.Parent then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
            end)
        end
    end
    local camera = workspace.CurrentCamera
    if camera then
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        pcall(function()
            camera.CameraSubject = humanoid or physicsCameraSubject
            camera.CameraType = physicsCameraType or Enum.CameraType.Custom
        end)
    end
    if clone then pcall(function() clone:Destroy() end) end
    physicsClone = nil
    physicsCloneHumanoid = nil
    physicsCharacter = nil
    physicsCameraSubject = nil
    physicsCameraType = nil
    table.clear(physicsMirroredTracks)
end

local function CreatePhysicsClone()
    local character = LocalPlayer.Character
    if not character then return false end
    if physicsClone and physicsClone.Parent and physicsCharacter == character then return true end
    DestroyPhysicsClone()
    local oldArchivable = character.Archivable
    character.Archivable = true
    local ok, clone = pcall(function() return character:Clone() end)
    character.Archivable = oldArchivable
    if not ok or not clone then return false end
    clone.Name = "JmodsUniversal_AnimationClone_" .. tostring(LocalPlayer.UserId)
    for _, object in ipairs(clone:GetDescendants()) do
        if object:IsA("Script") or object:IsA("LocalScript") then
            object:Destroy()
        elseif object:IsA("BasePart") then
            object.Anchored = true
            object.CanCollide = false
            object.CanTouch = false
            object.CanQuery = false
        end
    end
    local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
    local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
    if not cloneRoot or not cloneHumanoid then
        clone:Destroy()
        return false
    end
    clone.Parent = EnsurePhysicsVisualFolder()
    clone:PivotTo(character:GetPivot())
    cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    cloneHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    physicsClone = clone
    physicsCloneHumanoid = cloneHumanoid
    physicsCharacter = character
    local camera = workspace.CurrentCamera
    if camera then
        physicsCameraSubject = camera.CameraSubject
        physicsCameraType = camera.CameraType
        camera.CameraSubject = cloneHumanoid
    end
    physicsPoseConnection = RunService.PreSimulation:Connect(function()
        if not physicsModeEnabled or not physicsClone or not physicsClone.Parent then return end
        local currentCharacter = LocalPlayer.Character
        if not currentCharacter or currentCharacter ~= physicsCharacter then return end
        local sourceRoot = currentCharacter:FindFirstChild("HumanoidRootPart")
        local cloneRoot = physicsClone:FindFirstChild("HumanoidRootPart")
        if not sourceRoot or not cloneRoot then return end
        local function relativePath(object, model)
            local names = {}
            local node = object
            while node and node ~= model do
                table.insert(names, 1, node.Name)
                node = node.Parent
            end
            return table.concat(names, "\31")
        end
        local cloneParts = {}
        for _, object in ipairs(physicsClone:GetDescendants()) do
            if object:IsA("BasePart") then
                cloneParts[relativePath(object, physicsClone)] = object
            end
        end
        local rootCFrame = cloneRoot.CFrame
        local sourceRootCFrame = sourceRoot.CFrame
        for _, sourcePart in ipairs(currentCharacter:GetDescendants()) do
            if sourcePart:IsA("BasePart") and sourcePart ~= sourceRoot then
                local clonePart = cloneParts[relativePath(sourcePart, currentCharacter)]
                if clonePart and clonePart.Parent then
                    pcall(function()
                        clonePart.CFrame = rootCFrame * sourceRootCFrame:ToObjectSpace(sourcePart.CFrame)
                    end)
                end
            end
        end
    end)
    return true
end

local standAttacking = false
local standFlingEnabled = false
local standFlingMv = 0.1

local function ApplyStandFling(root)
    if not root or not root.Parent then return end
    pcall(function()
        local vel = root.Velocity
        root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
        RunService.RenderStepped:Wait()
        if root and root.Parent then
            root.Velocity = vel
            RunService.Stepped:Wait()
        end
        if root and root.Parent then
            root.Velocity = vel + Vector3.new(0, standFlingMv, 0)
            standFlingMv = -standFlingMv
        end
    end)
end


local function ApplyPlayerPlacement(root, targetRoot, desiredCFrame, preserveVelocity, fling)
    if not root or not desiredCFrame then return end
    EnsureStabilityGround(root)
    if not physicsModeEnabled then
        root.CFrame = desiredCFrame
        if not preserveVelocity then ZeroPlacementVelocity(root) end
        if fling and standFlingEnabled and standAttacking then
            ApplyStandFling(root)
        end
        return
    end
    if not targetRoot or not targetRoot.Parent or type(sethiddenproperty) ~= "function" then
        root.CFrame = desiredCFrame
        if not preserveVelocity then ZeroPlacementVelocity(root) end
        if fling and standFlingEnabled and standAttacking then
            ApplyStandFling(root)
        end
        return
    end
    if not physicsClone or not physicsClone.Parent or physicsCharacter ~= LocalPlayer.Character then
        if not CreatePhysicsClone() then
            root.CFrame = desiredCFrame
            if not preserveVelocity then ZeroPlacementVelocity(root) end
            return
        end
    end
    local relativeCFrame
    local relativeOk = pcall(function()
        relativeCFrame = targetRoot.CFrame:ToObjectSpace(desiredCFrame)
    end)
    if not relativeOk or not relativeCFrame then
        root.CFrame = desiredCFrame
        if not preserveVelocity then ZeroPlacementVelocity(root) end
        return
    end
    local ok = pcall(function()
        sethiddenproperty(root, "PhysicsRepRootPart", targetRoot)
        root.CFrame = relativeCFrame
        physicsClone:PivotTo(desiredCFrame)
    end)
    if not ok then
        pcall(function() root.CFrame = relativeCFrame end)
        pcall(function() physicsClone:PivotTo(desiredCFrame) end)
    end
    if not preserveVelocity then ZeroPlacementVelocity(root) end

    -- FLING DEL STAND (misma fuerza que WalkFling)
    if fling and standFlingEnabled and standAttacking then
        ApplyStandFling(root)
    end
end

