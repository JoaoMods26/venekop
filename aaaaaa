                end 

                SetStandBehindTarget( 
                    standTarget 
                ) 

                local jumping = 
                    IsJumpingTarget() 

                if jumping 
                and not standPreviousJumpState then 

                    ToggleStandModeFromJump(
                        "Heartbeat Jump"
                    )
                end 

                standPreviousJumpState = 
                    jumping 
            end 
        ) 
end 

local function StopStand() 

    StandHeader( 
        "STAND DESACTIVADO" 
    ) 

    standEnabled = false 
    UpdateStandStatus()

    standTarget = nil 
    standMode = "Normal" 

    standAttacking = false 
    standAttackTarget = nil 
    standPreviousJumpState = false 
    standBaselineAnimationIds = {} 
    standLastChatCommand = ""
    standLastChatCommandTime = 0
    if standConnection then 

        standConnection:Disconnect() 

        standConnection = nil 
    end 

    DisconnectTargetConnections() 

    if standLocalCharacterConnection then 

        standLocalCharacterConnection:Disconnect() 

        standLocalCharacterConnection = 
            nil 
    end 

    StopStandIdle() 
    StopStandAttack() 
    if CleanupPhysicsCloneIfIdle then CleanupPhysicsCloneIfIdle() end

    local root = GetStandRoot()
    if root then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end)
    end
end 

