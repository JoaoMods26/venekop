local function MoveAttackForward( 
    direction 
) 

    local root = 
        GetStandRoot() 

    if not root 
    or not direction then 
        return 
    end 

    direction = 
        Vector3.new( 
            direction.X, 
            0, 
            direction.Z 
        ) 

    if direction.Magnitude < 0.05 then 
        return 
    end 

    direction = 
        direction.Unit 

    local startPosition = 
        root.Position 

    local endPosition = 
        startPosition 
        + direction 
        * standAttackTravelDistance 

    local startTime = 
        os.clock() 

    while standEnabled 
    and standAttacking 
    and os.clock() - startTime < 
        standAttackTravelTime do 

        local alpha = 
            math.clamp( 
                ( 
                    os.clock() 
                    - startTime 
                ) 
                / standAttackTravelTime, 
                0, 
                1 
            ) 

        local position = 
            startPosition:Lerp( 
                endPosition, 
                alpha 
            ) 

        if root 
        and root.Parent then 

            ApplyPlayerPlacement(root, standTarget and GetPlayerRoot(standTarget), CFrame.lookAt(
                position,
                position + direction
            )) 
        end 

        RunService.Heartbeat:Wait() 
    end 

    if root 
    and root.Parent then 

        ApplyPlayerPlacement(root, standTarget and GetPlayerRoot(standTarget), CFrame.lookAt(
            endPosition,
            endPosition + direction
        )) 
    end 
end 

