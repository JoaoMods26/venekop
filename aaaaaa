local function BuildContentLineDeJugador(jugador)
    local lines = {}

    if jugador.Character then
        local hum = jugador.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            table.insert(lines, "❤️ HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth))
        end
    end

    table.insert(lines, "🆔 ID: " .. jugador.UserId)
    table.insert(lines, "📅 Cuenta: " .. jugador.AccountAge .. " días")

    local membership = jugador.MembershipType == Enum.MembershipType.Premium and "⭐ Premium" or "Sin Premium"
    table.insert(lines, "💎 " .. membership)

    table.insert(lines, "🏳️ Equipo: " .. (jugador.Team and jugador.Team.Name or "Ninguno"))

    if jugador.Character and jugador.Character:FindFirstChild("HumanoidRootPart") then
        local pos = jugador.Character.HumanoidRootPart.Position
        table.insert(lines, string.format("📍 Pos: %.1f, %.1f, %.1f", pos.X, pos.Y, pos.Z))

        local tuChar = LocalPlayer.Character
        if tuChar and tuChar:FindFirstChild("HumanoidRootPart") then
            local dist = (tuChar.HumanoidRootPart.Position - pos).Magnitude
            table.insert(lines, string.format("📏 Distancia: %.1f studs", dist))
        end
    end

    local leaderstats = jugador:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if stat:IsA("ValueBase") then
                local val = stat.Value
                if type(val) == "number" then val = math.floor(val) end
                table.insert(lines, "📊 " .. stat.Name .. ": " .. tostring(val))
            end
        end
    end

    return table.concat(lines, "\n")
end

