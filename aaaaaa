local function ConnectTargetAnimator( 
    target 
) 

    DisconnectTargetConnections() 

    if not target 
    or not target.Character then 
        return 
    end 

    local humanoid = 
        GetPlayerHumanoid( 
            target 
        ) 

    if not humanoid then 
        return 
    end 

    local animator = 
        humanoid:FindFirstChildOfClass( 
            "Animator" 
        ) 

    if not animator then 

        animator = 
            humanoid:WaitForChild( 
                "Animator", 
                3 
            ) 
    end 

    if not animator then 
        return 
    end 

    SaveTargetBaseline( 
        target 
    ) 

    StandDebug( 
        "ESCUCHANDO SOLO AL TARGET:", 
        target.Name 
    ) 

    standTargetStateConnection = 
        humanoid.StateChanged:Connect( 
            function( 
                _, 
                newState 
            ) 

                if not standEnabled then 
                    return 
                end 

                if standTarget ~= target then 
                    return 
                end 

                if newState == 
                    Enum.HumanoidStateType.Jumping then 

                    if not standPreviousJumpState then
                        ToggleStandModeFromJump(
                            "StateChanged Jumping"
                        )
                        standPreviousJumpState = true
                    end

                elseif newState == 
                    Enum.HumanoidStateType.Landed 
                or newState == 
                    Enum.HumanoidStateType.Running 
                or newState == 
                    Enum.HumanoidStateType.Climbing 
                or newState == 
                    Enum.HumanoidStateType.Seated then 

                    standPreviousJumpState = false
                end 
            end 
        ) 

    standTargetChatConnection = target.Chatted:Connect(
        function(message)
            HandleStandChatMessage(message)
        end
    )

    local textChatService = game:GetService("TextChatService")

    if textChatService then
        standTargetTextChatConnection = textChatService.MessageReceived:Connect(
            function(message)
                if not message then
                    return
                end

                local source = message.TextSource

                if not source then
                    return
                end

                if source.UserId ~= target.UserId then
                    return
                end

                HandleStandChatMessage(message.Text)
            end
        )
    end

    standTargetAnimatorConnection = 
        animator.AnimationPlayed:Connect( 
            function(track) 

                if not standEnabled then 
                    return 
                end 

                if not track then 
                    return 
                end 

                if IsOurStandAnimation( 
                    track 
                ) then 

                    PrintAnimationDebug( 
                        track, 
                        "NO EMOTE - STAND" 
                    ) 

                    return 
                end 

                local isEmote = 
                    IsLikelyEmote( 
                        track 
                    ) 

                local result 

                if track.Priority == 
                    Enum.AnimationPriority.Core then 

                    result = 
                        "NO EMOTE - CORE" 

                elseif track.Priority == 
                    Enum.AnimationPriority.Movement then 

                    result = 
                        "NO EMOTE - MOVEMENT" 

                elseif track.Priority == 
                    Enum.AnimationPriority.Idle 
                and track.Looped then 

                    result = 
                        "NO EMOTE - IDLE LOOP" 

                elseif isEmote then 

                    result = 
                        "EMOTE" 

                else 

                    result = 
                        "NO EMOTE" 
                end 

                PrintAnimationDebug( 
                    track, 
                    result 
                ) 

                if not isEmote then 
                    return 
                end 

                if standAttacking then 
                    return 
                end 

                local attackTarget 

                if standMode == 
                    "Normal" then 

                    attackTarget = 
                        GetPlayerInFrontOfTarget() 

                else 

                    attackTarget = 
                        GetRandomPlayerNearTarget() 
                end 

                local direction = 
                    GetAttackDirectionFromAnchor() 

                if attackTarget then 

                    if attackTarget == 
                        standTarget then 

                        return 
                    end 

                    if not IsPlayerInsideTargetRange( 
                        attackTarget 
                    ) then 

                        return 
                    end 

                    StandHeader( 
                        "EMOTE TARGET -> ATAQUE JUGADOR" 
                    ) 

                    PlayStandAttack( 
                        attackTarget, 
                        direction 
                    ) 

                else 

                    StandHeader( 
                        "EMOTE TARGET -> GOLPE HACIA DELANTE" 
                    ) 

                    PlayStandAttack( 
                        nil, 
                        direction 
                    ) 
                end 
            end 
        ) 

    standTargetCharacterConnection = 
        target.CharacterAdded:Connect( 
            function() 

                if not standEnabled then 
                    return 
                end 

                task.wait(0.5) 

                if standEnabled 
                and standTarget == target then 

                    ConnectTargetAnimator( 
                        target 
                    ) 

                    PlayStandIdle() 
                end 
            end 
        ) 
end 

