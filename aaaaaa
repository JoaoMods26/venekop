local function GetPlayerInFrontOfTarget() 

    if not standTarget then 
        return nil 
    end 

    local targetRoot = 
        GetPlayerRoot( 
            standTarget 
        ) 

    if not targetRoot then 
        return nil 
    end 

    local direction = 
        GetTargetDirection( 
            standTarget 
        ) 

    if not direction then 
        return nil 
    end 

    local closestPlayer = nil 
    local closestDistance = math.huge 

    for _, player in ipairs( 
        Players:GetPlayers() 
    ) do 

        if player ~= LocalPlayer 
        and player ~= standTarget then 

            local playerRoot = 
                GetPlayerRoot( 
                    player 
                ) 

            local humanoid = 
                GetPlayerHumanoid( 
                    player 
                ) 

            if playerRoot 
            and humanoid 
            and humanoid.Health > 0 then 

                local offset = 
                    playerRoot.Position 
                    - targetRoot.Position 

                local flat = 
                    Vector3.new( 
                        offset.X, 
                        0, 
                        offset.Z 
                    ) 

                local distance = 
                    flat.Magnitude 

                if distance > 0.5 
                and distance <= standAutoRange then 

                    local toPlayer = 
                        flat.Unit 

                    local dot = 
                        direction:Dot( 
                            toPlayer 
                        ) 

                    if dot >= 0.90 
                    and distance < closestDistance then 

                        closestDistance = 
                            distance 

                        closestPlayer = 
                            player 
                    end 
                end 
            end 
        end 
    end 

    return closestPlayer 
end 

