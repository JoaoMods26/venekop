local function StartESPBox()
    if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then
        Rayfield:Notify({
            Title = "ESP Box",
            Content = "Tu executor no soporta la librería Drawing.",
            Duration = 3,
            Image = 4483362458
        })
        return
    end
 
    CreateESPBoxDrawings()
 
    espBoxConnection = RunService.RenderStepped:Connect(function()
        if not espEnabled or not espTarget then
            if espBoxDrawing then espBoxDrawing.Visible = false end
            if espNameDrawing then espNameDrawing.Visible = false end
            return
        end
 
        local char = espTarget.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
 
        if not hrp or not head then
            espBoxDrawing.Visible = false
            espNameDrawing.Visible = false
            return
        end
 
        local camera = workspace.CurrentCamera
        local topPos, topVisible = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.4, 0))
        local botPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
 
        if not topVisible or topPos.Z < 0 then
            espBoxDrawing.Visible = false
            espNameDrawing.Visible = false
            return
        end
 
        local height = math.abs(topPos.Y - botPos.Y)
        local width = height * 0.55
 
        espBoxDrawing.Size = Vector2.new(width, height)
        espBoxDrawing.Position = Vector2.new(topPos.X - width / 2, topPos.Y)
        espBoxDrawing.Visible = true
 
        espNameDrawing.Text = espTarget.Name
        espNameDrawing.Position = Vector2.new(topPos.X, topPos.Y - 16)
        espNameDrawing.Visible = true
    end)
end
 
local function StopESPBox()
    if espBoxConnection then
        espBoxConnection:Disconnect()
        espBoxConnection = nil
    end
    RemoveESPBoxDrawings()
end

