local function HandleStandChatMessage(message)
    if not standEnabled then
        return
    end

    if not standTarget then
        return
    end

    if not IsAttackChatMessage(message) then
        return
    end

    local text = string.lower(tostring(message))
    local now = os.clock()
    local key = text

    if key == standLastChatCommand
    and now - standLastChatCommandTime < 0.2 then
        return
    end

    standLastChatCommand = key
    standLastChatCommandTime = now

    StandDebug(
        "COMANDO DE CHAT DETECTADO:",
        tostring(message)
    )

    TriggerStandAttackFromChat()
end

