local movementStatsByAction = {}
local function SaveMovementStats(action, humanoid)
    if not humanoid then return end
    local baseline
    for _, saved in pairs(movementStatsByAction) do
        baseline = saved
        break
    end
    local walkSpeed = humanoid.WalkSpeed
    local jumpPower = humanoid.JumpPower
    local jumpHeight = humanoid.JumpHeight
    local autoRotate = humanoid.AutoRotate
    if baseline then
        walkSpeed = baseline.WalkSpeed
        jumpPower = baseline.JumpPower
        jumpHeight = baseline.JumpHeight
        if baseline.AutoRotate ~= nil then autoRotate = baseline.AutoRotate end
    end
    movementStatsByAction[action] = {
        WalkSpeed = walkSpeed,
        JumpPower = jumpPower,
        JumpHeight = jumpHeight,
        AutoRotate = autoRotate
    }
end
local function RestoreMovementStats(action, humanoid)
    if not humanoid then return end
    local stats = movementStatsByAction[action]
    humanoid.WalkSpeed = stats and stats.WalkSpeed or 16
    humanoid.JumpPower = stats and stats.JumpPower or 50
    humanoid.JumpHeight = stats and stats.JumpHeight or 7.2
    if stats and stats.AutoRotate ~= nil then humanoid.AutoRotate = stats.AutoRotate end
    movementStatsByAction[action] = nil
end
