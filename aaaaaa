local function NormalizeAnimId(id)
    local value = tostring(id or "")
    return value:match("%d+") or value
end

local function StopAnimationTracksById(humanoid, animationId)
    if not humanoid then return end
    local wanted = NormalizeAnimId(animationId)
    pcall(function()
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            local currentId = ""
            pcall(function()
                if track.Animation then
                    currentId = track.Animation.AnimationId
                end
            end)
            if NormalizeAnimId(currentId) == wanted then
                pcall(function() track:Stop(0) end)
                pcall(function() track:Destroy() end)
            end
        end
    end)
end

local function DisconnectAnimationConnection(connection)
    if connection then
        pcall(function() connection:Disconnect() end)
    end
    return nil
end

