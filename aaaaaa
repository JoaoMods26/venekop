local perroAnim = Instance.new("Animation")
perroAnim.AnimationId = "rbxassetid://" .. perroAnimId

function PlayPerro(target)
    if not target or not target.Character then return end
    perroConnection = DisconnectAnimationConnection(perroConnection)
    local char = Players.LocalPlayer.Character or Players.LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    local targetRoot = target.Character:WaitForChild("HumanoidRootPart")
    if not humanoid or not root or not targetRoot then return end

    SaveMovementStats("perro", humanoid)
    StopAnimationTracksById(humanoid, perroAnimId)

    local track = humanoid:LoadAnimation(perroAnim)
    track:Play()
    track.TimePosition = perroAnimTime
    track:AdjustSpeed(0)

    humanoid.AutoRotate = false
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    SetNoCollision(char, true)

    do
        local offsetPosition = targetRoot.Position + targetRoot.CFrame.LookVector * perroCurrentDistance + Vector3.new(0, 0.23, 0)
        ApplyPlayerPlacement(root, targetRoot, CFrame.lookAt(offsetPosition, targetRoot.Position) * CFrame.Angles(0, math.rad(180), 0))
end

    perroConnection = RunService.Heartbeat:Connect(function(dt)
        if not targetRoot.Parent then
            perroConnection = DisconnectAnimationConnection(perroConnection)
            return
        end

        perroCurrentDistance = perroCurrentDistance + (perroSpeed * perroDirection * dt)

        if perroCurrentDistance >= (movementDistanceChanged and movementDistance or perroTargetDistance) then
            perroDirection = -1
        elseif perroCurrentDistance <= 2 then
            perroDirection = 1
        end

        local offsetPosition = targetRoot.Position + targetRoot.CFrame.LookVector * perroCurrentDistance + Vector3.new(0, 0.23, 0)
        ApplyPlayerPlacement(root, targetRoot, CFrame.lookAt(offsetPosition, targetRoot.Position) * CFrame.Angles(0, math.rad(180), 0))
end)
end

function StopPerro()
    local char = Players.LocalPlayer.Character or Players.LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:FindFirstChild("Humanoid")

    if perroConnection then
        perroConnection:Disconnect()
        perroConnection = nil
    end

    if humanoid then
        RestoreMovementStats("perro", humanoid)
        humanoid.AutoRotate = true
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        StopAnimationTracksById(humanoid, perroAnimId)
    end

    SetNoCollision(char, false)
    if CleanupPhysicsCloneIfIdle then CleanupPhysicsCloneIfIdle() end
end

