local function IsAttackChatMessage(message)
    if not message then
        return false
    end

    local text = string.lower(tostring(message))

    text = text:gsub("%s+", " ")
    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")

    return text:match("%f[%a]ataca%f[%A]") ~= nil
        or text:match("%f[%a]atacar%f[%A]") ~= nil
        or text:match("%f[%a]attack%f[%A]") ~= nil
end

