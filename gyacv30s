local function parseOpeningPoints(value)

    if typeof(value) ~= "string" then
        return nil
    end

    local numbers = {}

    for numberString in string.gmatch(value, "[^,]+") do

        local number = tonumber(numberString)

        if not number or number % 1 ~= 0 then
            return nil
        end

        table.insert(numbers, number)

    end

    if #numbers < 6 or #numbers % 2 ~= 0 then
        return nil
    end

    local points = {}

    for i = 1, #numbers, 2 do

        table.insert(points, {
            u = numbers[i],
            v = numbers[i + 1]
        })

    end

    return points

end
local function parseStairKey(key)

