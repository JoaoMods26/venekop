local function buildPlotList()
    local entries = {}

    for index, plot in ipairs(PlotsFolder:GetChildren()) do
        if plot:IsA("Model") and plotHasOwner(plot) then
            local objectId = plot:GetAttribute("ObjectId")
            local ownerId = plot:GetAttribute("OwnerId")

            table.insert(entries, {
                plot = plot,
                index = index,
                objectId = objectId,
                ownerId = ownerId,
                uniqueKey = getPlotUniqueKey(plot, index),
                text = makePlotText(plot, index),
            })
        end
    end

    table.sort(entries, function(a, b)
        if a.index ~= b.index then
            return a.index < b.index
        end

        return a.uniqueKey < b.uniqueKey
    end)

    return entries
end

local function rebuildPlots()
    local newOptions = {}
    local newMap = {}
    local seenLabels = {}

    for _, entry in ipairs(buildPlotList()) do
        local text = entry.text

        if seenLabels[text] then
            local suffix = 2

            repeat
                text = entry.text .. " #" .. tostring(suffix)
                suffix += 1
            until not seenLabels[text]
        end

        seenLabels[text] = true
        table.insert(newOptions, text)

        newMap[text] = entry.plot
    end

    PlotOptions = newOptions
    PlotMap = newMap
end

local function restorePlotByIds(objectId, ownerId)
    if objectId == nil then
        return nil
    end

    for _, plot in ipairs(PlotsFolder:GetChildren()) do
        if plot:IsA("Model") then
            local plotObjectId = plot:GetAttribute("ObjectId")
            local plotOwnerId = plot:GetAttribute("OwnerId")

            if plotHasOwner(plot)
            and tostring(plotObjectId) == tostring(objectId)
            and tostring(plotOwnerId) == tostring(ownerId) then
                return plot
            end
        end
    end

    return nil
end

local function syncSelectedPlotReferences()
    local myPlot = getMyPlot()

    local restoredSource = restorePlotByIds(CopySourceObjectId, CopySourceOwnerId)
    local restoredDestination = restorePlotByIds(DestinationObjectId, DestinationOwnerId)
    local restoredSavedPaste = restorePlotByIds(SavedPasteObjectId, SavedPasteOwnerId)

    if restoredSource then
        CopySourcePlot = restoredSource
    elseif not (CopySourcePlot and CopySourcePlot.Parent and plotHasOwner(CopySourcePlot)) then
        CopySourcePlot = myPlot or PlotMap[PlotOptions[1]]
    end

    if restoredDestination then
        DestinationPlot = restoredDestination
    elseif not (DestinationPlot and DestinationPlot.Parent and plotHasOwner(DestinationPlot)) then
        DestinationPlot = myPlot or PlotMap[PlotOptions[1]]
    end

    if restoredSavedPaste then
        SavedPastePlot = restoredSavedPaste
    elseif not (SavedPastePlot and SavedPastePlot.Parent and plotHasOwner(SavedPastePlot)) then
        SavedPastePlot = myPlot or PlotMap[PlotOptions[1]]
    end

    if CopySourcePlot and CopySourcePlot.Parent then
        CopySourceObjectId = CopySourcePlot:GetAttribute("ObjectId")
        CopySourceOwnerId = CopySourcePlot:GetAttribute("OwnerId")
    else
        CopySourceObjectId = nil
        CopySourceOwnerId = nil
    end

    if DestinationPlot and DestinationPlot.Parent then
        DestinationObjectId = DestinationPlot:GetAttribute("ObjectId")
        DestinationOwnerId = DestinationPlot:GetAttribute("OwnerId")
    else
        DestinationObjectId = nil
