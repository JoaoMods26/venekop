            local workId = rawget(obj, "workId")
            local scrub = rawget(obj, "scrub")
            if workId == "foodix-cleaner" and type(scrub) == "table" then
                return obj, scrub
            end
        end
    end
    return nil, nil
end

 function runAutoScrubForSpot(targetSpot)
    local waitedForSession = 0
    local controller, scrub

    while waitedForSession < ArepamovilConfig.ScrubSessionTimeout do
        if not ArepamovilConfig.AutoFarm or arepamovilState.paused then
            return true
        end
        if not (targetSpot and targetSpot.Parent) then
            return true
        end

        controller, scrub = getCurrentScrub()

        if scrub then
            break
        end

        task.wait(0.15)
        waitedForSession += 0.15
    end

    if not scrub then
        return false
    end

    while scrub
        and ArepamovilConfig.AutoFarm
        and not arepamovilState.paused
        and not scrub.finishing
        and scrub.done < scrub.strokes do

        local direction = scrub.lastStrokeDir == 1 and -1 or 1

        local waitTime = scrub.nextStrokeAt - time()

        if waitTime > 0 then
            task.wait(waitTime)
        end

        if scrub.finishing then
            break
        end
        if not ArepamovilConfig.AutoFarm or arepamovilState.paused then
            break
        end

        pcall(function()
            scrub:_feedPointer(direction * 55)
        end)

        task.wait()

        controller, scrub = getCurrentScrub()
    end

    return true
end
 function runJanitorCleanForSpot(targetSpot)
    if not JanitorAvailable then
        return
    end

    if not (targetSpot and targetSpot.Parent) then
        return
    end

    local spotId = targetSpot:GetAttribute(WorksModule.SPOT_ID_ATTRIBUTE)
    local spotSize = targetSpot:GetAttribute(WorksModule.SPOT_SIZE_ATTRIBUTE)

    if typeof(spotId) ~= "number" or typeof(spotSize) ~= "number" then
        return
    end

    local sizeData = JanitorConfig.SIZES[spotSize]
    if not sizeData then
        return
    end

    local started = time()
    local finished = false

    local function finish()
        if not ArepamovilConfig.AutoFarm or arepamovilState.paused then
            finished = true
            return
        end

        local ok, promiseOrErr = pcall(function()
            return JanitorNet.FinishClean.invoke({ spotId = spotId })
        end)

        if not ok then
            finished = true
            return
        end

        promiseOrErr
            :andThen(function(x)
                if x.ok then
                    finished = true
                elseif x.reason == "too-soon" then
                    task.wait(0.03)
                    finish()
                else
                    finished = true
                end
            end)
            :catch(function()
                finished = true
            end)
    end

    local startOk, startPromiseOrErr = pcall(function()
        return JanitorNet.StartClean.invoke({ spotId = spotId })
    end)

    if not startOk then
        return
    end

    startPromiseOrErr
        :andThen(function(r)
            if not r.ok then
                finished = true
                return
            end

            local waitTime = started + sizeData.minSeconds - time()
            if waitTime > 0 then
                task.wait(waitTime)
            end

            finish()
        end)
        :catch(function()
            finished = true
        end)

    local waitStart = tick()
    local safetyTimeout = (sizeData.minSeconds or 3) + 8

    while not finished do
        if tick() - waitStart >= safetyTimeout then
            break
        end
        if not ArepamovilConfig.AutoFarm then
            break
        end
        task.wait(0.1)
    end
end
 function cleanTargetSpot(targetSpot)
    local handled = false

    if HasGetGC then
        local ok, result = pcall(runAutoScrubForSpot, targetSpot)
        if ok and result then
            handled = true
        end
    end

    if not handled and JanitorAvailable then
        pcall(runJanitorCleanForSpot, targetSpot)
    end
end
 function arepamovilAutoFarmLoop()

    while ArepamovilConfig.AutoFarm do
        while arepamovilState.paused and ArepamovilConfig.AutoFarm do
            task.wait(0.2)
        end
        if not ArepamovilConfig.AutoFarm then break end

        arepamovilState.currentTask = "Yendo al punto"
        arepamovilMoveTo(ArepamovilConfig.InitialPosition)

        if ArepamovilConfig.WaitAfterMove > 0 then
            task.wait(ArepamovilConfig.WaitAfterMove)
        end

        arepamovilState.currentTask = "Recogiendo"
        activateArepamovilInitialPrompts()

        if ArepamovilConfig.WaitAfterPrompt > 0 then
            task.wait(ArepamovilConfig.WaitAfterPrompt)
        end

        arepamovilState.currentTask = "Limpiando manchas"

        local works = workspace:FindFirstChild("Works")
        local foodix = works and works:FindFirstChild("Foodix")
        local folder = foodix and foodix:FindFirstChild("WorkSpots")

        if not folder then
            warn("⚠️ No se encontró workspace.Works.Foodix.WorkSpots - saltando limpieza de manchas")
        else
            while ArepamovilConfig.AutoFarm do
                while arepamovilState.paused and ArepamovilConfig.AutoFarm do
                    task.wait(0.2)
                end
                if not ArepamovilConfig.AutoFarm then break end

                local targetSpot

                for _, spot in ipairs(folder:GetChildren()) do
                    if spot.Name == "Mancha" then
                        targetSpot = spot
                        break
                    end
                end

                if not targetSpot then
                    break
                end

                local pos
                if targetSpot:IsA("BasePart") then
                    pos = targetSpot.Position
                elseif targetSpot:IsA("Model") then
                    pos = targetSpot:GetPivot().Position
                end

                if pos then
                    local tpPos = pos + Vector3.new(0, ArepamovilConfig.ManchaYOffset, 0)

                    arepamovilMoveTo(tpPos)

                    cleanTargetSpot(targetSpot)
                end

                task.wait(0.05)
            end
        end

        if ArepamovilConfig.SlowMode then
            task.wait(ArepamovilConfig.SlowModeWaitPerRound)
        end
    end

    arepamovilState.currentTask = "Inactivo"
    RestoreCharacterState()
end
