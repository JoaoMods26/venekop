 function activateArepamovilInitialPrompts()
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local fromPos = hrp.Position
    local nearbyPrompts = {}

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent

            if parent and parent:IsA("BasePart") then
                local isDeliveryNPC = false

                local works = workspace:FindFirstChild("Works")
                if works then
                    local deliveryNpcs = works:FindFirstChild("DeliveryNpcs")

                    if deliveryNpcs and obj:IsDescendantOf(deliveryNpcs) then
                        isDeliveryNPC = true
                    end
                end

                if not isDeliveryNPC then
                    local distance = (parent.Position - fromPos).Magnitude

                    if distance < 15 then
                        table.insert(nearbyPrompts,{
                            prompt = obj,
                            distance = distance
                        })
                    end
                end
            end
        end
    end

    table.sort(nearbyPrompts,function(a,b)
        return a.distance < b.distance
    end)

    for round = 1,2 do
        for _,data in pairs(nearbyPrompts) do
            if data.prompt and data.prompt.Parent then

                pcall(function()
                    data.prompt.HoldDuration = 0
                    fireproximityprompt(data.prompt)
                end)

                pcall(function()
                    local conns = getconnections(data.prompt.Triggered)

                    if conns then
                        for _,c in pairs(conns) do
                            c:Fire()
                        end
                    end
                end)

                arepamovilState.stats.promptsActivated += 1
            end
        end

        task.wait(0.03)
    end
end
