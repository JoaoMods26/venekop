function JmodsBuildProgress:Update(current, stage, index, stageTotal, total)
    pcall(function()
        if not self.Gui or not self.Fill then
            return
        end

        total = math.max(1, tonumber(total) or 1)
        current = math.clamp(tonumber(current) or 0, 0, total)

        local percent = math.floor((current / total) * 100 + 0.5)
        self.Fill.Size = UDim2.new(current / total, 0, 1, 0)
        self.Percent.Text = tostring(percent) .. "%"

        local remaining = math.max(0, total - current)
        self.Info.Text =
            tostring(stage or "Procesando")
            .. " | "
            .. tostring(index or 0)
            .. "/"
            .. tostring(stageTotal or 0)
            .. " | quedan "
            .. tostring(remaining)
    end)
end

function JmodsBuildProgress:Finish(stopped)
    pcall(function()
        if self.Gui then
            local title = self.Gui:FindFirstChildWhichIsA("Frame")
            if title then
                local labels = title:GetChildren()
                for _, obj in ipairs(labels) do
                    if obj:IsA("TextLabel") and obj.Text == "Construyendo..." then
                        obj.Text = stopped and "Copia detenida" or "Construcción terminada"
                    end
                end
            end
        end

        task.delay(0.8, function()
            pcall(function()
                if self.Gui then
                    self.Gui:Destroy()
                    self.Gui = nil
                    self.Fill = nil
                    self.Percent = nil
                    self.Info = nil
                end
            end)
        end)
    end)
end

local function waitForPlacedObject(targetItems, itemId, timeout, beforeItems)
    beforeItems = beforeItems or {}

    if next(beforeItems) == nil then
        for _, obj in ipairs(targetItems:GetChildren()) do
            beforeItems[obj] = true
        end
    end

    local newObject = nil
    local objectFound = false
    local childConnection = nil
    local attributeConnections = {}

    local function cleanup()
        if childConnection then
            childConnection:Disconnect()
            childConnection = nil
        end

        for object, connection in pairs(attributeConnections) do
            if connection then
                connection:Disconnect()
            end
            attributeConnections[object] = nil
        end
    end

    local function tryMatch(obj)
        if objectFound or beforeItems[obj] or (not obj:IsA("Model") and not obj:IsA("BasePart")) then
            return false
        end

        local objectItemId = obj:GetAttribute("ItemId")

        if tostring(objectItemId) == tostring(itemId) then
            newObject = obj
            objectFound = true
            return true
        end

        if objectItemId == nil and not attributeConnections[obj] then
            attributeConnections[obj] =
                obj:GetAttributeChangedSignal("ItemId"):Connect(function()
                    tryMatch(obj)
                end)
        end

        return false
    end

    for _, obj in ipairs(targetItems:GetChildren()) do
        if tryMatch(obj) then
            break
        end
    end

    if not objectFound then
        childConnection = targetItems.ChildAdded:Connect(function(obj)
            tryMatch(obj)
        end)
    end

    local deadline = tick() + (timeout or 0.8)

    while not objectFound and tick() < deadline do
        task.wait()
    end

    cleanup()
    return newObject
end

local function makeFallbackPoint(point, attempt)
    local x = tonumber(point.x) or 0
    local z = tonumber(point.z) or 0
    local step = GridMath.UNIT * math.max(1, tonumber(attempt) or 1)

    if math.abs(x) > 0 then
        x -= (x > 0 and step or -step)
    end

    if math.abs(z) > 0 then
        z -= (z > 0 and step or -step)
    end

    return {
        x = x,
        z = z
    }
end

local function sendPlaceItemAndWait(targetItems, data, point, rotation, height, stand)
    local beforeItems = {}

    for _, obj in ipairs(targetItems:GetChildren()) do
        beforeItems[obj] = true
    end

    local requestOK, requestError = pcall(function()
        Net.PlaceItem.invoke({
            itemId = data.ItemId,
            point = {
                x = point.x,
                z = point.z
            },
            rotation = rotation,
            height = height,
            surface = data.Surface,
            stand = stand
        })
    end)

    if not requestOK then
        return nil, requestError
    end

    return waitForPlacedObject(targetItems, data.ItemId, 0.8, beforeItems), nil
end


local function makeCenterPoint(base)
    local columns = math.floor(base.Size.X / GridMath.TILE_STUDS)
    local rows = math.floor(base.Size.Z / GridMath.TILE_STUDS)
    local pointUnit = POINTS_PER_CORNER * GridMath.UNIT

    return {
        x = columns * pointUnit / 2,
        z = rows * pointUnit / 2
    }
end

local function scaleBiasForPointDelta(base, object, point, originalBias)
    local pointUnit = POINTS_PER_CORNER * GridMath.UNIT
    local columns = math.floor(base.Size.X / GridMath.TILE_STUDS)
    local rows = math.floor(base.Size.Z / GridMath.TILE_STUDS)
    local centerX = columns * pointUnit / 2
    local centerZ = rows * pointUnit / 2

    local localDelta = Vector3.new(
        ((tonumber(point.x) or 0) - centerX) / pointUnit * base.Size.X,
        0,
        ((tonumber(point.z) or 0) - centerZ) / pointUnit * base.Size.Z
    )

    local worldDelta = base.CFrame:VectorToWorldSpace(localDelta)
    local objectRotation = object:GetPivot().Rotation
    local objectDelta = objectRotation:VectorToObjectSpace(worldDelta)

    local bias = {
        x = objectDelta.X * 2000,
        y = objectDelta.Y * 2000,
        z = objectDelta.Z * 2000
    }

    bias.x += originalBias.x
    bias.y += originalBias.y
    bias.z += originalBias.z

    return bias
end

local function movePlacedObjectWithScaleBias(base, object, point, transformStretch, transformBias)
    local targetBias = scaleBiasForPointDelta(
        base,
        object,
        point,
        transformBias
    )

    for step = 1, 4 do
        local alpha = step / 4
        local stageBias = {
            x = targetBias.x * alpha,
            y = targetBias.y * alpha,
            z = targetBias.z * alpha
        }

        local ok, result = pcall(function()
            return Net.ScaleItem.invoke({
                key = tostring(object.Name),
                stretch = transformStretch,
                bias = stageBias
            })
        end)

        if not ok then
            return false, result
        end

        task.wait(0.05)
    end

    return true
end

