 function getMyVehicle()
    if not Vehicles then return nil end
    local myId = tostring(LocalPlayer.UserId)

    for _, vehicle in ipairs(Vehicles:GetChildren()) do
        if vehicle:IsA("Model") then
            local radio = vehicle:FindFirstChild("VehicleRadio", true)

            if radio then
                local ok, playerId = pcall(function()
                    return radio:GetAttribute("Player")
                end)

                if ok and tostring(playerId) == myId then
                    return vehicle
                end
            end
        end
    end

    return nil
end

 function setVehicleAttribute(attributeName, value)
    if not currentVehicle then return false end
    return pcall(function() currentVehicle:SetAttribute(attributeName, value) end)
end

 function checkVehicle()
    local ok, err = pcall(function()
        local vehicle = getMyVehicle()

        if vehicle then
            if vehicle ~= currentVehicle then
                currentVehicle = vehicle
                isInVehicle = true

                local s1, f = pcall(function()
                    return currentVehicle:GetAttribute("StrutSpringStiffnessFront")
                end)
                originalSuspensionFront = (s1 and f) and f or 1000

                local s2, r = pcall(function()
                    return currentVehicle:GetAttribute("StrutSpringStiffnessRear")
                end)
                originalSuspensionRear = (s2 and r) and r or 1000
            end
        else
            if isInVehicle then
                if lowriderEnabled then
                    lowriderEnabled = false

                    if lowriderConnection then
                        lowriderConnection:Disconnect()
                        lowriderConnection = nil
                    end
                end

                currentVehicle = nil
                isInVehicle = false
                originalSuspensionFront = nil
                originalSuspensionRear = nil
            end
        end
    end)

    if not ok then
        warn("❌ Error en checkVehicle:", err)
    end
end

