local CourierNet = nil

do
    local ok, netModule = pcall(function()
        return require(ReplicatedStorage.Shared.Works.Courier.Net)
    end)

    if ok then
        CourierNet = netModule

        _G.CourierTarget = nil
        _G.CourierBusy = false

        CourierNet.Event.onClient(function(data)
            if not data or data.kind ~= "point" or not data.position then
                return
            end

            local newTarget = Vector3.new(
                data.position.x,
                data.position.y,
                data.position.z
            )

            courierState.targetGeneration += 1
            _G.CourierTarget = newTarget
        end)

        task.spawn(function()
            while true do
                task.wait(0.2)

                if not CourierConfig.Enabled then
                    continue
                end

                local target = _G.CourierTarget
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if not target or not root or not hum or hum.Health <= 0 then
                    continue
                end

                if _G.CourierBusy then
                    continue
                end

                local diff = target - root.Position
                local distance = diff.Magnitude

                if distance <= CourierConfig.ThrowDistance then
                    if distance < 0.001 then
                        clearCourierTarget()
                        continue
                    end

                    _G.CourierBusy = true

                    local generation = courierState.targetGeneration
                    local direction = diff.Unit

                    local okInvoke, result = pcall(function()
                        return CourierNet.Throw.invoke({
                            direction = {
                                x = direction.X,
                                y = direction.Y,
                                z = direction.Z
                            },
                            charge = 1
                        })
                    end)

                    if not okInvoke or not result then
                        _G.CourierBusy = false
                    else
                        result:andThen(function()
                            if generation == courierState.targetGeneration then
                                _G.CourierTarget = nil
                            end
                            _G.CourierBusy = false
                        end):catch(function()
                            if generation == courierState.targetGeneration then
                                _G.CourierTarget = nil
                            end
                            _G.CourierBusy = false
                        end)
                    end
                end
            end
        end)
    else
        warn("⚠️ No se pudo cargar ReplicatedStorage.Shared.Works.Courier.Net, el auto-lanzado no va a funcionar:", netModule)
    end
end

