                if paintData.Shell then

                    applyPaint(
                        "Roof",
                        roofData.MemberKey .. "|Shell",
                        paintData.Shell
                    )

                end

                if paintData.Trim then

                    applyPaint(
                        "Roof",
                        roofData.MemberKey .. "|Trim",
                        paintData.Trim
                    )

                end

            end

            roofPlaced += 1

        else

            roofSkipped += 1

        end
    end

else

end

        if BuildCache.Objects
        and #BuildCache.Objects > 0 then

        for index, data in ipairs(BuildCache.Objects) do
            progressCurrent += 1
            JmodsBuildProgress:Update(progressCurrent, "Objects", index, #BuildCache.Objects, totalCached)

            if stopCopy then
                break
            end

            if not data.ItemId then
                warn(index, "sin ItemId")
                skipped += 1
                continue
            end

            if not data.LocalPosition then
                warn(index, "sin posición")
                skipped += 1
                continue
            end

            local sourcePoint = data.PlacePoint

            if not sourcePoint then
                warn("El objeto no tiene PlacePoint:", index, data.ItemId)
                skipped += 1
                continue
            end

            local pointX
            local pointZ

            if typeof(sourcePoint) == "Vector2" then
                pointX = sourcePoint.X
                pointZ = sourcePoint.Y
            elseif typeof(sourcePoint) == "Vector3" then
                pointX = sourcePoint.X
                pointZ = sourcePoint.Z
            elseif type(sourcePoint) == "table" then
                pointX = tonumber(sourcePoint.x) or tonumber(sourcePoint.X)
                pointZ = tonumber(sourcePoint.z) or tonumber(sourcePoint.Z)
            end

            if not pointX or not pointZ then
                warn("PlacePoint no tiene formato válido:", index, data.ItemId, tostring(sourcePoint))
                skipped += 1
                continue
            end

            local point = {
                x = pointX,
                z = pointZ
            }

            local rotation = tonumber(data.PlaceRotation) or 0
            local height = tonumber(data.PlaceHeight) or 0

            local stand

            if data.PlaceStand == 2 or data.PlaceStand == "Hang" then
                stand = "Hang"
            elseif data.PlaceStand == 3 or data.PlaceStand == "Side" then
                stand = "Side"
            end

            local newObject = nil
            local usedPoint = point
            local usedAttempt = 0
            local requestError = nil

            for attempt = 0, 4 do
                if stopCopy then
                    break
                end

                local candidate = point
                local candidateSurface = data.Surface
                local candidateStand = stand

                if attempt > 0 then
                    candidate = makeCenterPoint(TargetBase)
                    candidateSurface = nil
                    candidateStand = nil
                end

                local candidateData = data

                if attempt > 0 and candidateData.Surface == nil then
                    candidateData = table.clone(data)
                    candidateData.Surface = nil
                end

                local found, err = sendPlaceItemAndWait(
                    TargetItems,
                    candidateData,
                    candidate,
                    rotation,
                    height,
                    candidateStand
                )

                if found then
                    newObject = found
                    usedPoint = candidate
                    usedAttempt = attempt
                    break
                end

                requestError = err
            end

            if newObject then
                local originalStretch = data.Stretch
                local originalBias = data.Bias

                local transformStretch = {
                    x = 1,
                    y = 1,
                    z = 1
                }

                local transformBias = {
                    x = 0,
                    y = 0,
                    z = 0
                }

                if typeof(originalStretch) == "Vector3" then
                    transformStretch.x = originalStretch.X
                    transformStretch.y = originalStretch.Y
                    transformStretch.z = originalStretch.Z
                elseif type(originalStretch) == "table" then
                    transformStretch.x = tonumber(originalStretch.x) or tonumber(originalStretch.X) or 1
                    transformStretch.y = tonumber(originalStretch.y) or tonumber(originalStretch.Y) or 1
                    transformStretch.z = tonumber(originalStretch.z) or tonumber(originalStretch.Z) or 1
                end

                if typeof(originalBias) == "Vector3" then
                    transformBias.x = originalBias.X
                    transformBias.y = originalBias.Y
                    transformBias.z = originalBias.Z
                elseif type(originalBias) == "table" then
                    transformBias.x = tonumber(originalBias.x) or tonumber(originalBias.X) or 0
                    transformBias.y = tonumber(originalBias.y) or tonumber(originalBias.Y) or 0
                    transformBias.z = tonumber(originalBias.z) or tonumber(originalBias.Z) or 0
                end

                local scaleNeeded =
                    transformStretch.x ~= 1
                    or transformStretch.y ~= 1
                    or transformStretch.z ~= 1
                    or transformBias.x ~= 0
                    or transformBias.y ~= 0
                    or transformBias.z ~= 0

                if usedAttempt > 0 and scaleNeeded then
                    local movedOK, movedResult = movePlacedObjectWithScaleBias(
                        TargetBase,
                        newObject,
                        point,
                        transformStretch,
                        transformBias
                    )

                    if not movedOK then
                        warn(
                            "ERROR MOVIENDO CON ESCALADO:",
                            index,
                            data.ItemId,
                            movedResult
                        )
                    else
                        JmodsLib:Notify({
                            Title = "Objeto colocado",
                            Content =
                                tostring(data.ItemId)
                                .. " creado en el centro y recolocado mediante escala.",
                            Duration = 2
                        })
                    end
                elseif usedAttempt > 0 then
                    local transformOK, transformResult =
                        pcall(function()
                            return Net.TransformItem.invoke({
                                key = tostring(newObject.Name),
                                point = {
                                    x = point.x,
                                    z = point.z
                                },
                                height = tonumber(data.PlaceHeight) or 0,
                                rotation = tonumber(data.PlaceRotation) or 0,
                                pitch = tonumber(data.PlacePitch) or 0,
                                roll = tonumber(data.PlaceRoll) or 0,
                                stretch = transformStretch,
                                bias = transformBias,
                                surface = data.Surface,
                                stand = stand
                            })
                        end)

                    if not transformOK then
                        warn(
                            "ERROR MOVIENDO OBJETO SIN ESCALA:",
                            index,
                            data.ItemId,
                            transformResult
                        )
                    end
                elseif scaleNeeded then
                    local scaleOK, scaleResult =
                        pcall(function()
                            return Net.ScaleItem.invoke({
                                key = tostring(newObject.Name),
                                stretch = transformStretch,
                                bias = transformBias
                            })
                        end)

                    if not scaleOK then
                        warn("ERROR SCALEITEM:", index, data.ItemId, scaleResult)
                    end

                    task.wait(0.05)

                    local transformOK, transformResult =
                        pcall(function()
                            return Net.TransformItem.invoke({
                                key = tostring(newObject.Name),
                                point = {
                                    x = usedPoint.x,
                                    z = usedPoint.z
                                },
                                height = tonumber(data.PlaceHeight) or 0,
                                rotation = tonumber(data.PlaceRotation) or 0,
                                pitch = tonumber(data.PlacePitch) or 0,
                                roll = tonumber(data.PlaceRoll) or 0,
                                stretch = transformStretch,
                                bias = transformBias,
                                surface = data.Surface,
                                stand = stand
                            })
                        end)

                    if not transformOK then
                        warn("ERROR TRANSFORMITEM:", index, data.ItemId, transformResult)
                    end
                end

                local paintData = data.Paint

                if paintData then
                    local paintOK, paintResult =
                        pcall(function()
                            return Net.PaintPiece.invoke({
                                kind = "Item",
                                key = tostring(newObject.Name),
                                look = {
                                    c = paintData.c,
                                    m = paintData.m,
                                    v = paintData.v
                                }
                            })
                        end)

                    if not paintOK then
                        warn("ERROR PAINTPIECE:", index, data.ItemId, paintResult)
                    end
                end

                local artworkImage = tonumber(data.ArtworkImage)

                if artworkImage and artworkImage > 0 then
                    local imageOK, imageResult =
                        pcall(function()
                            return Net.SetItemImage.invoke({
                                key = tostring(newObject.Name),
                                image = artworkImage
                            })
                        end)

                    if not imageOK then
                        warn("ERROR SETITEMIMAGE:", index, data.ItemId, artworkImage, imageResult)
                    end
                end

                placed += 1
            else
                skipped += 1

                if requestError then
                    warn("ERROR ENVIANDO OBJETO:", index, data.ItemId, requestError)
                else
                    warn(
                        "NO SE PUDO COLOCAR OBJETO EN EL PUNTO ORIGINAL NI EN LOS PUNTOS DE RESPALDO:",
                        index,
                        data.ItemId,
                        "PUNTO ORIGINAL:",
                        point.x,
                        point.z,
                        "ULTIMO PUNTO:",
                        usedPoint.x,
                        usedPoint.z
                    )
                end
            end
        end
        end

      if stopCopy then
          JmodsBuildProgress:Update(progressCurrent, "Detenida", progressCurrent, totalCached, totalCached)
          JmodsBuildProgress:Finish(true)
      else
          progressCurrent = totalCached
          JmodsBuildProgress:Update(progressCurrent, "Completado", totalCached, totalCached, totalCached)
          JmodsBuildProgress:Finish(false)
      end

      copyRunning = false

        JmodsLib:Notify({

    Title = "Construcción terminada",

    Content =
        "Objetos: "
        .. tostring(placed)

        .. " | Walls: "
        .. tostring(wallPlaced)

        .. " | Floors: "
        .. tostring(floorPlaced)

        .. " | Openings: "
        .. tostring(openingPlaced)

        .. " | Stairs: "
        .. tostring(stairPlaced)

        .. " | Roofs: "
        .. tostring(roofPlaced)

        .. " | Paths: "
.. tostring(pathPlaced),

    Duration = 6
})

end

