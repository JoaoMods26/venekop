NoclipSystem = {
    _autoCount = 0,
    _manualActive = false,
    _connection = nil,
    _originalStates = {}
}

 function noclipApplyToCharacter()
    local char = LocalPlayer.Character
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if NoclipSystem._originalStates[part] == nil then
                NoclipSystem._originalStates[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end

 function noclipRestoreCharacter()
    local char = LocalPlayer.Character
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local original = NoclipSystem._originalStates[part]
            part.CanCollide = (original == nil) and true or original
        end
    end

    NoclipSystem._originalStates = {}
end

 function noclipStartLoop()
    if NoclipSystem._connection then return end

    NoclipSystem._connection = RunService.Stepped:Connect(function()
        if NoclipSystem._autoCount > 0 or NoclipSystem._manualActive then
            noclipApplyToCharacter()
        end
    end)
end

 function noclipStopLoopIfIdle()
    if NoclipSystem._autoCount <= 0 and not NoclipSystem._manualActive then
        if NoclipSystem._connection then
            NoclipSystem._connection:Disconnect()
            NoclipSystem._connection = nil
        end
        noclipRestoreCharacter()
    end
end

function NoclipSystem:RequestAuto()
    self._autoCount += 1
    noclipStartLoop()
end

function NoclipSystem:ReleaseAuto()
    self._autoCount = math.max(0, self._autoCount - 1)
    noclipStopLoopIfIdle()
end

function NoclipSystem:SetManual(state)
    self._manualActive = state
    if state then
        noclipStartLoop()
    else
        noclipStopLoopIfIdle()
    end
end
TeleportSystem = {
    Config = {
        warmupFrames = 6,
        warmupSpeed = 1580,
        confirmations = 6
    },
    _forcePositionActive = false,
    _forceConnection = nil
}

 function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

function TeleportSystem:Teleport(targetPosition)
    local hrp = getHRP()
    if not hrp then return false end

    local startPos = hrp.Position
    local direction = (targetPosition - startPos)
    local distance = direction.Magnitude

    if distance < 5 then
        hrp.CFrame = CFrame.new(targetPosition, targetPosition + Vector3.new(0, 0, -1))
        return true
    end

    local frames = math.max(1, self.Config.warmupFrames)
    local speed = self.Config.warmupSpeed

    for i = 1, frames do
        if not hrp or not hrp.Parent then
            hrp = getHRP()
            if not hrp then return false end
        end

        local alpha = i / frames
        local stepDistance = math.min(distance, speed * (1/60) * i)
        local newPos = startPos + direction.Unit * stepDistance

        pcall(function()
            hrp.CFrame = CFrame.new(newPos, newPos + direction.Unit)
        end)

        RunService.Heartbeat:Wait()
    end

    hrp = getHRP()
    if not hrp then return false end

    pcall(function()
        hrp.CFrame = CFrame.new(targetPosition, targetPosition + direction.Unit)
    end)

    local confirmations = math.max(1, self.Config.confirmations)

    for i = 1, confirmations do
        RunService.Heartbeat:Wait()
        hrp = getHRP()
        if hrp and hrp.Parent then
            pcall(function()
                hrp.CFrame = CFrame.new(targetPosition, targetPosition + direction.Unit)
            end)
        end
    end

    return true
end

function TeleportSystem:ForcePosition(targetPosition)
    self:StopForcePosition()
    self._forcePositionActive = true

    self._forceConnection = RunService.Heartbeat:Connect(function()
        if not self._forcePositionActive then return end
        local hrp = getHRP()
        if hrp then
            pcall(function()
                hrp.CFrame = CFrame.new(targetPosition, targetPosition + Vector3.new(0, 0, -1))
            end)
        end
    end)
end

function TeleportSystem:StopForcePosition()
    self._forcePositionActive = false
    if self._forceConnection then
        self._forceConnection:Disconnect()
        self._forceConnection = nil
    end
end
GradualMoveSystem = {
    _active = false,
    _connection = nil
}

function GradualMoveSystem:MoveTo(targetPosition, duration)
    self:Stop()

    local hrp = getHRP()
    if not hrp then return end

    duration = duration or 1
    local startPos = hrp.Position
    local startTime = tick()

    self._active = true
    self._connection = RunService.Heartbeat:Connect(function()
        if not self._active then return end

        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)

        local currentHrp = getHRP()
        if currentHrp then
            local newPos = startPos:Lerp(targetPosition, alpha)
            pcall(function()
                currentHrp.CFrame = CFrame.new(newPos, newPos + (targetPosition - startPos).Unit)
            end)
        end

        if alpha >= 1 then
            self:Stop()
        end
    end)
end

function GradualMoveSystem:Stop()
    self._active = false
    if self._connection then
        self._connection:Disconnect()
        self._connection = nil
    end
end
