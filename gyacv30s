local courierVehicleMaintainConn = nil

local function setVehicleNoclipAndAnchor(vehicleModel, enable)
    if not vehicleModel then
        return
    end

    for _, part in ipairs(vehicleModel:GetDescendants()) do
        if part:IsA("BasePart") then
            if enable then
                if courierState.originalCollide[part] == nil then
                    courierState.originalCollide[part] = part.CanCollide
                end

                if courierState.originalAnchored[part] == nil then
                    courierState.originalAnchored[part] = part.Anchored
                end

                part.CanCollide = false

                if part ~= courierState.currentSeat then
                    part.Anchored = courierState.originalAnchored[part] or false
                end
            else
                local origCollide = courierState.originalCollide[part]
                local origAnchored = courierState.originalAnchored[part]

                pcall(function()
                    part.CanCollide = (origCollide == nil) and true or origCollide

                    if part ~= courierState.currentSeat then
                        part.Anchored = (origAnchored == nil) and false or origAnchored
                    end
                end)
            end
        end
    end

    if enable then
        if courierVehicleMaintainConn then
            courierVehicleMaintainConn:Disconnect()
            courierVehicleMaintainConn = nil
        end

        courierVehicleMaintainConn = RunService.Heartbeat:Connect(function()
            if not vehicleModel.Parent then
                return
            end

            for part in pairs(courierState.originalCollide) do
                if part and part.Parent and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)

        vehicleModel.DescendantAdded:Connect(function(newPart)
            if not CourierConfig.Enabled then
                return
            end

            if newPart:IsA("BasePart") then
                task.defer(function()
                    if not newPart.Parent then
                        return
                    end

                    if courierState.originalCollide[newPart] == nil then
                        courierState.originalCollide[newPart] = newPart.CanCollide
                    end

                    if courierState.originalAnchored[newPart] == nil then
                        courierState.originalAnchored[newPart] = newPart.Anchored
                    end

                    newPart.CanCollide = false
                end)
            end
        end)
    else
        if courierVehicleMaintainConn then
            courierVehicleMaintainConn:Disconnect()
            courierVehicleMaintainConn = nil
        end

        courierState.originalCollide = {}
        courierState.originalAnchored = {}
    end
end

local courierWorldMaintainConn = nil
local courierWorldDescendantConn = nil

local function setWorldCollision(enable)
    if enable then
        if courierState.worldNoclipApplied then
            return
        end

        courierState.worldNoclipApplied = true

        local function shouldSkip(obj)
            if LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character) then
                return true
            end

            if courierState.vehicleModel and obj:IsDescendantOf(courierState.vehicleModel) then
                return true
            end

            return false
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not shouldSkip(obj) then
                pcall(function()
                    if obj.CanCollide then
                        courierState.originalWorldCollisions[obj] = true
                        obj.CanCollide = false
                    end
                end)
            end
        end

        if courierWorldMaintainConn then
            pcall(function()
                task.cancel(courierWorldMaintainConn)
            end)

            courierWorldMaintainConn = nil
        end

        courierWorldMaintainConn = task.spawn(function()
            while courierState.worldNoclipApplied and CourierConfig.Enabled do
                for part in pairs(courierState.originalWorldCollisions) do
                    if part and part.Parent then
                        if part.CanCollide then
                            pcall(function()
                                part.CanCollide = false
                            end)
                        end
                    else
                        courierState.originalWorldCollisions[part] = nil
                    end
                end

                task.wait(0.5)
            end
        end)

        if courierWorldDescendantConn then
            courierWorldDescendantConn:Disconnect()
            courierWorldDescendantConn = nil
        end

        courierWorldDescendantConn = workspace.DescendantAdded:Connect(function(obj)
            if not courierState.worldNoclipApplied then
                return
            end

            if not obj:IsA("BasePart") then
                return
            end

            task.defer(function()
                if not obj.Parent then
                    return
                end

                if shouldSkip(obj) then
                    return
                end

                pcall(function()
                    if obj.CanCollide then
                        courierState.originalWorldCollisions[obj] = true
                        obj.CanCollide = false
                    end
                end)
            end)
        end)
    else
        courierState.worldNoclipApplied = false

        if courierWorldMaintainConn then
            pcall(function()
                task.cancel(courierWorldMaintainConn)
            end)

            courierWorldMaintainConn = nil
        end

        if courierWorldDescendantConn then
            courierWorldDescendantConn:Disconnect()
            courierWorldDescendantConn = nil
        end

        for part in pairs(courierState.originalWorldCollisions) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide = true
                end)
            end
        end

        courierState.originalWorldCollisions = {}
    end
end

