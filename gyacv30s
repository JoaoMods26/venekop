local function Invoke(route,payload)

    local remote = AvatarNet[route]

    if not remote then
        warn("Remote no encontrado:",route)
        return false
    end

    local ok,promise = pcall(function()
        return remote.invoke(payload)
    end)

    if not ok or not promise then
        warn(route,promise)
        return false
    end

    local finished = false
    local success = false
    local response

    promise
        :andThen(function(res)

            success = true
            response = res
            finished = true

        end)
        :catch(function(err)

            response = err
            finished = true

            warn(route,err)

        end)

    local start = tick()

    while not finished and tick()-start < 5 do
        task.wait()
    end

    return success,response

end

